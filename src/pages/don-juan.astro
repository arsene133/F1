---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RelationshipMap from '../components/RelationshipMap.astro';
import {
	dissertationTakeaway,
	domJuanCharacters,
	domJuanEdgeTypes,
	domJuanFunctions,
	domJuanMechanism,
	domJuanRelationships,
	mainThemes,
	secondaryThemes,
} from '../data/dom-juan';

const pageTitle = 'Dom Juan de Molière — personnages, intrigue et analyse thématique';
const pageDescription =
	'Carte interactive des personnages et analyse thématique complète de Dom Juan de Molière (1665) pour la classe de seconde : libertinage, hypocrisie, châtiment et liberté.';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />

		<main class="page-container dom-juan-page">
			<article aria-labelledby="page-title">
				<header class="map-intro">
					<p class="intro-eyebrow">Molière · 1665 · Comédie en cinq actes et en prose</p>
					<h1 id="page-title"><cite>Dom Juan</cite> — les personnages et les thèmes</h1>
					<p class="intro-desc">
						<strong>Libertinage, défi divin, hypocrisie et comédie de mœurs</strong>
					</p>
					<p class="intro-instructions">
						Sélectionnez un personnage ou une relation pour explorer son rôle et ses enjeux ; les flèches du clavier parcourent les figures, Échap réinitialise la vue.
					</p>
				</header>

				<!-- Modèle interprétatif en cinq temps de la trajectoire dramatique -->
				<ol class="mechanism" aria-label="Trajectoire dramatique de la pièce en cinq étapes">
					{domJuanMechanism.map((m) => (
						<li>
							<strong>{m.step}</strong>
							<span>{m.text}</span>
						</li>
					))}
				</ol>

				<!-- Carte relationnelle interactive -->
				<RelationshipMap
					id="dom-juan"
					ariaLabel="Carte des relations entre les personnages de Dom Juan de Molière"
					nodesLabel="Personnages de Dom Juan"
					nodes={domJuanCharacters}
					relationships={domJuanRelationships}
					edgeTypes={domJuanEdgeTypes}
					layout={{ width: 900, height: 560 }}
					mobileLayout={{ width: 360, height: 750 }}
					anchor={{
						x: 450,
						y: 20,
						label: 'La Cour & la route de Sicile',
						sub: 'Le théâtre du défi libertin',
					}}
					hint="Cliquez ou appuyez sur un personnage pour afficher son analyse et ses relations, ou sur une étiquette pour expliquer une relation."
					pointsLabel="Dans la pièce :"
					relationsLabel="Relations :"
					indexLabel="Toutes les relations de Dom Juan, en texte"
				/>

				<!-- Synthèse des personnages et des rôles -->
				<footer class="map-synthesis" aria-labelledby="synthesis-title">
					<h2 id="synthesis-title">Qui fait avancer l’intrigue ?</h2>
					<div class="synthesis-table-wrapper">
						<table class="synthesis-table">
							<thead>
								<tr>
									<th scope="col">Personnage</th>
									<th scope="col">Statut & identité</th>
									<th scope="col">Rôle dramatique</th>
								</tr>
							</thead>
							<tbody>
								{domJuanCharacters.map((c) => (
									<tr>
										<th scope="row">{c.label}</th>
										<td>{c.meta?.join(' · ')}</td>
										<td>{domJuanFunctions[c.id]}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>

					<div class="synthesis-axioms">
						<blockquote>
							« Quoi ! tu veux qu’on se lie à demeurer au premier objet qui nous prend, qu’on renonce au monde pour lui, et qu’on n’ait plus d’yeux pour personne ? »
							<cite>Dom Juan, acte I, scène 2</cite>
						</blockquote>
						<blockquote>
							« Ah ! mes gages ! mes gages ! Voilà, par sa mort, un chacun satisfait […] il n’y a que moi seul de malheureux. Mes gages, Mes gages, Mes gages ! »
							<cite>Sganarelle, acte V, scène 6 (texte original de 1682) — dénouement</cite>
						</blockquote>
					</div>

					<!-- Navigation d'accès direct aux analyses thématiques -->
					<nav class="pedagogical-anchors-nav" aria-label="Navigation vers les repères thématiques">
						<span class="nav-label">Repères pour la classe de seconde :</span>
						<a href="#themes-dom-juan" class="nav-anchor">Les thèmes majeurs</a>
						<span class="nav-sep" aria-hidden="true">·</span>
						<a href="#autres-themes" class="nav-anchor">D’autres thèmes à retenir</a>
						<span class="nav-sep" aria-hidden="true">·</span>
						<a href="#question-interpretative" class="nav-anchor">Question d’interprétation</a>
						<span class="nav-sep" aria-hidden="true">·</span>
						<a href="#a-retenir-dissertation" class="nav-anchor">À retenir pour une dissertation</a>
					</nav>
				</footer>

				<!-- ==========================================================
				     SECTION 2 : Les thèmes de Dom Juan
				     ========================================================== -->
				<section class="pedagogical-section" id="themes-dom-juan" aria-labelledby="themes-title">
					<header class="pedagogical-header">
						<p class="pedagogical-eyebrow">Analyse littéraire · Classe de seconde</p>
						<h2 id="themes-title">Les thèmes de <cite>Dom Juan</cite></h2>
					</header>

					<p class="pedagogical-intro-lead">
						Créée en 1665 au théâtre du Palais-Royal, la pièce de Molière conjugue avec une audace singulière
						la comédie, la satire sociale, les interrogations morales et l’irruption du surnaturel.
						À travers le parcours provocateur de son héros libertin, l'auteur explore les contradictions de son
						siècle et compose une œuvre complexe qui échappe aux règles classiques traditionnelles.
					</p>

					<div class="themes-grid">
						{mainThemes.map((theme) => (
							<article class="theme-card" id={`theme-${theme.id}`}>
								<header class="theme-card-header">
									<span class="theme-tag">{theme.tag}</span>
									<h3 class="theme-title">{theme.title}</h3>
								</header>
								<div class="theme-card-body">
									<div class="theme-section-unit">
										<p class="theme-didactic-question">{theme.definitionQuestion}</p>
										<p class="theme-summary">{theme.summary}</p>
									</div>
									<div class="theme-section-unit">
										<p class="theme-didactic-question">{theme.illustrationQuestion}</p>
										<p class="theme-analysis">{theme.analysis}</p>
									</div>
									{theme.quote && (
										<blockquote class="theme-quote">
											<p>« {theme.quote.text} »</p>
											<cite>{theme.quote.speaker}, {theme.quote.ref}</cite>
										</blockquote>
									)}
								</div>
							</article>
						))}
					</div>

					<!-- ==========================================================
					     SECTION 3 : D'autres thèmes à retenir
					     ========================================================== -->
					<div class="secondary-themes-block" id="autres-themes">
						<div class="secondary-themes-header">
							<span class="secondary-themes-badge">Vue panoramique</span>
							<h3 class="secondary-themes-title">D’autres thèmes à retenir</h3>
						</div>
						<p class="secondary-themes-lead">
							Au-delà des grands axes fondateurs, plusieurs motifs essentiels enrichissent la compréhension de la pièce et fournissent des exemples précis pour nourrir un commentaire ou une dissertation :
						</p>
						<div class="secondary-themes-grid">
							{secondaryThemes.map((item) => (
								<div class="secondary-theme-card">
									<h4 class="secondary-theme-name">{item.title}</h4>
									<p class="secondary-theme-desc">{item.description}</p>
								</div>
							))}
						</div>
					</div>

					<!-- ==========================================================
					     SECTION 4 : Question d'interprétation
					     ========================================================== -->
					<div class="pedagogical-box question-box" id="question-interpretative">
						<div class="question-box-header">
							<span class="question-badge">Question d’interprétation</span>
							<h3 class="question-title">Dom Juan est-il un homme libre ou un homme sans morale ?</h3>
						</div>
						<div class="question-box-content">
							<p>
								Poser cette question, c’est explorer la tension morale et philosophique fondamentale qui habite la pièce de Molière. D’un côté, Dom Juan fascine par son <strong>audace intellectuelle et son courage héroïque</strong> : il refuse les conventions étouffantes, démasque les hypocrisies de son temps et ne cède devant aucune intimidation. Face aux brigands qui encerclent Dom Carlos (acte III, scène 2) ou devant la statue de pierre qui s’avance (actes IV et V), il ne fuit jamais et refuse de mentir sur sa peur.
							</p>
							<p>
								Mais d’un autre côté, cette liberté revendiquée se retourne en <strong>instrument de domination et de prédation cruelle</strong>. Dom Juan utilise sa supériorité d’esprit et son statut social pour duper les femmes, fouler aux pieds sa parole d’honneur, se débarrasser sans scrupule de ses créanciers et humilier son père. Sa liberté personnelle refuse toute réciprocité morale : elle se fonde sur l’écrasement de ceux qui l’entourent et refuse toute responsabilité envers la société humaine.
							</p>
							<p>
								La pièce se garde bien de trancher d’une manière simpliste. Molière ne propose ni une apologie enthousiaste du libertin ni une pièce morale édifiante au dénouement convenu : le spectateur demeure partagé entre l’admiration pour la virtuosité et l’éloquence du personnage, et le malaise profond face à son cynisme dévastateur. C’est cette ambiguïté permanente qui fait de <cite>Dom Juan</cite> un classique inépuisable.
							</p>
						</div>
					</div>

					<!-- ==========================================================
					     SECTION 5 : À retenir pour une dissertation
					     ========================================================== -->
					<div class="takeaway-banner" id="a-retenir-dissertation" role="note" aria-labelledby="takeaway-heading">
						<span class="takeaway-tag" id="takeaway-heading">À retenir pour une dissertation</span>
						<p class="takeaway-content">
							« {dissertationTakeaway} »
						</p>
					</div>
				</section>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	.dom-juan-page {
		--intro-eyebrow-color: #8a1f1a;
	}

	.map-intro h1 cite {
		font-style: italic;
	}

	/* Mécanisme dramatique de Dom Juan */
	.mechanism {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		margin: -1rem 0 1.75rem;
		padding: 0;
		list-style: none;
		counter-reset: step;
	}

	.mechanism li {
		position: relative;
		margin: 0;
		padding: 0 0.85rem;
		font-size: 0.8rem;
		line-height: 1.35;
		color: #5e6d7a;
		text-align: center;
	}

	.mechanism li + li::before {
		content: '→';
		position: absolute;
		left: -0.45rem;
		top: 0;
		font-family: Georgia, 'Times New Roman', serif;
		color: #a2312b;
	}

	.mechanism strong {
		display: block;
		margin-bottom: 0.15rem;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 0.95rem;
		font-style: italic;
		color: #172b3a;
	}

	.mechanism li:last-child strong {
		color: #8a1f1a;
	}

	@media (max-width: 720px) {
		.mechanism {
			grid-template-columns: 1fr;
			gap: 0.35rem;
			margin-top: -1.25rem;
		}

		.mechanism li {
			display: flex;
			gap: 0.5rem;
			align-items: baseline;
			padding: 0 0 0 1.1rem;
			text-align: left;
		}

		.mechanism li + li::before {
			content: '↓';
			left: 0;
		}

		.mechanism strong {
			display: inline;
			flex-shrink: 0;
			min-width: 6.5rem;
		}
	}

	/* Navigation rapide vers les sections pédagogiques */
	.pedagogical-anchors-nav {
		margin-top: 2rem;
		padding: 0.85rem 1.25rem;
		background: #fbf9f4;
		border: 1px solid var(--map-border);
		border-radius: 6px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem 0.75rem;
		font-size: 0.88rem;
	}

	.pedagogical-anchors-nav .nav-label {
		font-weight: 700;
		color: var(--map-ink);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-size: 0.78rem;
	}

	.pedagogical-anchors-nav .nav-anchor {
		color: #235284;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color 0.15s ease;
	}

	.pedagogical-anchors-nav .nav-anchor:hover {
		color: #8a1f1a;
	}

	.pedagogical-anchors-nav .nav-sep {
		color: var(--map-border);
	}

	/* ==========================================================================
	   Sections pédagogiques : Les thèmes de Dom Juan
	   ========================================================================== */
	.pedagogical-section {
		margin-top: 4.5rem;
		border-top: 1px solid var(--map-border);
		padding-top: 3rem;
		scroll-margin-top: 2rem;
	}

	.pedagogical-header {
		text-align: center;
		max-width: 780px;
		margin: 0 auto 1.75rem;
	}

	.pedagogical-eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: #8a1f1a;
	}

	.pedagogical-header h2 {
		margin: 0;
		font-family: var(--map-serif);
		font-size: clamp(1.6rem, 3vw, 2.25rem);
		font-weight: normal;
		line-height: 1.25;
		color: var(--map-ink);
	}

	.pedagogical-header h2 cite {
		font-style: italic;
	}

	.pedagogical-intro-lead {
		font-size: 1.02rem;
		line-height: 1.7;
		color: var(--map-ink-soft);
		margin: 0 auto 2.5rem;
		max-width: 820px;
		text-align: center;
	}

	/* Grille des 6 thèmes majeurs */
	.themes-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		margin-bottom: 3.5rem;
	}

	.theme-card {
		background: #ffffff;
		border: 1px solid var(--map-border);
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(23, 43, 58, 0.03);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.theme-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 14px rgba(23, 43, 58, 0.07);
	}

	.theme-card-header {
		padding: 1.15rem 1.25rem 0.85rem;
		background: #fbf9f4;
		border-bottom: 1px solid var(--map-border-soft);
	}

	.theme-tag {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #8a1f1a;
		margin-bottom: 0.35rem;
	}

	.theme-title {
		margin: 0;
		font-family: var(--map-serif);
		font-size: 1.18rem;
		font-weight: 600;
		line-height: 1.35;
		color: var(--map-ink);
	}

	.theme-card-body {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		flex: 1 1 auto;
	}

	.theme-section-unit {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.theme-didactic-question {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: #235284;
	}

	.theme-summary {
		margin: 0;
		font-size: 0.94rem;
		line-height: 1.55;
		font-weight: 600;
		color: var(--map-ink);
	}

	.theme-analysis {
		margin: 0;
		font-size: 0.91rem;
		line-height: 1.62;
		color: var(--map-ink-soft);
		text-align: justify;
	}

	.theme-quote {
		margin: 0.25rem 0 0;
		padding: 0.75rem 0.95rem;
		background: #fdfcf9;
		border-left: 3px solid #8a1f1a;
		border-radius: 0 4px 4px 0;
		font-size: 0.86rem;
		line-height: 1.48;
		color: var(--map-ink);
	}

	.theme-quote p {
		margin: 0;
		font-style: italic;
	}

	.theme-quote cite {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.78rem;
		font-style: normal;
		color: var(--map-muted);
		text-align: right;
	}

	/* Section D'autres thèmes à retenir */
	.secondary-themes-block {
		margin-bottom: 3.5rem;
		background: #ffffff;
		border: 1px solid var(--map-border);
		border-radius: 8px;
		padding: 1.75rem;
		box-shadow: 0 2px 8px rgba(23, 43, 58, 0.03);
	}

	.secondary-themes-header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.secondary-themes-badge {
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.2rem 0.55rem;
		border-radius: 3px;
		background: rgba(35, 82, 132, 0.1);
		color: #235284;
		border: 1px solid rgba(35, 82, 132, 0.25);
	}

	.secondary-themes-title {
		margin: 0;
		font-family: var(--map-serif);
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--map-ink);
	}

	.secondary-themes-lead {
		margin: 0 0 1.25rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--map-ink-soft);
	}

	.secondary-themes-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1rem;
	}

	.secondary-theme-card {
		background: #fbf9f4;
		border: 1px solid var(--map-border-soft);
		border-radius: 6px;
		padding: 1rem 1.15rem;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.secondary-theme-name {
		margin: 0;
		font-family: var(--map-serif);
		font-size: 0.98rem;
		font-weight: 700;
		color: var(--map-ink);
	}

	.secondary-theme-desc {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.52;
		color: var(--map-ink-soft);
	}

	/* Question d'interprétation */
	.question-box {
		margin: 3.5rem 0;
		background: #ffffff;
		border: 1px solid var(--map-border);
		border-left: 4px solid #8b572a;
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(23, 43, 58, 0.03);
		overflow: hidden;
	}

	.question-box-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		padding: 1.15rem 1.4rem;
		background: #fdfcf9;
		border-bottom: 1px solid var(--map-border-soft);
	}

	.question-badge {
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.2rem 0.55rem;
		border-radius: 3px;
		background: rgba(139, 87, 42, 0.1);
		color: #8b572a;
		border: 1px solid rgba(139, 87, 42, 0.25);
	}

	.question-title {
		margin: 0;
		font-family: var(--map-serif);
		font-size: 1.22rem;
		font-weight: 600;
		color: var(--map-ink);
	}

	.question-box-content {
		padding: 1.35rem 1.4rem;
	}

	.question-box-content p {
		margin: 0 0 1rem;
		font-size: 0.95rem;
		line-height: 1.68;
		color: var(--map-ink-soft);
		text-align: justify;
	}

	.question-box-content p:last-child {
		margin-bottom: 0;
	}

	.question-box-content strong {
		color: var(--map-ink);
	}

	/* Synthèse / À retenir pour une dissertation */
	.takeaway-banner {
		margin: 3.5rem 0 1.5rem;
		padding: 1.5rem 1.75rem;
		background: linear-gradient(135deg, #fdfcf9 0%, #f7f1e6 100%);
		border: 1px solid #dcd6cb;
		border-left: 5px solid #8a1f1a;
		border-radius: 6px;
		text-align: center;
		box-shadow: 0 2px 8px rgba(23, 43, 58, 0.03);
	}

	.takeaway-tag {
		display: inline-block;
		margin-bottom: 0.6rem;
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: #8a1f1a;
	}

	.takeaway-content {
		margin: 0;
		font-family: var(--map-serif);
		font-size: 1.18rem;
		font-weight: 600;
		line-height: 1.6;
		color: var(--map-ink);
		font-style: italic;
	}

	@media (max-width: 820px) {
		.themes-grid {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.secondary-themes-grid {
			grid-template-columns: 1fr;
		}

		.question-box-content,
		.secondary-themes-block {
			padding: 1.15rem;
		}

		.takeaway-banner {
			padding: 1.25rem 1.15rem;
		}

		.takeaway-content {
			font-size: 1.05rem;
		}
	}
</style>
