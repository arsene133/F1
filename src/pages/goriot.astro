---
import { Image } from 'astro:assets';
import pereGoriotIllustration from '../assets/pere-goriot-illustration.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import GoriotMap from '../components/GoriotMap.astro';
import GoriotRelationshipsMap from '../components/GoriotRelationshipsMap.astro';
import GoriotThemesDashboard from '../components/GoriotThemesDashboard.astro';
import Header from '../components/Header.astro';
import { goriotCategories, goriotPlaces } from '../data/goriot-places';

const pageTitle = 'Le Père Goriot d’Honoré de Balzac — Lieux, personnages et thèmes du roman';
const pageDescription =
	'Explorez Le Père Goriot (1835) : le réseau relationnel des personnages, la carte géographique des lieux de Paris et le tableau de bord thématique interactif (paternité, argent, ambition, corruption, solitude).';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<link
			rel="stylesheet"
			href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
			integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
			crossorigin=""
		/>
	</head>
	<body>
		<Header />

		<main class="page-container goriot-page">
			<article aria-labelledby="page-title">
				<!-- En-tête éditorial -->
				<header class="map-intro">
					<p class="intro-eyebrow">Honoré de Balzac · 1835 · La Comédie humaine</p>
					<h1 id="page-title"><cite>Le Père Goriot</cite> — Lieux, relations et thèmes</h1>
					<p class="intro-desc">
						<strong>Topographie parisienne, ascension d’Eugène de Rastignac et grille d’analyse critique</strong>
					</p>
					<p class="intro-context">
						Situé à Paris à la fin de l’année 1819 sous la Restauration, <em>Le Père Goriot</em> déploie
						une dramaturgie où la ville n’est pas un simple arrière-plan pittoresque, mais un
						<strong>espace social divisé</strong> et un puissant moteur dramatique. Entre le faubourg
						Saint-Marceau (où végètent les déclassés de la pension Vauquer), le noble faubourg
						Saint-Germain (où règne l’ancienne aristocratie) et la Chaussée-d’Antin (où triomphe la haute banque),
						chaque franchissement de la Seine traduit une conquête ou une déchéance morale.
					</p>
					<p class="intro-instructions">
						Naviguez entre les trois volets complémentaires : le réseau des personnages, la carte topographique des lieux et le tableau de bord des thèmes littéraires.
					</p>

					<!-- Navigation rapide entre les trois sections -->
					<nav class="goriot-visualizations-nav" aria-label="Choisir la vue ou l’outil d’analyse">
						<a href="#section-reseau-personnages" class="viz-nav-btn viz-nav-highlight">
							<span class="viz-nav-icon" aria-hidden="true">👥</span>
							<span>1. Réseau des personnages & intrigues</span>
						</a>
						<a href="#section-carte-lieux" class="viz-nav-btn">
							<span class="viz-nav-icon" aria-hidden="true">🗺️</span>
							<span>2. Carte géographique des lieux de Paris</span>
						</a>
						<a href="#section-themes-roman" class="viz-nav-btn viz-nav-thematic">
							<span class="viz-nav-icon" aria-hidden="true">💡</span>
							<span>3. Tableau de bord thématique</span>
						</a>
						<a href="#sources-iconographiques" class="viz-nav-btn viz-nav-iconography">
							<span class="viz-nav-icon" aria-hidden="true">🖼️</span>
							<span>4. Documents iconographiques</span>
						</a>
					</nav>
				</header>

				<!-- Section 1 : Carte relationnelle des personnages -->
				<section class="goriot-section" id="section-reseau-personnages" aria-labelledby="rel-network-title">
					<header class="section-editorial-header">
						<p class="section-tag">Visualisation relationnelle</p>
						<h2 id="rel-network-title" class="section-title">Le réseau des personnages et leurs relations</h2>
						<p class="section-lead">
							Comprendre qui sont les 16 protagonistes majeurs, comment s'entrecroisent les liens familiaux, financiers, amoureux et de manipulation, et quelle place centrale occupe Eugène de Rastignac dans cet échiquier social.
						</p>
					</header>

					<GoriotRelationshipsMap id="goriot-relationships" />
				</section>

				<!-- Section 2 : Carte géographique des lieux parisiens -->
				<section class="goriot-section" id="section-carte-lieux" aria-labelledby="geo-places-title">
					<header class="section-editorial-header">
						<p class="section-tag">Visualisation topographique</p>
						<h2 id="geo-places-title" class="section-title">La carte des lieux parisiens du roman</h2>
						<p class="section-lead">
							Topographie sociale, fractures spatiales entre les rives de la Seine et stations du parcours initiatique d’Eugène de Rastignac.
						</p>
					</header>

					<!-- Panneau d'introduction illustrée et repères littéraires -->
					<section class="goriot-literary-overview" aria-labelledby="overview-title">
						<div class="overview-grid">
							<div class="overview-image-wrapper">
								<Image
									src={pereGoriotIllustration}
									alt="Illustration du roman Le Père Goriot d'Honoré de Balzac"
									class="overview-image"
									width={320}
									height={420}
								/>
								<figcaption class="overview-image-caption">
									Le père Goriot dépouillé par la passion de ses filles (illustration d’époque).
								</figcaption>
							</div>

							<div class="overview-text">
								<h3 id="overview-title" class="overview-title">Paris comme théâtre des ambitions et des abîmes</h3>
								<p>
									Dans <em>Le Père Goriot</em>, Honoré de Balzac invente une véritable « sociologie de l’espace ».
									Le jeune Eugène de Rastignac, venu de sa province charentaise pour étudier le droit, découvre
									que la capitale est un échiquier impitoyable gouverné par deux passions absolues : <strong>l’argent</strong>
									et <strong>le paraître</strong>.
								</p>
								<div class="social-contrasts-cards">
									<div class="contrast-card contrast-modest">
										<span class="contrast-badge">Le monde d’en bas</span>
										<h4>Le faubourg Saint-Marceau</h4>
										<p>
											La <em>rue Neuve-Sainte-Geneviève</em> et la pension Vauquer : ruelles boueuses, crasse, odeur de renfermé.
											Ici s’accumulent les misères, les ambitions contrariées et le sacrifice du père Goriot.
										</p>
									</div>
									<div class="contrast-card contrast-noble">
										<span class="contrast-badge">Le monde du rang</span>
										<h4>Le faubourg Saint-Germain</h4>
										<p>
											La <em>rue de Grenelle</em> et l’hôtel de Beauséant : salons aux armoiries séculaires, faste glacé et
											mépris aristocratique des parvenus. L’école où Rastignac apprend les lois du cynisme.
										</p>
									</div>
									<div class="contrast-card contrast-bourgeois">
										<span class="contrast-badge">Le monde de l’or</span>
										<h4>La Chaussée-d’Antin</h4>
										<p>
											La <em>rue Saint-Lazare</em> et la <em>rue du Helder</em> : hôtels de banquiers aux stucs opulents,
											spéculations boursières dévorantes et filles ingrates prêtes à dépouiller leur père pour une parure.
										</p>
									</div>
								</div>
							</div>
						</div>
					</section>

					<!-- Composant interactif principal de la carte géographique -->
					<GoriotMap />
				</section>

				<!-- Section 3 : Tableau de bord thématique du roman -->
				<section class="goriot-section" id="section-themes-roman" aria-labelledby="themes-dashboard-title">
					<header class="section-editorial-header">
						<p class="section-tag">Analyse littéraire & baccalauréat</p>
						<h2 id="themes-dashboard-title" class="section-title">Tableau de bord thématique du roman</h2>
						<p class="section-lead">
							Passer de l’observation des faits à l’interprétation littéraire : questions directrices pour la dissertation, repères pour la classe de seconde, scènes fondatrices et citations vérifiées.
						</p>
					</header>

					<GoriotThemesDashboard id="goriot-themes" />
				</section>

				<!-- Section 4 : Dossier iconographique patrimonial et critique des sources -->
				<section class="goriot-iconography-section" id="sources-iconographiques" aria-labelledby="iconography-section-title">
					<header class="iconography-header">
						<p class="iconography-tag">Sources historiques & Archives patrimoniales</p>
						<h2 id="iconography-section-title" class="iconography-heading">
							Documents iconographiques — Lire le monde du <cite>Père Goriot</cite>
						</h2>
						<p class="iconography-lead">
							Pour un élève de seconde étudiant le réalisme balzacien, confronter le roman à des documents visuels du XIX<sup>e</sup> siècle permet de mesurer comment Balzac ancre sa fiction dans la matière historique et sociale de son temps. Loin de simples illustrations décoratives, ces estampes, éditions originales, photographies patrimoniales et tableaux constituent des <strong>sources historiques à observer et à interroger avec rigueur</strong> : qui est l'auteur ? Quelle est la date réelle de création ? Que montre le document avec certitude et que ne prouve-t-il pas ?
						</p>

						<!-- Cadre méthodologique des 4 statuts documentaires -->
						<div class="iconography-method-banner">
							<span class="method-banner-title">Méthode d’observation : les quatre statuts documentaires</span>
							<ul class="method-banner-list">
								<li><span class="status-badge status-contemporain">Document contemporain (1815–1835)</span> Produit pendant l'époque du récit ou de sa rédaction ; témoin direct.</li>
								<li><span class="status-badge status-editorial">Représentation éditoriale (vers 1842)</span> Illustration créée pour l'édition de l'œuvre sous le regard de l'auteur.</li>
								<li><span class="status-badge status-posterieur">Document historique postérieur (vers 1880–1912)</span> Enregistre l'état ultérieur d'un lieu à ne pas rétroprojeter sans recul critique.</li>
								<li><span class="status-badge status-reconstitution">Reconstitution / Vue rétrospective</span> Vue historique restituée a posteriori pour documenter un cadre disparu.</li>
							</ul>
						</div>
					</header>

					<div class="iconography-cards-grid">
						<!-- Document 1 : Page de titre de l'édition originale (1835, Werdet) -->
						<article class="iconography-card" id="doc-edition-originale-1835">
							<header class="iconography-card-header">
								<span class="status-badge status-contemporain">Document contemporain (1835)</span>
								<h3 class="iconography-card-title">1. Le livre et sa naissance : l’édition originale de 1835</h3>
							</header>

							<figure class="iconography-figure">
								<img
									src="/images/goriot/goriot-edition-originale-1835.jpg"
									alt="Page de titre de l'édition originale du Père Goriot d'Honoré de Balzac, librairie Werdet, Paris, 1835"
									class="iconography-img"
									loading="lazy"
									width="862"
									height="1500"
								/>
								<figcaption class="iconography-caption">
									Page de titre du tome premier de l’édition originale du <em>Père Goriot</em>, Paris, Librairie de Werdet, 1835 (BnF Gallica).
								</figcaption>
							</figure>

							<div class="iconography-meta-box">
								<ul class="iconography-meta-list">
									<li><strong>Titre exact du document :</strong> <cite>Le Père Goriot, histoire parisienne publiée par M. De Balzac</cite> (Tome I)</li>
									<li><strong>Auteur / Éditeur :</strong> Honoré de Balzac (auteur) ; Librairie de Werdet, Spachmann (imprimeur-éditeur à Paris)</li>
									<li><strong>Date de publication :</strong> Mars 1835 (après pré-publication en feuilleton dans la <em>Revue de Paris</em>, déc. 1834 – fév. 1835)</li>
									<li><strong>Institution de conservation :</strong> Bibliothèque nationale de France (département Réserve des livres rares)</li>
									<li><strong>Identifiant pérenne :</strong> <a href="https://gallica.bnf.fr/ark:/12148/btv1b8625627c" target="_blank" rel="noopener noreferrer" class="meta-permalink">Gallica ark:/12148/btv1b8625627c</a></li>
									<li><strong>Licence :</strong> Domaine public</li>
								</ul>
							</div>

							<div class="iconography-evaluation-box">
								<h4>Évaluation documentaire & analyse critique</h4>
								<p>
									<strong>Que montre réellement le document ?</strong> La typographie d'époque et le sous-titre originel <em>« histoire parisienne »</em>. Le roman est d'abord paru en deux volumes in-8° chez Werdet avant d'être intégré plus tard dans les <em>Scènes de la vie parisienne</em> de <em>La Comédie humaine</em> (1842).
								</p>
								<p>
									<strong>Rapprochement avec le texte du roman :</strong> Dans l'avertissement et le célèbre préambule, Balzac prévient solennellement son lecteur : <em>« Ah ! sachez-le : ce drame n'est ni une fiction, ni un roman. All is true, il est si véritable que chacun peut en reconnaître les éléments chez soi, dans son cœur peut-être. »</em>
								</p>
								<p>
									<strong>Limite historiographique :</strong> La page de titre témoigne des conditions matérielles de publication sous la monarchie de Juillet (1835), alors que l’intrigue diégétique se déroule seize ans plus tôt, à la fin de l’année 1819 sous la Restauration.
								</p>
							</div>

							<div class="iconography-question-box">
								<strong>Questions d’observation pour les élèves :</strong>
								<p>1. Pourquoi Balzac sous-titre-t-il son œuvre « histoire parisienne » plutôt que simplement « roman » ? Que suggère ce choix sur son projet réaliste ?</p>
								<p>2. Quelle différence faites-vous entre la date de l'histoire racontée (1819) et la date d'impression de ce livre (1835) ?</p>
							</div>
						</article>

						<!-- Document 2 : Atget, Cour et puits au 24 rue Tournefort (Maison Vauquer) -->
						<article class="iconography-card" id="doc-cour-tournefort-vauquer">
							<header class="iconography-card-header">
								<span class="status-badge status-posterieur">Document historique postérieur (1901–1912)</span>
								<h3 class="iconography-card-title">2. L’habitat et la pension : cour et puits de la rue Tournefort</h3>
							</header>

							<figure class="iconography-figure">
								<img
									src="/images/goriot/atget-cour-tournefort.jpg"
									alt="Photographie ancienne d'une cour pavée et d'un puits au 24 rue Tournefort par Eugène Atget"
									class="iconography-img"
									loading="lazy"
									width="5345"
									height="6547"
								/>
								<figcaption class="iconography-caption">
									Eugène Atget, <em>Cour et puits, 24 rue Tournefort, 5ᵉ arrondissement</em> (vers 1901, tirage acquis en 1912), Musée Carnavalet (Paris Musées).
								</figcaption>
							</figure>

							<div class="iconography-meta-box">
								<ul class="iconography-meta-list">
									<li><strong>Titre de la notice :</strong> <cite>Cour et puits, 24 rue Tournefort, 5ème arrondissement, Paris</cite></li>
									<li><strong>Photographe :</strong> Eugène Atget (1857–1927), campagne documentaire des « Coins du vieux Paris »</li>
									<li><strong>Date de prise de vue :</strong> Vers 1901 (tirage monté acquis par le musée en 1912)</li>
									<li><strong>Institution conservatrice :</strong> Musée Carnavalet — Histoire de Paris (Paris Musées)</li>
									<li><strong>Numéro d'inventaire :</strong> PH4494 / CARPHATGETE7677</li>
									<li><strong>Identifiant pérenne :</strong> <a href="https://www.parismuseescollections.paris.fr/fr/musee-carnavalet/oeuvres/cour-et-puits-24-rue-tournefort-5eme-arrondissement-paris#infos-principales" target="_blank" rel="noopener noreferrer" class="meta-permalink">Paris Musées PH4494</a></li>
									<li><strong>Licence :</strong> CC0 Paris Musées / Domaine public</li>
								</ul>
							</div>

							<div class="iconography-evaluation-box">
								<h4>Évaluation documentaire & analyse critique</h4>
								<p>
									<strong>Que montre réellement le document ?</strong> Une étroite cour pavée bordée de hauts murs décrépits, avec un puits en pierre et un sol humide, caractéristique des cours intérieures populeuses de la montagne Sainte-Geneviève.
								</p>
								<p>
									<strong>Rapprochement avec le texte du roman :</strong> Balzac décrit méticuleusement l'entrée et l'environnement de la pension de Mme Vauquer : <em>« Entre la maison et la cour se trouve un puits à roue, avec une margelle de pierre... Le pavé gras et glissant semble imprégné de misère. »</em>
								</p>
								<p>
									<strong>Limite historiographique majeure :</strong> Balzac ne mentionne aucun numéro dans le roman (il écrit seulement <em>« dans le bas de la rue Neuve-Sainte-Geneviève »</em>, ancienne appellation de la rue Tournefort). Ce n'est qu'au tournant du XX<sup>e</sup> siècle que des érudits parisiens ont proposé le n° 24 comme modèle probable. <strong>Cette photographie ne prouve pas l'existence physique de la pension Vauquer</strong> : elle documente la réalité architecturale des cours vétustes de ce quartier.
								</p>
							</div>

							<div class="iconography-question-box">
								<strong>Questions d’observation pour les élèves :</strong>
								<p>1. Quels éléments matériels de cette cour photographiée par Atget évoquent l'atmosphère d'isolement et de dénuement décrite par Balzac ?</p>
								<p>2. Pourquoi faut-il refuser d'affirmer avec certitude que ce lieu précis était « la maison de madame Vauquer » ?</p>
							</div>
						</article>

						<!-- Document 3 : Atget, Hôtel du Châtelet rue de Grenelle (Faubourg Saint-Germain) -->
						<article class="iconography-card" id="doc-hotel-grenelle-beauseant">
							<header class="iconography-card-header">
								<span class="status-badge status-posterieur">Document historique postérieur (XVIIIᵉ s. / début XXᵉ)</span>
								<h3 class="iconography-card-title">3. Le sanctuaire aristocratique : hôtel particulier rue de Grenelle</h3>
							</header>

							<figure class="iconography-figure">
								<img
									src="/images/goriot/atget-hotel-chatelet-grenelle.jpg"
									alt="Portail monumental et cour d'honneur de l'hôtel du Châtelet, 127 rue de Grenelle à Paris, photographié par Eugène Atget"
									class="iconography-img"
									loading="lazy"
									width="5377"
									height="4390"
								/>
								<figcaption class="iconography-caption">
									Eugène Atget, <em>Hôtel du Châtelet, 127 rue de Grenelle, 7ᵉ arrondissement</em>, Musée Carnavalet (Paris Musées, CC0).
								</figcaption>
							</figure>

							<div class="iconography-meta-box">
								<ul class="iconography-meta-list">
									<li><strong>Titre de la notice :</strong> <cite>Hôtel du Châtelet (hôtel de Chanac ancien), 127 rue de Grenelle, 7ème arrondissement, Paris</cite></li>
									<li><strong>Photographe / Édifice :</strong> Photographie d’Eugène Atget (acquis en 1912) ; hôtel édifié par Mathurin Cherpitel en 1770–1776</li>
									<li><strong>Période du monument :</strong> Architecture aristocratique d’Ancien Régime subsistant sous la Restauration</li>
									<li><strong>Institution conservatrice :</strong> Musée Carnavalet — Histoire de Paris (Paris Musées)</li>
									<li><strong>Numéro d'inventaire :</strong> PH3893 (Coins du Vieux Paris, planche 18)</li>
									<li><strong>Identifiant pérenne :</strong> <a href="https://www.parismuseescollections.paris.fr/fr/musee-carnavalet/oeuvres/hotel-du-chatelet-hotel-de-chanac-ancien-127-rue-de-grenelle-7eme#infos-principales" target="_blank" rel="noopener noreferrer" class="meta-permalink">Paris Musées PH3893</a></li>
									<li><strong>Licence :</strong> CC0 Paris Musées / Domaine public</li>
								</ul>
							</div>

							<div class="iconography-evaluation-box">
								<h4>Évaluation documentaire & analyse critique</h4>
								<p>
									<strong>Que montre réellement le document ?</strong> La majesté solennelle d'un grand hôtel particulier du faubourg Saint-Germain : portail monumental entre cour et jardin, colonnades classiques et cour d'honneur isolant les maîtres du tumulte de la rue.
								</p>
								<p>
									<strong>Rapprochement avec le texte du roman :</strong> C'est dans ce décor architectural précis de la <em>rue de Grenelle</em> que réside la vicomtesse de Beauséant. Rastignac y pénètre intimidé, avant d'entendre la leçon du cynisme aristocratique : <em>« Plus froidement vous calculerez, plus avant vous irez. Frappez sans pitié, vous serez craint. »</em>
								</p>
								<p>
									<strong>Limite historiographique :</strong> L'hôtel de Beauséant est un domaine romanesque fictif. L'hôtel du Châtelet (aujourd'hui ministère du Travail) illustre le gabarit, l'opulence et la clôture sociale des demeures de cette rue sous la Restauration, sans être le logis de personnages imaginaires.
								</p>
							</div>

							<div class="iconography-question-box">
								<strong>Questions d’observation pour les élèves :</strong>
								<p>1. Comparez cette cour monumentale avec la cour de la rue Tournefort (document 2). Quelles fractures sociales sautent aux yeux ?</p>
								<p>2. Pourquoi le portail fermé sur la rue symbolise-t-il le caractère exclusif de l'aristocratie légitimiste face aux provinciaux comme Rastignac ?</p>
							</div>
						</article>

						<!-- Document 4 : Galeries de bois du Palais-Royal (Hoffbauer, 1825) -->
						<article class="iconography-card" id="doc-palais-royal-galeries-bois">
							<header class="iconography-card-header">
								<span class="status-badge status-reconstitution">Reconstitution historique (1825 / v. 1880)</span>
								<h3 class="iconography-card-title">4. L’argent et le vertige du jeu : les galeries de bois du Palais-Royal</h3>
							</header>

							<figure class="iconography-figure">
								<img
									src="/images/goriot/palais-royal-galerie-bois-1825.jpg"
									alt="Lithographie représentant les galeries de bois du Palais-Royal animées de promeneurs en 1825 par Theodor Hoffbauer"
									class="iconography-img"
									loading="lazy"
									width="5175"
									height="3058"
								/>
								<figcaption class="iconography-caption">
									Theodor Hoffbauer, <em>Galeries de bois (ancien camp des Tartares), au Palais-Royal, 1825</em>, Brown University Library / Wikimedia Commons.
								</figcaption>
							</figure>

							<div class="iconography-meta-box">
								<ul class="iconography-meta-list">
									<li><strong>Titre exact :</strong> <cite>Galeries de bois (ancien camp des Tartares), au Palais-Royal, 1825</cite></li>
									<li><strong>Artiste / Historien :</strong> Theodor Josef Hubert Hoffbauer (1839–1922), architecte et peintre archéologue de Paris</li>
