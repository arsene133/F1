---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const pageTitle = "Balzac, Rastignac, la Commune, Marx et Rimbaud";
const pageDescription = "Diagramme éditorial et cartographie conceptuelle du XIXe siècle : de l'observation balzacienne à la rupture poétique de Rimbaud, sous le regard critique de Marx.";
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />

		<main class="editorial-page">
			<section class="relations-editorial" aria-labelledby="relations-title">
				<!-- En-tête éditorial -->
				<header class="editorial-intro">
					<div class="intro-eyebrow">
						<span class="eyebrow-line" aria-hidden="true"></span>
						<span class="eyebrow-text">XIX<sup>e</sup> siècle · Cartographie intellectuelle & littéraire</span>
						<span class="eyebrow-line" aria-hidden="true"></span>
					</div>
					<h1 id="relations-title">
						Balzac, Rastignac, la Commune, Marx et Rimbaud
					</h1>
					<p class="intro-lead">
						Cinq regards sur une même société bourgeoise :
						<strong>Paris, l’argent, le pouvoir et la révolte.</strong>
					</p>
					<p class="intro-subtext">
						Une progression narrative de l'observation réaliste jusqu'à la rupture poétique,
						éclairée par le regard analytique transversal de Karl Marx.
					</p>

					<!-- Légende éditoriale -->
					<div class="editorial-legend" aria-label="Légende des relations">
						<div class="legend-item">
							<span class="legend-line solid" aria-hidden="true"></span>
							<span>Filiation & contexte direct</span>
						</div>
						<div class="legend-item">
							<span class="legend-line dashed" aria-hidden="true"></span>
							<span>Regard analytique & tension conceptuelle</span>
						</div>
					</div>
				</header>

				<!-- Définitions des marqueurs SVG partagés -->
				<svg class="svg-defs" aria-hidden="true" width="0" height="0">
					<defs>
						<marker id="arrow-ochre" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
							<path d="M0,0 L0,6 L8,3 z" fill="#8c5218" />
						</marker>
						<marker id="arrow-blue" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
							<path d="M0,0 L0,6 L8,3 z" fill="#1e4e7e" />
						</marker>
						<marker id="arrow-green" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
							<path d="M0,0 L0,6 L8,3 z" fill="#185c43" />
						</marker>
						<marker id="arrow-red" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
							<path d="M0,0 L0,6 L8,3 z" fill="#962822" />
						</marker>
						<marker id="arrow-purple" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
							<path d="M0,0 L0,6 L8,3 z" fill="#542d7a" />
						</marker>
						<marker id="arrow-neutral" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
							<path d="M0,0 L0,6 L8,3 z" fill="#716053" />
						</marker>
					</defs>
				</svg>

				<!-- Diagramme principal -->
				<div class="diagram-grid">

					<!-- 1. BALZAC (Point de départ) -->
					<article class="node node-balzac" id="node-balzac">
						<header class="node-header">
							<div class="node-badge ochre">
								<span class="badge-index">01</span>
								<span class="badge-label">Point de départ</span>
							</div>
							<p class="node-posture">« Observer la société »</p>
							<h2>Honoré de Balzac</h2>
							<p class="node-meta">
								<span class="date">1799–1850</span>
								<span class="meta-separator" aria-hidden="true">·</span>
								<cite class="work">La Comédie humaine</cite>
							</p>
						</header>
						<ul class="node-points">
							<li>Observe et décrit la société bourgeoise</li>
							<li>Montre la puissance de l’argent et de la propriété</li>
							<li>Fait de Paris un théâtre social</li>
						</ul>
					</article>

					<!-- LIAISON DESKTOP 1 : Balzac -> Rastignac (Gauche) -->
					<div class="connector connector-balzac-rastignac" aria-hidden="true">
						<svg class="connector-svg" viewBox="0 0 120 70" preserveAspectRatio="none">
							<path class="conn-path solid ochre" d="M100,5 C50,20 20,40 20,65" marker-end="url(#arrow-blue)" />
						</svg>
					</div>

					<!-- RELATION 1 : Balzac -> Rastignac (Label éditorial) -->
					<aside class="relation-block rel-balzac-rastignac" aria-label="Relation Balzac et Rastignac">
						<span class="rel-tag blue">Filiation littéraire</span>
						<p class="rel-text">
							Balzac crée le personnage de Rastignac :
							<strong>«&nbsp;Balzac observe la société&nbsp;; Rastignac apprend à y réussir.&nbsp;»</strong>
						</p>
					</aside>

					<!-- LIAISON DESKTOP 2 : Balzac <-> Marx (Droite) -->
					<div class="connector connector-balzac-marx" aria-hidden="true">
						<svg class="connector-svg" viewBox="0 0 120 70" preserveAspectRatio="none">
							<path class="conn-path dashed green" d="M20,5 C70,20 100,40 100,65" marker-end="url(#arrow-green)" />
						</svg>
					</div>

					<!-- RELATION 2 : Balzac <-> Marx (Label éditorial central) -->
					<aside class="relation-block rel-balzac-marx" aria-label="Relation Balzac et Marx">
						<span class="rel-tag green">Regards croisés sur la société</span>
						<p class="rel-text">
							Deux approches d’une même réalité bourgeoise :
							<strong>«&nbsp;Balzac montre la société&nbsp;; Marx cherche à en expliquer les mécanismes.&nbsp;»</strong>
						</p>
					</aside>

					<!-- 2. RASTIGNAC (Contrepoint : intégration & conquête) -->
					<article class="node node-rastignac" id="node-rastignac">
						<header class="node-header">
							<div class="node-badge blue">
								<span class="badge-index">02</span>
								<span class="badge-label">Intégration & Réussite</span>
							</div>
							<p class="node-posture">« S’adapter et conquérir »</p>
							<h2>Rastignac</h2>
							<p class="node-meta">
								<span class="date">Personnage de Balzac</span>
								<span class="meta-separator" aria-hidden="true">·</span>
								<cite class="work">Le Père Goriot</cite>
							</p>
						</header>
						<ul class="node-points">
							<li>Jeune provincial ambitieux</li>
							<li>Découvre les règles du monde parisien</li>
							<li>S’adapte au système pour réussir</li>
							<li>Incarnation de la conquête sociale</li>
						</ul>
						<footer class="node-callout blue">
							<span class="callout-icon" aria-hidden="true">◆</span>
							<p class="callout-statement"><strong>Rastignac veut conquérir le système.</strong></p>
						</footer>
					</article>

					<!-- 3. MARX (Regard analytique transversal) -->
					<article class="node node-marx" id="node-marx">
						<header class="node-header">
							<div class="node-badge green">
								<span class="badge-label">Regard analytique transversal</span>
							</div>
							<p class="node-posture">« Analyser et théoriser »</p>
							<h2>Karl Marx</h2>
							<p class="node-meta">
								<span class="date">1818–1883</span>
								<span class="meta-separator" aria-hidden="true">·</span>
								<cite class="work">Le Capital · Manifeste du parti communiste</cite>
							</p>
						</header>
						<ul class="node-points">
							<li>Analyse le fonctionnement du capitalisme</li>
							<li>Théorise la lutte des classes</li>
							<li>Montre comment la richesse produit l’exploitation</li>
						</ul>
						<div class="transversal-note" aria-label="Rôle analytique">
							<span class="transversal-label">Analyse critique</span>
							<p>Un regard théorique transversal qui décrypte les ressorts économiques de l'époque.</p>
						</div>
					</article>

					<!-- LIAISON DESKTOP 3 : Marx -> Commune -->
					<div class="connector connector-marx-commune" aria-hidden="true">
						<svg class="connector-svg" viewBox="0 0 40 70" preserveAspectRatio="none">
							<path class="conn-path solid red" d="M20,5 L20,65" marker-end="url(#arrow-red)" />
						</svg>
					</div>

					<!-- RELATION 4 : Commune -> Marx (Label éditorial) -->
					<aside class="relation-block rel-commune-marx" aria-label="Relation Commune et Marx">
						<span class="rel-tag red">Expérience révolutionnaire</span>
						<p class="rel-text">
							<strong>«&nbsp;Marx voit dans la Commune une expérience révolutionnaire et un moment de la lutte des classes.&nbsp;»</strong>
						</p>
					</aside>

					<!-- RELATION 6 : RASTIGNAC <-> RIMBAUD (Pont conceptuel majeur) -->
					<aside class="conceptual-bridge" id="tension-conceptuelle" aria-label="Tension conceptuelle majeure">
						<div class="bridge-header">
							<span class="bridge-tag">Tension conceptuelle fondamentale</span>
							<span class="bridge-sub">Accepter le monde vs. Tout renverser</span>
						</div>
						<blockquote class="bridge-statement">
							<p><strong>Rastignac accepte le jeu.</strong> Rimbaud représente une rupture radicale avec le monde que Rastignac accepte : là où Rastignac veut réussir, Rimbaud veut tout renverser.</p>
						</blockquote>
						<div class="bridge-track" aria-hidden="true">
							<svg viewBox="0 0 100 50" preserveAspectRatio="none" class="bridge-track-svg">
								<path d="M10,5 C10,35 70,45 95,45" class="conn-path dashed purple" marker-end="url(#arrow-purple)" />
							</svg>
						</div>
					</aside>

					<!-- 4. COMMUNE DE PARIS (Pivot historique 1871) -->
					<article class="node node-commune" id="node-commune">
						<header class="node-header">
							<div class="node-badge red">
								<span class="badge-index">03</span>
								<span class="badge-label">Pivot historique</span>
							</div>
							<p class="node-posture">« Se révolter »</p>
							<h2>La Commune de Paris</h2>
							<p class="node-meta">
								<span class="date">1871</span>
								<span class="meta-separator" aria-hidden="true">·</span>
								<cite class="work">Insurrection et expérience politique</cite>
							</p>
						</header>
						<ul class="node-points">
							<li>Insurrection populaire</li>
							<li>Refus de l’ordre bourgeois</li>
							<li>Expérimentation d’une autre société</li>
							<li>Répression sanglante</li>
						</ul>
					</article>

					<!-- LIAISON DESKTOP 4 : Commune -> Rimbaud -->
					<div class="connector connector-commune-rimbaud" aria-hidden="true">
						<svg class="connector-svg" viewBox="0 0 120 70" preserveAspectRatio="none">
							<path class="conn-path solid purple" d="M100,5 C70,30 30,45 20,65" marker-end="url(#arrow-purple)" />
						</svg>
					</div>

					<!-- RELATION 5 : Commune -> Rimbaud (Label éditorial) -->
					<aside class="relation-block rel-commune-rimbaud" aria-label="Relation Commune et Rimbaud">
						<span class="rel-tag purple">Transmutation littéraire de 1871</span>
						<p class="rel-text">
							Le bouleversement immédiat de 1871 :
							<strong>«&nbsp;Rimbaud transforme la révolte sociale en langage poétique.&nbsp;»</strong>
						</p>
					</aside>

					<!-- 5. RIMBAUD (Aboutissement poétique) -->
					<article class="node node-rimbaud" id="node-rimbaud">
						<header class="node-header">
							<div class="node-badge purple">
								<span class="badge-index">04</span>
								<span class="badge-label">Aboutissement poétique</span>
							</div>
							<p class="node-posture">« Refuser et transformer »</p>
							<h2>Arthur Rimbaud</h2>
							<p class="node-meta">
								<span class="date">1854–1891</span>
								<span class="meta-separator" aria-hidden="true">·</span>
								<cite class="work">Poèmes de 1871</cite>
							</p>
						</header>
						<ul class="node-points">
							<li>Arrive à Paris pendant la Commune</li>
							<li>Dénonce la bourgeoisie et la répression</li>
							<li>Transforme la révolte sociale en langage poétique</li>
							<li>Refuse le monde et ses règles</li>
						</ul>
					</article>

				</div>

				<!-- Synthèse finale narrative -->
				<footer class="editorial-summary" aria-labelledby="summary-heading">
					<div class="summary-header">
						<h3 id="summary-heading">Synthèse narrative du parcours</h3>
						<p class="summary-lead">D'un siècle d'ambitions bourgeoises à l'éclair poétique de la révolte :</p>
					</div>
					<ol class="summary-flow">
						<li class="summary-step balzac-step">
							<span class="step-num">01</span>
							<strong class="step-subject">Balzac</strong>
							<span class="step-action">Observe</span>
						</li>
						<li class="flow-arrow" aria-hidden="true">→</li>
						<li class="summary-step rastignac-step">
							<span class="step-num">02</span>
							<strong class="step-subject">Rastignac</strong>
							<span class="step-action">S’adapte et conquiert</span>
						</li>
						<li class="flow-arrow" aria-hidden="true">→</li>
						<li class="summary-step commune-step">
							<span class="step-num">03</span>
							<strong class="step-subject">Commune</strong>
							<span class="step-action">Se révolte</span>
						</li>
						<li class="flow-arrow" aria-hidden="true">→</li>
						<li class="summary-step marx-step">
							<span class="step-tag">Analyste</span>
							<strong class="step-subject">Marx</strong>
							<span class="step-action">Analyse et théorise</span>
						</li>
						<li class="flow-arrow" aria-hidden="true">→</li>
						<li class="summary-step rimbaud-step">
							<span class="step-num">04</span>
							<strong class="step-subject">Rimbaud</strong>
							<span class="step-action">Refuse et transforme</span>
						</li>
					</ol>
				</footer>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* ==========================================================================
	   VARIABLES ÉDITORIALES & PALETTE SOBRE
	   ========================================================================== */
	:root {
		--ink: #17242d;
		--ink-light: #485661;
		--muted: #6b7780;
		--paper: #faf8f4;
		--paper-card: #ffffff;
		--line-subtle: #e6e0d4;
		--line-strong: #cfc6b6;

		/* Couleurs désaturées avec excellent contraste */
		--c-ochre: #8c5218;
		--c-ochre-bg: #fcf6ef;
		--c-ochre-border: #deb789;

		--c-blue: #1e4e7e;
		--c-blue-bg: #f0f5fa;
		--c-blue-border: #99bede;

		--c-green: #185c43;
		--c-green-bg: #eff7f3;
		--c-green-border: #8ec4b0;

		--c-red: #962822;
		--c-red-bg: #fdf2f1;
		--c-red-border: #de9b97;

		--c-purple: #542d7a;
		--c-purple-bg: #f5effa;
		--c-purple-border: #b89ece;
	}

	/* Réinitialisation de largeur de page pour un diagramme ample */
	main.editorial-page {
		width: 100%;
		max-width: 1180px;
		margin: 0 auto;
		padding: 3rem 1.5rem 6rem;
		box-sizing: border-box;
		overflow-x: hidden;
	}

	.relations-editorial {
		position: relative;
		color: var(--ink);
	}

	.svg-defs {
		position: absolute;
		width: 0;
		height: 0;
		pointer-events: none;
	}

	/* ==========================================================================
	   EN-TÊTE ÉDITORIAL
	   ========================================================================== */
	.editorial-intro {
		max-width: 860px;
		margin: 0 auto 4rem;
		text-align: center;
		animation: fadeIn 0.8s ease-out both;
	}

	.intro-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.eyebrow-line {
		width: 32px;
		height: 1px;
		background-color: var(--c-ochre-border);
	}

	.eyebrow-text {
		color: var(--c-ochre);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-family: system-ui, -apple-system, sans-serif;
	}

	h1 {
		margin: 0 0 1.25rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.2rem, 5vw, 3.8rem);
		font-weight: normal;
		line-height: 1.1;
		color: var(--ink);
		letter-spacing: -0.015em;
	}

	.intro-lead {
		margin: 0 auto 0.75rem;
		max-width: 720px;
		font-size: 1.25rem;
		line-height: 1.5;
		color: var(--ink-light);
	}

	.intro-lead strong {
		color: var(--ink);
	}

	.intro-subtext {
		margin: 0 auto 2rem;
		max-width: 650px;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.editorial-legend {
		display: inline-flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 2rem;
		padding: 0.75rem 1.5rem;
		background: var(--paper-card);
		border: 1px solid var(--line-subtle);
		border-radius: 999px;
		font-size: 0.82rem;
		color: var(--muted);
	}

	.legend-item {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}

	.legend-line {
		width: 24px;
		height: 2px;
		display: inline-block;
	}

	.legend-line.solid {
		background-color: var(--c-ochre);
	}

	.legend-line.dashed {
		border-top: 2px dashed var(--c-purple);
		height: 0;
	}

	/* ==========================================================================
	   COMPOSITION EN GRILLE (DESKTOP)
	   Balzac (haut)
	   Rastignac (gauche)  | Marx (droite)
	   Rupture conceptuelle| Commune (droite)
	   Rimbaud (bas)
	   ========================================================================== */
	.diagram-grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 1.5rem 3.5rem;
		align-items: stretch;
	}

	/* Nœuds (cartes) */
	.node {
		position: relative;
		z-index: 2;
		background: var(--paper-card);
		border: 1px solid var(--line-subtle);
		border-radius: 14px;
		padding: 2.2rem;
		box-shadow: 0 4px 18px rgba(23, 36, 45, 0.03);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
		animation: fadeIn 0.6s ease-out both;
	}

	.node:hover {
		box-shadow: 0 8px 26px rgba(23, 36, 45, 0.06);
	}

	/* En-tête des nœuds */
	.node-header {
		margin-bottom: 1.25rem;
	}

	.node-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.25rem 0.65rem;
		border-radius: 6px;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: 0.6rem;
		font-family: system-ui, -apple-system, sans-serif;
	}

	.node-badge.ochre  { background: var(--c-ochre-bg);  color: var(--c-ochre);  border: 1px solid var(--c-ochre-border); }
	.node-badge.blue   { background: var(--c-blue-bg);   color: var(--c-blue);   border: 1px solid var(--c-blue-border); }
	.node-badge.green  { background: var(--c-green-bg);  color: var(--c-green);  border: 1px solid var(--c-green-border); }
	.node-badge.red    { background: var(--c-red-bg);    color: var(--c-red);    border: 1px solid var(--c-red-border); }
	.node-badge.purple { background: var(--c-purple-bg); color: var(--c-purple); border: 1px solid var(--c-purple-border); }

	.node-posture {
		margin: 0 0 0.5rem;
		font-family: Georgia, "Times New Roman", serif;
		font-style: italic;
		font-size: 1.05rem;
		color: var(--muted);
	}

	.node h2 {
		margin: 0 0 0.4rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.85rem;
		font-weight: normal;
		line-height: 1.2;
		color: var(--ink);
	}

	.node-meta {
		margin: 0;
		font-size: 0.92rem;
		color: var(--muted);
	}

	.meta-separator {
		margin: 0 0.35rem;
	}

	.work {
		font-family: Georgia, "Times New Roman", serif;
		font-style: italic;
		color: var(--ink-light);
	}

	/* Liste des points */
	.node-points {
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line-subtle);
		padding-top: 1.25rem;
	}

	.node-points li {
		position: relative;
		padding-left: 1.35rem;
		margin-bottom: 0.65rem;
		font-size: 0.97rem;
		line-height: 1.55;
		color: var(--ink-light);
	}

	.node-points li:last-child {
		margin-bottom: 0;
	}

	.node-points li::before {
		content: "—";
		position: absolute;
		left: 0;
		top: 0;
		font-weight: 700;
	}

	.node-balzac .node-points li::before   { color: var(--c-ochre); }
	.node-rastignac .node-points li::before{ color: var(--c-blue); }
	.node-marx .node-points li::before     { color: var(--c-green); }
	.node-commune .node-points li::before  { color: var(--c-red); }
	.node-rimbaud .node-points li::before  { color: var(--c-purple); }

	/* Bordures distinctives légères */
