---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import balzacPortrait from '../assets/honore-de-balzac-1842.jpg';
import marxPortrait from '../assets/karl-marx.jpg';
import goriotIllustration from '../assets/pere-goriot-illustration.jpg';
import communePhoto from '../assets/commune-barricade-1871.jpg';
import rimbaudPortrait from '../assets/arthur-rimbaud.jpg';

const pageTitle = "Balzac, Rastignac, la Commune, Marx et Rimbaud";
const pageDescription = "Carte interactive des relations intellectuelles et sociales au XIXe siècle : Balzac, Rastignac, la Commune, Marx et Rimbaud face à la société bourgeoise.";

// Modèle de données explicite des nœuds
const nodes = [
	{
		id: "balzac",
		label: "Honoré de Balzac",
		dates: "1799–1850",
		role: "Écrivain",
		work: "La Comédie humaine",
		posture: "Observe",
		description: "Observe et décrit méticuleusement la société bourgeoise émergente, montrant la toute-puissance de l'argent et de la propriété, et faisant de Paris un vaste théâtre social.",
		points: [
			"Observe et décrit la société bourgeoise",
			"Montre la puissance de l’argent et de la propriété",
			"Fait de Paris un théâtre social",
		],
		image: {
			asset: balzacPortrait,
			alt: "Portrait photographique d'Honoré de Balzac en 1842, par Louis-Auguste Bisson.",
			creditPrefix: "Honoré de Balzac, 1842 — Louis-Auguste Bisson, daguerréotype · ",
			sourceLabel: "Wikimedia Commons",
			sourceUrl: "https://commons.wikimedia.org/wiki/File:Honor%C3%A9_de_Balzac_(1842)_Detail.jpg",
			creditSuffix: " · domaine public",
			orientation: "portrait",
			position: "50% 20%",
		},
		// Coordonnées relatives sur le canvas (x, y) dans l'espace 900 x 520
		href: "#node-balzac",
		x: 450,
		y: 80,
	},
	{
		id: "rastignac",
		label: "Rastignac",
		dates: "Personnage de Balzac",
		role: "Personnage de fiction",
		work: "Le Père Goriot",
		posture: "S’adapte et conquiert",
		description: "Jeune provincial ambitieux découvrant les codes cyniques du monde parisien ; il choisit d'accepter les règles du jeu pour conquérir le système social.",
		points: [
			"Jeune provincial ambitieux",
			"Découvre les règles du monde parisien",
			"S’adapte au système pour réussir",
			"Incarnation de la conquête sociale",
		],
		image: {
			asset: goriotIllustration,
			alt: "Illustration de Le Père Goriot, œuvre de Honoré de Balzac.",
			creditPrefix: "Illustration de Le Père Goriot — ",
			sourceLabel: "Wikimedia Commons",
			sourceUrl: "https://commons.wikimedia.org/wiki/File:BalzacOldGoriot02.jpg",
			creditSuffix: " · domaine public",
			orientation: "portrait",
			position: "50% 30%",
		},
		href: "#node-rastignac",
		x: 710,
		y: 220,
	},
	{
		id: "marx",
		label: "Karl Marx",
		dates: "1818–1883",
		role: "Philosophe & économiste",
		work: "Le Capital · Manifeste du parti communiste",
		posture: "Analyse et théorise",
		description: "Démonte scientifiquement les ressorts du capitalisme et théorise la lutte des classes comme moteur de l'histoire, montrant comment l'accumulation de la richesse produit l'exploitation.",
		points: [
			"Analyse le fonctionnement du capitalisme",
			"Théorise la lutte des classes",
			"Montre comment la richesse produit l’exploitation",
		],
		image: {
			asset: marxPortrait,
			alt: "Portrait photographique de Karl Marx.",
			creditPrefix: "Karl Marx — ",
			sourceLabel: "Image source fournie par l'auteur du site",
			sourceUrl: null,
			creditSuffix: "",
			orientation: "portrait",
			position: "50% 20%",
		},
		href: "#node-marx",
		x: 190,
		y: 220,
	},
	{
		id: "commune",
		label: "La Commune de Paris",
		dates: "1871",
		role: "Insurrection & expérience politique",
		work: "Insurrection populaire",
		posture: "Se révolte",
		description: "Soulèvement révolutionnaire du peuple parisien refusant l'ordre bourgeois établi ; expérimentation fulgurante d'une démocratie populaire conclue par une répression sanglante.",
		points: [
			"Insurrection populaire",
			"Refus de l’ordre bourgeois",
			"Expérimentation d’une autre société",
			"Répression sanglante",
		],
		image: {
			asset: communePhoto,
			alt: "Barricade à l'angle des boulevards Voltaire et Richard-Lenoir pendant la Commune de Paris, 1871.",
			creditPrefix: "Barricade à l'angle des boulevards Voltaire et Richard-Lenoir, 1871 — Bruno Braquehais · ",
			sourceLabel: "Wikimedia Commons",
			sourceUrl: "https://commons.wikimedia.org/wiki/File:Barricade_Voltaire_Lenoir_Commune_Paris_1871.jpg",
			creditSuffix: " · domaine public",
			orientation: "landscape",
			position: "50% 50%",
		},
		href: "#node-commune",
		x: 630,
		y: 440,
	},
	{
		id: "rimbaud",
		label: "Arthur Rimbaud",
		dates: "1854–1891",
		role: "Poète",
		work: "Poèmes de 1871",
		posture: "Refuse et transforme",
		description: "Présent à Paris pendant les événements de la Commune, il refuse catégoriquement le monde bourgeois et transmue la révolte sociale en rupture poétique radicale.",
		points: [
			"Arrive à Paris pendant la Commune",
			"Dénonce la bourgeoisie et la répression",
			"Transforme la révolte sociale en langage poétique",
			"Refuse le monde et ses règles",
		],
		image: {
			asset: rimbaudPortrait,
			alt: "Portrait d'Arthur Rimbaud jeune.",
			creditPrefix: "Arthur Rimbaud — ",
			sourceLabel: "Image source fournie par l'auteur du site",
			sourceUrl: null,
			creditSuffix: "",
			orientation: "portrait",
			position: "50% 25%",
		},
		href: "#node-rimbaud",
		x: 270,
		y: 440,
	},
];

// Nœud central conceptuel
const societyCenter = {
	x: 450,
	y: 260,
	label: "SOCIÉTÉ DU XIXe SIÈCLE",
	sub: "Paris · argent · pouvoir · révolte",
};

// Relations conceptuelles et visuelles
const relationships = [
	{
		id: "balzac-rastignac",
		source: "balzac",
		target: "rastignac",
		label: "observe → s’adapte",
		explanation: "Balzac observe la structure sociale ; Rastignac apprend à y circuler et cherche à la conquérir.",
		type: "direct",
	},
	{
		id: "balzac-marx",
		source: "balzac",
		target: "marx",
		label: "décrire ↔ analyser",
		explanation: "Balzac montre le monde social ; Marx cherche à en expliquer les mécanismes.",
		type: "comparison",
	},
	{
		id: "commune-marx",
		source: "commune",
		target: "marx",
		label: "expérience révolutionnaire",
		explanation: "Marx voit dans la Commune une expérience révolutionnaire et un moment de la lutte des classes.",
		type: "direct",
	},
	{
		id: "commune-rimbaud",
		source: "commune",
		target: "rimbaud",
		label: "révolte → poésie",
		explanation: "Rimbaud transforme la révolte sociale en langage poétique.",
		type: "direct",
	},
	{
		id: "rastignac-rimbaud",
		source: "rastignac",
		target: "rimbaud",
		label: "accepter le jeu ↔ tout renverser",
		explanation: "Rastignac accepte le jeu. Rimbaud représente une rupture radicale avec le monde que Rastignac accepte : là où Rastignac veut réussir, Rimbaud veut tout renverser.",
		type: "contrast",
	},
];

// Préparation des données pour sérialisation sécurisée dans les data-attributs
const nodesById = Object.fromEntries(nodes.map(n => [n.id, n]));
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />

		<main class="page-container">
			<article class="relationship-map-article" aria-labelledby="page-title">
				<!-- En-tête éditorial de la page -->
				<header class="map-intro">
					<p class="intro-eyebrow">XIX<sup>e</sup> siècle · Cartographie relationnelle</p>
					<h1 id="page-title">Balzac, Rastignac, la Commune, Marx et Rimbaud</h1>
					<p class="intro-desc">
						Cinq figures et postures observant une même société :
						<strong>Paris, l’argent, le pouvoir, la révolte.</strong>
					</p>
					<p class="intro-instructions">
						Explorez la carte des relations : survolez ou sélectionnez une figure pour révéler ses liens directs et ses concepts clés.
					</p>
				</header>

				<!-- Composant de carte interactive relationnelle -->
				<section
					class="relationship-map-wrapper"
					aria-label="Carte des relations du XIXe siècle"
					data-rel-map
				>
					<div class="map-frame">
						<div class="map-viewport" data-map-viewport>
							<div
								class="map-canvas"
								style="--canvas-w: 900; --canvas-h: 520; aspect-ratio: 900 / 520;"
								data-map-canvas
							>
								<!-- Ancrage central éditorial (en arrière-plan du graphe) -->
								<div
									class="society-anchor"
									style={`left: ${societyCenter.x}px; top: ${societyCenter.y}px;`}
									aria-hidden="true"
								>
									<span class="anchor-title">{societyCenter.label}</span>
									<span class="anchor-sub">{societyCenter.sub}</span>
								</div>

								<!-- SVG des connexions relationnelles -->
								<svg
									class="map-lines-svg"
									viewBox="0 0 900 520"
									aria-hidden="true"
									focusable="false"
								>
									<defs>
										<marker
											id="marker-arrow"
											markerWidth="7"
											markerHeight="7"
											refX="6"
											refY="3.5"
											orient="auto"
										>
											<polygon points="0 0, 7 3.5, 0 7" class="marker-fill" />
										</marker>
									</defs>

									{relationships.map((rel) => {
										const s = nodesById[rel.source];
										const t = nodesById[rel.target];
										const mx = (s.x + t.x) / 2;
										const my = (s.y + t.y) / 2;
										return (
											<g
												class={`rel-edge edge-${rel.type}`}
												data-edge-id={rel.id}
												data-source={rel.source}
												data-target={rel.target}
											>
												<line
													x1={s.x}
													y1={s.y}
													x2={t.x}
													y2={t.y}
													class="edge-line"
													marker-end={rel.type === "direct" ? "url(#marker-arrow)" : undefined}
												/>
												<text
													x={mx}
													y={my}
													class="edge-text"
													text-anchor="middle"
													dy="-6"
												>
													{rel.label}
												</text>
											</g>
										);
									})}
								</svg>

								<!-- Nœuds interactifs du graphe -->
								<ul class="map-nodes-list" aria-label="Figures et forces du XIXe siècle">
									{nodes.map((node) => {
										const relatedRels = relationships.filter(
											r => r.source === node.id || r.target === node.id
										);
										const relatedNodeIds = relatedRels.map(
											r => (r.source === node.id ? r.target : r.source)
										);

										return (
											<li class="map-node-item" id={node.id}>
												<a
													href={node.href}
													id={`node-${node.id}`}
													class={`map-node-btn node-${node.id}`}
													aria-pressed="false"
													data-node-id={node.id}
													data-href={node.href}
													data-label={node.label}
													data-dates={node.dates}
													data-role={node.role}
													data-work={node.work}
													data-posture={node.posture}
													data-description={node.description}
													data-points={JSON.stringify(node.points)}
													data-related={relatedNodeIds.join(" ")}
													style={`--nx: ${node.x}; --ny: ${node.y};`}
												>
													<span class="node-bullet" aria-hidden="true" />
													<span class="node-content">
														<strong class="node-title">{node.label}</strong>
														<span class="node-meta">{node.dates} · {node.posture}</span>
													</span>
												</a>
											</li>
										);
									})}
								</ul>
							</div>
						</div>

						<p class="map-scroll-hint" aria-hidden="true">
							← Faites défiler horizontalement pour voir tout le graphe →
						</p>
					</div>

					<!-- Panneau d'information dédié (hors du graphe) -->
					<aside
						class="map-info-panel"
						aria-live="polite"
						data-info-panel
					>
						<div class="panel-hint" data-panel-hint>
							<p>
								<em>Cliquez ou appuyez sur une figure de la carte pour afficher son analyse détaillée et l'ensemble de ses relations.</em>
							</p>
						</div>

						<div class="panel-detail" data-panel-detail hidden>
							<!-- Conteneurs d'images historiques / sources pour chaque figure (affiché selon la sélection) -->
							{nodes.filter(n => n.image).map((node) => (
								<div
									class={`detail-portrait-wrapper detail-portrait-wrapper--${node.image.orientation}`}
									data-node-image={node.id}
									hidden
								>
									<figure class={`detail-portrait-figure detail-portrait-figure--${node.image.orientation}`}>
										<Image
											src={node.image.asset}
											alt={node.image.alt}
											width={node.image.orientation === 'landscape' ? 600 : 400}
											loading="lazy"
											decoding="async"
											class={`detail-portrait-img detail-portrait-img--${node.image.orientation}`}
											style={`object-position: ${node.image.position};`}
										/>
										<figcaption class="detail-portrait-caption">
											{node.image.creditPrefix}
											{node.image.sourceUrl ? (
												<a
													href={node.image.sourceUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="detail-portrait-link"
												>{node.image.sourceLabel}</a>
											) : (
												<span>{node.image.sourceLabel}</span>
											)}
											{node.image.creditSuffix}
										</figcaption>
									</figure>
								</div>
							))}

							<header class="detail-header">
								<div>
									<span class="detail-posture" data-detail-posture></span>
									<h2 class="detail-title" data-detail-title></h2>
									<p class="detail-meta">
										<span data-detail-dates></span> · <span data-detail-role></span> · <em data-detail-work></em>
									</p>
								</div>
								<button
									type="button"
									class="panel-reset-btn"
									data-panel-reset
								>
									Tout afficher
								</button>
							</header>

							<p class="detail-description" data-detail-description></p>

							<div class="detail-points-wrapper">
								<strong>Idées maîtresses :</strong>
								<ul class="detail-points" data-detail-points></ul>
							</div>

							<div class="detail-relations-wrapper">
								<strong>Relations actives dans le réseau :</strong>
								<ul class="detail-relations-list" data-detail-relations></ul>
							</div>
						</div>
					</aside>
				</section>

				<!-- Version accessible / fallback statique pour indexation et JavaScript désactivé -->
				<noscript>
					<section class="noscript-section" aria-label="Contenu textuel complet">
						<h2>Figures et analyses (mode lecture accessible)</h2>
						{nodes.map((node) => (
							<div class="noscript-node">
								{node.image && (
									<figure class={`noscript-portrait-figure noscript-portrait-figure--${node.image.orientation}`}>
										<Image
											src={node.image.asset}
											alt={node.image.alt}
											width={node.image.orientation === 'landscape' ? 600 : 400}
											loading="lazy"
											decoding="async"
											class={`detail-portrait-img detail-portrait-img--${node.image.orientation}`}
											style={`object-position: ${node.image.position};`}
										/>
										<figcaption class="detail-portrait-caption">
											{node.image.creditPrefix}
											{node.image.sourceUrl ? (
												<a
													href={node.image.sourceUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="detail-portrait-link"
												>{node.image.sourceLabel}</a>
											) : (
												<span>{node.image.sourceLabel}</span>
											)}
											{node.image.creditSuffix}
										</figcaption>
									</figure>
								)}
								<h3>{node.label} ({node.dates})</h3>
								<p><strong>Rôle :</strong> {node.role} — <em>{node.work}</em></p>
								<p><strong>Posture :</strong> {node.posture}</p>
								<p>{node.description}</p>
								<ul>
									{node.points.map(pt => <li>{pt}</li>)}
								</ul>
							</div>
						))}
					</section>
				</noscript>

				<!-- Synthèse générale sous forme de tableau éditorial -->
				<footer class="map-synthesis" aria-labelledby="synthesis-title">
					<h2 id="synthesis-title">Synthèse des postures face à la société bourgeoise</h2>
					<div class="synthesis-table-wrapper">
						<table class="synthesis-table">
							<thead>
								<tr>
									<th scope="col">Figure / Force</th>
									<th scope="col">Nature</th>
									<th scope="col">Posture</th>
									<th scope="col">Œuvre ou Événement</th>
								</tr>
							</thead>
							<tbody>
								{nodes.map(n => (
									<tr>
										<th scope="row"><strong>{n.label}</strong></th>
										<td>{n.role}</td>
										<td><span class="table-posture">{n.posture}</span></td>
										<td><em>{n.work}</em></td>
									</tr>
								))}
							</tbody>
						</table>
					</div>

					<div class="synthesis-axioms">
						<blockquote>
							« Deux réponses à la même société : Rastignac veut la conquérir. Marx veut l’expliquer et la transformer. »
						</blockquote>
						<blockquote>
							« Rastignac accepte le jeu. Rimbaud représente une rupture radicale avec le monde que Rastignac accepte : là où Rastignac veut réussir, Rimbaud veut tout renverser. »
						</blockquote>
					</div>
				</footer>
			</article>
		</main>

		<Footer />

		<!-- Script côté client minimal, robuste et accessible -->
		<script is:inline define:vars={{ nodes, relationships }}>
			(function () {
				const mapEl = document.querySelector('[data-rel-map]');
				if (!mapEl) return;

				const canvas = mapEl.querySelector('[data-map-canvas]');
				const viewport = mapEl.querySelector('[data-map-viewport]');
				const nodeButtons = [...mapEl.querySelectorAll('.map-node-btn')];
				const edgeElements = [...mapEl.querySelectorAll('.rel-edge')];
				const panelHint = mapEl.querySelector('[data-panel-hint]');
				const panelDetail = mapEl.querySelector('[data-panel-detail]');
				const resetBtn = mapEl.querySelector('[data-panel-reset]');

				// Éléments du panneau
				const detailTitle = mapEl.querySelector('[data-detail-title]');
				const detailDates = mapEl.querySelector('[data-detail-dates]');
				const detailRole = mapEl.querySelector('[data-detail-role]');
				const detailWork = mapEl.querySelector('[data-detail-work]');
				const detailPosture = mapEl.querySelector('[data-detail-posture]');
				const detailDesc = mapEl.querySelector('[data-detail-description]');
				const detailPoints = mapEl.querySelector('[data-detail-points]');
				const detailRelations = mapEl.querySelector('[data-detail-relations]');
				const imageContainers = [...mapEl.querySelectorAll('[data-node-image]')];

				let selectedNode = null;

				// Construction d'une table d'accès rapide
				const nodeMap = new Map(nodes.map(n => [n.id, n]));

				function getRelatedNodeIds(nodeId) {
					const related = [];
					for (const rel of relationships) {
						if (rel.source === nodeId) related.push({ targetId: rel.target, rel });
						else if (rel.target === nodeId) related.push({ targetId: rel.source, rel });
					}
					return related;
				}

				function updateHighlights(activeNode) {
					mapEl.toggleAttribute('data-active', !!activeNode);

					const relatedData = activeNode ? getRelatedNodeIds(activeNode.dataset.nodeId) : [];
					const relatedIds = new Set(relatedData.map(r => r.targetId));

					// Gestion des nœuds
					for (const btn of nodeButtons) {
						const isSelf = activeNode && btn === activeNode;
						const isRelated = activeNode && relatedIds.has(btn.dataset.nodeId);
						btn.classList.toggle('is-active', isSelf);
						btn.classList.toggle('is-related', isRelated);
					}

					// Gestion des connexions SVG
					const activeId = activeNode ? activeNode.dataset.nodeId : null;
					for (const edge of edgeElements) {
						const isConn = activeId && (edge.dataset.source === activeId || edge.dataset.target === activeId);
						edge.classList.toggle('is-related', isConn);
					}
				}

				function populatePanel(btn) {
					if (!btn) {
						panelHint.hidden = false;
						panelDetail.hidden = true;
						for (const imgEl of imageContainers) {
							imgEl.hidden = true;
						}
						return;
					}

					panelHint.hidden = true;
					panelDetail.hidden = false;

					const nodeId = btn.dataset.nodeId;
					const data = nodeMap.get(nodeId);

					for (const imgEl of imageContainers) {
						imgEl.hidden = imgEl.dataset.nodeImage !== nodeId;
					}

					detailTitle.textContent = data.label;
					detailDates.textContent = data.dates;
					detailRole.textContent = data.role;
					detailWork.textContent = data.work;
					detailPosture.textContent = `Posture : ${data.posture}`;
					detailDesc.textContent = data.description;

					// Points clés
					detailPoints.innerHTML = '';
					for (const pt of data.points) {
						const li = document.createElement('li');
						li.textContent = pt;
						detailPoints.appendChild(li);
					}

					// Relations
					detailRelations.innerHTML = '';
					const related = getRelatedNodeIds(nodeId);
					for (const item of related) {
						const other = nodeMap.get(item.targetId);
						const li = document.createElement('li');
						const badge = document.createElement('span');
						badge.className = 'rel-badge';
						badge.textContent = item.rel.label;

						const text = document.createElement('span');
						text.innerHTML = ` <strong>${other.label}</strong> : ${item.rel.explanation}`;

						li.appendChild(badge);
						li.appendChild(text);
						detailRelations.appendChild(li);
					}
				}

				function setSelectedNode(btn) {
					if (selectedNode) {
						selectedNode.setAttribute('aria-pressed', 'false');
					}

					selectedNode = btn;

					if (selectedNode) {
						selectedNode.setAttribute('aria-pressed', 'true');
					}

					updateHighlights(selectedNode);
					populatePanel(selectedNode);
				}

				function clearSelection() {
					const prev = selectedNode;
					setSelectedNode(null);
					if (window.location.hash) {
						history.replaceState(null, '', window.location.pathname + window.location.search);
					}
					if (prev) {
						prev.focus();
					}
				}

				// Événements boutons / liens
				for (const btn of nodeButtons) {
					btn.addEventListener('click', function () {
						if (selectedNode === btn) {
							clearSelection();
						} else {
							setSelectedNode(btn);
						}
					});

					btn.addEventListener('keydown', function (e) {
						if (e.key === ' ' || e.key === 'Spacebar') {
							e.preventDefault();
							if (selectedNode === btn) {
								clearSelection();
							} else {
								btn.click();
							}
						}
					});

					btn.addEventListener('pointerenter', function () {
						updateHighlights(btn);
					});

					btn.addEventListener('pointerleave', function () {
						updateHighlights(selectedNode);
					});

					btn.addEventListener('focus', function () {
						updateHighlights(btn);
					});

					btn.addEventListener('blur', function () {
						updateHighlights(selectedNode);
					});
				}

				if (resetBtn) {
					resetBtn.addEventListener('click', clearSelection);
				}

				// Synchronisation avec l'ancre URL
				function syncFromHash() {
					const hash = window.location.hash;
					if (hash) {
						const match = nodeButtons.find(
							b => b.getAttribute('href') === hash || `#${b.id}` === hash || `#${b.dataset.nodeId}` === hash
						);
						if (match && match !== selectedNode) {
							setSelectedNode(match);
						}
					}
				}

				syncFromHash();
				window.addEventListener('hashchange', syncFromHash);

				// Fermeture par Échap
				mapEl.addEventListener('keydown', function (e) {
					if (e.key === 'Escape' && selectedNode) {
						e.preventDefault();
						clearSelection();
					}
				});

				// Centrage initial doux du viewport sur mobile
				if (viewport && viewport.scrollWidth > viewport.clientWidth) {
					viewport.scrollLeft = (viewport.scrollWidth - viewport.clientWidth) / 2;
				}
			})();
		</script>
	</body>
</html>

