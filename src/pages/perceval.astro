---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PercevalGeoMap from '../components/PercevalGeoMap.astro';
import RelationshipMap from '../components/RelationshipMap.astro';
import {
	didacticNotes,
	percevalCharacters,
	percevalEdgeTypes,
	percevalFunctions,
	percevalIconography,
	percevalRelationships,
	percevalSequences,
} from '../data/perceval';
import '../styles/editorial-map.css';

const pageTitle = 'Le Conte du Graal (Perceval) de Chrétien de Troyes — Réseau des personnages et des relations';
const pageDescription =
	'Réseau interactif des personnages et des relations du Conte du Graal (Perceval) de Chrétien de Troyes pour la classe de seconde : famille, chevalerie, Graal, Gauvain et question non posée.';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			.perceval-page .mechanism-step {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}
			.mechanism-cycle {
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--map-muted);
			}
			.cycle-perceval {
				color: #235284;
			}
			.cycle-gauvain {
				color: #5b347b;
			}
			.mechanism-verses {
				font-size: 0.8rem;
				color: var(--map-muted);
				font-style: italic;
			}
			.perceval-page .didactic-section {
				margin-top: 3.5rem;
				border-top: 1px solid var(--map-border);
				padding-top: 2.5rem;
			}
			.perceval-page .didactic-section h2 {
				font-family: var(--map-serif);
				font-size: 1.5rem;
				margin: 0 0 1rem;
				color: var(--map-ink);
				text-align: center;
			}
			.didactic-lead {
				text-align: center;
				max-width: 760px;
				margin: 0 auto 2rem;
				color: var(--map-muted);
				font-size: 0.98rem;
				line-height: 1.5;
			}
			.didactic-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 1.5rem;
				margin-bottom: 2rem;
			}
			.didactic-card {
				background: var(--map-surface);
				border: 1px solid var(--map-border);
				border-radius: 8px;
				padding: 1.35rem 1.5rem;
				box-sizing: border-box;
				min-width: 0;
			}
			.didactic-card h3 {
				font-family: var(--map-serif);
				font-size: 1.15rem;
				margin: 0 0 0.65rem;
				color: var(--map-ink);
			}
			.didactic-card p {
				margin: 0;
				font-size: 0.92rem;
				line-height: 1.55;
				color: var(--map-ink-soft);
			}
			.sources-block {
				background: var(--map-bg);
				border: 1px solid var(--map-border-soft);
				border-radius: 8px;
				padding: 1.25rem 1.5rem;
				margin-top: 2rem;
				font-size: 0.88rem;
				line-height: 1.5;
				color: var(--map-muted);
				box-sizing: border-box;
			}
			.sources-block strong {
				color: var(--map-ink);
			}
			.sources-block ul {
				margin: 0.5rem 0 0;
				padding-left: 1.25rem;
			}
			/* Section Iconographique : Images du Moyen Âge et légende du Graal */
			.perceval-iconography-section {
				margin-top: 3.5rem;
				border-top: 1px solid var(--map-border);
				padding-top: 2.5rem;
			}
			.iconography-header {
				text-align: center;
				max-width: 820px;
				margin: 0 auto 2.5rem;
			}
			.iconography-header h2 {
				font-family: var(--map-serif);
				font-size: 1.6rem;
				margin: 0 0 1rem;
				color: var(--map-ink);
			}
			.iconography-lead {
				font-size: 0.98rem;
				line-height: 1.55;
				color: var(--map-muted);
				margin: 0 0 1.5rem;
			}
			.iconography-method-banner {
				background: #fbf9f4;
				border: 1px solid var(--map-border-soft);
				border-radius: 8px;
				padding: 1rem 1.25rem;
				text-align: left;
				font-size: 0.88rem;
				line-height: 1.5;
			}
			.method-banner-title {
				display: block;
				font-weight: 700;
				color: var(--map-ink);
				margin-bottom: 0.5rem;
				font-family: var(--map-sans, system-ui, sans-serif);
				font-size: 0.84rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.method-banner-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.45rem;
			}
			.method-banner-list li {
				display: flex;
				align-items: baseline;
				gap: 0.65rem;
				flex-wrap: wrap;
				color: var(--map-ink-soft);
			}
			.status-badge {
				display: inline-block;
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				padding: 0.2rem 0.55rem;
				border-radius: 4px;
				line-height: 1.3;
				white-space: normal;
			}
			.status-medieval {
				background: #e8f0fe;
				color: #174ea6;
				border: 1px solid rgba(23, 78, 166, 0.25);
			}
			.status-tardif {
				background: #fef3c7;
				color: #92400e;
				border: 1px solid rgba(146, 64, 14, 0.25);
			}
			.status-moderne {
				background: #f3e8ff;
				color: #6b21a8;
				border: 1px solid rgba(107, 33, 168, 0.25);
			}

			.iconography-cards-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 2rem;
				margin-top: 2rem;
			}
			@media (min-width: 820px) {
				.iconography-cards-grid {
					grid-template-columns: 1fr 1fr;
				}
			}

			.iconography-card {
				background: #ffffff;
				border: 1px solid var(--map-border);
				border-radius: 10px;
				padding: 1.4rem 1.5rem;
				box-shadow: 0 3px 12px rgba(23, 43, 58, 0.04);
				display: flex;
				flex-direction: column;
				gap: 1.1rem;
				min-width: 0;
				max-width: 100%;
				box-sizing: border-box;
				overflow-wrap: break-word;
			}
			.iconography-card-header {
				display: flex;
				flex-direction: column;
				gap: 0.45rem;
				padding-bottom: 0.6rem;
				border-bottom: 1px solid var(--map-border-soft);
			}
			.iconography-card-title {
				margin: 0;
				font-family: var(--map-serif);
				font-size: 1.18rem;
				font-weight: 600;
				color: var(--map-ink);
				line-height: 1.35;
			}
			.iconography-figure {
				margin: 0;
				padding: 0;
				background: #faf8f5;
				border: 1px solid var(--map-border-soft);
				border-radius: 6px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				position: relative;
			}
			.iconography-img {
				display: block;
				width: 100%;
				height: auto;
				max-height: 340px;
				object-fit: contain;
				background: #f2ede4;
				cursor: zoom-in;
			}
			.iconography-caption {
				padding: 0.75rem 0.95rem;
				font-size: 0.82rem;
				line-height: 1.45;
				color: var(--map-ink-soft);
				border-top: 1px solid var(--map-border-soft);
				background: #ffffff;
			}
			.iconography-meta-box {
				background: #fbf9f4;
				border: 1px solid var(--map-border-soft);
				border-radius: 6px;
				padding: 0.85rem 1rem;
				font-size: 0.82rem;
				line-height: 1.5;
			}
			.iconography-meta-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}
			.iconography-meta-list li {
				color: var(--map-ink-soft);
				word-break: break-word;
			}
			.meta-permalink {
				color: var(--map-accent, #8b572a);
				text-decoration: underline;
				text-underline-offset: 2px;
			}
			.meta-permalink:hover {
				color: var(--map-ink);
			}
			.iconography-evaluation-box {
				border-left: 3px solid #8b572a;
				padding: 0.85rem 1.1rem;
				background: #faf8f5;
				border-radius: 0 6px 6px 0;
				font-size: 0.88rem;
				line-height: 1.6;
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
			}
			.iconography-evaluation-box h4 {
				margin: 0;
				font-family: var(--map-sans, system-ui, sans-serif);
				font-size: 0.82rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: #8b572a;
				font-weight: 700;
			}
			.iconography-evaluation-box p {
				margin: 0;
				color: var(--map-ink-soft);
			}
			.iconography-evaluation-box strong {
				color: var(--map-ink);
			}
			.iconography-question-box {
				background: #f5f8fa;
				border: 1px solid #d8e3eb;
				border-radius: 6px;
				padding: 0.95rem 1.1rem;
				font-size: 0.88rem;
				line-height: 1.55;
				display: flex;
				flex-direction: column;
				gap: 0.45rem;
			}
			.iconography-question-box strong {
				color: #235284;
				font-size: 0.82rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.iconography-question-box p {
				margin: 0;
				color: var(--map-ink);
			}

			.iconography-synthesis-box {
				margin-top: 2.5rem;
				background: #ffffff;
				border: 1px solid var(--map-border);
				border-radius: 8px;
				padding: 1.4rem 1.6rem;
			}
			.iconography-synthesis-header {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 0.85rem;
				flex-wrap: wrap;
			}
			.iconography-synthesis-badge {
				background: #235284;
				color: #ffffff;
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				padding: 0.2rem 0.55rem;
				border-radius: 4px;
			}
			.iconography-synthesis-title {
				margin: 0;
				font-family: var(--map-serif);
				font-size: 1.25rem;
				color: var(--map-ink);
			}
			.iconography-synthesis-content p {
				margin: 0 0 0.85rem;
				font-size: 0.92rem;
				line-height: 1.55;
				color: var(--map-ink-soft);
			}
			.iconography-synthesis-steps {
				margin: 0;
				padding-left: 1.25rem;
				display: flex;
				flex-direction: column;
				gap: 0.55rem;
				font-size: 0.9rem;
				line-height: 1.55;
				color: var(--map-ink-soft);
			}
			.iconography-synthesis-steps strong {
				color: var(--map-ink);
			}

			.perceval-geography-section {
				margin-top: 3rem;
				padding-top: 2.5rem;
				border-top: 1px solid var(--map-border);
			}
			.geography-header {
				margin-bottom: 1.5rem;
			}
			.geography-header h2 {
				margin: 0 0 0.5rem;
				font-family: var(--map-serif);
				font-size: 1.6rem;
				color: var(--map-ink);
			}
			.geography-lead {
				margin: 0;
				font-size: 0.98rem;
				line-height: 1.6;
				color: var(--map-ink-soft);
				max-width: 58rem;
			}
			.status-real {
				background: #e8f0fe;
				color: #1a4971;
				border: 1px solid #c2d7f2;
			}
			.status-fictional {
				background: #fdf3e7;
				color: #7a461b;
				border: 1px solid #ebd0b5;
			}
			.status-natural {
				background: #f0f4e8;
				color: #43511e;
				border: 1px solid #d4dfbe;
			}
			.status-continuation {
				background: #f3edf8;
				color: #553477;
				border: 1px solid #d9cbe6;
			}

			@media (max-width: 640px) {
				.perceval-page .rm-anchor {
					display: none;
				}
				.didactic-card {
					padding: 1rem 1.15rem;
				}
				.iconography-card {
					padding: 1.1rem 1.15rem;
				}
				.iconography-synthesis-box {
					padding: 1.1rem 1.15rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />

		<main class="page-container perceval-page">
			<article aria-labelledby="page-title">
				<header class="map-intro">
					<p class="intro-eyebrow">Chrétien de Troyes · Fin du XII<sup>e</sup> siècle (vers 1181–1190) · Roman de chevalerie en vers</p>
					<h1 id="page-title"><cite>Le Conte du Graal</cite> — Réseau des personnages et de leurs relations</h1>
					<p class="intro-desc">
						<strong>Qui sont les personnages ? Quels liens de famille, d’amitié, de chevalerie et de foi les unissent ?</strong>
					</p>
					<p class="intro-lead">
						Perceval grandit seul dans la forêt sans rien savoir des chevaliers. Devenu chevalier à son tour, il découvre le monde de la cour, secourt Blanchefleur et assiste au mystérieux cortège du Graal où il n’ose poser aucune question. Découvrez ses aventures, celles de son compagnon Gauvain et le secret de son silence expliqué par un saint ermite.
					</p>
					<p class="intro-instructions">
						Cliquez ou appuyez sur un personnage, un objet ou une relation pour lire sa fiche. Vous pouvez aussi filtrer les liens par couleur et utiliser le tableau récapitulatif sous le réseau.
					</p>
				</header>

				<!-- Trajectoire narrative en 8 séquences -->
				<ol class="mechanism" aria-label="Trajectoire de l’histoire en huit étapes">
					{percevalSequences.map((s) => (
						<li class="mechanism-step">
							<span class:list={['mechanism-cycle', s.cycle === 'perceval' ? 'cycle-perceval' : 'cycle-gauvain']}>
								{s.cycle === 'perceval' ? 'Aventures de Perceval' : 'Aventures de Gauvain'}
							</span>
							<strong>{s.title}</strong>
							<span class="mechanism-verses">{s.verses} · {s.keyFigure}</span>
							<span>{s.summary}</span>
						</li>
					))}
				</ol>

				<!-- Carte relationnelle interactive -->
				<RelationshipMap
					id="perceval"
					ariaLabel="Carte des relations entre les personnages et objets du Conte du Graal"
					nodesLabel="Personnages et objets du Conte du Graal"
					nodes={percevalCharacters}
					relationships={percevalRelationships}
					edgeTypes={percevalEdgeTypes}
					layout={{ width: 920, height: 640 }}
					mobileLayout={{ width: 360, height: 860 }}
					anchor={{
						x: 450,
						y: 20,
						label: 'La Cour d’Arthur & le cortège du Graal',
						sub: 'Le monde des chevaliers et des châteaux mystérieux',
					}}
					hint="Cliquez ou appuyez sur un personnage ou un objet pour afficher sa fiche et ses relations, ou sur une étiquette pour expliquer un lien."
					pointsLabel="Dans le roman de Chrétien :"
					relationsLabel="Ses relations directes :"
					resetLabel="Fermer la fiche"
					indexLabel="Toutes les relations du roman, en texte (alternative accessible)"
					filters
					filtersResetLabel="Toutes les relations"
				/>

				<!-- Synthèse pédagogique des figures du roman -->
				<footer class="map-synthesis" aria-labelledby="synthesis-title">
					<h2 id="synthesis-title">Tableau récapitulatif des personnages et objets</h2>
					<div class="synthesis-table-wrapper">
						<table class="synthesis-table">
							<thead>
								<tr>
									<th scope="col">Personnage ou objet</th>
									<th scope="col">Identité & rôle</th>
									<th scope="col">Ce qu’il fait dans l’histoire</th>
								</tr>
							</thead>
							<tbody>
								{percevalCharacters.map((c) => (
									<tr>
										<th scope="row">{c.label}</th>
										<td>{c.meta?.join(' · ')}</td>
										<td>{percevalFunctions[c.id]}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>

					<!-- Repères didactiques pour les élèves -->
					<section class="didactic-section" aria-labelledby="didactic-title">
						<h2 id="didactic-title">Repères de lecture : bien comprendre le texte médiéval</h2>
						<p class="didactic-lead">
							Quelques repères simples pour bien lire <em>Le Conte du Graal</em> sans le confondre avec les films ou les légendes plus tardives :
						</p>

						<div class="didactic-grid">
							{didacticNotes.map((note) => (
								<article class="didactic-card">
									<h3>{note.title}</h3>
									<p>{note.text}</p>
								</article>
							))}
						</div>

						<div class="sources-block">
							<strong>Éditions de référence et sources textuelles :</strong>
							<ul>
								<li>Chrétien de Troyes, <em>Le Conte du Graal (Perceval)</em>, édition d’après le manuscrit BnF fr. 794 (copie de Guiot) par Félix Lecoy, Paris, Champion (CFMA), 2 tomes, 1973–1975.</li>
								<li>Chrétien de Troyes, <em>Œuvres complètes</em>, sous la direction de Daniel Poirion, avec Anne Berthelot, Peter F. Dembowski, Sylvie Lefèvre, Karl D. Uitti et Philippe Walter, Paris, Gallimard, coll. « Bibliothèque de la Pléiade », 1994.</li>
								<li>Chrétien de Troyes, <em>Le Conte du Graal ou le Roman de Perceval</em>, édition bilingue et traduction par Charles Méla, Paris, Le Livre de Poche, coll. « Lettres gothiques », 1990.</li>
							</ul>
						</div>
					</section>

					<!-- Section Géographie littéraire & Déplacements du héros -->
					<section class="perceval-geography-section" id="geographie" aria-labelledby="geography-title">
						<header class="geography-header">
							<h2 id="geography-title">Les étapes du voyage de Perceval dans le roman</h2>
							<p class="geography-lead">
								Suivez les sept grandes étapes de l’apprentissage de Perceval, depuis sa forêt natale jusqu’à l’ermitage secret. Ce schéma montre l’ordre des événements dans l’histoire : il permet de comprendre comment Chrétien de Troyes mêle de vrais repères de Bretagne, des châteaux inventés et des forêts de contes.
							</p>
						</header>

						<PercevalGeoMap />
					</section>

					<!-- Section Iconographique : Images du Moyen Âge et légende du Graal -->
					<section class="perceval-iconography-section" id="iconographie" aria-labelledby="iconography-title">
						<header class="iconography-header">
							<h2 id="iconography-title">Images du Moyen Âge et légende du Graal</h2>
							<p class="iconography-lead">
								Observer des manuscrits médiévaux, des objets de chevaliers et des peintures plus récentes pour comprendre comment on lisait et imaginait l’histoire de Perceval à travers les siècles.
							</p>

							<!-- Cadre méthodologique des trois statuts documentaires -->
							<div class="iconography-method-banner">
								<span class="method-banner-title">Conseil pour les élèves de 5ᵉ : bien distinguer les trois types d’images</span>
								<ul class="method-banner-list">
									<li>
										<span class="status-badge status-medieval">Témoignage médiéval</span>
										Document ou peinture réalisé réellement au Moyen Âge (manuscrits copiés à la main, enluminures).
									</li>
									<li>
										<span class="status-badge status-tardif">Légende du Graal écrite plus tard</span>
										Image inspirée par les légendes écrites après Chrétien de Troyes (qui transforment le Graal en calice de la messe).
									</li>
									<li>
										<span class="status-badge status-moderne">Reconstitution moderne</span>
										Dessin ou peinture du XIXᵉ ou du XXᵉ siècle imaginé pour un livre d’aventures pour la jeunesse.
									</li>
								</ul>
							</div>
						</header>

						<div class="iconography-cards-grid">
							{percevalIconography.map((doc, idx) => (
								<article class="iconography-card" id={doc.id}>
									<header class="iconography-card-header">
										<span class={`status-badge ${doc.badgeClass}`}>{doc.badge}</span>
										<h3 class="iconography-card-title">{idx + 1}. {doc.title}</h3>
									</header>

									<figure class="iconography-figure">
										<img
											src={doc.image.src}
											alt={doc.image.alt}
											class="iconography-img"
											loading="lazy"
											width={doc.image.width}
											height={doc.image.height}
										/>
										<figcaption class="iconography-caption">
											{doc.image.caption}
										</figcaption>
									</figure>

									<div class="iconography-meta-box">
										<ul class="iconography-meta-list">
											<li><strong>Titre du document :</strong> {doc.meta.title}</li>
											<li><strong>Artiste / Origine :</strong> {doc.meta.author}</li>
											<li><strong>Date :</strong> {doc.meta.date}</li>
											<li><strong>Lieu de conservation :</strong> {doc.meta.institution}</li>
											<li>
												<strong>Notice et cote :</strong>{' '}
												<a href={doc.meta.identifierUrl} target="_blank" rel="noopener noreferrer" class="meta-permalink">
													{doc.meta.identifier}
												</a>
											</li>
