						<article class="iconography-card" id="doc-plan-charleville">
							<header class="iconography-card-header">
								<span class="status-badge status-plan">Plan cadastral ancien</span>
								<h3 class="iconography-card-title">1. L’espace urbain de Charleville avant le square de la gare (1854)</h3>
							</header>

							<figure class="iconography-figure">
								<img
									src="/images/rimbaud/plan-charleville-1854.jpg"
