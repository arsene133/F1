---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/editorial-map.css';
import {
	categoryLabels,
	categoryOrder,
	difficultyLabels,
	potBouilleLeitnerCards as cards,
	skillLabels,
} from '../data/pot-bouille-leitner';
import { boxPurpose, intervalLabel, intervalShort } from '../lib/leitner/labels';
import { BOX_INTERVAL_DAYS, BOXES } from '../lib/leitner/scheduler';
import { DAILY_GOAL_OPTIONS, DEFAULT_SETTINGS, NEW_PER_DAY_OPTIONS } from '../lib/leitner/storage';

const pageTitle = 'Réviser Pot-Bouille — boîte de Leitner';
const pageDescription =
	'Quelques questions pour mieux connaître et comprendre Pot-Bouille d’Émile Zola : 100 questions de révision (œuvre, personnages, thèmes, écriture, interprétation, bac de français), avec répétition espacée.';

const countIn = (category: string) => cards.filter((c) => c.category === category).length;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body id="page-leitner">
		<Header />

		<main class="page-container leitner-page" id="leitner-app" data-total={cards.length}>
			<!-- ============================================================ -->
			<!-- Écran d’accueil : une seule action principale                -->
			<!-- ============================================================ -->
			<header class="lb-intro" data-intro>
				<p class="intro-eyebrow">Émile Zola · <cite>Pot-Bouille</cite></p>
				<h1 id="lb-title">Réviser <cite>Pot-Bouille</cite></h1>
				<p class="lb-subtitle">Quelques questions pour mieux connaître et comprendre le roman de Zola.</p>
			</header>

			<!-- ============================================================ -->
			<!-- La boîte : bac des nouvelles fiches + cinq compartiments.     -->
			<!-- Grande à l’accueil, réduite à une réglette pendant la séance. -->
			<!-- ============================================================ -->
			<section class="lb-box-section" data-box-section aria-labelledby="lb-box-title">
				<div class="lb-box-head">
					<h2 id="lb-box-title" class="lb-box-title">Ta boîte de fiches</h2>
					<p class="lb-box-hint" data-box-hint>Touche un compartiment pour voir ses fiches.</p>
				</div>
				<div class="lb-box" data-box>
					<button
						type="button"
						class="lb-slot lb-slot--intake"
						data-compartment="new"
						aria-expanded="false"
						aria-controls="lb-drawer"
					>
						<span class="lb-slot-well" aria-hidden="true"><span class="lb-stack" data-stack></span></span>
						<span class="lb-slot-front">
							<span class="lb-slot-name">Nouvelles</span>
							<span class="lb-slot-interval">jamais vues</span>
							<span class="lb-slot-count" data-slot-count>–</span>
							<span class="lb-slot-flag" data-slot-flag hidden></span>
						</span>
					</button>
					<div class="lb-compartments">
						{
							BOXES.map((box) => (
								<button
									type="button"
									class={`lb-slot lb-box-${box}`}
									data-compartment={box}
									aria-expanded="false"
									aria-controls="lb-drawer"
								>
									<span class="lb-slot-well" aria-hidden="true">
										<span class="lb-stack" data-stack />
									</span>
									<span class="lb-slot-front">
										<span class="lb-slot-name">
											<span class="lb-slot-word">Compartiment </span>
											<span class="lb-slot-num">{box}</span>
										</span>
										<span class="lb-slot-interval">{intervalShort(BOX_INTERVAL_DAYS[box])}</span>
										<span class="lb-slot-count" data-slot-count>–</span>
										<span class="lb-slot-flag" data-slot-flag hidden />
									</span>
								</button>
							))
						}
					</div>
				</div>
				<ul class="lb-box-rule" aria-label="Règles de la boîte">
					<li><span class="lb-rule-mark" aria-hidden="true">✓</span> <strong>Je savais</strong> : la fiche passe au compartiment suivant</li>
					<li><span class="lb-rule-mark" aria-hidden="true">↺</span> <strong>À revoir</strong> : retour au compartiment 1</li>
					<li><span class="lb-rule-mark lb-rule-mark--due" aria-hidden="true">⚑</span> à revoir aujourd’hui</li>
				</ul>
				<section class="lb-drawer" id="lb-drawer" data-drawer hidden aria-labelledby="lb-drawer-title">
					<div class="lb-drawer-head">
						<h3 id="lb-drawer-title" tabindex="-1" data-drawer-title></h3>
						<button type="button" class="lb-linklike" data-drawer-close>Fermer</button>
					</div>
					<p class="lb-drawer-summary" data-drawer-summary></p>
					<ul class="lb-drawer-list" data-drawer-list></ul>
				</section>
			</section>

			<section class="lb-home" data-home aria-label="Commencer">
				<button type="button" class="lb-btn lb-btn--primary lb-btn--hero" data-start>Commencer ma révision</button>

				<ul class="lb-summary-lines" aria-label="Où tu en es">
					<li data-line="due">Questions à revoir aujourd’hui : –</li>
					<li data-line="new">Nouvelles questions disponibles : –</li>
					<li data-line="mastered">Questions maîtrisées : –</li>
				</ul>

				<div class="lb-home-message" data-home-message role="status" hidden></div>

				<nav class="lb-choices" aria-label="Choisir une activité">
					<p class="lb-choices-label">Ou choisis :</p>
					<div class="lb-choices-row">
						<button type="button" class="lb-choice" data-choice="revision">
							<span class="lb-choice-name">Réviser</span>
							<span class="lb-choice-desc">les questions du jour</span>
						</button>
						<button type="button" class="lb-choice" data-choice="decouverte">
							<span class="lb-choice-name">Découvrir</span>
							<span class="lb-choice-desc">de nouvelles questions</span>
						</button>
						<button type="button" class="lb-choice" data-choice="entrainement" aria-expanded="false" aria-controls="lb-practice">
							<span class="lb-choice-name">S’entraîner</span>
							<span class="lb-choice-desc">librement, sans rien changer</span>
						</button>
					</div>
				</nav>

				<form class="lb-practice" id="lb-practice" data-practice-form hidden>
					<p class="lb-practice-intro">
						Choisis tes questions. L’entraînement ne modifie pas ta progression.
					</p>
					<div class="lb-field">
						<label for="practice-category">Thème</label>
						<select id="practice-category" name="category">
							<option value="">Tous les thèmes</option>
							{categoryOrder.map((c) => <option value={c}>{categoryLabels[c]} ({countIn(c)})</option>)}
						</select>
					</div>
					<details class="lb-more">
						<summary>Plus d’options</summary>
						<div class="lb-more-grid">
							<div class="lb-field">
								<label for="practice-difficulty">Difficulté</label>
								<select id="practice-difficulty" name="difficulty">
									<option value="">Toutes</option>
									{Object.entries(difficultyLabels).map(([v, l]) => <option value={v}>{l}</option>)}
								</select>
							</div>
							<div class="lb-field">
								<label for="practice-skill">Type de question</label>
								<select id="practice-skill" name="skill">
									<option value="">Tous</option>
									{Object.entries(skillLabels).map(([v, l]) => <option value={v}>{l}</option>)}
								</select>
							</div>
							<div class="lb-field">
								<label for="practice-size">Nombre de questions</label>
								<select id="practice-size" name="size">
									<option value="10">10</option>
									<option value="20">20</option>
									<option value="0">Toutes celles qui correspondent</option>
								</select>
							</div>
						</div>
					</details>
					<p class="lb-help" data-practice-count aria-live="polite"></p>
					<div class="lb-practice-actions">
						<button type="submit" class="lb-btn lb-btn--primary">Commencer l’entraînement</button>
						<button type="button" class="lb-linklike" data-practice-preset="interpretation">
							ou seulement les questions d’interprétation
						</button>
					</div>
				</form>

				<p class="lb-progress-link"><a href="#progression">Voir ma progression</a></p>
			</section>

			<noscript>
				<p class="lb-noscript">
					La révision et l’enregistrement de ta progression nécessitent JavaScript. Tu peux tout de même
					lire toutes les questions dans « Voir ma progression », plus bas.
				</p>
			</noscript>

			<p class="lb-storage-warning" id="lb-storage-warning" role="status" hidden></p>

			<!-- ============================================================ -->
			<!-- Séance                                                        -->
			<!-- ============================================================ -->
			<section class="lb-session" data-session hidden aria-label="Séance de révision">
				<div class="lb-session-bar">
					<p class="lb-session-title" data-session-title></p>
					<button type="button" class="lb-linklike" data-session-quit>Arrêter</button>
				</div>
				<div class="lb-bar lb-bar--thin" aria-hidden="true" data-bar="session"><span class="lb-bar-fill"></span></div>

				<div class="lb-feedback-wrap" role="status" aria-live="polite">
					<p class="lb-feedback" data-feedback></p>
					<p class="lb-movement" data-movement></p>
				</div>

				<div class="lb-desk" data-study-card>
					<!-- La fiche : recto (question) puis verso (réponse), retournée par « Voir la réponse ». -->
					<article class="lb-index-card" data-index-card aria-labelledby="study-question">
						<div class="lb-card-head">
							<div class="lb-card-top">
								<p class="lb-card-eyebrow" data-study-eyebrow></p>
								<p class="lb-card-origin" data-card-origin></p>
							</div>
							<p class="lb-card-count" data-session-progress></p>
						</div>

						<div class="lb-face lb-face--front" data-face-front>
							<h2 id="study-question" class="lb-card-question" tabindex="-1" data-study-question></h2>
							<p class="lb-practice-note" data-practice-note hidden>Entraînement libre : ta progression n’est pas modifiée.</p>
							<details class="lb-hint" data-study-hint-wrap>
								<summary>Un indice ?</summary>
								<p data-study-hint></p>
							</details>
						</div>

						<section class="lb-face lb-face--back lb-answer" data-answer hidden aria-labelledby="study-answer-title">
							<p class="lb-answer-recall" data-answer-question></p>
							<h3 id="study-answer-title" tabindex="-1" data-answer-title>Réponse</h3>
							<p class="lb-answer-text" data-answer-text></p>
							<p class="lb-explanation" data-answer-explanation></p>
							<blockquote class="lb-quote" data-answer-quote>
								<p data-answer-quote-text></p>
								<cite data-answer-quote-cite></cite>
							</blockquote>
							<p class="lb-reference" data-answer-reference></p>
						</section>
					</article>

					<!-- Brouillon, à côté de la fiche : il reste visible une fois la fiche retournée. -->
					<details class="lb-hint lb-attempt">
						<summary>Écrire ma réponse</summary>
						<label for="study-attempt" class="sr-only">Ta réponse (facultatif, rien n’est enregistré)</label>
						<textarea id="study-attempt" rows="3" data-study-attempt placeholder="Facultatif : rien n’est enregistré."></textarea>
					</details>

					<div class="lb-reveal-row" data-reveal-row>
						<button type="button" class="lb-btn lb-btn--secondary lb-btn--wide" data-reveal>Voir la réponse</button>
					</div>

					<div class="lb-assess" role="group" aria-labelledby="lb-assess-title" data-assess-group hidden>
						<p class="lb-assess-title" id="lb-assess-title">
							Réponds honnêtement : une bonne réponse doit contenir les idées essentielles.
						</p>
						<p class="lb-assess-hint" data-assess-hint hidden>
							Ici, il faut savoir expliquer le sens, pas seulement donner un fait.
						</p>
						<div class="lb-assess-buttons">
							<button type="button" class="lb-btn lb-btn--again" data-assess="forgotten">
								<span class="lb-assess-label">À revoir</span>
								<span class="lb-assess-dest" data-assess-dest="forgotten"></span>
							</button>
							<button type="button" class="lb-btn lb-btn--known" data-assess="known">
								<span class="lb-assess-label">Je savais</span>
								<span class="lb-assess-dest" data-assess-dest="known"></span>
							</button>
						</div>
						<p class="lb-kbd-help">Au clavier : <kbd>R</kbd> à revoir · <kbd>S</kbd> je savais</p>
					</div>
				</div>

				<section class="lb-summary" data-summary hidden aria-labelledby="lb-summary-title">
					<h2 id="lb-summary-title" tabindex="-1">Séance terminée !</h2>
					<ul class="lb-summary-counts">
						<li>Questions révisées : <strong data-summary-total>0</strong></li>
						<li>Questions réussies : <strong data-summary-known>0</strong></li>
						<li>Questions à revoir : <strong data-summary-forgotten>0</strong></li>
					</ul>
					<p class="lb-summary-moves" data-summary-moves hidden></p>
					<p class="lb-summary-message" data-summary-message></p>
					<p class="lb-summary-saved" data-summary-saved>Ta progression est enregistrée : tu peux t’arrêter quand tu veux.</p>
					<div class="lb-summary-actions">
						<button type="button" class="lb-btn lb-btn--primary" data-summary-back>Terminer</button>
						<button type="button" class="lb-btn lb-btn--secondary" data-summary-continue>Continuer à réviser</button>
					</div>
				</section>
			</section>

			<p class="sr-only" aria-live="polite" data-announcer></p>

			<!-- ============================================================ -->
			<!-- Section secondaire : progression, questions, réglages        -->
			<!-- ============================================================ -->
			<section class="lb-secondary" id="progression" data-secondary aria-labelledby="lb-secondary-title">
				<h2 id="lb-secondary-title">Voir ma progression</h2>

				<details class="lb-fold" data-fold="stats">
					<summary>Mes statistiques</summary>
					<div class="lb-fold-body">
						<dl class="lb-stats">
							<div class="lb-stat">
								<dt>Questions au total</dt>
								<dd data-stat="total">{cards.length}</dd>
							</div>
							<div class="lb-stat">
								<dt>À revoir aujourd’hui</dt>
								<dd data-stat="due">–</dd>
							</div>
							<div class="lb-stat">
								<dt>Jamais vues</dt>
								<dd data-stat="new">–</dd>
							</div>
							<div class="lb-stat">
								<dt>Maîtrisées</dt>
								<dd data-stat="mastered">–</dd>
							</div>
						</dl>

						<p class="lb-progress-label" id="lb-progress-label">
							Progression globale : <strong data-stat="progress">–</strong>
						</p>
						<div
							class="lb-bar"
							role="progressbar"
							aria-labelledby="lb-progress-label"
							aria-valuemin="0"
							aria-valuemax="100"
							aria-valuenow="0"
							data-bar="progress"
						>
							<span class="lb-bar-fill"></span>
						</div>
						<p class="lb-help">
							Une question jamais vue compte pour 0, une question maîtrisée pour 1. Lire une question ne
							la fait pas progresser : seule une bonne réponse compte.
						</p>

						<h3>Par compartiment</h3>
						<p class="lb-dist-new-line">
							<strong data-dist="new">–</strong> question(s) jamais vue(s), dans le bac des nouvelles.
						</p>
						<ol class="lb-dist" aria-label="Nombre de questions par compartiment">
							{
								BOXES.map((box) => (
									<li class={`lb-dist-col lb-box-${box}`}>
										<span class="lb-dist-count" data-dist={box}>–</span>
										<span class="lb-dist-track"><span class="lb-dist-fill" /></span>
										<span class="lb-dist-label">Comp. {box}</span>
									</li>
								))
							}
						</ol>

						<h3>Aujourd’hui</h3>
						<p class="lb-goal-text" id="lb-goal-label" data-goal-text>
							Questions évaluées aujourd’hui : – sur un objectif de {DEFAULT_SETTINGS.dailyGoal}
						</p>
						<div
							class="lb-bar lb-bar--goal"
							role="progressbar"
							aria-labelledby="lb-goal-label"
							aria-valuemin="0"
							aria-valuemax="100"
							aria-valuenow="0"
							data-bar="goal"
						>
							<span class="lb-bar-fill"></span>
						</div>
						<p class="lb-help" data-goal-message>
							L’objectif est un repère, pas une obligation : mieux vaut un peu chaque jour que beaucoup une fois.
						</p>

						<h3>Les 14 derniers jours</h3>
						<ol class="lb-history" data-history aria-label="Questions évaluées chaque jour pendant les 14 derniers jours"></ol>
						<p class="lb-history-legend" aria-hidden="true">
							<span class="lb-key lb-key--known"></span> je savais
							<span class="lb-key lb-key--forgotten"></span> à revoir
						</p>

						<div class="lb-attention" data-attention hidden>
							<h3>Questions à surveiller</h3>
							<p class="lb-help">Oubliées récemment ou plusieurs fois : relis-les.</p>
							<ul class="lb-attention-list" data-attention-list></ul>
						</div>
					</div>
				</details>

				<details class="lb-fold" data-fold="browse">
					<summary>Toutes les questions</summary>
					<div class="lb-fold-body">
						<p class="lb-help lb-help--top">
							Lis librement toutes les questions et leurs réponses. Les consulter ne change pas ta progression.
						</p>
						<form class="lb-browse-filters" data-browse-form>
							<div class="lb-field lb-field--search">
								<label for="browse-search">Rechercher</label>
								<input id="browse-search" name="search" type="search" placeholder="Berthe, ironie, dot…" autocomplete="off" />
							</div>
							<div class="lb-field">
								<label for="browse-category">Thème</label>
								<select id="browse-category" name="category">
									<option value="">Tous</option>
									{categoryOrder.map((c) => <option value={c}>{categoryLabels[c]}</option>)}
								</select>
							</div>
							<div class="lb-field">
								<label for="browse-difficulty">Difficulté</label>
								<select id="browse-difficulty" name="difficulty">
									<option value="">Toutes</option>
									{Object.entries(difficultyLabels).map(([v, l]) => <option value={v}>{l}</option>)}
								</select>
							</div>
							<div class="lb-field">
								<label for="browse-box">Compartiment</label>
								<select id="browse-box" name="box">
									<option value="">Toutes</option>
									<option value="0">Jamais vue</option>
									{BOXES.map((b) => <option value={String(b)}>Compartiment {b}</option>)}
								</select>
							</div>
							<div class="lb-field">
								<label for="browse-status">État</label>
								<select id="browse-status" name="status">
									<option value="">Tous</option>
									<option value="new">Jamais vues</option>
									<option value="learning">En cours</option>
									<option value="mastered">Maîtrisées</option>
								</select>
							</div>
							<button type="reset" class="lb-linklike">Effacer les filtres</button>
						</form>
						<p class="lb-browse-count" data-browse-count role="status">{cards.length} questions affichées</p>
						<p class="lb-empty" data-browse-empty hidden>Aucune question ne correspond. Essaie de retirer un filtre.</p>

						<ul class="lb-browse-list" data-browse-list>
							{
								cards.map((card) => (
									<li
										class="lb-browse-item"
										id={`carte-${card.id}`}
										data-card-id={card.id}
										data-category={card.category}
										data-difficulty={card.difficulty}
										data-box="0"
										data-status="new"
									>
										<details>
											<summary>
												<span class="lb-browse-meta">
													{categoryLabels[card.category]} · {difficultyLabels[card.difficulty]} ·{' '}
													<span data-box-chip>Jamais vue</span>
												</span>
												<span class="lb-browse-question">{card.question}</span>
											</summary>
											<div class="lb-browse-body">
												<p class="lb-skill">{skillLabels[card.skill]}</p>
												{card.hint && (
													<p class="lb-browse-hint">
														<strong>Indice :</strong> {card.hint}
													</p>
												)}
												<p class="lb-answer-text">{card.answer}</p>
												{card.explanation && <p class="lb-explanation">{card.explanation}</p>}
												{card.quotation && (
													<blockquote class="lb-quote">
														<p>« {card.quotation.text} »</p>
														<cite>
															{card.quotation.speaker}, ch. {card.quotation.chapter}
														</cite>
													</blockquote>
												)}
												{card.reference && <p class="lb-reference">Dans le roman : {card.reference}</p>}
												{card.focus && <p class="lb-reference">Personnages / thèmes : {card.focus.join(' · ')}</p>}
											</div>
										</details>
									</li>
								))
							}
						</ul>
					</div>
				</details>

				<details class="lb-fold" data-fold="settings">
					<summary>Réglages</summary>
					<div class="lb-fold-body lb-settings-grid">
						<div class="lb-field">
							<label for="setting-goal">Objectif par jour (questions)</label>
							<select id="setting-goal" data-setting="dailyGoal">
								{DAILY_GOAL_OPTIONS.map((n) => <option value={n} selected={n === DEFAULT_SETTINGS.dailyGoal}>{n}</option>)}
							</select>
						</div>
						<div class="lb-field">
							<label for="setting-new">Nouvelles questions par jour</label>
							<select id="setting-new" data-setting="newPerDay">
								{NEW_PER_DAY_OPTIONS.map((n) => <option value={n} selected={n === DEFAULT_SETTINGS.newPerDay}>{n}</option>)}
							</select>
						</div>
						<div class="lb-field">
							<label for="discover-category">Nouvelles questions : commencer par</label>
							<select id="discover-category">
								<option value="">tous les thèmes, en alternance</option>
								{categoryOrder.map((c) => <option value={c}>{categoryLabels[c]}</option>)}
							</select>
						</div>
						<div class="lb-reset">
							<p class="lb-help">
								Ta progression est enregistrée dans ce navigateur, sur cet appareil seulement. Aucun compte,
								aucune donnée envoyée.
							</p>
							<button type="button" class="lb-btn lb-btn--danger" data-reset-open>Effacer ma progression…</button>
						</div>
					</div>
				</details>

				<details class="lb-fold" data-fold="method">
					<summary>Comment ça marche</summary>
					<div class="lb-fold-body lb-method">
						<p>
							Chaque question est une fiche qui voyage entre les cinq compartiments de la boîte. Si tu connaissais
							la réponse, elle passe dans le compartiment suivant et reviendra plus tard ; sinon, elle retourne dans le compartiment 1 et revient dès la prochaine
							séance. Les questions faciles s’espacent, les difficiles reviennent souvent.
						</p>
						<ol class="lb-boxes-strip" aria-label="Les cinq compartiments et leur rythme de révision">
							{
								BOXES.map((box) => (
									<li class={`lb-box-step lb-box-${box}`}>
										<span class="lb-box-step-name">Compartiment {box}</span>
										<span class="lb-box-step-interval">{intervalLabel(BOX_INTERVAL_DAYS[box])}</span>
										<span class="lb-box-step-purpose">{boxPurpose[box]}</span>
									</li>
								))
							}
						</ol>
						<h3>Pourquoi ça marche</h3>
						<p>
							<strong>Se tester plutôt que relire :</strong> chercher une réponse dans sa mémoire, même sans la
							trouver, la renforce davantage qu’une relecture. <strong>Espacer :</strong> revoir une notion au
							moment où elle commence à s’effacer la fixe plus durablement. <strong>Connaître, puis
							comprendre :</strong> certaines questions demandent un fait, d’autres une explication du sens.
						</p>
						<h3>Pour qui ?</h3>
						<p class="lb-level-note">
							Pour une élève ou un élève de seconde qui lit le roman. Les questions « Se préparer au bac » vont
							plus loin : en <strong>première</strong>, pour l’épreuve anticipée de français de la session 2027,
							<cite>Pot-Bouille</cite> est associé au parcours « Dévoiler les rouages de la société ». Ce n’est
							pas une exigence du programme de seconde, mais un entraînement anticipé.
						</p>
						<p class="lb-sources">
							<strong>Sources des citations :</strong> toutes les phrases de Zola citées ont été vérifiées mot
							pour mot sur le texte de l’édition G. Charpentier (1883), transcrit sur Wikisource. Quand aucune
							citation sûre n’était disponible, la question décrit la scène sans la citer.
						</p>
						<p class="lb-back-link">
							<a href="/pot-bouille">Revoir la carte des personnages et la coupe de l’immeuble de <cite>Pot-Bouille</cite></a>
						</p>
					</div>
				</details>
			</section>

			<dialog class="lb-dialog" data-reset-dialog aria-labelledby="lb-reset-title" aria-describedby="lb-reset-desc">
				<form method="dialog">
					<h2 id="lb-reset-title">Effacer toute ta progression ?</h2>
					<p id="lb-reset-desc">
						Toutes les questions redeviendront « jamais vues » et ton historique sera supprimé. C’est
						définitif. Tes réglages sont conservés.
					</p>
					<div class="lb-dialog-actions">
						<button type="submit" value="cancel" class="lb-btn lb-btn--primary" autofocus>Annuler</button>
						<button type="submit" value="confirm" class="lb-btn lb-btn--danger" data-reset-confirm>Oui, tout effacer</button>
					</div>
				</form>
			</dialog>
		</main>

		<Footer />

		<script>
			import { initLeitnerApp } from '../lib/leitner/app';

			initLeitnerApp();
		</script>
	</body>
