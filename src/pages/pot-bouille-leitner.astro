		color: var(--lb-again);
	}
	.lb-btn--known:hover,
	.lb-btn--again:hover {
		filter: brightness(0.97);
	}
	.lb-kbd-help {
		margin: 0.6rem 0 0;
		font-size: 0.8rem;
		color: var(--lb-muted);
	}
	.lb-kbd-help kbd {
		padding: 0.05rem 0.35rem;
		border: 1px solid var(--lb-border-strong);
		border-bottom-width: 2px;
		border-radius: 4px;
		font-family: inherit;
		font-size: 0.78rem;
	}

	.lb-summary {
		margin-top: 1rem;
		padding: 2rem 1.4rem;
		background: var(--lb-surface);
		border: 1px solid var(--lb-border);
		border-radius: 14px;
		text-align: center;
	}
	.lb-summary-counts {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
		display: grid;
		gap: 0.3rem;
		font-size: 1.05rem;
	}
	.lb-summary-message {
		margin: 0 auto 1.5rem;
		max-width: 28rem;
		color: var(--lb-muted);
	}
	.lb-summary-saved {
		margin: -0.75rem auto 1.5rem;
		font-size: 0.85rem;
		color: var(--lb-muted);
	}
	.lb-summary-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}

	/* La boîte ------------------------------------------------------------- */
	.lb-box-section {
		margin: 0;
	}
	.lb-box-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.15rem 1rem;
		margin: 0 0 0.6rem;
	}
	.leitner-page .lb-box-title {
		margin: 0;
		font-size: 1.15rem;
	}
	.lb-box-hint {
		margin: 0;
		font-size: 0.85rem;
		color: var(--lb-muted);
	}
	.lb-box {
		display: grid;
		grid-template-columns: minmax(6.5rem, 0.95fr) minmax(0, 5fr);
		gap: 0.75rem;
		align-items: stretch;
	}
	/* Les cinq compartiments, de plus en plus larges comme dans une vraie boîte :
	   le cadre en bois apparaît entre eux et forme les séparations. */
	.lb-compartments {
		display: grid;
		grid-template-columns: 1fr 1.05fr 1.1fr 1.15fr 1.2fr;
		gap: 6px;
		padding: 7px 7px 0;
		background: linear-gradient(180deg, var(--lb-wood-deep), var(--lb-wood) 70%, var(--lb-wood-deep));
		border-radius: 12px 12px 10px 10px;
		box-shadow: var(--lb-shadow);
	}
	.lb-slot {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 6px 6px 0 0;
		background: none;
		color: var(--lb-wood-ink);
		font: inherit;
		text-align: center;
		cursor: pointer;
		transition: transform 0.15s ease;
	}
	.lb-slot:disabled {
		cursor: default;
	}
	.lb-slot-well {
		position: relative;
		display: block;
		height: 6.25rem;
		background: var(--lb-well);
		border-radius: 5px 5px 0 0;
		box-shadow: inset 0 7px 10px -6px var(--lb-well-shade), inset 0 0 0 1px rgba(0, 0, 0, 0.05);
		overflow: hidden;
	}
	/* Pile de fiches posées à plat : chaque feuille dépasse de quelques pixels. */
	.lb-stack {
		--sheet-h: 1.15rem;
		position: absolute;
		inset: 0.55rem 14% 0.4rem;
	}
	.lb-sheet {
		position: absolute;
		left: 0;
		right: 0;
		height: var(--sheet-h);
		bottom: calc(var(--i) * min(4px, (100% - var(--sheet-h)) / var(--n)));
		background: var(--lb-sheet);
		border: 1px solid var(--lb-sheet-edge);
		border-radius: 2px;
		box-shadow: 0 1px 0 rgba(60, 40, 20, 0.08);
	}
	.lb-sheet:nth-child(odd) {
		transform: rotate(-0.9deg);
	}
	.lb-sheet:nth-child(3n) {
		transform: translateX(2px) rotate(0.7deg);
	}
	/* Fiches à revoir : un onglet dépasse du haut de la pile. */
	.lb-sheet.is-due::after {
		content: '';
		position: absolute;
		top: -5px;
		left: 12%;
		width: 24%;
		height: 5px;
		background: var(--lb-due);
		border-radius: 2px 2px 0 0;
	}
	.lb-sheet.is-due:nth-child(even)::after {
		left: 52%;
	}
	.lb-slot-front {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.1rem;
		padding: 0.45rem 0.2rem 0.55rem;
		line-height: 1.25;
	}
	.lb-slot-name {
		font-size: 0.8rem;
		font-weight: 700;
	}
	.lb-slot-word {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	/* Porte-étiquette : le numéro est écrit sur un petit carton. */
	.lb-slot-num {
		display: inline-block;
		min-width: 1.9em;
		padding: 0 0.35em;
		background: var(--lb-paper);
		color: var(--lb-paper-ink);
		border: 1px solid rgba(0, 0, 0, 0.18);
		border-radius: 3px;
		font-family: var(--lb-serif);
		font-size: 1.15rem;
		box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.12);
	}
	.lb-slot-interval {
		font-size: 0.74rem;
	}
	.lb-slot-count {
		font-size: 0.82rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.lb-slot-flag {
		display: inline-flex;
		align-items: center;
		gap: 0.2em;
		margin-top: 0.15rem;
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		background: var(--lb-due);
		color: var(--lb-accent-ink);
		font-size: 0.72rem;
		font-weight: 700;
		white-space: nowrap;
	}
	.lb-slot-flag::before {
		content: '⚑';
	}
	.lb-slot-flag[hidden] {
		display: none;
	}
	.lb-slot.is-empty .lb-slot-well::after {
		content: 'vide';
		position: absolute;
		inset: auto 0 0.6rem;
		font-size: 0.72rem;
		color: var(--lb-muted);
	}
	@media (hover: hover) {
		.lb-slot:not(:disabled):hover {
			transform: translateY(-2px);
		}
	}
	.lb-slot[aria-expanded='true'] {
		transform: translateY(-3px);
	}
	.lb-slot[aria-expanded='true'] .lb-slot-well {
		box-shadow: inset 0 0 0 3px var(--lb-accent), inset 0 7px 10px -6px var(--lb-well-shade);
	}
	.lb-slot[aria-expanded='true'] .lb-slot-front::after {
		content: '▾ ouvert';
		font-size: 0.7rem;
		font-weight: 700;
	}

	/* Bac des nouvelles fiches : un plateau à part, en papier, hors du bois. */
	.lb-slot--intake {
		border: 1px dashed var(--lb-border-strong);
		border-radius: 12px;
		background: var(--lb-surface-alt);
		color: var(--lb-ink);
		overflow: hidden;
	}
	.lb-slot--intake .lb-slot-well {
		margin: 7px 7px 0;
		background: transparent;
		box-shadow: none;
	}
	.lb-slot--intake .lb-sheet:nth-child(even) {
		transform: translateX(-3px) rotate(-2deg);
	}
	.lb-slot--intake .lb-slot-name {
		font-family: var(--lb-serif);
		font-size: 1rem;
		font-weight: normal;
	}
	.lb-slot--intake .lb-slot-interval {
		color: var(--lb-muted);
	}
	.lb-slot--intake .lb-slot-flag {
		background: var(--lb-paper);
		color: var(--lb-paper-ink);
		border: 1px solid var(--lb-paper-edge);
	}
	.lb-slot--intake .lb-slot-flag::before {
		content: '+';
	}
	.lb-slot--intake .lb-sheet.is-due::after {
		display: none;
	}

	/* Fiche qui vient d’être rangée, fiche « en main » pendant la séance. */
	.lb-slot.is-receiving .lb-slot-well {
		box-shadow: inset 0 0 0 3px var(--lb-known), inset 0 7px 10px -6px var(--lb-well-shade);
	}
	.lb-slot.is-receiving {
		animation: lb-receive 0.6s ease-out 0.35s;
	}
	@keyframes lb-receive {
		30% {
			transform: translateY(2px);
		}
	}
	.lb-slot.is-source .lb-slot-well {
		outline: 2px dashed var(--lb-accent);
		outline-offset: -4px;
	}
	.lb-ghost {
		position: fixed;
		z-index: 50;
		pointer-events: none;
		background: var(--lb-paper);
		border: 1px solid var(--lb-paper-edge);
		border-top: 3px solid var(--lb-paper-rule);
		border-radius: 4px;
		box-shadow: var(--lb-shadow);
	}

	.lb-box-rule {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.15rem 1.25rem;
		list-style: none;
		margin: 0.7rem 0 0;
		padding: 0;
		font-size: 0.85rem;
		color: var(--lb-muted);
	}
	.lb-box-rule strong {
		color: var(--lb-ink);
	}
	.lb-rule-mark {
		font-weight: 700;
		color: var(--lb-ink);
	}
	.lb-rule-mark--due {
		color: var(--lb-due);
	}

	/* Tiroir : les fiches du compartiment choisi ------------------------------ */
	.lb-drawer {
		margin-top: 0.9rem;
		padding: 1rem 1.1rem 1.1rem;
		background: var(--lb-surface-alt);
		border: 1px solid var(--lb-border);
		border-radius: 12px;
	}
	.lb-drawer-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.leitner-page .lb-drawer h3 {
		margin: 0;
		font-size: 1.1rem;
	}
	.lb-drawer-head .lb-linklike {
		min-height: 2.75rem;
		flex-shrink: 0;
	}
	.lb-drawer-summary {
		margin: 0.2rem 0 0.8rem;
		font-size: 0.9rem;
		color: var(--lb-muted);
	}
	.lb-drawer-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: 0.6rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.lb-drawer-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.65rem 0.8rem 0.5rem;
		background: var(--lb-paper);
		color: var(--lb-paper-ink);
		border: 1px solid var(--lb-paper-edge);
		border-top: 3px solid transparent;
		border-radius: 4px;
		box-shadow: 0 1px 2px rgba(60, 40, 20, 0.1);
	}
	.lb-drawer-card[data-due='true'] {
		border-top-color: var(--lb-due);
	}
	.lb-drawer-card p {
		margin: 0;
	}
	.lb-drawer-status {
		font-size: 0.78rem;
		color: var(--lb-muted);
	}
	.lb-drawer-card[data-due='true'] .lb-drawer-status {
		font-weight: 700;
		color: var(--lb-accent);
	}
	.lb-drawer-q {
		font-family: var(--lb-serif);
		line-height: 1.35;
	}
	.lb-drawer-meta {
		font-size: 0.76rem;
		color: var(--lb-muted);
	}
	.lb-drawer-card .lb-linklike {
		align-self: flex-start;
		min-height: 2.75rem;
		font-size: 0.88rem;
	}

	/* Pendant la séance : la boîte devient une réglette compacte, toujours visible. */
	.leitner-page[data-view='session'] .lb-box-section {
		position: sticky;
		top: 0;
		z-index: 5;
		margin: 0 -0.5rem;
		padding: 0.5rem 0.5rem 0.4rem;
		background: var(--bg);
		border-bottom: 1px solid var(--lb-border);
	}
	.leitner-page[data-view='session'] :is(.lb-box-head, .lb-box-rule, .lb-drawer, .lb-slot-interval, .lb-slot-flag) {
		display: none;
	}
	.leitner-page[data-view='session'] .lb-box {
		grid-template-columns: minmax(0, 1fr) minmax(0, 5.6fr);
		gap: 0.4rem;
	}
	.leitner-page[data-view='session'] .lb-compartments {
		gap: 4px;
		padding: 4px 4px 0;
		border-radius: 8px;
	}
	.leitner-page[data-view='session'] .lb-slot-well {
		height: 2.1rem;
	}
	.leitner-page[data-view='session'] .lb-stack {
		--sheet-h: 0.55rem;
		inset: 0.35rem 12% 0.2rem;
	}
	.leitner-page[data-view='session'] .lb-slot-front {
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0 0.35rem;
		padding: 0.2rem 0.1rem 0.3rem;
	}
	.leitner-page[data-view='session'] .lb-slot-num {
		font-size: 0.9rem;
	}
	.leitner-page[data-view='session'] .lb-slot-count {
		font-size: 0.72rem;
	}
	.leitner-page[data-view='session'] .lb-slot--intake .lb-slot-name {
		font-size: 0.78rem;
	}
	.leitner-page[data-view='session'] .lb-slot--intake .lb-slot-well {
		margin: 4px 4px 0;
	}
	.leitner-page[data-view='session'] .lb-slot.is-empty .lb-slot-well::after {
		content: none;
	}

	/* Section secondaire ------------------------------------------------- */
	.lb-secondary {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--lb-border);
	}
	.lb-fold {
		border-bottom: 1px solid var(--lb-border);
	}
	.lb-fold > summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.95rem 0.25rem;
		font-weight: 700;
		cursor: pointer;
		list-style: none;
	}
	.lb-fold > summary::-webkit-details-marker {
		display: none;
	}
	.lb-fold > summary::after {
		content: '+';
		font-size: 1.3rem;
		font-weight: 400;
		color: var(--lb-accent);
	}
	.lb-fold[open] > summary::after {
		content: '–';
	}
	.lb-fold-body {
		padding: 0.25rem 0.25rem 1.75rem;
	}

	.lb-stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.6rem;
		margin: 0 0 1.25rem;
	}
	.lb-stat {
		padding: 0.7rem 0.85rem;
		background: var(--lb-surface-alt);
		border-radius: 10px;
	}
	.lb-stat dt {
		font-size: 0.8rem;
		color: var(--lb-muted);
	}
	.lb-stat dd {
		margin: 0.1rem 0 0;
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--lb-heading);
		font-variant-numeric: tabular-nums;
	}
	.lb-progress-label {
		margin: 0 0 0.35rem;
	}
	.lb-dist-new-line {
		margin: 0 0 0.5rem;
		font-size: 0.9rem;
		color: var(--lb-muted);
	}
	.lb-dist-new-line strong {
		color: var(--lb-heading);
	}
	.lb-dist {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.5rem;
		align-items: end;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.lb-dist-col {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
	}
	.lb-dist-count {
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.lb-dist-track {
		display: flex;
		align-items: flex-end;
		width: 100%;
		max-width: 3rem;
		height: 6rem;
		background: var(--lb-surface-alt);
		border-radius: 6px 6px 3px 3px;
		overflow: hidden;
	}
	.lb-dist-fill {
		display: block;
		width: 100%;
		height: var(--value, 0%);
		background: var(--box-color);
		transition: height 0.3s ease;
	}
	.lb-dist-label {
		font-size: 0.76rem;
		color: var(--lb-muted);
	}
	.lb-box-1 { --box-color: var(--lb-box-1); }
	.lb-box-2 { --box-color: var(--lb-box-2); }
	.lb-box-3 { --box-color: var(--lb-box-3); }
	.lb-box-4 { --box-color: var(--lb-box-4); }
	.lb-box-5 { --box-color: var(--lb-box-5); }
	.lb-goal-text {
		margin: 0 0 0.4rem;
	}
	.lb-history {
		display: grid;
		grid-template-columns: repeat(14, minmax(0, 1fr));
		gap: 3px;
		align-items: end;
		height: 4rem;
		list-style: none;
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--lb-border-strong);
	}
	.lb-history li {
		display: flex;
		flex-direction: column-reverse;
		height: 100%;
	}
	.lb-history .lb-h-known {
		background: var(--lb-known);
		border-radius: 2px 2px 0 0;
	}
	.lb-history .lb-h-forgotten {
		background: var(--lb-again);
		opacity: 0.55;
		border-radius: 2px 2px 0 0;
	}
	.lb-history-legend {
		margin: 0.4rem 0 0;
		font-size: 0.78rem;
		color: var(--lb-muted);
	}
	.lb-key {
		display: inline-block;
		width: 0.7rem;
		height: 0.7rem;
		margin: 0 0.2rem 0 0.6rem;
		border-radius: 2px;
		vertical-align: -0.05rem;
	}
	.lb-key--known {
		margin-left: 0;
		background: var(--lb-known);
	}
	.lb-key--forgotten {
		background: var(--lb-again);
		opacity: 0.55;
	}
	.lb-attention-list {
		margin: 0.5rem 0 0;
		padding-left: 1.1rem;
	}
	.lb-attention-list li + li {
		margin-top: 0.3rem;
	}

	.lb-browse-filters {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
		align-items: end;
	}
	.lb-field--search {
		grid-column: 1 / -1;
	}
	.lb-browse-filters .lb-linklike {
		grid-column: 1 / -1;
		justify-self: start;
		font-size: 0.9rem;
	}
	.lb-browse-count {
		margin: 0.75rem 0 0.5rem;
		font-size: 0.9rem;
		color: var(--lb-muted);
	}
	.lb-empty {
		padding: 1rem;
		border: 1px dashed var(--lb-border-strong);
		border-radius: 10px;
		text-align: center;
	}
	.lb-browse-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.lb-browse-item {
		border-top: 1px solid var(--lb-border);
		scroll-margin-top: 1rem;
	}
	.lb-browse-item summary {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.75rem 0.25rem;
		cursor: pointer;
		list-style: none;
	}
	.lb-browse-item summary::-webkit-details-marker {
		display: none;
	}
	.lb-browse-meta {
		font-size: 0.78rem;
		color: var(--lb-muted);
	}
	.lb-browse-question {
		font-weight: 700;
	}
	.lb-browse-body {
		padding: 0 0.25rem 1rem;
	}
	.lb-skill {
		margin: 0 0 0.4rem;
		font-size: 0.8rem;
		color: var(--lb-muted);
	}
	.lb-browse-hint {
		margin: 0 0 0.5rem;
		font-size: 0.9rem;
	}
	.lb-browse-item[data-status='mastered'] [data-box-chip] {
		color: var(--lb-known);
		font-weight: 700;
	}
	.lb-browse-item.is-highlighted {
		outline: 3px solid var(--lb-accent);
		border-radius: 6px;
	}

	.lb-settings-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem 1.5rem;
	}
	.lb-reset {
		grid-column: 1 / -1;
	}
	.lb-reset .lb-help {
		margin: 0 0 0.6rem;
	}

	.lb-method p {
		margin: 0 0 0.75rem;
	}
	.lb-boxes-strip {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.4rem;
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
	}
	.lb-box-step {
		display: flex;
		flex-direction: column;
		padding: 0.55rem 0.6rem;
		border-top: 5px solid var(--box-color);
		background: var(--lb-surface-alt);
		border-radius: 6px;
		font-size: 0.8rem;
		line-height: 1.35;
	}
	.lb-box-step-name {
		font-weight: 700;
	}
