---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/editorial-map.css';
import {
	categoryLabels,
	categoryOrder,
	difficultyLabels,
	potBouilleLeitnerCards as cards,
	skillLabels,
} from '../data/pot-bouille-leitner';
import { BOX_INTERVAL_DAYS, BOXES } from '../lib/leitner/scheduler';
import { DAILY_GOAL_OPTIONS, DEFAULT_SETTINGS, NEW_PER_DAY_OPTIONS } from '../lib/leitner/storage';

const pageTitle = 'Réviser Pot-Bouille — boîte de Leitner';
const pageDescription =
	'Une boîte de Leitner pour comprendre, mémoriser et interpréter Pot-Bouille d’Émile Zola : 100 cartes de révision (œuvre, personnages, thèmes, écriture, interprétation, bac de français), avec répétition espacée.';

const boxPurpose: Record<number, string> = {
	1: 'Cartes nouvelles ou difficiles',
	2: 'Première consolidation',
	3: 'Renforcement',
	4: 'Mémoire à long terme',
	5: 'Entretien',
};
const intervalLabel = (days: number) =>
	days === 0 ? 'à chaque séance' : days === 1 ? 'après 1 jour' : `après ${days} jours`;
const countIn = (category: string) => cards.filter((c) => c.category === category).length;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />

		<main class="page-container leitner-page" id="leitner-app" data-total={cards.length}>
			<header class="lb-intro">
				<p class="intro-eyebrow">Émile Zola · <cite>Pot-Bouille</cite> (1882) · Boîte de Leitner</p>
				<h1>Réviser <cite>Pot-Bouille</cite></h1>
				<p class="lb-subtitle">
					<em>Une boîte de Leitner pour comprendre, mémoriser et interpréter le roman de Zola.</em>
				</p>
				<p class="lb-principle">
					<strong>Le principe :</strong> chaque carte voyage entre cinq boîtes. Si vous connaissiez la réponse, elle
					passe dans la boîte suivante et reviendra plus tard ; sinon, elle retourne dans la boîte 1 et revient
					dès la prochaine séance. Les cartes faciles s’espacent, les cartes difficiles reviennent souvent.
				</p>

				<ol class="lb-boxes-strip" aria-label="Les cinq boîtes et leur rythme de révision">
					{
						BOXES.map((box) => (
							<li class={`lb-box-step lb-box-${box}`}>
								<span class="lb-box-step-name">Boîte {box}</span>
								<span class="lb-box-step-interval">{intervalLabel(BOX_INTERVAL_DAYS[box])}</span>
								<span class="lb-box-step-purpose">{boxPurpose[box]}</span>
							</li>
						))
					}
				</ol>

				<aside class="lb-level-note" aria-label="Niveau et programme">
					<p>
						<strong>Pour qui ?</strong> Pour une élève ou un élève de seconde qui lit le roman et veut en garder
						une connaissance solide. Les cartes « Se préparer au bac » vont plus loin : en <strong>première</strong>,
						pour l’épreuve anticipée de français de la session 2027, <cite>Pot-Bouille</cite> est associé au
						parcours « Dévoiler les rouages de la société ». Ce n’est pas une exigence du programme de seconde,
						mais un entraînement anticipé.
					</p>
					<p class="lb-back-link">
						<a href="/pot-bouille">Revoir la carte des personnages et la coupe de l’immeuble de <cite>Pot-Bouille</cite></a>
					</p>
				</aside>
			</header>

			<noscript>
				<p class="lb-noscript">
					La révision et l’enregistrement de votre progression nécessitent JavaScript. Vous pouvez tout de même
					consulter toutes les cartes dans la section « Parcourir toutes les cartes », plus bas.
				</p>
			</noscript>

			<p class="lb-storage-warning" id="lb-storage-warning" role="status" hidden></p>

			<!-- ============================================================ -->
			<!-- Tableau de bord                                               -->
			<!-- ============================================================ -->
			<section class="lb-dashboard" aria-labelledby="lb-dashboard-title">
				<h2 id="lb-dashboard-title">Où en êtes-vous ?</h2>

				<dl class="lb-stats">
					<div class="lb-stat">
						<dt>Cartes au total</dt>
						<dd data-stat="total">{cards.length}</dd>
					</div>
					<div class="lb-stat lb-stat--due">
						<dt>À revoir aujourd’hui</dt>
						<dd data-stat="due">–</dd>
					</div>
					<div class="lb-stat">
						<dt>Nouvelles cartes</dt>
						<dd data-stat="new">–</dd>
					</div>
					<div class="lb-stat">
						<dt>Cartes maîtrisées</dt>
						<dd data-stat="mastered">–</dd>
						<p class="lb-stat-help">arrivées en boîte 5</p>
					</div>
				</dl>

				<div class="lb-progress-block">
					<p class="lb-progress-label" id="lb-progress-label">
						Progression globale : <strong data-stat="progress">–</strong>
					</p>
					<div
						class="lb-bar"
						role="progressbar"
						aria-labelledby="lb-progress-label"
						aria-valuemin="0"
						aria-valuemax="100"
						aria-valuenow="0"
						data-bar="progress"
					>
						<span class="lb-bar-fill"></span>
					</div>
					<p class="lb-help">
						Chemin parcouru par l’ensemble des cartes vers la boîte 5 : une carte nouvelle compte pour 0, une carte
						en boîte 5 pour 1. Regarder une carte ne la fait jamais progresser ; seul un rappel réussi compte.
					</p>
				</div>

				<div class="lb-dashboard-grid">
					<figure class="lb-panel lb-distribution">
						<figcaption><h3>Répartition dans les boîtes</h3></figcaption>
						<p class="lb-dist-new-line">
							<strong data-dist="new">–</strong> carte(s) pas encore découverte(s), hors des boîtes.
						</p>
						<ol class="lb-dist" aria-label="Nombre de cartes par boîte">
							{
								BOXES.map((box) => (
									<li class={`lb-dist-col lb-box-${box}`}>
										<span class="lb-dist-count" data-dist={box}>–</span>
										<span class="lb-dist-track"><span class="lb-dist-fill" /></span>
										<span class="lb-dist-label">Boîte {box}</span>
									</li>
								))
							}
						</ol>
					</figure>

					<div class="lb-panel lb-today">
						<h3>Aujourd’hui</h3>
						<p class="lb-goal-text" id="lb-goal-label" data-goal-text>
							Cartes évaluées aujourd’hui : – sur un objectif de {DEFAULT_SETTINGS.dailyGoal}
						</p>
						<div
							class="lb-bar lb-bar--goal"
							role="progressbar"
							aria-labelledby="lb-goal-label"
							aria-valuemin="0"
							aria-valuemax="100"
							aria-valuenow="0"
							data-bar="goal"
						>
							<span class="lb-bar-fill"></span>
						</div>
						<p class="lb-goal-message" data-goal-message>
							L’objectif est un repère, pas une obligation : mieux vaut un peu chaque jour que beaucoup une fois.
						</p>

						<h3 class="lb-history-title">Les 14 derniers jours</h3>
						<ol class="lb-history" data-history aria-label="Cartes évaluées chaque jour pendant les 14 derniers jours"></ol>
						<p class="lb-history-legend" aria-hidden="true">
							<span class="lb-key lb-key--known"></span> je savais
							<span class="lb-key lb-key--forgotten"></span> à revoir
						</p>
					</div>
				</div>

				<div class="lb-panel lb-attention" data-attention hidden>
					<h3>Cartes à surveiller</h3>
					<p class="lb-help">Ces cartes ont été oubliées récemment ou plusieurs fois. Relisez-les dans « Parcourir ».</p>
					<ul class="lb-attention-list" data-attention-list></ul>
				</div>
			</section>

			<!-- ============================================================ -->
			<!-- Modes d’étude                                                 -->
			<!-- ============================================================ -->
			<section class="lb-study" aria-labelledby="lb-study-title">
				<h2 id="lb-study-title">Travailler</h2>

				<div class="lb-tabs" role="tablist" aria-label="Modes d’étude" data-tablist>
					<button type="button" role="tab" id="tab-revision" aria-controls="panel-revision" aria-selected="true">
						<span class="lb-tab-name">Révision quotidienne</span>
						<span class="lb-tab-meta" data-tab-meta="revision">cartes du jour</span>
					</button>
					<button type="button" role="tab" id="tab-decouverte" aria-controls="panel-decouverte" aria-selected="false" tabindex="-1">
						<span class="lb-tab-name">Découverte</span>
						<span class="lb-tab-meta" data-tab-meta="decouverte">nouvelles cartes</span>
					</button>
					<button type="button" role="tab" id="tab-entrainement" aria-controls="panel-entrainement" aria-selected="false" tabindex="-1">
						<span class="lb-tab-name">Entraînement</span>
						<span class="lb-tab-meta">sans effet sur les boîtes</span>
					</button>
					<button type="button" role="tab" id="tab-parcourir" aria-controls="panel-parcourir" aria-selected="false" tabindex="-1">
						<span class="lb-tab-name">Parcourir</span>
						<span class="lb-tab-meta">toutes les cartes</span>
					</button>
				</div>

				<!-- Révision quotidienne -->
				<div class="lb-tabpanel" role="tabpanel" id="panel-revision" aria-labelledby="tab-revision" tabindex="0">
					<p class="lb-mode-intro">
						Les cartes dont la date de révision est arrivée. C’est le cœur de la méthode : ces révisions font
						avancer les cartes d’une boîte à l’autre.
					</p>
					<div data-mode-start="revision"></div>
				</div>

				<!-- Découverte -->
				<div class="lb-tabpanel" role="tabpanel" id="panel-decouverte" aria-labelledby="tab-decouverte" tabindex="0" hidden>
					<p class="lb-mode-intro">
						Les cartes que vous n’avez encore jamais vues, introduites quelques-unes à la fois, des plus simples
						aux plus exigeantes. Une carte découverte entre dans la boîte 1.
					</p>
					<div class="lb-field lb-field--inline">
						<label for="discover-category">Commencer par</label>
						<select id="discover-category">
							<option value="">toutes les catégories, en alternance</option>
							{categoryOrder.map((c) => <option value={c}>{categoryLabels[c]}</option>)}
						</select>
					</div>
					<div data-mode-start="decouverte"></div>
				</div>

				<!-- Entraînement -->
				<div class="lb-tabpanel" role="tabpanel" id="panel-entrainement" aria-labelledby="tab-entrainement" tabindex="0" hidden>
					<p class="lb-mode-intro">
						Choisissez librement vos questions, par exemple les questions d’interprétation avant un devoir.
						<strong>L’entraînement ne modifie pas vos boîtes</strong> : il ne remplace pas la révision quotidienne.
					</p>
					<form class="lb-practice-form" data-practice-form>
						<div class="lb-field">
							<label for="practice-category">Catégorie</label>
							<select id="practice-category" name="category">
								<option value="">Toutes</option>
								{categoryOrder.map((c) => <option value={c}>{categoryLabels[c]} ({countIn(c)})</option>)}
							</select>
						</div>
						<div class="lb-field">
							<label for="practice-difficulty">Difficulté</label>
							<select id="practice-difficulty" name="difficulty">
								<option value="">Toutes</option>
								{Object.entries(difficultyLabels).map(([v, l]) => <option value={v}>{l}</option>)}
							</select>
						</div>
						<div class="lb-field">
							<label for="practice-skill">Type de question</label>
							<select id="practice-skill" name="skill">
								<option value="">Toutes</option>
								{Object.entries(skillLabels).map(([v, l]) => <option value={v}>{l}</option>)}
							</select>
						</div>
						<div class="lb-field">
							<label for="practice-size">Nombre de cartes</label>
							<select id="practice-size" name="size">
								<option value="10">10</option>
								<option value="20">20</option>
								<option value="0">Toutes celles qui correspondent</option>
							</select>
						</div>
						<div class="lb-practice-actions">
							<p class="lb-help" data-practice-count aria-live="polite"></p>
							<button type="submit" class="lb-btn lb-btn--primary">Commencer l’entraînement</button>
							<button type="button" class="lb-btn lb-btn--ghost" data-practice-preset="interpretation">
								Questions d’interprétation (avancé)
							</button>
						</div>
					</form>
				</div>

				<!-- Parcourir -->
				<div class="lb-tabpanel" role="tabpanel" id="panel-parcourir" aria-labelledby="tab-parcourir" tabindex="0" hidden>
					<p class="lb-mode-intro">
						Consultez toutes les cartes, avec leur réponse. Parcourir les cartes <strong>ne modifie pas</strong>
						votre progression : seule une révision compte.
					</p>
					<form class="lb-browse-filters" data-browse-form>
						<div class="lb-field">
							<label for="browse-category">Catégorie</label>
							<select id="browse-category" name="category">
								<option value="">Toutes</option>
								{categoryOrder.map((c) => <option value={c}>{categoryLabels[c]}</option>)}
							</select>
						</div>
						<div class="lb-field">
							<label for="browse-difficulty">Difficulté</label>
							<select id="browse-difficulty" name="difficulty">
								<option value="">Toutes</option>
								{Object.entries(difficultyLabels).map(([v, l]) => <option value={v}>{l}</option>)}
							</select>
						</div>
						<div class="lb-field">
							<label for="browse-box">Boîte</label>
							<select id="browse-box" name="box">
								<option value="">Toutes</option>
								<option value="0">Pas encore découverte</option>
								{BOXES.map((b) => <option value={String(b)}>Boîte {b}</option>)}
							</select>
						</div>
						<div class="lb-field">
							<label for="browse-status">État</label>
							<select id="browse-status" name="status">
								<option value="">Tous</option>
								<option value="new">Nouvelles</option>
								<option value="learning">Revues, en cours</option>
								<option value="mastered">Maîtrisées</option>
							</select>
						</div>
						<div class="lb-field lb-field--search">
							<label for="browse-search">Rechercher</label>
							<input id="browse-search" name="search" type="search" placeholder="Berthe, ironie, dot…" autocomplete="off" />
						</div>
						<button type="reset" class="lb-btn lb-btn--ghost">Effacer les filtres</button>
					</form>
					<p class="lb-browse-count" data-browse-count role="status">{cards.length} cartes affichées</p>
					<p class="lb-empty" data-browse-empty hidden>
						Aucune carte ne correspond à ces filtres. Essayez d’en retirer un.
					</p>

					<ul class="lb-browse-list" data-browse-list>
						{
							cards.map((card) => (
								<li
									class="lb-browse-item"
									id={`carte-${card.id}`}
									data-card-id={card.id}
									data-category={card.category}
									data-difficulty={card.difficulty}
									data-box="0"
									data-status="new"
								>
									<details>
										<summary>
											<span class="lb-chips">
												<span class={`lb-chip lb-chip--cat lb-cat-${card.category}`}>{categoryLabels[card.category]}</span>
												<span class={`lb-chip lb-chip--diff lb-diff-${card.difficulty}`}>{difficultyLabels[card.difficulty]}</span>
												<span class="lb-chip lb-chip--box" data-box-chip>Nouvelle</span>
											</span>
											<span class="lb-browse-question">{card.question}</span>
										</summary>
										<div class="lb-browse-body">
											<p class="lb-skill">{skillLabels[card.skill]}</p>
											{card.hint && (
												<p class="lb-browse-hint">
													<strong>Indice :</strong> {card.hint}
												</p>
											)}
											<p class="lb-answer-text">{card.answer}</p>
											{card.explanation && <p class="lb-explanation">{card.explanation}</p>}
											{card.quotation && (
												<blockquote class="lb-quote">
													<p>« {card.quotation.text} »</p>
													<cite>
														{card.quotation.speaker}, ch. {card.quotation.chapter}
													</cite>
												</blockquote>
											)}
											{(card.focus || card.reference) && (
												<dl class="lb-meta">
													{card.focus && (
														<div>
															<dt>Personnages / thèmes</dt>
															<dd>{card.focus.join(' · ')}</dd>
														</div>
													)}
													{card.reference && (
														<div>
															<dt>Dans le roman</dt>
															<dd>{card.reference}</dd>
														</div>
													)}
												</dl>
											)}
										</div>
									</details>
								</li>
							))
						}
					</ul>
				</div>

				<!-- Séance en cours (révision, découverte ou entraînement) -->
				<div class="lb-session" data-session hidden>
					<div class="lb-session-bar">
						<p class="lb-session-title" data-session-title></p>
						<p class="lb-session-progress" data-session-progress></p>
						<button type="button" class="lb-btn lb-btn--ghost lb-btn--small" data-session-quit>Terminer la séance</button>
					</div>
					<div class="lb-bar lb-bar--thin" aria-hidden="true" data-bar="session"><span class="lb-bar-fill"></span></div>

					<article class="lb-card" data-study-card aria-labelledby="study-question">
						<header class="lb-card-head">
							<span class="lb-chips" data-study-chips></span>
						</header>
						<p class="lb-step">1. Lisez la question.</p>
						<h3 id="study-question" class="lb-card-question" tabindex="-1" data-study-question></h3>
						<details class="lb-hint" data-study-hint-wrap>
							<summary>Besoin d’un indice ?</summary>
							<p data-study-hint></p>
						</details>

						<div class="lb-attempt">
							<label for="study-attempt" class="lb-step">2. Cherchez la réponse de mémoire. <span class="lb-optional">Vous pouvez l’écrire ici (facultatif, rien n’est enregistré).</span></label>
							<textarea id="study-attempt" rows="3" data-study-attempt></textarea>
						</div>

						<div class="lb-reveal-row" data-reveal-row>
							<button type="button" class="lb-btn lb-btn--primary lb-btn--large" data-reveal>
								3. Afficher la réponse
							</button>
							<p class="lb-kbd-help">Raccourci : touche <kbd>Entrée</kbd> ou <kbd>Espace</kbd> sur le bouton.</p>
						</div>

						<section class="lb-answer" data-answer hidden aria-labelledby="study-answer-title">
							<h4 id="study-answer-title" tabindex="-1" data-answer-title>Réponse</h4>
							<p class="lb-answer-text" data-answer-text></p>
							<p class="lb-explanation" data-answer-explanation></p>
							<blockquote class="lb-quote" data-answer-quote>
								<p data-answer-quote-text></p>
								<cite data-answer-quote-cite></cite>
							</blockquote>
							<dl class="lb-meta" data-answer-meta></dl>

							<div class="lb-assess" role="group" aria-labelledby="lb-assess-title">
								<p class="lb-step" id="lb-assess-title">4. Évaluez honnêtement votre réponse.</p>
								<p class="lb-assess-hint" data-assess-hint></p>
								<div class="lb-assess-buttons">
									<button type="button" class="lb-btn lb-btn--again" data-assess="forgotten">
										<span class="lb-assess-label">À revoir</span>
										<span class="lb-assess-effect" data-assess-effect="forgotten"></span>
									</button>
									<button type="button" class="lb-btn lb-btn--known" data-assess="known">
										<span class="lb-assess-label">Je savais</span>
										<span class="lb-assess-effect" data-assess-effect="known"></span>
									</button>
								</div>
								<p class="lb-kbd-help">Raccourcis clavier : <kbd>R</kbd> à revoir · <kbd>S</kbd> je savais.</p>
							</div>
						</section>
					</article>

					<section class="lb-summary" data-summary hidden aria-labelledby="lb-summary-title">
						<h3 id="lb-summary-title" tabindex="-1">Séance terminée</h3>
						<p class="lb-summary-message" data-summary-message></p>
						<dl class="lb-summary-stats">
							<div class="lb-summary-stat lb-summary-stat--known">
								<dt>Je savais</dt>
								<dd data-summary-known>0</dd>
							</div>
							<div class="lb-summary-stat lb-summary-stat--forgotten">
								<dt>À revoir</dt>
								<dd data-summary-forgotten>0</dd>
							</div>
						</dl>
						<div data-summary-review-wrap hidden>
							<h4>À relire en priorité</h4>
							<ul class="lb-summary-list" data-summary-list></ul>
						</div>
						<p class="lb-help" data-summary-next></p>
						<div class="lb-summary-actions">
							<button type="button" class="lb-btn lb-btn--primary" data-summary-back>Retour aux modes d’étude</button>
						</div>
					</section>
				</div>

				<p class="sr-only" aria-live="polite" data-announcer></p>
			</section>

			<!-- ============================================================ -->
			<!-- Réglages, méthode, réinitialisation                          -->
			<!-- ============================================================ -->
			<section class="lb-settings" aria-labelledby="lb-settings-title">
				<h2 id="lb-settings-title">Réglages</h2>
				<div class="lb-settings-grid">
					<div class="lb-field">
						<label for="setting-goal">Objectif quotidien (cartes évaluées)</label>
						<select id="setting-goal" data-setting="dailyGoal">
							{DAILY_GOAL_OPTIONS.map((n) => <option value={n} selected={n === DEFAULT_SETTINGS.dailyGoal}>{n}</option>)}
						</select>
					</div>
					<div class="lb-field">
						<label for="setting-new">Nouvelles cartes par jour</label>
						<select id="setting-new" data-setting="newPerDay">
							{NEW_PER_DAY_OPTIONS.map((n) => <option value={n} selected={n === DEFAULT_SETTINGS.newPerDay}>{n}</option>)}
						</select>
					</div>
					<div class="lb-reset">
						<p class="lb-help">
							Votre progression est enregistrée dans ce navigateur, sur cet appareil uniquement. Aucun compte,
							aucune donnée envoyée.
						</p>
						<button type="button" class="lb-btn lb-btn--danger" data-reset-open>Effacer ma progression…</button>
					</div>
				</div>
			</section>

			<section class="lb-method" aria-labelledby="lb-method-title">
				<h2 id="lb-method-title">Pourquoi ça marche</h2>
				<div class="lb-method-grid">
					<div>
						<h3>Se tester plutôt que relire</h3>
						<p>
							Chercher une réponse dans sa mémoire, même sans la trouver, la renforce davantage qu’une simple
							relecture. C’est pourquoi la réponse reste cachée tant que vous n’avez pas essayé.
						</p>
					</div>
					<div>
						<h3>Espacer les révisions</h3>
						<p>
							On oublie vite ce qu’on vient d’apprendre. Revoir une notion juste au moment où elle commence à
							s’effacer la fixe plus durablement : c’est la répétition espacée. Les intervalles de 1, 3, 7 et
							14 jours suivent ce principe.
						</p>
					</div>
					<div>
						<h3>Connaître, puis comprendre</h3>
						<p>
							Certaines cartes demandent un fait (<em>Connaître un fait</em>), d’autres une explication
							(<em>Comprendre le sens</em>). Pour ces dernières, répondez « je savais » seulement si vous avez
							su expliquer, pas seulement citer.
						</p>
					</div>
				</div>
				<p class="lb-sources">
					<strong>Sources des citations :</strong> toutes les phrases de Zola citées sur les cartes ont été
					vérifiées mot pour mot sur le texte de l’édition G. Charpentier (1883), transcrit sur Wikisource. Quand
					aucune citation sûre n’était disponible, la carte décrit la scène sans la citer.
				</p>
			</section>

			<dialog class="lb-dialog" data-reset-dialog aria-labelledby="lb-reset-title" aria-describedby="lb-reset-desc">
				<form method="dialog">
					<h2 id="lb-reset-title">Effacer toute votre progression ?</h2>
					<p id="lb-reset-desc">
						Toutes les cartes retourneront à l’état « nouvelle » et votre historique sera supprimé. Cette action
