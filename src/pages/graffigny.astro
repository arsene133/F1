---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import GraffignyGeoMap from '../components/GraffignyGeoMap.astro';
import GraffignyJourney from '../components/GraffignyJourney.astro';
import GraffignyThemesMap from '../components/GraffignyThemesMap.astro';
import Header from '../components/Header.astro';
import RelationshipMap from '../components/RelationshipMap.astro';
import {
	crossLinkIndex,
	graffignyCharacters,
	graffignyEdgeTypes,
	graffignyIconography,
	graffignyRelationships,
	graffignySources,
	graffignyThemes,
	keyFacts,
	montesquieuComparison,
	narrativeSteps,
	peruKnowledgeNote,
	revisionQuestions,
	sevigneComparisonNote,
	ziliaEvolution,
} from '../data/graffigny';
import '../styles/graffigny.css';

const pageTitle = 'Françoise de Graffigny — Lettres d’une Péruvienne : cartographie interactive';
const pageDescription =
	'Carte interactive des Lettres d’une Péruvienne (1747, 1752) de Françoise de Graffigny pour le lycée : personnages et relations, parcours de Zilia lettre après lettre, thèmes et regard critique des Lumières.';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<noscript>
			<style>
				[data-step-detail],
				[data-theme-detail] {
					display: block !important;
				}
				[data-step-detail] + [data-step-detail],
				[data-theme-detail] + [data-theme-detail] {
					margin-top: 2rem;
				}
				.view-close,
				.selection-bar {
					display: none !important;
				}
			</style>
		</noscript>
	</head>
	<body>
		<Header />

		<main class="page-container graffigny-page">
			<article aria-labelledby="page-title">
				<header class="map-intro">
					<p class="intro-eyebrow">Les Lumières · 1747, édition augmentée en 1752 · Roman épistolaire</p>
					<h1 id="page-title">Françoise de Graffigny — <cite>Lettres d’une Péruvienne</cite></h1>
					<p class="intro-desc">
						<strong>Comment le regard d’une étrangère permet-il de découvrir, de questionner et de critiquer la société française du XVIII<sup>e</sup> siècle ?</strong>
					</p>
					<p class="intro-lead">
						Zilia, jeune Inca arrachée à son pays, raconte dans ses lettres sa captivité, son arrivée en France et sa découverte d’une société qu’elle ne comprend pas d’abord. Son amour pour Aza, son apprentissage de la langue et son regard sur les mœurs françaises la conduisent peu à peu à penser par elle-même.
						Œuvre étudiée dans le parcours <strong>« Un nouvel univers s’est offert à mes yeux »</strong>.
					</p>
				</header>

				<dl class="key-facts" aria-label="Repères essentiels">
					{keyFacts.map((f) => (
						<div>
							<dt>{f.label}</dt>
							<dd>{f.value}</dd>
						</div>
					))}
				</dl>

				<!-- Barre commune aux quatre vues : navigation, sélection en cours, réinitialisation -->
				<div class="selection-bar" data-selection-bar>
					<nav class="selection-nav" aria-label="Les quatre vues de la cartographie">
						<a href="#vue-geographie">Géographie du récit</a>
						<a href="#vue-personnages">Personnages</a>
						<a href="#vue-parcours">Parcours de Zilia</a>
						<a href="#vue-idees">Carte des idées</a>
					</nav>
					<p class="selection-status" aria-live="polite" data-selection-status>Rien n’est sélectionné : explorez librement.</p>
					<button type="button" class="selection-reset" data-global-reset disabled>Tout afficher</button>
				</div>

				<p class="how-to">
					<strong>Mode d’emploi.</strong> Les quatre vues sont reliées : choisir un personnage, une relation, une étape, un thème ou un lieu géographique met en évidence ce qui lui correspond dans les autres vues. « Tout afficher » rétablit la vue initiale ; Échap ferme la fiche ouverte.
				</p>

				<!-- ======================================================
				     VUE 1 : géographie du récit
				     ====================================================== -->
				<section class="carto-section" id="vue-geographie" aria-labelledby="vue-geographie-title">
					<header class="carto-header">
						<p class="carto-eyebrow">Vue 1 · Géographie du récit</p>
						<h2 id="vue-geographie-title">L’espace du roman : du Pérou des Incas à la France des Lumières</h2>
						<p class="carto-lead">
							Comprendre les déplacements de Zilia, l’arrachement au Nouveau Monde, la traversée transatlantique et la découverte de l’espace français. Distinguez les lieux attestés dans le texte, les repères historiques contextuels et les trajets narratifs indicatifs.
						</p>
					</header>

					<GraffignyGeoMap />
				</section>

				<!-- ======================================================
				     VUE 2 : personnages et relations
				     ====================================================== -->
				<section class="carto-section" id="vue-personnages" aria-labelledby="vue-personnages-title">
					<header class="carto-header">
						<p class="carto-eyebrow">Vue 2 · Carte des relations</p>
						<h2 id="vue-personnages-title">Les personnages et leurs liens</h2>
						<p class="carto-lead">
							Les flèches indiquent le sens d’une relation à sens unique : l’amour de Déterville pour Zilia, par exemple, n’est pas réciproque. Les filtres sous la carte masquent ou affichent chaque type de lien.
						</p>
					</header>

					<RelationshipMap
						id="graffigny"
						ariaLabel="Carte des relations entre les personnages des Lettres d’une Péruvienne"
						nodesLabel="Personnages des Lettres d’une Péruvienne"
						nodes={graffignyCharacters}
						relationships={graffignyRelationships}
						edgeTypes={graffignyEdgeTypes}
						layout={{ width: 900, height: 600 }}
						mobileLayout={{ width: 360, height: 920 }}
						hint="Choisissez un personnage pour afficher sa fiche, ou une étiquette pour comprendre une relation. Sur téléphone, les relations sont détaillées dans la fiche de chaque personnage."
						pointsLabel="Dans le roman :"
						relationsLabel="Ses relations :"
						resetLabel="Fermer la fiche"
						indexLabel="Toutes les relations, en texte"
						linksLabel="Dans les autres vues :"
						filters
						filtersResetLabel="Afficher toutes les relations"
					/>
				</section>

				<!-- ======================================================
				     VUE 3 : parcours narratif
				     ====================================================== -->
				<section class="carto-section" id="vue-parcours" aria-labelledby="vue-parcours-title">
					<header class="carto-header">
						<p class="carto-eyebrow">Vue 3 · Parcours narratif</p>
						<h2 id="vue-parcours-title">Le parcours de Zilia, de la captivité à l’indépendance</h2>
						<p class="carto-lead">
							Le roman n’est pas un journal régulier : il avance au rythme des lettres, écrites après coup, parfois après de longs silences. Les sept étapes ci-dessous regroupent ces lettres pour faire apparaître l’évolution de Zilia.
						</p>
					</header>

					<GraffignyJourney steps={narrativeSteps} characters={graffignyCharacters} themes={graffignyThemes} />
				</section>

				<!-- ======================================================
				     VUE 4 : carte des idées
				     ====================================================== -->
				<section class="carto-section" id="vue-idees" aria-labelledby="vue-idees-title">
					<header class="carto-header">
						<p class="carto-eyebrow">Vue 4 · Carte des idées</p>
						<h2 id="vue-idees-title">Ce que le regard de Zilia met en question</h2>
						<p class="carto-lead">
							Chaque axe part du même point : une étrangère qui observe la France sans en partager les habitudes. Choisissez un axe pour l’expliquer, le relier aux personnages et aux étapes du récit.
						</p>
					</header>

					<GraffignyThemesMap themes={graffignyThemes} steps={narrativeSteps} characters={graffignyCharacters} />
				</section>

				<!-- ======================================================
				     SYNTHÈSE, RÉVISION, RESSOURCES
				     ====================================================== -->
				<section class="carto-section" id="evolution-zilia" aria-labelledby="evolution-title">
					<header class="carto-header">
						<p class="carto-eyebrow">Synthèse</p>
						<h2 id="evolution-title">L’évolution de Zilia en bref</h2>
					</header>
					<ol class="evolution">
						{ziliaEvolution.map((e) => (
							<li>
								<strong>{e.from}</strong>
								<span aria-hidden="true">→</span>
								<span class="sr-only">devient</span>
								<strong>{e.to}</strong>
								<p>{e.text}</p>
							</li>
						))}
					</ol>
				</section>

				<!-- ======================================================
				     SECTION COMPARATIVE : MONTESQUIEU ET GRAFFIGNY
				     ====================================================== -->
				<section class="carto-section" id={montesquieuComparison.id} aria-labelledby="montesquieu-comparison-title">
					<header class="carto-header">
						<p class="carto-eyebrow">{montesquieuComparison.sectionEyebrow}</p>
						<h2 id="montesquieu-comparison-title">{montesquieuComparison.title}</h2>
						<p class="carto-lead">{montesquieuComparison.lead}</p>
					</header>

					<div class="comparison-article">
						<!-- A. Un procédé commun -->
						<div class="comparison-block">
							<h3>{montesquieuComparison.commonDevice.title}</h3>
							{montesquieuComparison.commonDevice.paragraphs.map((p) => (
								<p>{p}</p>
							))}
						</div>

						<!-- B. Tableau comparatif responsive -->
						<div class="comparison-block">
							<h3>Regards croisés : tableau comparatif</h3>
							<div class="comparison-table-wrapper">
								<table class="comparison-table">
									<thead>
										<tr>
											<th scope="col" class="col-aspect">Aspect</th>
											<th scope="col" class="col-montesquieu">Montesquieu — <cite>Lettres persanes</cite> (1721)</th>
											<th scope="col" class="col-graffigny">Graffigny — <cite>Lettres d’une Péruvienne</cite> (1747, 1752)</th>
										</tr>
									</thead>
									<tbody>
										{montesquieuComparison.tableRows.map((row) => (
											<tr>
												<th scope="row">{row.aspect}</th>
												<td data-label="Montesquieu (1721)">{row.montesquieu}</td>
												<td data-label="Graffigny (1747, 1752)">{row.graffigny}</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
							<p class="comparison-caveat">
								<strong>Rappel de nuance :</strong> {montesquieuComparison.tableCaveat}
							</p>
						</div>

						<!-- C. L'originalité de Graffigny -->
						<div class="comparison-block">
							<h3>{montesquieuComparison.singularity.title}</h3>
							{montesquieuComparison.singularity.paragraphs.map((p) => (
								<p>{p}</p>
							))}
							<ul class="singularity-list">
								{montesquieuComparison.singularity.points.map((pt) => (
									<li>{pt}</li>
								))}
							</ul>
							<p>{montesquieuComparison.singularity.conclusion}</p>
						</div>

						<!-- D. Encadré pédagogique : question de synthèse -->
						<div class="pedagogical-box synthesis-box">
							<div class="synthesis-box-header">
								<span class="synthesis-badge">Question de synthèse · Classe de seconde</span>
								<h3 class="synthesis-box-title">À vous d’analyser</h3>
							</div>
							<div class="synthesis-box-content">
								<p class="synthesis-prompt">
									<strong>« {montesquieuComparison.synthesisQuestion.question} »</strong>
								</p>
								<details class="synthesis-details">
									<summary>Pistes pour structurer votre réponse</summary>
									<ul>
										{montesquieuComparison.synthesisQuestion.hints.map((h) => (
											<li>{h}</li>
										))}
									</ul>
								</details>
							</div>
						</div>

						<!-- E. Note pédagogique repliée : Sévigné et Graffigny (de la correspondance au roman épistolaire) -->
						<details class="peru-knowledge-note sevigne-epistolary-note" id="note-sevigne-graffigny" aria-labelledby="sevigne-epistolary-title">
							<summary class="peru-knowledge-summary">
								<span class="peru-knowledge-badge">{sevigneComparisonNote.badge}</span>
								<h3 class="peru-knowledge-title" id="sevigne-epistolary-title">{sevigneComparisonNote.title}</h3>
								<span class="peru-knowledge-toggle" aria-hidden="true">
									<span class="toggle-more">Déplier ▾</span>
									<span class="toggle-less">Replier ▴</span>
								</span>
							</summary>
							<div class="peru-knowledge-content">
								<p class="peru-knowledge-intro">{sevigneComparisonNote.intro}</p>

								<div class="peru-knowledge-grid">
									<!-- Deux autrices, deux statuts de la lettre -->
									{sevigneComparisonNote.authors.map((author) => (
										<div class="peru-knowledge-item">
											<h4 class="peru-knowledge-item-title">{author.name}</h4>
											<p>{author.text}</p>
										</div>
									))}

									<!-- Ce qui les rapproche -->
									<div class="peru-knowledge-item">
										<h4 class="peru-knowledge-item-title">{sevigneComparisonNote.similarities.title}</h4>
										<ul class="epistolary-note-list">
											{sevigneComparisonNote.similarities.points.map((pt) => (
												<li>{pt}</li>
											))}
										</ul>
									</div>

									<!-- Ce qui les distingue -->
									<div class="peru-knowledge-item">
										<h4 class="peru-knowledge-item-title">{sevigneComparisonNote.differences.title}</h4>
										<ul class="epistolary-note-list">
											{sevigneComparisonNote.differences.points.map((pt) => (
												<li>
													<strong>{pt.label} :</strong> {pt.text}
												</li>
											))}
										</ul>
									</div>
								</div>

								<!-- Utilité de la comparaison -->
								<div class="epistolary-note-utility">
									<h4 class="peru-knowledge-item-title">{sevigneComparisonNote.utility.title}</h4>
									<p>{sevigneComparisonNote.utility.text}</p>
								</div>

								<!-- Question de lecture finale -->
								<div class="epistolary-note-question">
									<strong>{sevigneComparisonNote.readingQuestion.label} :</strong>
									<p>« {sevigneComparisonNote.readingQuestion.question} »</p>
								</div>
							</div>
						</details>
					</div>
				</section>

				<!-- ======================================================
				     SECTION ICONOGRAPHIQUE & ARCHIVES PATRIMONIALES
				     ====================================================== -->
				<section class="graffigny-iconography-section carto-section" id="sources-iconographiques" aria-labelledby="iconography-section-title">
					<header class="carto-header">
						<p class="carto-eyebrow">Parcours iconographique & Histoire matérielle</p>
						<h2 id="iconography-section-title">L’univers visuel et documentaire des <em>Lettres d’une Péruvienne</em></h2>
						<p class="carto-lead">
							Pour comprendre un roman épistolaire des Lumières, l’étude du texte gagne à être confrontée aux traces matérielles de son époque : l’édition princeps clandestine, le portrait de l’autrice en femme de lettres, les quipos incas conservés dans les musées et la vie intellectuelle des salons parisiens.
						</p>

						<div class="iconography-method-banner">
							<strong>Guide de lecture documentaire pour la classe de seconde :</strong>
							<span class="status-badge status-original">Édition originale (1747)</span> atteste la publication clandestine sans nom d’auteur ;
							<span class="status-badge status-auteur">Portrait d’autrice</span> documente la reconnaissance de Françoise de Graffigny ;
							<span class="status-badge status-perou">Mémoire inca</span> confronte la fiction aux réalités précolombiennes et andines ;
							<span class="status-badge status-societe">Histoire sociale</span> et
							<span class="status-badge status-lumieres">Débat des Lumières</span> éclairent la condition féminine et les cercles philosophiques.
						</div>

						<!-- Note repliée : Ce que Graffigny savait du Pérou -->
						<details class="peru-knowledge-note" id="note-sources-perou" aria-labelledby="peru-knowledge-title">
							<summary class="peru-knowledge-summary">
								<span class="peru-knowledge-badge">{peruKnowledgeNote.badge}</span>
								<h3 class="peru-knowledge-title" id="peru-knowledge-title">{peruKnowledgeNote.title}</h3>
								<span class="peru-knowledge-toggle" aria-hidden="true">
									<span class="toggle-more">Déplier ▾</span>
									<span class="toggle-less">Replier ▴</span>
								</span>
							</summary>
							<div class="peru-knowledge-content">
								<p class="peru-knowledge-intro">{peruKnowledgeNote.intro}</p>
								<div class="peru-knowledge-grid">
									{peruKnowledgeNote.sections.map((sec) => (
										<div class="peru-knowledge-item">
											<h4 class="peru-knowledge-item-title">{sec.title}</h4>
											<p>{sec.text}</p>
										</div>
									))}
								</div>
							</div>
						</details>
					</header>

					<div class="iconography-cards-grid">
						{graffignyIconography.map((doc, idx) => (
							<article class="iconography-card" id={doc.id}>
								<header class="iconography-card-header">
									<span class={`status-badge ${doc.badgeClass}`}>{doc.badge}</span>
									<h3 class="iconography-card-title">{idx + 1}. {doc.title}</h3>
								</header>

								<figure class="iconography-figure">
									<img
										src={doc.image.src}
										alt={doc.image.alt}
										class="iconography-img"
										loading="lazy"
										width={doc.image.width}
										height={doc.image.height}
									/>
									<figcaption class="iconography-caption">
										{doc.image.caption}
									</figcaption>
								</figure>

								<div class="iconography-meta-box">
									<ul class="iconography-meta-list">
										<li><strong>Titre du document :</strong> {doc.meta.title}</li>
										<li><strong>Auteur / Origine :</strong> {doc.meta.author}</li>
										<li><strong>Datation :</strong> {doc.meta.date}</li>
										<li><strong>Conservation :</strong> {doc.meta.institution}</li>
										<li>
											<strong>Référence / Cote :</strong>{' '}
											<a href={doc.meta.identifierUrl} target="_blank" rel="noopener noreferrer" class="meta-permalink">
												{doc.meta.identifier}
											</a>
										</li>
										<li><strong>Statut juridique :</strong> {doc.meta.license}</li>
									</ul>
								</div>

								<div class="iconography-evaluation-box">
									<h4>Évaluation documentaire & analyse littéraire</h4>
									<p>
										<strong>Que montre réellement le document ?</strong> {doc.analysis.whatItShows}
									</p>
									<p>
										<strong>Lien avec le texte de Graffigny :</strong> {doc.analysis.textualLink}
									</p>
									<p>
										<strong>Limite critique & mise en garde historique :</strong> {doc.analysis.criticalLimitation}
									</p>
								</div>

								<div class="iconography-question-box">
									<strong>Questions d’observation pour les élèves :</strong>
									<p>1. {doc.questions[0]}</p>
									<p>2. {doc.questions[1]}</p>
								</div>
							</article>
						))}
					</div>

					<div class="iconography-synthesis-box">
						<header class="iconography-synthesis-header">
							<span class="iconography-synthesis-badge">Bilan méthodologique · Seconde</span>
							<h3 class="iconography-synthesis-title">Comment exploiter ces images dans une analyse littéraire ?</h3>
						</header>
						<div class="iconography-synthesis-content">
							<p>
								Une image n’est jamais une simple illustration décorative : elle constitue un document historique doté d’une intention, d’un support matériel et d’un public visé. Pour enrichir votre commentaire ou votre oral de français :
							</p>
							<ol class="iconography-synthesis-steps">
								<li>
									<strong>Identifier le statut du document :</strong> s’agit-il d’un vestige archéologique (quipu), d’un imprimé d’époque (édition originale de 1747), ou d’une reconstitution artistique rétrospective (Lemonnier peignant 1755 en 1812) ?
								</li>
								<li>
									<strong>Confronter le document au texte :</strong> le texte de Graffigny confirme-t-il, idéalise-t-il ou conteste-t-il ce que montre l’image ? (Par exemple, la violence de la conquête espagnole vécue par Zilia contraste avec la dignité administrative du quipucamayoc de Guaman Poma).
								</li>
								<li>
									<strong>Dégager la portée critique :</strong> montrez comment Françoise de Graffigny utilise le regard de Zilia pour interroger ce qui semble naturel aux Français de son siècle (la marchandisation du mariage, l’éducation d’apparat des filles, la tyrannie des convenances).
								</li>
							</ol>
						</div>
					</div>
				</section>

				<section class="carto-section" id="revision" aria-labelledby="revision-title">
					<header class="carto-header">
						<p class="carto-eyebrow">Réviser</p>
						<h2 id="revision-title">Questions de révision</h2>
					</header>
					<ol class="revision">
						{revisionQuestions.map((q) => (
							<li>
								<details>
									<summary>{q.question}</summary>
									<p>{q.hint}</p>
								</details>
							</li>
						))}
					</ol>
				</section>

				<section class="carto-section" id="sources" aria-labelledby="sources-title">
					<header class="carto-header">
						<p class="carto-eyebrow">Sources</p>
						<h2 id="sources-title">Édition, références et prolongements</h2>
					</header>

					<div class="sources">
						<p class="sources-note">{graffignySources.editionNote}</p>
						<p class="sources-note">
							<strong>Comment lire cette page :</strong> les citations entre guillemets et les numéros de lettres viennent du texte ; les repères biographiques et historiques relèvent du contexte ; les rapprochements thématiques, les questions et la division en sept étapes sont des propositions pédagogiques.
						</p>

						<h3>Références</h3>
						<ul class="sources-list">
							{graffignySources.references.map((r) => (
								<li>
									<a href={r.url} rel="noopener" target="_blank">{r.title}</a>
									<span> — {r.note}</span>
								</li>
							))}
						</ul>

						<h3>Sur ce site</h3>
						<ul class="sources-list">
							{graffignySources.internal.map((r) => (
								<li>
									<a href={r.url}>{r.title}</a>
									<span> — {r.note}</span>
								</li>
							))}
						</ul>
					</div>
				</section>
			</article>
		</main>

		<Footer />

		<!-- Index des correspondances entre les vues (lu par le script de coordination) -->
		<script type="application/json" id="graffigny-index" set:html={JSON.stringify(crossLinkIndex)} />
	</body>
</html>

<script>
	// Coordination des quatre vues : une seule sélection pour toute la page.
	type Kind = 'node' | 'edge' | 'step' | 'theme' | 'place';
	type Selection = { kind: Kind; id: string } | null;
	interface Linked {
		characters: string[];
		relationships: string[];
		steps: string[];
		themes: string[];
		places: string[];
	}
	interface Index {
		names: Record<Kind, Record<string, string>>;
		nodes: Record<string, Linked>;
		edges: Record<string, Linked>;
		steps: Record<string, Linked>;
		themes: Record<string, Linked>;
		places: Record<string, Linked>;
	}

	const index = JSON.parse(document.getElementById('graffigny-index')!.textContent!) as Index;
	const mapEl = document.querySelector<HTMLElement>('[data-rel-map]')!;
	const journey = document.querySelector<HTMLElement>('[data-journey]')!;
	const ideas = document.querySelector<HTMLElement>('[data-ideas]')!;
	const geoApp = document.querySelector<HTMLElement>('[data-geo-app]');
	const stepButtons = [...journey.querySelectorAll<HTMLButtonElement>('[data-step-id]')];
	const themeButtons = [...ideas.querySelectorAll<HTMLButtonElement>('[data-theme-id]')];
	const spokes = [...ideas.querySelectorAll<SVGLineElement>('[data-spoke]')];
	const stepDetails = [...journey.querySelectorAll<HTMLElement>('[data-step-detail]')];
	const themeDetails = [...ideas.querySelectorAll<HTMLElement>('[data-theme-detail]')];
	const status = document.querySelector<HTMLElement>('[data-selection-status]')!;
	const globalReset = document.querySelector<HTMLButtonElement>('[data-global-reset]')!;
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const KIND_LABEL: Record<Kind, string> = {
		node: 'personnage',
		edge: 'relation',
		step: 'étape',
		theme: 'thème',
		place: 'lieu',
	};
	const INDEX_KEY = {
		node: 'nodes',
		edge: 'edges',
		step: 'steps',
		theme: 'themes',
		place: 'places',
	} as const;

	let current: Selection = null;

	const plural = (n: number, word: string) => `${n} ${word}${n > 1 ? 's' : ''}`;

	function render() {
		const linked: Linked | null = current ? index[INDEX_KEY[current.kind]][current.id] : null;

		// Parcours narratif
		journey.toggleAttribute('data-dimmed', !!current);
		for (const btn of stepButtons) {
			const id = btn.dataset.stepId!;
			btn.setAttribute('aria-pressed', String(current?.kind === 'step' && current.id === id));
			btn.classList.toggle('is-linked', !!linked?.steps.includes(id));
		}
		for (const el of stepDetails) el.hidden = !(current?.kind === 'step' && current.id === el.dataset.stepDetail);
		journey.querySelector<HTMLElement>('[data-journey-hint]')!.hidden = current?.kind === 'step';

		// Carte des idées
		ideas.toggleAttribute('data-dimmed', !!current);
		for (const btn of themeButtons) {
			const id = btn.dataset.themeId!;
			btn.setAttribute('aria-pressed', String(current?.kind === 'theme' && current.id === id));
			btn.classList.toggle('is-linked', !!linked?.themes.includes(id));
		}
		for (const line of spokes) {
			const id = line.dataset.spoke!;
			line.classList.toggle('is-linked', !!linked?.themes.includes(id) || (current?.kind === 'theme' && current.id === id));
		}
		for (const el of themeDetails) el.hidden = !(current?.kind === 'theme' && current.id === el.dataset.themeDetail);
		ideas.querySelector<HTMLElement>('[data-ideas-hint]')!.hidden = current?.kind === 'theme';

		// Barre de sélection
		globalReset.disabled = !current;
		if (!current || !linked) {
			status.textContent = 'Rien n’est sélectionné : explorez librement.';
		} else {
			const parts = [];
			if (current.kind !== 'step' && linked.steps.length > 0) parts.push(plural(linked.steps.length, 'étape'));
			if (current.kind !== 'theme' && linked.themes.length > 0) parts.push(plural(linked.themes.length, 'thème'));
			if (current.kind !== 'node' && linked.characters.length > 0) parts.push(plural(linked.characters.length, 'personnage'));
			if (current.kind !== 'place' && linked.places && linked.places.length > 0) parts.push(plural(linked.places.length, 'lieu'));
			status.replaceChildren(
				`Sélection (${KIND_LABEL[current.kind]}) : `,
				Object.assign(document.createElement('strong'), { textContent: index.names[current.kind][current.id] }),
				parts.length > 0 ? ` · ${parts.join(', ')} en lien` : '',
			);
		}
	}

	function setSelection(sel: Selection) {
		current = sel;
		const linked = sel ? index[INDEX_KEY[sel.kind]][sel.id] : null;

		// La carte des relations gère elle-même la sélection d'un personnage ou d'une relation ;
		// pour une étape, un thème ou un lieu, elle met en évidence les éléments liés.
		if (!sel || sel.kind === 'step' || sel.kind === 'theme' || sel.kind === 'place') {
			mapEl.dispatchEvent(
				new CustomEvent('relmap:highlight', {
					detail: linked ? { nodes: linked.characters, edges: linked.relationships } : null,
				}),
			);
		}

		// La carte géographique reçoit la notification de surbrillance
		if (geoApp) {
			geoApp.dispatchEvent(
				new CustomEvent('geomap:highlight', {
					detail: linked ? { places: linked.places } : null,
				}),
			);
		}

		render();
	}

	function reveal(el: HTMLElement | null, focusEl?: HTMLElement | null) {
		if (!el) return;
		const rect = el.getBoundingClientRect();
		const barBottom = document.querySelector('[data-selection-bar]')!.getBoundingClientRect().bottom;
		// Fait défiler seulement si le haut de la fiche est caché : sous l'écran (cas fréquent
		// sur téléphone), au-dessus, ou sous la barre collante.
		if (rect.top > window.innerHeight - 80 || rect.top < barBottom) {
			el.scrollIntoView({ block: 'start', behavior: reducedMotion ? 'auto' : 'smooth' });
		}
		focusEl?.focus({ preventScroll: true });
	}

	const panelOf = (kind: 'step' | 'theme', id: string) =>
		document.getElementById(`${kind === 'step' ? 'etape' : 'theme'}-${id}`);
	const titleOf = (kind: 'step' | 'theme', id: string) =>
		document.getElementById(`${kind === 'step' ? 'etape' : 'theme'}-${id}-title`);

	function openView(kind: 'step' | 'theme', id: string, fromElsewhere: boolean) {
		setSelection({ kind, id });
		const panel = kind === 'step' ? journey.querySelector<HTMLElement>('[data-journey-panel]') : ideas.querySelector<HTMLElement>('[data-ideas-panel]');
		// Depuis une autre vue : le focus suit vers la fiche ; sinon il reste sur le bouton.
		reveal(fromElsewhere ? panelOf(kind, id) : panel, fromElsewhere ? titleOf(kind, id) : null);
	}

	function toggleView(kind: 'step' | 'theme', id: string) {
		if (current?.kind === kind && current.id === id) setSelection(null);
		else openView(kind, id, false);
	}

	stepButtons.forEach((btn) => btn.addEventListener('click', () => toggleView('step', btn.dataset.stepId!)));
	themeButtons.forEach((btn) => btn.addEventListener('click', () => toggleView('theme', btn.dataset.themeId!)));

	// Navigation fléchée dans le parcours et dans la carte des idées.
	for (const group of [stepButtons, themeButtons]) {
		group.forEach((btn, i) =>
			btn.addEventListener('keydown', (e) => {
				const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
				if (!step) return;
				e.preventDefault();
				group[(i + step + group.length) % group.length].focus();
			}),
		);
	}

	// Fermeture d'une fiche d'étape ou de thème : le focus revient sur le bouton d'origine.
	document.querySelectorAll<HTMLButtonElement>('[data-view-close]').forEach((btn) =>
		btn.addEventListener('click', () => {
			const prev = current;
			setSelection(null);
			if (prev?.kind === 'step') stepButtons.find((b) => b.dataset.stepId === prev.id)?.focus();
			if (prev?.kind === 'theme') themeButtons.find((b) => b.dataset.themeId === prev.id)?.focus();
		}),
	);

	for (const root of [journey, ideas]) {
		root.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && current) {
				e.preventDefault();
				root.querySelector<HTMLButtonElement>('article:not([hidden]) [data-view-close]')?.click();
			}
		});
	}

	// Renvois depuis les fiches : vers un personnage, une étape, un thème, un lieu.
	document.addEventListener('click', (e) => {
		const target = e.target as Element;
		const nodeChip = target.closest<HTMLElement>('[data-goto-node]');
		const stepChip = target.closest<HTMLElement>('[data-goto-step]');
		const themeChip = target.closest<HTMLElement>('[data-goto-theme]');
		const placeChip = target.closest<HTMLElement>('[data-goto-place]');
		const anchor = target.closest<HTMLAnchorElement>('.rm-detail-links a[href^="#"]');

		if (nodeChip) {
			const id = nodeChip.dataset.gotoNode!;
			mapEl.dispatchEvent(new CustomEvent('relmap:select-request', { detail: { kind: 'node', id } }));
			const nodeBtn = mapEl.querySelector<HTMLElement>(`.rm-node[data-node-id="${id}"]`);
			const section = document.getElementById('vue-personnages')!;
			section.scrollIntoView({ block: 'start', behavior: reducedMotion ? 'auto' : 'smooth' });
			nodeBtn?.focus({ preventScroll: true });
		} else if (stepChip) {
			openView('step', stepChip.dataset.gotoStep!, true);
		} else if (themeChip) {
			openView('theme', themeChip.dataset.gotoTheme!, true);
		} else if (placeChip) {
			const id = placeChip.dataset.gotoPlace!;
			setSelection({ kind: 'place', id });
			geoApp?.dispatchEvent(new CustomEvent('geomap:select-request', { detail: { id } }));
			const section = document.getElementById('vue-geographie')!;
			section.scrollIntoView({ block: 'start', behavior: reducedMotion ? 'auto' : 'smooth' });
		} else if (anchor) {
			const [, kind, id] = anchor.getAttribute('href')!.match(/^#(etape|theme|lieu)-(.+)$/) ?? [];
			if (!kind) return;
			e.preventDefault();
			if (kind === 'lieu') {
				setSelection({ kind: 'place', id });
				geoApp?.dispatchEvent(new CustomEvent('geomap:select-request', { detail: { id } }));
				document.getElementById('vue-geographie')!.scrollIntoView({ block: 'start', behavior: reducedMotion ? 'auto' : 'smooth' });
			} else {
				openView(kind === 'etape' ? 'step' : 'theme', id, true);
			}
		}
	});

	// Sélection faite dans la carte des relations par l'utilisateur.
	mapEl.addEventListener('relmap:select', (e) => {
		const sel = (e as CustomEvent<{ kind: 'node' | 'edge'; id: string } | null>).detail;
		if (sel) {
			setSelection(sel);
			// Sur téléphone, la fiche est sous la carte : on l'amène à l'écran.
			if (window.matchMedia('(max-width: 640px)').matches) reveal(mapEl.querySelector<HTMLElement>('.rm-panel'));
		} else if (current?.kind === 'node' || current?.kind === 'edge') {
			setSelection(null);
		}
	});

	// Sélection faite dans la carte géographique par l'utilisateur.
	geoApp?.addEventListener('geomap:select', (e) => {
		const sel = (e as CustomEvent<{ kind: 'place'; id: string } | null>).detail;
		if (sel) {
			setSelection(sel);
			if (window.matchMedia('(max-width: 960px)').matches) {
				reveal(geoApp.querySelector<HTMLElement>('.geo-card-panel'));
			}
		} else if (current?.kind === 'place') {
			setSelection(null);
		}
	});

	globalReset.addEventListener('click', () => {
		setSelection(null);
		mapEl.dispatchEvent(new CustomEvent('relmap:reset'));
		document.getElementById('vue-personnages')!.scrollIntoView({ block: 'start', behavior: reducedMotion ? 'auto' : 'smooth' });
	});

	render();
</script>

