---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<ul>
				<li>
					<a href="/chronologie">
						Frise chronologique — XVIIe - XIXe siècle
					</a>
				</li>
				<li>
					<a href="/balzac-rimbaud">
						Balzac, Rastignac, la Commune, Marx et Rimbaud
					</a>
				</li>
				<li>
					<a href="/on-ne-badine-pas-avec-l-amour">
						On ne badine pas avec l’amour — les personnages
					</a>
				</li>
				<li>
					<a href="/pot-bouille">
						Pot-Bouille d’Émile Zola — les personnages et leurs intrigues
					</a>
				</li>
				<li>
					<a href="/don-juan">
						Dom Juan de Molière — les personnages et l’analyse thématique
					</a>
				</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
