		font-size: 0.93rem;
		line-height: 1.55;
		color: var(--map-ink-soft);
	}

	.counterfactual-points strong {
		color: var(--map-ink);
	}

	.counterfactual-conclusion {
		margin: 0;
		padding-top: 0.75rem;
		border-top: 1px dashed #dcd6cb;
		font-style: italic;
		font-size: 0.93rem;
		line-height: 1.55;
		color: #475569;
	}

	.history-note-intro {
		margin: 0 0 1.5rem;
		font-size: 0.96rem;
		line-height: 1.6;
		color: var(--map-ink-soft);
	}

	.history-milestones {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-bottom: 1.5rem;
	}

	.milestone-item {
		background: #fdfcf9;
		border: 1px solid #ece7de;
		border-radius: 6px;
		padding: 1rem 1.2rem;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

