		color: #5e6d7a;
	}

	.intimacy-caution strong {
		color: #172b3a;
	}

	.intimacy-section p.intimacy-reference,
	.intimacy-section p.intimacy-related {
		margin: 1rem 0 0;
		font-size: 0.85rem;
		color: var(--map-muted);
	}

	.intimacy-related a {
		color: var(--map-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* Encadrés d’approfondissement dépliables (details / summary) */
	.inhabitants-note,
	.counterfactual-note,
	.historical-context-note,
	.intimacy-note {
		margin: 1.75rem 0;
		background: #fbf9f4;
		border: 1px solid #e5dfd3;
		border-radius: 6px;
		box-shadow: 0 2px 8px rgba(23, 43, 58, 0.03);
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.inhabitants-note {
		background: #ffffff;
		border: 1px solid #dcd6cb;
		border-left: 4px solid var(--intro-eyebrow-color, #be185d);
	}

	.counterfactual-note {
		border-left: 4px solid #8b572a;
	}

	.historical-context-note,
	.intimacy-note {
		background: #ffffff;
		border: 1px solid #dcd6cb;
		border-left: 4px solid #274765;
	}

	.inhabitants-note[open],
	.counterfactual-note[open],
	.historical-context-note[open],
	.intimacy-note[open] {
		box-shadow: 0 4px 14px rgba(23, 43, 58, 0.06);
	}

	/* En-tête cliquable (summary) */
	.note-summary {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 0.85rem;
		padding: 1.15rem 1.4rem;
		cursor: pointer;
		user-select: none;
		list-style: none; /* Retrait de la flèche native */
	}

	.note-summary::-webkit-details-marker {
		display: none;
	}

	.note-summary:hover {
		background: rgba(23, 43, 58, 0.02);
	}

	.note-summary:focus-visible {
		outline: 2px solid var(--map-accent);
		outline-offset: 2px;
	}

	.note-summary-badge {
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.15rem 0.5rem;
		border-radius: 3px;
	}

	.badge-thought {
		background: rgba(139, 87, 42, 0.1);
		color: #8b572a;
		border: 1px solid rgba(139, 87, 42, 0.25);
	}

	.badge-history {
		background: rgba(39, 71, 101, 0.08);
		color: #274765;
		border: 1px solid rgba(39, 71, 101, 0.22);
	}

	.badge-inhabitants {
		background: rgba(190, 24, 93, 0.08);
		color: #be185d;
		border: 1px solid rgba(190, 24, 93, 0.22);
	}

	.note-summary-title {
		font-family: var(--map-serif);
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--map-ink);
		flex: 1 1 auto;
	}

	.note-summary-toggle {
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--map-muted);
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.inhabitants-note[open] .note-summary-toggle,
	.counterfactual-note[open] .note-summary-toggle,
	.historical-context-note[open] .note-summary-toggle,
	.intimacy-note[open] .note-summary-toggle {
		color: var(--map-ink);
	}

	/* Corps dépliable */
	.note-details-content {
		padding: 0 1.4rem 1.4rem;
		border-top: 1px solid rgba(0, 0, 0, 0.06);
		margin-top: 0.25rem;
		padding-top: 1.15rem;
	}

	.counterfactual-disclaimer {
		margin: 0 0 1rem;
		padding: 0.65rem 0.9rem;
		background: rgba(139, 87, 42, 0.05);
		border-left: 2px solid #8b572a;
		font-size: 0.88rem;
		line-height: 1.5;
		color: #5e6d7a;
		border-radius: 0 4px 4px 0;
	}

	.counterfactual-disclaimer strong {
		color: #172b3a;
	}

	.counterfactual-note p,
	.historical-context-note p {
		margin: 0 0 0.85rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--map-ink-soft);
	}

	.counterfactual-points {
		margin: 0.75rem 0 1.1rem;
		padding-left: 1.35rem;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

