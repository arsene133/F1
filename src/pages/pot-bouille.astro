---
import BaseHead from '../components/BaseHead.astro';
import BuildingCutaway from '../components/BuildingCutaway.astro';
import Footer from '../components/Footer.astro';
import GraphStructureCard from '../components/GraphStructureCard.astro';
import Header from '../components/Header.astro';
import RelationshipMap from '../components/RelationshipMap.astro';
import {
	potBouilleCharacters,
	potBouilleEdgeTypes,
	potBouilleFunctions,
	potBouilleMechanism,
	potBouilleRelationships,
} from '../data/pot-bouille';
import { adaptPotBouilleCorpus } from '../lib/graph/adapters/other-works';
import { analyzeNetworkStructure } from '../lib/graph/structure';

const potBouilleCorpus = adaptPotBouilleCorpus(potBouilleCharacters, potBouilleRelationships, potBouilleEdgeTypes);
const potBouilleStructureReport = analyzeNetworkStructure(potBouilleCorpus.nodes, potBouilleCorpus.edges);

const pageTitle = 'Pot-Bouille d’Émile Zola — les personnages et leurs intrigues';
const pageDescription =
	'Carte interactive des personnages de Pot-Bouille d’Émile Zola (1882) : Octave Mouret, Berthe Josserand, la famille Vabre et les secrets du 28, rue de Choiseul. Ambition, mariage d’intérêt et satire bourgeoise.';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />

		<main class="page-container pot-bouille-page">
			<article aria-labelledby="page-title">
				<header class="map-intro">
					<p class="intro-eyebrow">Émile Zola · 1882 · Les Rougon-Macquart (t. X)</p>
					<h1 id="page-title"><cite>Pot-Bouille</cite> — les personnages</h1>
					<p class="intro-desc">
						<strong>Relations, intrigues et secrets au 28, rue de Choiseul</strong>
					</p>
					<p class="intro-context">
						Dixième volume du cycle des <em>Rougon-Macquart</em> publié en 1882, <em>Pot-Bouille</em>
						dépeint l’arrivée à Paris du jeune Octave Mouret. Derrière la majestueuse façade de pierre
						de taille d’un immeuble bourgeois de la rue de Choiseul et ses portes d’acajou verni, Zola
						déchire le voile de la respectabilité : mariages mercantiles, dots fictives, adultères
						généralisés, déchirements d’héritage et coulisses ordurières où les domestiques colportent
						la vérité des maîtres.
					</p>
					<p class="intro-instructions">
						Sélectionnez un personnage ou une relation pour en afficher l’analyse détaillée ; les
						flèches du clavier parcourent les personnages, Échap réinitialise la vue.
					</p>

					<!-- Navigation rapide vers les sections clés -->
					<nav class="page-quicklinks" aria-label="Accès rapide aux sections">
						<a href="#coupe-immeuble" class="quicklink-item">
							<span class="quicklink-icon" aria-hidden="true">🏢</span>
							<span>Coupe architecturale</span>
						</a>
						<a href="#pot-bouille" class="quicklink-item">
							<span class="quicklink-icon" aria-hidden="true">👥</span>
							<span>Réseau des personnages</span>
						</a>
						<a href="#history-note-title" class="quicklink-item">
							<span class="quicklink-icon" aria-hidden="true">⏳</span>
							<span>Repères historiques</span>
						</a>
						<a href="#sources-iconographiques" class="quicklink-item">
							<span class="quicklink-icon" aria-hidden="true">🖼️</span>
							<span>Documents iconographiques</span>
						</a>
					</nav>
				</header>

				<ol class="mechanism" aria-label="Mécanisme du roman">
					{potBouilleMechanism.map((m) => (
						<li>
							<strong>{m.step}</strong>
							<span>{m.text}</span>
						</li>
					))}
				</ol>

				<!-- Section Bande dessinée satirique : Les Jeux olympiques de l’hypocrisie -->
				<section class="potbouille-comic-section" id="jeux-olympiques-hypocrisie" aria-labelledby="comic-heading">
					<header class="comic-header">
						<p class="comic-tag">Expérience graphique & Satire contemporaine</p>
						<h2 id="comic-heading" class="comic-heading">
							Les Jeux olympiques de l’hypocrisie
						</h2>
						<p class="comic-lead">
							Et si les personnages de Zola s’affrontaient dans une compétition sportive ? Une bande dessinée satirique sur l’ambition, les apparences et les secrets de l’immeuble.
						</p>
					</header>

					<div class="comic-presentation">
						<figure class="comic-figure">
							<img
								src="/images/pot-bouille/jeux-olympiques-hypocrisie.png"
								alt="Bande dessinée satirique « Les Jeux olympiques de l'hypocrisie » représentant les personnages de Pot-Bouille d'Émile Zola dans des épreuves sportives parodiques : sprint social d'Octave Mouret, gymnastique de Valérie Vabre, lancer de responsabilités d'Auguste, marathon des apparences de Berthe, épreuves de mariage des Josserand et course de fond des domestiques"
								class="comic-img"
								loading="lazy"
								width="1254"
								height="1254"
							/>
							<figcaption class="comic-caption">
								<strong>« Les Jeux olympiques de l’hypocrisie »</strong> — Bande dessinée satirique inspirée de <em>Pot-Bouille</em>. Cliquez sur l’image pour l’agrandir en plein écran.
							</figcaption>
						</figure>

						<div class="comic-commentary">
							<div class="comic-commentary-card">
								<h3 class="commentary-title">Le tournoi des faux-semblants</h3>
								<p>
									Dans cette transposition humoristique, les intrigues du 28, rue de Choiseul deviennent autant d’épreuves athlétiques taillées sur mesure :
								</p>
								<ul class="comic-events-list">
									<li><strong>Octave Mouret :</strong> le sprint social vers la réussite parisienne, franchissant les convenances sans faiblir.</li>
									<li><strong>Valérie Vabre :</strong> la gymnastique virtuose de l’hypocrisie, combinant dévotion de façade et liaisons clandestines.</li>
									<li><strong>Auguste Vabre :</strong> le lancer de responsabilités pour esquiver ses propres faillites intimes et commerciales.</li>
									<li><strong>Berthe Vabre :</strong> le marathon épuisant des apparences et de la dépense vestimentaire pour masquer l’absence de dot.</li>
									<li><strong>Les Josserand :</strong> les épreuves combinées du mariage avantageux et des ambitions familiales déçues.</li>
									<li><strong>Les domestiques :</strong> la course d’endurance au fond de la cour, spectateurs impitoyables des défaillances des maîtres.</li>
								</ul>
								<p class="comic-conclusion">
									<strong>Le relais des convenances :</strong> Le podium final et le classement social ne récompensent pas la vertu, mais l’art consommé de sembler respectable plutôt que de l’être.
								</p>
							</div>

							<div class="comic-note-disclaimer">
								<p>
									<strong>Expérience de pensée humoristique :</strong> Cette illustration est une libre création satirique inspirée du roman d’Émile Zola, et non la reproduction d’un épisode historique ou d’un document d’époque. Les dialogues et épreuves sportives constituent une métaphore ludique des intrigues bourgeoises.
								</p>
							</div>
						</div>
					</div>
				</section>

				<BuildingCutaway id="coupe-immeuble" />

				<RelationshipMap
					id="pot-bouille"
					ariaLabel="Carte des relations entre les personnages de Pot-Bouille"
					nodesLabel="Personnages de Pot-Bouille"
					nodes={potBouilleCharacters}
					relationships={potBouilleRelationships}
					edgeTypes={potBouilleEdgeTypes}
					layout={{ width: 900, height: 560 }}
					mobileLayout={{ width: 360, height: 750 }}
					anchor={{
						x: 450,
						y: 20,
						label: '28, rue de Choiseul',
						sub: 'Le théâtre des apparences bourgeoises',
					}}
					hint="Cliquez ou appuyez sur un habitant de l’immeuble pour explorer son rôle et ses relations, ou sur une étiquette pour analyser un lien."
					pointsLabel="Dans le roman :"
					relationsLabel="Relations :"
					indexLabel="Toutes les relations du roman, en texte"
				/>

				<GraphStructureCard report={potBouilleStructureReport} workTitle="Pot-Bouille" />

				<footer class="map-synthesis" aria-labelledby="synthesis-title">
					<details class="inhabitants-note" aria-labelledby="synthesis-title">
						<summary class="note-summary">
							<span class="note-summary-badge badge-inhabitants">Inventaire des personnages</span>
							<h2 class="note-summary-title" id="synthesis-title">Les habitants et acteurs du 28, rue de Choiseul</h2>
							<span class="note-summary-toggle" aria-hidden="true">Déplier ▾</span>
						</summary>
						<div class="note-details-content">
							<div class="synthesis-table-wrapper">
								<table class="synthesis-table">
									<thead>
										<tr>
											<th scope="col">Personnage</th>
											<th scope="col">Situation & foyer</th>
											<th scope="col">Rôle narratif & satire</th>
										</tr>
									</thead>
									<tbody>
										{potBouilleCharacters.map((c) => (
											<tr>
												<th scope="row">{c.label}</th>
												<td>{c.meta?.map((item) => (typeof item === 'string' ? item : item.text)).join(' · ')}</td>
												<td>{potBouilleFunctions[c.id]}</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						</div>
					</details>

					<section class="interpretation-section" aria-labelledby="interpretation-title">
						<h3 id="interpretation-title">La satire zolienne : la marmite des faux-semblants</h3>
						<p>
							Le titre du roman renvoie à la cuisine ordinaire du ménage — le pot-bouille —, mais
							surtout à la tambouille morale inavouable qui bouillonne à l’abri des regards. Tandis
							que les traités d’hygiène et l’architecture haussmannienne érigent l’immeuble moderne
							en modèle d’ordre et de propreté, Zola montre que la cour intérieure et les boyaux de
							service concentrent toutes les pourritures étouffées. L’ambition d’Octave Mouret — qui
							déploiera toute son ampleur commerciale dans <em>Au Bonheur des Dames</em> — trouve ici
							son apprentissage : la conquête de la ville s’opère d’abord par la séduction calculée
							des femmes de l’étage supérieur.
						</p>
					</section>

					<details class="counterfactual-note" aria-labelledby="counterfactual-title">
						<summary class="note-summary">
							<span class="note-summary-badge badge-thought">Expérience de pensée</span>
							<span class="note-summary-title" id="counterfactual-title">Et si l’immeuble avait eu un ascenseur ?</span>
							<span class="note-summary-toggle" aria-hidden="true">Déplier ▾</span>
						</summary>
						<div class="note-details-content">
							<p class="counterfactual-disclaimer">
								<strong>Remarque préalable :</strong> L’immeuble décrit par Zola ne possède aucun ascenseur. Les personnages montent et descendent uniquement par l’escalier d’honneur ou par l’escalier de service. Cette supposition permet simplement de mieux comprendre pourquoi l’escalier joue un rôle central dans l’intrigue.
							</p>
							<p>
								À la fin du XIX<sup>e</sup> siècle, quelques grands hôtels ou magasins parisiens commencent à installer des ascenseurs hydrauliques. Si l’immeuble du 28, rue de Choiseul en avait été équipé, cela aurait profondément changé la vie des résidents :
							</p>
							<ul class="counterfactual-points">
								<li>
									<strong>Les rencontres :</strong> Dans l’escalier, on monte pas à pas, on s’arrête, on salue un voisin sur le palier. Avec un ascenseur, les trajets auraient été plus rapides, mais auraient créé un face-à-face silencieux et gênant à deux dans une petite boîte fermée.
								</li>
								<li>
									<strong>Les classes sociales :</strong> L’ascenseur n’aurait pas effacé les inégalités. Il aurait été réservé aux riches locataires des premiers étages, tandis que les domestiques auraient continué à monter à pied par l’escalier de service.
								</li>
								<li>
									<strong>La surveillance et les secrets :</strong> Le concierge Gourd surveille tout le monde en regardant qui passe dans l’escalier. Avec une cabine fermée, il aurait dû chercher d’autres indices : guetter le bruit des câbles, surveiller les horaires ou attendre les gens devant la porte.
								</li>
								<li>
									<strong>L’ambition d’Octave :</strong> Monter sans effort dans une cabine dorée aurait été une image parlante pour résumer l’ascension sociale d’Octave Mouret, qui cherche à grimper rapidement dans la bourgeoisie parisienne.
								</li>
							</ul>
							<p class="counterfactual-conclusion">
								En résumé : l’escalier donne du temps aux rencontres et rend chaque déplacement visible ; l’ascenseur aurait tout accéléré en créant des huis clos brefs, sans rien changer aux barrières entre riches et pauvres.
							</p>
						</div>
					</details>

					<details class="historical-context-note" aria-labelledby="history-note-title">
						<summary class="note-summary">
							<span class="note-summary-badge badge-history">Repères historiques</span>
							<span class="note-summary-title" id="history-note-title">Sciences, techniques et vie quotidienne au XIX<sup>e</sup> siècle</span>
							<span class="note-summary-toggle" aria-hidden="true">Déplier ▾</span>
						</summary>
						<div class="note-details-content">
							<p class="history-note-intro">
								Pour bien comprendre le monde de <em>Pot-Bouille</em>, il faut distinguer trois repères dans le temps :
								<strong>1. L’époque de l’histoire</strong> (sous le Second Empire de Napoléon III, vers 1860) ;
								<strong>2. L’époque où Zola écrit son roman</strong> (en 1882, sous la Troisième République) ;
								<strong>3. L’apparition des inventions</strong> (certaines techniques existaient dans les expositions, mais n’étaient pas encore installées dans les appartements ordinaires).
							</p>

							<div class="history-milestones">
								<article class="milestone-item">
									<header class="milestone-header">
										<span class="milestone-date">1853–1870</span>
										<h4 class="milestone-title">Les transformations de Paris et l’essor de l’habitat bourgeois sous le Second Empire</h4>
										<span class="milestone-status status-widespread">Cadre urbain et architectural du roman</span>
									</header>
									<p class="milestone-desc">
										Sous le Second Empire, les grands travaux dirigés par le préfet Haussmann percent de larges artères rectilignes et généralisent des immeubles de rapport en pierre de taille aux façades alignées et réglementées. Mais dans les rues déjà tracées du centre parisien (comme la rue de Choiseul, ouverte à la fin du XVII<sup>e</sup> siècle), des immeubles bourgeois récents ou reconstruits adoptent ce nouveau standing sans pour autant résulter d'une percée haussmannienne directe.
									</p>
									<p class="milestone-linkage">
										<strong>Ce que cela éclaire dans le roman :</strong> L’immeuble fictif du n° 28 illustre cette architecture bourgeoise du Second Empire : façade imposante de pierre blanche, imitation du marbre, portes d’acajou et conciergerie solennelle créent une illusion de grandeur, masquant la promiscuité d'une parcelle resserrée sur cour et l'étroitesse des cuisines.
									</p>
								</article>

								<article class="milestone-item">
									<header class="milestone-header">
										<span class="milestone-date">1855–1865</span>
										<h4 class="milestone-title">L’éclairage au gaz et le chauffage central (calorifère)</h4>
										<span class="milestone-status status-emerging">Présent dans l’entrée et les étages nobles</span>
									</header>
									<p class="milestone-desc">
										Le gaz de ville se diffuse dans les rues et les entrées des beaux immeubles. Dans les sous-sols, de gros calorifères chauffent l’escalier principal avec de l’air chaud.
									</p>
									<p class="milestone-linkage">
										<strong>Ce que cela éclaire dans le roman :</strong> L’entrée brille avec une statue dorée portant trois becs de gaz et une douce chaleur. Mais ce confort s’arrête au troisième étage : le quatrième et les chambres sous le toit n’ont droit ni au tapis rouge, ni à la chaleur.
									</p>
								</article>

								<article class="milestone-item">
									<header class="milestone-header">
										<span class="milestone-date">1855–1878</span>
										<h4 class="milestone-title">L’eau courante et le réseau des égouts</h4>
										<span class="milestone-status status-gradual">En cours d’installation</span>
									</header>
									<p class="milestone-desc">
										L’ingénieur Eugène Belgrand modernise les égouts et apporte de l’eau potable dans la ville. L’eau arrive peu à peu dans les cuisines des immeubles récents.
									</p>
									<p class="milestone-linkage">
										<strong>Ce que cela éclaire dans le roman :</strong> Si l’eau propre entre dans les logements, les déchets et les mauvaises odeurs s’accumulent dans la petite cour intérieure et l’escalier de service, loin du regard des invités.
									</p>
								</article>

								<article class="milestone-item">
									<header class="milestone-header">
										<span class="milestone-date">1867–1878</span>
										<h4 class="milestone-title">L’ascenseur : une rareté réservée aux hôtels de luxe</h4>
										<span class="milestone-status status-rare">Absent des immeubles d’habitation</span>
									</header>
									<p class="milestone-desc">
										Des ascenseurs hydrauliques sont présentés lors des Expositions universelles de Paris et installés dans quelques palaces pour les voyageurs fortunés, mais pas dans les immeubles de quartier.
									</p>
									<p class="milestone-linkage">
										<strong>Ce que cela éclaire dans le roman :</strong> Les personnages doivent donc tous monter à pied. Cela explique la fatigue des visites, les bruits de pas surveillés par le concierge et l’importance de chaque rencontre sur le palier.
									</p>
								</article>

								<article class="milestone-item">
									<header class="milestone-header">
										<span class="milestone-date">1865–1880</span>
										<h4 class="milestone-title">La découverte des microbes par Louis Pasteur</h4>
										<span class="milestone-status status-intellectual">Découverte scientifique naissante</span>
									</header>
									<p class="milestone-desc">
										Louis Pasteur prouve que les maladies infectieuses sont causées par des micro-organismes invisibles. Mais sous Napoléon III, la plupart des gens croient encore que les maladies se transmettent simplement par les « mauvaises odeurs ».
									</p>
									<p class="milestone-linkage">
										<strong>Ce que cela éclaire dans le roman :</strong> Les bourgeois ont une peur panique des odeurs de cuisine (oignon, chou) qui trahissent la pauvreté. Zola, inspiré par la science de son époque, décrit le corps humain et les maladies avec un réalisme très précis.
									</p>
								</article>

								<article class="milestone-item">
									<header class="milestone-header">
										<span class="milestone-date">1878–1881</span>
										<h4 class="milestone-title">L’électricité et le téléphone : inventions postérieures au roman</h4>
										<span class="milestone-status status-later">N’existaient pas à l’époque de l’action</span>
									</header>
									<p class="milestone-desc">
										Les ampoules électriques et les premières lignes de téléphone apparaissent à Paris au début des années 1880, soit vingt ans après les événements racontés dans le livre.
									</p>
									<p class="milestone-linkage">
										<strong>Ce que cela éclaire dans le roman :</strong> Sans téléphone, les personnages doivent s’écrire des lettres portées à la main ou glisser des petits billets par les servantes. Cette lenteur favorise les rumeurs, les soupçons et le suspense.
									</p>
								</article>
							</div>

							<footer class="history-note-footer">
								<p>
									<strong>À retenir :</strong> Même si Paris se modernise avec de nouvelles techniques, la mentalité des bourgeois ne change pas pour autant. Les équipements modernes (tapis insonorisants, portes épaisses en acajou) servent surtout à cacher les disputes de famille et à préserver les apparences.
								</p>
							</footer>
						</div>
					</details>

					<!-- Mise en perspective historique : la nuit de noces et l’intimité conjugale (d’après Aïcha Limbada) -->
					<details class="intimacy-note" id="nuit-de-noces" aria-labelledby="intimacy-title">
						<summary class="note-summary">
							<span class="note-summary-badge badge-history">Mise en perspective historique</span>
							<h2 class="note-summary-title" id="intimacy-title">La nuit de noces : l’histoire intime derrière la satire de Zola</h2>
							<span class="note-summary-toggle" aria-hidden="true">Déplier ▾</span>
						</summary>
						<div class="note-details-content intimacy-section">
						<div class="history-note-footer intimacy-takeaway">
							<p>
								<strong>À retenir :</strong> l’histoire de l’intimité conjugale montre que la satire de Zola repose sur
								des normes bien réelles : l’ignorance imposée aux jeunes filles, le devoir conjugal et le poids de la dot.
								Le romancier dévoile ce que la respectabilité bourgeoise veut faire taire.
							</p>
						</div>
						<p>
							L’historienne Aïcha Limbada a consacré un livre à la nuit de noces en France, du XIX<sup>e</sup> au début
							du XX<sup>e</sup> siècle. Elle s’appuie en particulier sur des procès de couples qui demandaient la
							séparation ou l’annulation de leur mariage : ces archives font entendre la voix des époux eux-mêmes. Son
							enquête montre que la première nuit était vécue comme une épreuve, où la femme devait prouver sa virginité
							et l’homme sa virilité.
						</p>
						<p>
							Zola n’a évidemment pas pu lire ce livre, paru en 2023. Mais il aide à comprendre ce que les personnages de
							<em>Pot-Bouille</em> taisent, subissent ou dissimulent derrière les portes d’acajou.
						</p>
						<p class="intimacy-method">
							<strong>Comment lire cette section :</strong> chaque partie distingue le <strong>repère historique</strong>
							(ce qu’établissent les historiens), <strong>ce que montre le roman</strong> (épisodes vérifiés, avec leur
							chapitre) et, quand c’est utile, une <strong>précaution de lecture</strong> pour éviter de faire dire au
							texte plus qu’il ne dit.
						</p>

						<h3>1. L’éducation des jeunes filles et le marché matrimonial</h3>
						<p>
							<strong>Repère historique :</strong> dans la bourgeoisie, une jeune fille doit arriver vierge au mariage et,
							le plus souvent, ignorante de la sexualité. Limbada parle d’une ignorance <em>construite</em> : on transmet
							très peu de choses aux filles, et ce peu passe surtout par les mères. Pourtant, ces mêmes jeunes filles
							doivent trouver un mari, car le mariage décide de leur place dans la société.
						</p>
						<p class="milestone-linkage">
							<strong>Ce que montre le roman :</strong> chez les Vuillaume, l’ignorance est un programme éducatif. Mme
							Vuillaume recommande à sa fille Marie Pichon, à propos de sa petite-fille : « tâche qu’elle garde son
							ignorance » (ch. IV). Les Josserand, eux, préparent leurs filles à plaire : Berthe a connu « trois hivers
							de chasse à l’homme » dans les salons (ch. XVI), et sa mère va jusqu’à annoncer une dot de cinquante mille
							francs qu’elle sait ne pas pouvoir payer (ch. V). Hortense, l’aînée, a choisi l’avocat Verdier, qui vit
							pourtant avec une femme depuis quinze ans (ch. III).
						</p>
						<p>
							<strong>Interprétation :</strong> Zola met en scène une contradiction. On cache aux jeunes filles tout ce
							qui touche au corps et au désir, mais on leur apprend à séduire pour « se caser ».
						</p>

						<h3>2. La nuit de noces et les difficultés conjugales</h3>
						<p>
							<strong>Repère historique :</strong> aux yeux de l’Église, un mariage n’est pleinement accompli
							qu’une fois <em>consommé</em>, c’est-à-dire après le premier rapport sexuel des époux. Le <em>devoir
							conjugal</em> impose ensuite à chacun, et surtout à l’épouse, d’accepter les relations sexuelles.
							Limbada montre que cette norme laissait peu de place au consentement de la femme : l’expression
							« viol légal » apparaît d’ailleurs dans la littérature et la presse de l’époque. L’homme, lui, doit
							faire la preuve de sa virilité.
						</p>
						<p class="milestone-linkage">
							<strong>Ce que montre le roman :</strong> Zola ne raconte pas la nuit de noces de Berthe et d’Auguste. Berthe
							l’évoque seulement après le scandale, devant ses parents : « Dès le lendemain, il a eu l’air de croire que
							nous l’avions mis dedans […] comme les jours où il rate une vente » (ch. XVI). Elle parle du lendemain de ses
							noces avec le vocabulaire du commerce. Pour Théophile et Valérie Vabre, le lecteur dispose surtout de
							ragots : chez les Campardon, on chuchote que Théophile est « un impuissant » et que Valérie est « une femme
							hystérique » (ch. IV).
						</p>
						<p class="intimacy-caution">
							<strong>Précaution de lecture :</strong> le roman ne permet pas d’établir une maladie de Théophile ou de
							Valérie. Zola prend d’ailleurs ses distances avec ces commérages : repoussé par Valérie, Octave juge
							« inepte » le diagnostic de Campardon (ch. IV), et le docteur Juillerat se contente de constater que « le
							mariage ne réussissait pas à toutes les femmes » (ch. III). Ces mots médicaux montrent surtout comment les
							bourgeois parlent de l’intimité des autres.
						</p>

						<h3>3. L’intimité conjugale sous surveillance</h3>
						<p>
							<strong>Repère historique :</strong> au XIX<sup>e</sup> siècle, la famille bourgeoise affiche une vie
							privée protégée par l’appartement, les portes closes et les convenances. Mais les domestiques, qui
							entretiennent les chambres et le linge, sont les témoins les plus proches de cette intimité.
						</p>
						<p class="milestone-linkage">
							<strong>Ce que montre le roman :</strong> au chapitre XIII, Berthe quitte en cachette la chambre d’Octave
							par l’escalier de service. Arrêtés sur le palier, les deux amants entendent les bonnes commenter leur
							liaison depuis les cuisines qui donnent sur l’étroite cour intérieure. Zola conclut : « Ces filles savaient
							tout, sans que personne eût parlé. » La cour et l’escalier de service font circuler ce que l’escalier
							d’honneur dissimule. Au chapitre XII, Berthe accuse Auguste de payer sa bonne, Rachel, pour l’espionner ;
							au chapitre XIV, elle surprend son mari « parlant bas avec Rachel, derrière la porte de la cuisine », juste
							avant que le piège ne se referme.
						</p>
						<p class="intimacy-caution">
							<strong>Précaution de lecture :</strong> quand Berthe affirme que Rachel « peut bien regarder par le trou de
							la serrure » (ch. XII), c’est une accusation lancée pendant une dispute, et non une scène racontée par le
							narrateur. Dans le roman, les secrets se propagent surtout par la parole des domestiques, plus que par
							l’espionnage.
						</p>

						<h3>4. Le mariage, l’argent et la domination</h3>
						<p>
							<strong>Repère historique :</strong> dans la bourgeoisie, le mariage unit aussi deux familles et deux
							patrimoines. La <em>dot</em>, somme apportée par la famille de l’épouse, pèse lourd dans les négociations.
							Le Code civil de 1804 impose à la femme l’obéissance à son mari, et le divorce, supprimé en 1816, n’est
							rétabli qu’en 1884, deux ans après la parution du roman. Dès le XIX<sup>e</sup> siècle, des écrivains et
							des militantes dénoncent le mariage d’argent comme un marché.
						</p>
						<p class="milestone-linkage">
							<strong>Ce que montre le roman :</strong> Auguste épouse Berthe en comptant sur une dot qui ne sera jamais
							versée, et leurs disputes tournent sans cesse autour de l’argent. Au chapitre XVI, le narrateur résume
							l’histoire du mariage que Berthe raconte à ses parents : ce que les mères enseignent aux filles sans
							fortune, écrit-il, c’est « tout un cours de prostitution décente et permise ». Après le scandale, les époux
							reprennent la vie commune pour sauver les apparences (ch. XVII).
						</p>
						<p class="intimacy-caution">
							<strong>Précaution de lecture :</strong> la formule n’est pas une réplique de Berthe : c’est la voix du
							narrateur qui reformule ses propos. Elle ne vaut pas non plus pour tous les mariages du XIX<sup>e</sup>
							siècle. L’immeuble de Zola est une satire qui grossit les vices d’un milieu. Les archives judiciaires
							étudiées par Limbada viennent, elles aussi, de couples en crise : ni le roman ni ces procès ne décrivent
							le mariage « ordinaire ».
						</p>

						<p class="intimacy-reference">
							<strong>Référence :</strong> Aïcha Limbada, <cite>La Nuit de noces. Une histoire de l’intimité
							conjugale</cite>, Paris, La Découverte, 2023, 352 p.
						</p>
						<p class="intimacy-related">
							<strong>Pour comparer :</strong> les filles mariées pour leur dot dans
							<a href="/goriot"><cite>Le Père Goriot</cite> de Balzac</a> ; l’éducation au couvent de Camille dans
							<a href="/on-ne-badine-pas-avec-l-amour"><cite>On ne badine pas avec l’amour</cite> de Musset</a>.
						</p>
						</div>
					</details>

					<!-- Section iconographique patrimoniale : L’immeuble bourgeois vu par Zola -->
					<section class="potbouille-iconography-section" id="sources-iconographiques" aria-labelledby="iconography-section-title">
