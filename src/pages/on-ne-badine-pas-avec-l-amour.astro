---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RelationshipMap from '../components/RelationshipMap.astro';
import type { EdgeType, MapNode, MapRelationship } from '../components/relationship-map/types';

const pageTitle = "On ne badine pas avec l'amour — les personnages";
const pageDescription =
	"Carte interactive des personnages d’On ne badine pas avec l’amour de Musset : Perdican, Camille, Rosette et ceux qui les entourent. Amour, orgueil, jalousie et manipulation.";

// Personnages. Coordonnées : espace 900 × 500 (x, y) et 360 × 640 sur mobile (mx, my).
const characters: MapNode[] = [
	{
		id: 'perdican',
		label: 'Perdican',
		caption: '21 ans · fils du Baron',
		eyebrow: 'Aime Camille · se sert de Rosette',
		meta: ['21 ans', 'fils du Baron', 'cousin de Camille'],
		description:
			"Il revient au château de son père, reçu docteur à Paris. Il aime sa cousine Camille depuis l’enfance. Blessé par son refus, il fait la cour à Rosette sous les yeux de Camille pour la rendre jalouse : son orgueil transforme un amour sincère en jeu cruel.",
		points: [
			'Retrouve avec émotion les lieux et les gens de son enfance',
			'Refuse de s’avouer vaincu après le refus de Camille',
			'Promet le mariage à Rosette pour piquer Camille',
			'Défend l’amour malgré ses souffrances : « mais j’ai aimé »',
		],
		color: '#235284',
		tier: 'major',
		x: 270, y: 240, mx: 72, my: 165,
	},
	{
		id: 'camille',
		label: 'Camille',
		caption: '18 ans · nièce du Baron',
		eyebrow: 'Aime Perdican · se défend par l’orgueil',
		meta: ['18 ans', 'nièce du Baron', 'cousine de Perdican'],
		description:
			"Elle sort du couvent où elle a été élevée. Elle aime Perdican, mais les récits des religieuses déçues par l’amour l’ont rendue méfiante : elle refuse le mariage et annonce son retour au couvent. Par fierté, elle met Perdican à l’épreuve, jusqu’à faire de Rosette le témoin caché de leur affrontement.",
		points: [
			'Formée par le couvent à se défier de l’amour humain',
			'Repousse d’abord la main de Perdican',
			'Veut mesurer son pouvoir sur lui',
			'Cache Rosette pour qu’elle entende Perdican lui parler d’amour',
		],
		color: '#7a2f4f',
		tier: 'major',
		x: 630, y: 240, mx: 288, my: 165,
	},
	{
		id: 'rosette',
		label: 'Rosette',
		caption: 'sœur de lait de Camille',
		eyebrow: 'Aime sincèrement Perdican · victime du jeu',
		meta: ['jeune paysanne', 'sœur de lait de Camille'],
		description:
			"Jeune paysanne du village, sœur de lait de Camille. Elle croit sincèrement à la cour que lui fait Perdican et à sa promesse de mariage. Prise dans le duel d’orgueil des deux cousins, elle en est la victime : à la fin de la pièce, elle surprend leurs aveux et en meurt.",
		points: [
			'Sincère là où les deux cousins calculent',
			'Croit à la promesse de mariage de Perdican',
			'Découvre qu’elle a servi d’instrument',
			'Sa mort fait basculer la comédie dans le drame',
		],
		color: '#3f6b3a',
		tier: 'major',
		x: 450, y: 405, mx: 180, my: 315,
	},
	{
		id: 'baron',
		label: 'Le Baron',
		caption: 'père de Perdican · oncle de Camille',
		eyebrow: 'Veut marier Perdican et Camille',
		meta: ['seigneur du château', 'père de Perdican', 'oncle de Camille'],
		description:
			"Il a préparé de longue date le mariage de son fils et de sa nièce, et l’organise comme une affaire réglée. Il ne comprend rien aux refus des deux jeunes gens et s’indigne de voir son fils courtiser une paysanne. Figure comique d’une autorité dépassée par les sentiments qu’elle prétend ordonner.",
		color: '#8b572a',
		tier: 'standard',
		x: 450, y: 60, mx: 180, my: 40,
	},
	{
		id: 'dame-pluche',
		label: 'Dame Pluche',
		caption: 'gouvernante de Camille',
		eyebrow: 'Personnage comique · le monde du couvent',
		meta: ['gouvernante de Camille'],
		description:
			"Gouvernante dévote et revêche qui accompagne Camille au sortir du couvent. Elle incarne la morale du couvent, presse Camille de repartir et sert d’intermédiaire, notamment en portant une lettre de Camille adressée au couvent.",
		color: '#5b347b',
		tier: 'minor',
		x: 790, y: 105, mx: 282, my: 505,
	},
	{
		id: 'blazius',
		label: 'Maître Blazius',
		caption: 'gouverneur de Perdican',
		eyebrow: 'Personnage comique · ancienne génération',
		meta: ['ancien gouverneur (précepteur) de Perdican'],
		description:
			"Ancien gouverneur de Perdican, il ramène au château son élève reçu docteur et vante ses succès. Bon vivant porté sur le vin, il se dispute avec le curé Bridaine la faveur du Baron. Il appartient, avec Bridaine et Dame Pluche, au trio grotesque de la pièce.",
		color: '#6b5a3e',
		tier: 'minor',
		x: 110, y: 105, mx: 78, my: 505,
	},
	{
		id: 'bridaine',
		label: 'Maître Bridaine',
		caption: 'curé du village',
		eyebrow: 'Personnage comique · l’Église',
		meta: ['curé du village'],
		description:
			"Curé gourmand, il jalouse Blazius, que le Baron fait asseoir à sa droite à table, et dénonce son ivrognerie. Leur querelle de préséance est un contrepoint comique à l’intrigue principale.",
		color: '#4d5b66',
		tier: 'minor',
		x: 110, y: 405, mx: 78, my: 600,
	},
	{
		id: 'choeur',
		label: 'Le Chœur',
		caption: 'les paysans du village',
		eyebrow: 'Voix collective',
		meta: ['les paysans du village'],
		description:
			"À la manière du chœur antique, la voix collective des paysans commente l’action. Il raille l’arrivée de Blazius et de Dame Pluche et accueille Perdican, qu’il a connu enfant. Il représente le monde du village auquel appartient Rosette.",
		color: '#7a7366',
		tier: 'minor',
		x: 790, y: 405, mx: 180, my: 420,
	},
];

// Types de relations : le trait distingue ce qui fait avancer l’intrigue
// (amour, manipulation, projet de mariage) des liens familiaux, éducatifs et comiques.
const edgeTypes: Record<string, EdgeType> = {
	love: { legend: 'Amour contrarié', stroke: '#a2312b', activeStroke: '#8a1f1a', width: 3.5, activeWidth: 4.5 },
	manipulation: { legend: 'Séduction / manipulation', stroke: '#4a5a68', activeStroke: '#172b3a', width: 2, activeWidth: 2.75, dash: '7 5', arrow: 'end' },
	marriage: { legend: 'Projet de mariage', stroke: '#b07a3f', activeStroke: '#8b572a', width: 1.6, activeWidth: 2.4, dash: '2 4', arrow: 'end' },
	family: { legend: 'Lien familial', stroke: '#a39886', activeStroke: '#4a5a68', width: 1.6, activeWidth: 2.4 },
	education: { legend: 'Éducation', stroke: '#c4bbac', activeStroke: '#5e6d7a', width: 1.25, activeWidth: 2, arrow: 'end' },
	influence: { legend: 'Influence', stroke: '#c4bbac', activeStroke: '#5e6d7a', width: 1.25, activeWidth: 2, dash: '5 3', arrow: 'end' },
	rivalry: { legend: 'Rivalité comique', stroke: '#cfc6b6', activeStroke: '#7a7366', width: 1.25, activeWidth: 2, dash: '3 5' },
	friendship: { legend: 'Amitié', stroke: '#a39886', activeStroke: '#4a5a68', width: 1.6, activeWidth: 2.4, dash: '6 4' },
	'collective-observation': { legend: 'Regard collectif', stroke: '#cfc6b6', activeStroke: '#7a7366', width: 1.25, activeWidth: 2, dash: '1 4' },
};

const relationships: MapRelationship[] = [
	{
		source: 'perdican',
		target: 'camille',
		type: 'love',
		label: 's’aiment ↔ se repoussent',
		description:
			"Cousins élevés ensemble, ils s’aiment depuis l’enfance et le Baron veut les marier. Mais Camille refuse, et Perdican répond par l’orgueil. Chacun cache ou travestit ses sentiments : leur amour devient un affrontement verbal fait de défis, d’épreuves et de jalousie, qu’ils ne s’avouent qu’à la fin — trop tard.",
		labelDy: 52,
		mLabelDy: 48,
		mobileLabel: true,
	},
	{
		source: 'perdican',
		target: 'rosette',
		type: 'manipulation',
		label: 'séduit → manipule',
		description:
			"Après le refus de Camille, Perdican courtise Rosette sous les yeux de sa cousine et lui promet le mariage. Il n’est pas insensible à la tendresse sincère de la jeune fille, mais il se sert d’elle pour provoquer la jalousie de Camille. Rosette, elle, y croit.",
		labelDx: -58,
		labelDy: 0,
		mLabelT: 0.55,
		mLabelDx: -32,
		mLabelDy: 12,
		mobileLabel: true,
	},
	{
		source: 'camille',
		target: 'rosette',
		type: 'family',
		label: 'sœurs de lait',
		description:
			"Un lien d’enfance, non de sang, qui unit la jeune fille du château et la paysanne. Cette proximité fait de Rosette l’instrument idéal — et la victime — du jeu entre les deux cousins : Perdican la courtise pour atteindre Camille, et Camille la cache pour qu’elle entende Perdican.",
		labelDx: 48,
		labelDy: 0,
		mLabelT: 0.55,
		mLabelDx: 30,
		mLabelDy: 12,
		mobileLabel: true,
	},
	{
		source: 'baron',
		target: ['perdican', 'camille'],
		type: 'marriage',
		label: 'veut les marier',
		description:
			"Le Baron a projeté depuis longtemps l’union de son fils et de sa nièce. C’est son projet, pas le leur : il l’annonce et l’organise, puis s’étonne de le voir échouer, sans comprendre ce qui se joue entre eux.",
		labelT: 0.5,
		labelDy: 0,
		mLabelT: 0.5,
		mLabelDy: 0,
		mobileLabel: true,
	},
	{
		source: 'baron',
		target: 'perdican',
		type: 'family',
		label: 'père → fils',
		description: "Le Baron est le père de Perdican, qu’il accueille fièrement à son retour de Paris.",
		labelDx: -22,
	},
	{
		source: 'baron',
		target: 'camille',
		type: 'family',
		label: 'oncle → nièce',
		description: "Le Baron est l’oncle de Camille, qui revient au château au sortir du couvent.",
		labelDx: 26,
	},
	{
		source: 'baron',
		target: 'bridaine',
		type: 'friendship',
		label: 'amis',
		description:
			"Le Baron qualifie explicitement Maître Bridaine de son ami à l’acte I, scène 2 (« Maître Bridaine, vous êtes mon ami »). Curé de la paroisse, Bridaine est son confident et participe aux projets du Baron pour marier Perdican et Camille.",
		labelT: 0.8,
		labelDx: 0,
		labelDy: -8,
	},
	{
		source: 'dame-pluche',
		target: 'camille',
		type: 'influence',
		label: 'gouverne · influence',
		description:
			"Gouvernante de Camille, Dame Pluche porte la morale du couvent et l’encourage à se défier du monde et du mariage. Elle sert aussi d’intermédiaire, en portant sa lettre au couvent.",
		labelDx: 52,
		labelDy: 0,
	},
	{
		source: 'blazius',
		target: 'perdican',
		type: 'education',
		label: 'précepteur',
		description:
			"Ancien gouverneur de Perdican, Blazius l’a éduqué et revient avec lui. Lien d’éducation et de dépendance comique, sans influence réelle sur les choix amoureux de Perdican.",
		labelDx: 34,
		labelDy: -6,
	},
	{
		source: 'blazius',
		target: 'bridaine',
		type: 'rivalry',
		label: 'rivalité comique',
		description:
			"Le gouverneur et le curé se disputent la faveur du Baron et la meilleure place à sa table. Cette querelle grotesque fait contrepoint à l’intrigue principale, sans jamais l’influencer.",
		labelDy: 0,
	},
	{
		source: 'choeur',
		target: 'rosette',
		type: 'collective-observation',
		label: 'le village',
		description:
			"Le chœur est la voix du village auquel appartient Rosette. Il observe et commente l’action sans y prendre part — rappel de l’écart social qui sépare la paysanne du château.",
		labelDy: -10,
	},
];

const mechanism = [
	{ step: 'Amour', text: 'Perdican et Camille s’aiment depuis l’enfance.' },
	{ step: 'Orgueil', text: 'Camille refuse ; aucun des deux ne veut céder.' },
	{ step: 'Manipulation', text: 'Perdican courtise Rosette sous les yeux de Camille.' },
	{ step: 'Jalousie', text: 'Camille riposte et fait de Rosette un témoin caché.' },
	{ step: 'Catastrophe', text: 'Rosette surprend leurs aveux et en meurt.' },
];

const functions: Record<string, string> = {
	perdican: 'Moteur de l’intrigue',
	camille: 'Moteur de l’intrigue',
	rosette: 'Victime de l’intrigue',
	baron: 'Autorité · comique',
	'dame-pluche': 'Comique · couvent',
	blazius: 'Comique',
	bridaine: 'Comique',
	choeur: 'Commentaire',
};
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />

		<main class="page-container musset-page">
			<article aria-labelledby="page-title">
				<header class="map-intro">
					<p class="intro-eyebrow">Alfred de Musset · 1834 · Proverbe en trois actes</p>
					<h1 id="page-title"><cite>On ne badine pas avec l’amour</cite> — les personnages</h1>
					<p class="intro-desc"><strong>Amour, orgueil, jalousie et manipulation</strong></p>
					<p class="intro-instructions">
						Sélectionnez un personnage ou une relation pour en afficher l’analyse ; les flèches du clavier parcourent les personnages, Échap réinitialise.
					</p>
				</header>

				<ol class="mechanism" aria-label="Mécanisme de la pièce">
					{mechanism.map((m) => (
						<li>
							<strong>{m.step}</strong>
							<span>{m.text}</span>
						</li>
					))}
				</ol>

				<RelationshipMap
					id="musset"
					ariaLabel="Carte des relations entre les personnages d’On ne badine pas avec l’amour"
					nodesLabel="Personnages"
					nodes={characters}
					relationships={relationships}
					edgeTypes={edgeTypes}
					layout={{ width: 900, height: 470 }}
					mobileLayout={{ width: 360, height: 650 }}
					hint="Cliquez ou appuyez sur un personnage pour afficher son rôle et ses relations, ou sur une étiquette pour expliquer une relation."
					pointsLabel="Dans la pièce :"
					relationsLabel="Relations :"
					indexLabel="Toutes les relations, en texte"
				/>

				<footer class="map-synthesis" aria-labelledby="synthesis-title">
					<h2 id="synthesis-title">Qui fait avancer l’intrigue ?</h2>
					<div class="synthesis-table-wrapper">
						<table class="synthesis-table">
							<thead>
								<tr>
									<th scope="col">Personnage</th>
									<th scope="col">Statut</th>
									<th scope="col">Fonction</th>
								</tr>
							</thead>
							<tbody>
								{characters.map((c) => (
									<tr>
										<th scope="row">{c.label}</th>
										<td>{c.meta?.join(' · ')}</td>
										<td>{functions[c.id]}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>

					<div class="synthesis-axioms">
						<blockquote>
							« On est souvent trompé en amour, souvent blessé et souvent malheureux ; mais on aime […]. J’ai souffert souvent, je me suis trompé quelquefois, mais j’ai aimé. »
							<cite>Perdican, acte II, scène 5</cite>
						</blockquote>
						<blockquote>
							« Elle est morte. Adieu, Perdican ! »
							<cite>Camille, acte III, scène 8 — dernière réplique</cite>
						</blockquote>
					</div>

					<nav class="pedagogical-anchors-nav" aria-label="Sections pédagogiques pour le lycée">
						<span class="nav-label">Approfondissements bac & seconde :</span>
						<a href="#musset-shakespeare" class="nav-anchor">Musset et Shakespeare (comparaison)</a>
						<span class="nav-sep" aria-hidden="true">·</span>
						<a href="#trois-unites" class="nav-anchor">Les trois unités classiques (cours & révisions)</a>
					</nav>
				</footer>

				<section class="pedagogical-section" id="musset-shakespeare" aria-labelledby="shakespeare-section-title">
					<header class="pedagogical-header">
						<p class="pedagogical-eyebrow">Repères littéraires · Classe de seconde</p>
						<h2 id="shakespeare-section-title">Musset et Shakespeare : l’amour entre comédie et tragédie</h2>
					</header>

					<div class="pedagogical-block">
						<h3>1. Une parenté littéraire</h3>
						<p>
							Pour les dramaturges romantiques des années 1820-1830, le théâtre de William Shakespeare fait figure de référence majeure et d’antidote aux règles rigides du classicisme français. Alfred de Musset puise dans cette liberté dramatique une audace singulière : le refus de la séparation stricte des genres, le passage sans transition du rire aux larmes, ainsi qu’une exploration fiévreuse des contradictions du cœur humain.
						</p>
						<p>
							Comme chez Shakespeare, l’intrigue d’<cite>On ne badine pas avec l’amour</cite> s’intéresse aux ravages causés par les passions exacerbées et aux dérives funestes du sentiment amoureux. Cependant, il convient de ne pas affirmer qu’<cite>On ne badine pas avec l’amour</cite> est directement adapté ou inspiré de <cite>Roméo et Juliette</cite> : aucun document ni brouillon de Musset n’établit une réécriture directe. Il s’agit avant tout d’une <strong>parenté d’esprit et d’esthétique</strong> propre à l’émancipation romantique.
						</p>
					</div>

					<div class="pedagogical-block">
						<h3>2. Comparaison avec <em>Roméo et Juliette</em></h3>
						<p>
							Pour mettre en lumière la mécanique dramatique de chaque pièce dans une dissertation ou un commentaire comparé, ce tableau confronte les deux œuvres point par point :
						</p>

						<div class="comparison-table-wrapper">
							<table class="comparison-table">
								<thead>
									<tr>
										<th scope="col" class="col-axis">Axe de comparaison</th>
										<th scope="col" class="col-musset"><cite>On ne badine pas avec l’amour</cite> (Musset, 1834)</th>
										<th scope="col" class="col-shakespeare"><cite>Roméo et Juliette</cite> (Shakespeare, v. 1595)</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<th scope="row">Les obstacles à l’amour</th>
										<td>
											<strong>Obstacles intérieurs et psychologiques :</strong> l’orgueil blessé, la méfiance religieuse transmise par le couvent et les jeux de séduction manipulateurs érigés en défis.
										</td>
										<td>
											<strong>Obstacles extérieurs et sociaux :</strong> la rivalité ancestrale des deux familles (Montaigu et Capulet), la haine civile à Vérone et l’interdit paternel.
										</td>
									</tr>
									<tr>
										<th scope="row">La parole et les malentendus</th>
										<td>
											<strong>Les paroles comme armes tactiques :</strong> lettres interceptées, doubles sens cyniques et répliques destinées à piquer la jalousie de l’autre au détriment de la sincérité.
										</td>
										<td>
											<strong>Les accidents de transmission du message :</strong> une lettre capitale bloquée par la quarantaine (frère Jean), entraînant un désastreux malentendu sur la mort feinte de Juliette.
										</td>
									</tr>
									<tr>
										<th scope="row">Le mélange des registres</th>
										<td>
											<strong>Du proverbe comique au drame noir :</strong> les querelles de table grotesques entre Blazius et Bridaine contrastent violemment avec la détresse finale de Rosette et Camille.
										</td>
										<td>
											<strong>De la verve comique à la tragédie :</strong> les calembours truculents de Mercutio et les facéties de la Nourrice côtoient les duels à mort et le deuil déchirant.
										</td>
									</tr>
									<tr>
										<th scope="row">La responsabilité des personnages</th>
										<td>
											<strong>Responsabilité morale directe des amants :</strong> Perdican et Camille provoquent eux-mêmes la catastrophe en usant froidement d’un tiers innocent pour blesser l’autre.
										</td>
										<td>
											<strong>Engrenage collectif et destin :</strong> la vendetta familiale, le hasard tragique et la précipitation des jeunes gens s’entrecroisent dans la fatalité.
										</td>
									</tr>
									<tr>
										<th scope="row">Le dénouement</th>
										<td>
											<strong>Mort de la victime innocente :</strong> Rosette s’effondre foudroyée par la douleur en découvrant la vérité ; Perdican et Camille survivent, mais sont séparés à jamais par le remords (« Adieu, Perdican ! »).
										</td>
										<td>
											<strong>Double suicide des amants passionnés :</strong> Roméo puis Juliette s’ôtent la vie dans le tombeau, scellant dans leur sacrifice la réconciliation finale des deux familles ennemies.
										</td>
									</tr>
								</tbody>
							</table>
						</div>

						<p class="comparison-summary">
							<strong>Bilan de la comparaison :</strong> Si les deux œuvres mettent en scène l’extrême fragilité de l’amour de jeunesse face aux pièges du monde, la nature du conflit diverge profondément : Shakespeare oppose la pureté des amants à la violence aveugle de leur société, tandis que Musset ausculte le poison intime de l’amour-propre qui pousse deux êtres à détruire leur propre bonheur.
						</p>
					</div>

					<div class="pedagogical-box nuance-box">
						<div class="nuance-box-header">
							<span class="nuance-badge">Repère critique</span>
							<h3 class="nuance-title">Une influence à nuancer</h3>
						</div>
						<div class="nuance-box-content">
							<p>
								En dissertation de français, veillez à ne pas confondre une <strong>convergence esthétique</strong> avec une <strong>filiation directe prouvée</strong>. Certes, Shakespeare a galvanisé le romantisme français après les représentations parisiennes des troupes anglaises en 1827 et la préface de <em>Cromwell</em> de Victor Hugo. Musset lui-même admire le dramaturge élisabéthain, comme en témoigne la structure éclatée de <em>Lorenzaccio</em>.
							</p>
							<p>
								Néanmoins, aucune preuve philologique ni témoignage de Musset n’atteste qu’<cite>On ne badine pas avec l’amour</cite> a été conçu en pensant spécifiquement à <cite>Roméo et Juliette</cite>. La source biographique la plus directe du proverbe demeure la passion tourmentée que Musset venait de vivre avec George Sand (dont certaines lettres sont reprises presque mot pour mot dans la bouche de Perdican et de Camille), combinée à la tradition française du proverbe de salon issue du XVIII<sup>e</sup> siècle (Carmontelle). Rapprocher les deux pièces enrichit l’analyse de la dramaturgie romantique, mais sans affirmer un emprunt textuel non avéré.
							</p>
						</div>
					</div>

					<div class="pedagogical-box homework-box">
						<div class="homework-box-header">
							<span class="homework-badge">Méthode devoir</span>
							<h3 class="homework-title">Comment mobiliser ce parallèle dans un devoir de français ?</h3>
						</div>
						<div class="homework-box-content">
							<ul class="homework-list">
								<li>
									<strong>Sur le mélange des genres (comédie / tragédie) :</strong> citez la cohabitation des personnages grotesques (Bridaine, Blazius, dame Pluche) et du dénouement fatal comme un héritage direct de la liberté shakespearienne célébrée par les romantiques contre les trois unités classiques.
								</li>
								<li>
									<strong>Sur la fatalité et le destin amoureux :</strong> soulignez la différence philosophique entre le <em>fatum</em> shakespearien (des amants maudits par les étoiles et la haine des clans) et la fatalité psychologique chez Musset (des amants victimes de leur vanité et du mensonge).
								</li>
								<li>
									<strong>Sur la formule du proverbe :</strong> analysez comment la réplique célèbre de Perdican à l’acte II, scène 5 (« on est souvent trompé en amour […] mais on aime ») dialogue avec le lyrisme shakespearien tout en dressant un constat moderne et désabusé sur les blessures du couple.
								</li>
							</ul>
						</div>
					</div>
				</section>

				<section class="pedagogical-section" id="trois-unites" aria-labelledby="unites-section-title">
					<header class="pedagogical-header">
						<p class="pedagogical-eyebrow">Repères littéraires · Classe de seconde</p>
						<h2 id="unites-section-title">Les trois unités classiques : temps, lieu, action</h2>
					</header>

					<p class="pedagogical-intro-lead">
						Codifiée au XVII<sup>e</sup> siècle par les théoriciens du classicisme français (notamment Nicolas Boileau dans son <em>Art poétique</em>), la <strong>règle des trois unités</strong> répond à un impératif fondamental : la <em>vraisemblance</em>. Pour que le spectateur croie à ce qu'il voit et s'identifie aux tourments des personnages, la fiction théâtrale doit se rapprocher des conditions d'une expérience vécue.
					</p>

					<div class="units-grid">
						<article class="unit-card">
							<div class="unit-card-header">
								<span class="unit-tag">Règle classique n° 1</span>
								<h3 class="unit-name">Unité de temps</h3>
								<p class="unit-question">Quand se déroule l’histoire ?</p>
							</div>
							<div class="unit-card-body">
								<p>
									L’action dramatique est traditionnellement circonscrite à une durée proche d’une seule révolution de soleil, soit <strong>vingt-quatre heures au maximum</strong> (et idéalement au temps réel de la représentation).
								</p>
								<p>
									Il s'agit d'une <strong>convention dramatique</strong> propre au classicisme, et non d'une loi immuable de l’histoire du théâtre. En resserrant les événements dans une journée critique, l'auteur élimine les temps morts : l'urgence précipite les passions, accélère la crise et porte la tension tragique ou comique à son paroxysme.
								</p>
							</div>
						</article>

						<article class="unit-card">
							<div class="unit-card-header">
								<span class="unit-tag">Règle classique n° 2</span>
								<h3 class="unit-name">Unité de lieu</h3>
								<p class="unit-question">Où se déroule l’action ?</p>
							</div>
							<div class="unit-card-body">
								<p>
									L’action dramatique se déroule dans <strong>un décor unique</strong> ou un périmètre scénique très étroit (antichambre d’un palais, vestibule ou salon de maison).
								</p>
								<p>
									Cette contrainte est directement liée à la <strong>vraisemblance théâtrale</strong> et aux contraintes techniques de la scène au XVII<sup>e</sup> siècle. Faire voyager les personnages d'un pays à l'autre en quelques minutes brisait l'illusion dramatique aux yeux des classiques : un lieu unique permet au public de concentrer toute son attention sur la parole et le conflit intérieur.
								</p>
							</div>
						</article>

						<article class="unit-card">
							<div class="unit-card-header">
								<span class="unit-tag">Règle classique n° 3</span>
								<h3 class="unit-name">Unité d’action</h3>
								<p class="unit-question">Quelle est l’intrigue principale ?</p>
							</div>
							<div class="unit-card-body">
								<p>
									La pièce s’articule autour d’<strong>une intrigue principale unique et cohérente</strong>, du nœud dramatique initial jusqu’à son dénouement.
								</p>
								<p>
									Cette règle n’interdit pas les <em>intrigues secondaires</em>, mais impose qu’elles demeurent strictement subordonnées et indispensables au conflit central. Tous les épisodes périphériques doivent converger vers l’axe dramatique majeur, garantissant ainsi l'unité esthétique et la clarté intellectuelle de l'ensemble.
								</p>
							</div>
						</article>
					</div>

					<div class="mnemonic-banner" role="note" aria-label="Formule de mémorisation">
						<p class="mnemonic-title">Synthèse mnémotechnique à retenir :</p>
						<p class="mnemonic-formula">« Temps : <em>quand ?</em> · Lieu : <em>où ?</em> · Action : <em>quelle intrigue principale ?</em> »</p>
					</div>

					<div class="pedagogical-block musset-case-block">
						<h3>Et dans <em>On ne badine pas avec l’amour</em> ?</h3>
						<p>
							À l’instar de Victor Hugo dénonçant la « cage » des unités dans la célèbre préface de <em>Cromwell</em> (1827), les dramaturges romantiques revendiquent une plus grande liberté pour peindre la complexité du réel. Toutefois, l’examen précis du texte interdit de prétendre que Musset rejette indistinctement toutes les conventions classiques. Publiée en 1834 dans le recueil <em>Un spectacle dans un fauteuil</em> (puis créée sur scène à la Comédie-Française en 1861 seulement), la pièce adopte une démarche singulière : elle s’affranchit des contraintes matérielles du plateau sans abandonner la concentration dramatique.
						</p>

						<div class="textual-analysis-list">
							<div class="analysis-item">
								<h4>1. Le temps : une durée minimale de deux jours et une chronologie interne en partie indéterminée</h4>
								<p>
									<strong>Ce que le texte établit avec certitude :</strong> L'analyse scrupuleuse des répliques montre que l'action s'étend nécessairement sur plus de vingt-quatre heures :
								</p>
								<ul class="didascalie-locations">
									<li>
										<strong>Acte I (Jour 1) :</strong> Perdican et Camille arrivent au château le matin (I, 1) ; ils dînent à midi (I, 3) ; le soir venu, Camille refuse de se promener : <em>« Non, pas ce soir »</em> (I, 3).
									</li>
									<li>
										<strong>Acte II (Jour 2) :</strong> Au réveil, Perdican salue Camille : <em>« Déjà levée, cousine ? J’en suis toujours pour ce que je t’ai dit hier »</em> (II, 1) ; dame Pluche rappelle que le baron l’a traitée de pécore <em>« hier soir »</em> (II, 1) ; maître Bridaine se plaint du dîner de la veille et redoute celui d’<em>« aujourd’hui »</em> (II, 2) ; à midi, Camille et Perdican s'affrontent à la fontaine (II, 5).
									</li>
								</ul>
								<p>
									<strong>Ce qui demeure indéterminé à l'acte III :</strong> La reconstitution exacte de l'acte III ouvre deux hypothèses légitimes :
								</p>
								<ul class="didascalie-locations">
									<li>
										<em>Hypothèse 1 (l'acte III se déroule le Jour 2 après-midi) :</em> Camille lit le billet que Perdican vient de lui rédiger sous le coup de la colère (III, 2) : <em>« Perdican me demande de lui dire adieu […] près de la petite fontaine où je l’ai fait venir hier »</em> (III, 3). Si le mot <em>« hier »</em> est une ellipse ou renvoie à un décalage d'écriture, l'acte III pourrait enchaîner directement l'après-midi du deuxième jour, comme le suggère la réplique de Camille à Rosette : <em>« Ce matin à la fontaine, dans le petit bois »</em> (III, 6).
									</li>
									<li>
										<em>Hypothèse 2 (l'acte III s'étend sur un Jour 3) :</em> Dès la scène 1 de l'acte III, Perdican songe : <em>« cette conversation d’hier ne veut-elle pas me sortir de la tête ? En vérité, j’ai passé la nuit à radoter »</em>, ce qui atteste qu'une nuit entière s'est écoulée depuis le grand entretien de la fontaine (II, 5). Bridaine constate ensuite de nouveau : <em>« voilà midi. — Ils sont à table »</em> (III, 2). Dans ce cadre, la mention de Rosette (<em>« ce matin »</em>) désignerait la nouvelle promenade matinale avec Perdican.
									</li>
								</ul>
								<p>
									<strong>Bilan critique pour une copie :</strong> Les indications temporelles — notamment les mentions répétées de <em>« hier »</em>, <em>« ce soir »</em> et <em>« ce matin »</em> — prouvent de façon indéniable que la pièce s’étend sur <strong>au moins deux journées</strong> et probablement sur un troisième jour, sans que le texte ne cherche à fixer un calendrier d'horloger. L’essentiel est de retenir que Musset <strong>s’écarte de la règle classique des vingt-quatre heures</strong>, tout en maintenant une <strong>action resserrée et précipitée</strong>, exempte des longues ellipses temporelles du drame romantique historique.
								</p>
							</div>

							<div class="analysis-item">
								<h4>2. Le lieu : un éclatement réel des décors entre château et nature</h4>
								<p>
									<strong>Ce que les didascalies indiquent explicitement :</strong> Les trois actes mobilisent de multiples décors distincts, alternant entre espaces clos et paysages extérieurs :
								</p>
								<ul class="didascalie-locations">
									<li><strong>Espaces ouverts du village et de la nature :</strong> <em>« Une place devant le château »</em> (I, 1 ; I, 3), <em>« Une place »</em> (I, 4), <em>« Un jardin »</em> (II, 1), <em>« Un champ devant une petite maison »</em> (II, 3), <em>« Une fontaine dans un bois »</em> (II, 5 ; III, 3), <em>« Un chemin »</em> (III, 2).</li>
									<li><strong>Espaces domestiques du château :</strong> <em>« Le salon du baron »</em> (I, 2), <em>« Une salle »</em> (I, 5), <em>« La salle à manger »</em> (II, 2), <em>« Au château »</em> (II, 4), <em>« La chambre de Camille »</em> (III, 6).</li>
									<li><strong>Espace sacré :</strong> <em>« Un oratoire »</em> (III, 8), ultime lieu de détresse où meurt Rosette.</li>
								</ul>
								<p>
									<strong>Faits et nuances d'interprétation :</strong> Cette multiplicité d’espaces rompt indéniablement avec le décor unique de la tragédie classique. Doit-on l'attribuer uniquement au fait que la pièce a été publiée en 1834 dans <em>Un spectacle dans un fauteuil</em> (théâtre fait pour la lecture) ? Il faut être nuancé : si cette publication permettait à Musset d'ignorer les contraintes matérielles des changements de décors de son époque, cette variété spatiale répond surtout à une <strong>nécessité dramatique et poétique</strong>. Les salons clos figurent le carcan social et les comédies du monde ; la fontaine et la nature favorisent les épanchements sincères ou les pièges d'orgueil ; enfin, l'oratoire isole la mort dans une gravité spirituelle.
								</p>
							</div>

							<div class="analysis-item">
								<h4>3. L'action : une intrigue dominante enrichie de contrepoints comiques</h4>
								<p>
									<strong>L'intrigue principale :</strong> Le cœur de la pièce repose sur <strong>le conflit amoureux entre Perdican et Camille</strong>, paralysés par leur orgueil, la méfiance issue du couvent et le refus d'avouer leurs sentiments.
								</p>
								<p>
									<strong>Le rôle des personnages secondaires :</strong> Peut-on parler pour autant d'une unité d'action stricte ?
								</p>
								<ul class="didascalie-locations">
									<li>
										<strong>Rosette :</strong> Elle n'anime pas une action indépendante, mais devient l'instrument sacrificiel du duel de Camille et Perdican. Sa mort à l'acte III brise le jeu et transforme la comédie en tragédie.
									</li>
									<li>
										<strong>Le trio comique (Bridaine, Blazius, dame Pluche) :</strong> Leurs querelles d'ivrognes et de gloutons (qui aura la meilleure place à table ?) constituent de véritables scènes épisodiques grotesques. Cependant, ces épisodes restent reliés à l'axe central, car ils interceptent les lettres et colportent les rumeurs qui précipitent la rupture.
									</li>
								</ul>
								<p>
									<strong>Bilan critique :</strong> L’unité d’action n’est pas appliquée de façon rigide ou épurée comme chez Racine, mais elle n'est pas éclatée en plusieurs intrigues concurrentes. Musset maintient une <strong>forte cohérence d'ensemble</strong>, où chaque épisode secondaire sert de caisse de résonance comique ou tragique au duel des deux amants.
								</p>
							</div>
						</div>
					</div>

					<div class="pedagogical-block">
						<h3>Outil de révision : tableau comparatif des unités</h3>
						<p>
							Ce tableau synthétise les règles classiques et leur traitement réel chez Musset pour préparer vos rédactions et vos oraux :
						</p>

						<div class="comparison-table-wrapper">
							<table class="comparison-table units-summary-table">
								<thead>
									<tr>
										<th scope="col" class="col-unit">Unité</th>
										<th scope="col" class="col-motive">Question à retenir</th>
										<th scope="col" class="col-classic">Principe classique (XVII<sup>e</sup> s.)</th>
										<th scope="col" class="col-musset-app">Traitement chez Musset (1834)</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<th scope="row">Unité de temps</th>
										<td><em>« Quand ? »</em></td>
										<td>Une durée maximale de 24 heures pour resserrer la crise et respecter la vraisemblance.</td>
										<td>
											<strong>Assouplissement mesuré :</strong> l’action s’étend sur au moins deux journées (repères textuels « hier », « ce matin », nuit passée à l'acte III, repas successifs), mais conserve une action dramatique resserrée et continue, sans grandes ellipses temporelles.
										</td>
									</tr>
									<tr>
										<th scope="row">Unité de lieu</th>
										<td><em>« Où ? »</em></td>
										<td>Un décor unique (palais, antichambre) adapté à la fixité de la scène classique.</td>
										<td>
											<strong>Éclatement assumé :</strong> alternance fréquente entre les pièces du château (salon, chambre, salle à manger), les extérieurs villageois ou champêtres (place, bois, fontaine) et un oratoire final.
										</td>
									</tr>
									<tr>
										<th scope="row">Unité d’action</th>
										<td><em>« Quelle intrigue principale ? »</em></td>
										<td>Une intrigue maîtresse unique ; les intrigues secondaires doivent lui être strictement subordonnées.</td>
										<td>
											<strong>Convergence vers le duel central :</strong> l'intrigue est dominée par l'affrontement d'amour-propre entre Camille et Perdican ; les bouffonneries des secondaires et le sort tragique de Rosette s'y rattachent directement.
										</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>

					<div class="pedagogical-box quiz-box">
						<div class="quiz-box-header">
							<span class="quiz-badge">Auto-évaluation</span>
							<h3 class="quiz-title">Questions de révision · Testez vos connaissances</h3>
						</div>
						<div class="quiz-box-content">
							<p class="quiz-lead-text">
								Cliquez sur chaque question pour afficher ou masquer la réponse détaillée rédigée pour une copie de seconde :
							</p>

							<div class="quiz-items">
								<details class="quiz-item">
									<summary class="quiz-question">
										<span class="quiz-q-num">1</span>
										<span class="quiz-q-text">Quelle unité répond à la question « où ? »</span>
										<span class="quiz-q-toggle" aria-hidden="true">Afficher la réponse ▾</span>
									</summary>
									<div class="quiz-answer">
										<p>
											Il s’agit de <strong>l’unité de lieu</strong>. Au théâtre classique, elle recommande de situer tous les actes dans un décor unique ou un espace contigu très étroit afin de respecter la <em>vraisemblance</em> scénique et d'éviter que le spectateur n'ait à imaginer des déplacements géographiques irréalistes en cours de pièce.
										</p>
									</div>
								</details>

								<details class="quiz-item">
									<summary class="quiz-question">
										<span class="quiz-q-num">2</span>
										<span class="quiz-q-text">Pourquoi l’unité d’action n’interdit-elle pas tous les personnages secondaires ?</span>
										<span class="quiz-q-toggle" aria-hidden="true">Afficher la réponse ▾</span>
									</summary>
									<div class="quiz-answer">
										<p>
											Parce que l’unité d’action exige la <strong>cohérence de l’ensemble</strong> et non l'absence de personnages secondaires. Ceux-ci et leurs intrigues épisodiques sont admis dès lors qu'ils restent <em>subordonnés à l’intrigue principale</em> et concourent à faire avancer le nœud ou le dénouement de la pièce.
										</p>
										<p>
											Dans la pièce de Musset, les querelles comiques entre Blazius et Bridaine ne forment pas une histoire indépendante : elles s'intègrent au projet de mariage du Baron, tandis que l'interception de la lettre par dame Pluche et Blazius fournit à Perdican l'arme qui relance le conflit avec Camille.
										</p>
									</div>
								</details>

								<details class="quiz-item">
									<summary class="quiz-question">
										<span class="quiz-q-num">3</span>
										<span class="quiz-q-text">Pourquoi faut-il examiner le texte avant d’affirmer que Musset ne respecte pas une unité ?</span>
										<span class="quiz-q-toggle" aria-hidden="true">Afficher la réponse ▾</span>
									</summary>
									<div class="quiz-answer">
										<p>
											Pour ne pas plaquer de jugements hâtifs sur le théâtre romantique et mesurer avec précision le degré de liberté de l'auteur :
										</p>
										<ul>
											<li><strong>Sur le temps :</strong> si le texte dépasse les 24 heures (il s'étend sur au moins deux journées et probablement trois, comme l'attestent les mentions de « hier », « ce soir » et la nuit mentionnée à l'acte III), la pièce ne s'étale pas sur des mois et préserve une grande concentration de la crise.</li>
											<li><strong>Sur le lieu :</strong> l'analyse des didascalies révèle une réelle dispersion entre décors intérieurs et extérieurs, qui dépasse le modèle classique.</li>
											<li><strong>Sur l'action :</strong> loin de multiplier les intrigues concurrentes, Musset concentre l'essentiel de la tension sur le duel entre Perdican et Camille.</li>
										</ul>
										<p>
											L’étude littéraire doit donc toujours s'appuyer sur des <em>faits textuels vérifiés</em> avant de conclure.
										</p>
									</div>
								</details>
							</div>
						</div>
					</div>
				</section>
			</article>
