---
// Composant Carte narrative schématique : Les déplacements et espaces du Conte du Graal
// Conçu spécialement pour des élèves de 5e (12–13 ans) :
// 1. Distinction catégorielle (Lieux réels arthuriennes / Lieux fictionnels / Espaces sauvages / Continuations)
// 2. Trajet narratif et symbolique sans coordonnées modernes trompeuses
// 3. Navigation étape par étape, sélection interactive, alternative textuelle complète et responsive
import {
	PERCEVAL_SPATIAL_CATEGORIES,
	percevalSpatialStages,
	type PercevalSpatialCategory,
	type PercevalSpatialStage,
} from '../data/perceval-geography';

const initialStage = percevalSpatialStages[0];
const categoriesList = Object.entries(PERCEVAL_SPATIAL_CATEGORIES);
---

<div class="perceval-geo-app" id="perceval-geo-app" data-geo-app>
	<!-- Données sérialisées pour hydratation client -->
	<script
		type="application/json"
		id="perceval-geo-data"
		set:html={JSON.stringify({
			stages: percevalSpatialStages,
			categories: PERCEVAL_SPATIAL_CATEGORIES,
		})}
	/>

	<!-- En-tête pédagogique et filtres de la carte -->
	<div class="geo-controls-bar">
		<div class="geo-filters-group" role="group" aria-label="Filtrer les espaces du récit">
			<span class="geo-filters-label">Nature de l’espace :</span>
			<div class="geo-filter-buttons">
				<button
					type="button"
					class="geo-filter-btn is-active"
					data-geo-filter="all"
					aria-pressed="true"
				>
					<span class="geo-filter-dot dot-all" aria-hidden="true"></span>
					<span>Toutes les étapes ({percevalSpatialStages.length})</span>
				</button>
				{categoriesList.map(([key, cat]) => {
					const count = percevalSpatialStages.filter((s) => s.category === key).length;
					return (
						<button
							type="button"
							class="geo-filter-btn"
							data-geo-filter={key}
							aria-pressed="false"
							style={`--cat-color: ${cat.color};`}
						>
							<span class="geo-filter-dot" aria-hidden="true"></span>
							<span>{cat.label} ({count})</span>
						</button>
					);
				})}
			</div>
		</div>

		<div class="geo-actions-group">
			<button
				type="button"
				class="geo-action-btn"
				id="btn-prev-stage"
				aria-label="Étape précédente du récit"
			>
				← Étape précédente
			</button>
			<button
				type="button"
				class="geo-action-btn"
				id="btn-next-stage"
				aria-label="Étape suivante du récit"
			>
				Étape suivante →
			</button>
			<button
				type="button"
				class="geo-action-btn"
				id="btn-reset-geo"
				title="Revenir au point de départ du voyage"
			>
				Réinitialiser le parcours
			</button>
		</div>
	</div>

	<!-- Grille principale : Carte narrative SVG à gauche, Fiche détaillée à droite -->
	<div class="geo-main-grid">
		<div class="geo-canvas-card">
			<div class="geo-canvas-wrapper" role="region" aria-label="Schéma interactif de l’itinéraire de Perceval">
				<svg
					viewBox="0 0 900 400"
					class="geo-narrative-svg"
					role="img"
					aria-label="Parcours géographique et narratif de Perceval à travers sept étapes"
				>
					<defs>
						<!-- Filtre d'ombre portée pour les jalons -->
						<filter id="geo-shadow" x="-20%" y="-20%" width="140%" height="140%">
							<feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.25" />
						</filter>

						<!-- Dégradé de la trajectoire narrative -->
						<linearGradient id="geo-path-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
							<stop offset="0%" stop-color="#5f6b2f" />
							<stop offset="25%" stop-color="#235284" />
							<stop offset="50%" stop-color="#8b572a" />
							<stop offset="75%" stop-color="#b4502f" />
							<stop offset="100%" stop-color="#5f6b2f" />
						</linearGradient>

						<!-- Motifs de fond stylisé pour le parchemin médiéval -->
						<pattern id="geo-parchment-grid" width="40" height="40" patternUnits="userSpaceOnUse">
							<path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(139, 87, 42, 0.05)" stroke-width="1" />
						</pattern>
					</defs>

					<!-- Fond de carte stylisé -->
					<rect width="900" height="400" rx="12" fill="url(#geo-parchment-grid)" class="geo-svg-bg" />

					<!-- Éléments de décors schématiques évocateurs -->
					<g class="geo-svg-decorations" aria-hidden="true">
						<!-- Forêt sauvage (Gaste Forêt) -->
						<g transform="translate(40, 240)" opacity="0.35">
							<path d="M 15 25 L 25 5 L 35 25 Z M 30 30 L 42 8 L 54 30 Z M 5 32 L 15 12 L 25 32 Z" fill="#5f6b2f" />
							<text x="5" y="48" font-size="11" font-family="serif" fill="#5f6b2f" font-style="italic">Gaste Forêt</text>
						</g>
						<!-- Mer et côte (Carduel / Beaurepaire) -->
						<g transform="translate(300, 25)" opacity="0.3">
							<path d="M 0 10 Q 30 0 60 10 T 120 10 T 180 10 T 240 10" fill="none" stroke="#235284" stroke-width="1.5" stroke-dasharray="3 3" />
							<text x="130" y="5" font-size="11" font-family="serif" fill="#235284" font-style="italic">Rivages de la mer</text>
						</g>
						<!-- Monts rocheux du Roi Pêcheur -->
						<g transform="translate(560, 310)" opacity="0.35">
							<path d="M 0 30 L 25 5 L 50 30 L 75 10 L 100 30 Z" fill="none" stroke="#8b572a" stroke-width="1.5" />
							<text x="15" y="45" font-size="11" font-family="serif" fill="#8b572a" font-style="italic">Vallée cachée</text>
						</g>
						<!-- Forêt de l'ermitage -->
						<g transform="translate(760, 280)" opacity="0.35">
							<path d="M 10 25 L 20 8 L 30 25 Z M 25 28 L 38 10 L 51 28 Z" fill="#5f6b2f" />
							<text x="12" y="44" font-size="11" font-family="serif" fill="#5f6b2f" font-style="italic">Bois sacrés</text>
						</g>
					</g>

					<!-- Ligne narrative pointillée continue entre les 7 étapes -->
					<path
						d="M 80 190 Q 140 120 210 90 T 340 220 T 470 110 T 600 260 T 710 120 T 820 250"
						class="geo-svg-trajectory"
						fill="none"
						stroke="url(#geo-path-gradient)"
						stroke-width="3"
						stroke-dasharray="6 5"
					/>

					<!-- Jalons narratifs cliquables / accessibles au clavier -->
					<g class="geo-svg-nodes" role="group" aria-label="Étapes du voyage">
						{percevalSpatialStages.map((stage) => {
							const cat = PERCEVAL_SPATIAL_CATEGORIES[stage.category];
							return (
								<g
									class={`geo-stage-marker ${stage.id === initialStage.id ? 'is-active' : ''}`}
									data-stage-id={stage.id}
									data-stage-category={stage.category}
									tabindex="0"
									role="button"
									aria-pressed={stage.id === initialStage.id ? 'true' : 'false'}
									aria-label={`Étape ${stage.order} : ${stage.name}. Catégorie : ${stage.categoryLabel}.`}
									style={`--stage-color: ${cat.color};`}
								>
									<!-- Cercle d'aura au focus/survol -->
									<circle
										cx={stage.x}
										cy={stage.y}
										r="22"
										class="geo-marker-aura"
										fill={cat.color}
										opacity="0.15"
									/>
									<!-- Cercle principal -->
									<circle
										cx={stage.x}
										cy={stage.y}
										r="16"
										class="geo-marker-circle"
										fill="#ffffff"
										stroke={cat.color}
										stroke-width="3"
										filter="url(#geo-shadow)"
									/>
									<!-- Numéro d'étape -->
									<text
										x={stage.x}
										y={stage.y + 4}
										text-anchor="middle"
										class="geo-marker-number"
										fill={cat.color}
										font-size="12"
										font-weight="bold"
										font-family="sans-serif"
									>
										{stage.order}
									</text>
									<!-- Libellé de l'étape -->
									<text
										x={stage.x + (stage.labelDx || 0)}
										y={stage.y + (stage.labelDy || 24)}
										text-anchor="middle"
										class="geo-marker-label"
										fill="#1c252e"
										font-size="11"
										font-weight="600"
										font-family="system-ui, sans-serif"
									>
										{stage.name.replace(/ \(.*\)/, '')}
									</text>
								</g>
							);
						})}
					</g>
				</svg>
			</div>

			<!-- Légende didactique sous le schéma -->
			<div class="geo-legend-box" aria-label="Légende des statuts géographiques">
				<span class="geo-legend-heading">Statut géographique des lieux :</span>
				<ul class="geo-legend-items">
					{categoriesList.map(([key, cat]) => (
						<li class="geo-legend-item" style={`--cat-color: ${cat.color};`}>
							<span class="geo-legend-bullet" aria-hidden="true"></span>
							<span class="geo-legend-text">
								<strong>{cat.label}</strong> : {cat.description}
							</span>
						</li>
					))}
				</ul>
				<p class="geo-legend-warning">
					<strong>Règle d’or pour les élèves :</strong> cette carte ne mesure pas des kilomètres réels. Elle montre l’ordre dans lequel Perceval voyage et découvre le monde, entre des forteresses imaginaires et des forêts de contes.
				</p>
			</div>
		</div>

		<!-- Panneau de détail dynamique de l'étape sélectionnée -->
		<aside class="geo-detail-panel" id="geo-detail-panel" aria-live="polite">
			<article class="geo-stage-card">
				<header class="stage-card-header">
					<div class="stage-badge-row">
						<span class={`status-badge ${initialStage.categoryBadgeClass}`} id="detail-stage-badge">
							{initialStage.categoryLabel}
						</span>
						<span class="stage-order-badge" id="detail-stage-order">
							Étape {initialStage.order} sur {percevalSpatialStages.length}
						</span>
					</div>
					<h3 class="stage-card-title" id="detail-stage-title">{initialStage.name}</h3>
					<p class="stage-card-verses" id="detail-stage-verses">{initialStage.verses}</p>
				</header>

				<div class="stage-card-body">
					<div class="stage-info-group">
						<h4 class="stage-group-title">Rôle dans le voyage de Perceval</h4>
						<p class="stage-group-text" id="detail-stage-role">{initialStage.spatialRole}</p>
					</div>

					<div class="stage-info-group">
						<h4 class="stage-group-title">Ce qui s’y passe dans l’histoire</h4>
						<p class="stage-group-text" id="detail-stage-summary">{initialStage.summary}</p>
					</div>

					<div class="stage-info-group stage-group-characters">
						<h4 class="stage-group-title">Personnages présents</h4>
						<p class="stage-group-text" id="detail-stage-characters">
							{initialStage.characters.join(' · ')}
						</p>
					</div>

					<div class="stage-evaluation-box">
						<h4 class="stage-eval-title">Repère pour l’élève de 5ᵉ</h4>
						<p class="stage-eval-status">
							<strong>Statut du lieu :</strong> <span id="detail-stage-status">{initialStage.geographicStatus}</span>
						</p>
						<p class="stage-eval-explanation" id="detail-stage-explanation">
							{initialStage.didacticExplanation}
						</p>
					</div>
				</div>
			</article>
		</aside>
	</div>

	<!-- Alternative accessible complète : tableau chronologique détaillé -->
	<details class="geo-accessible-details">
		<summary class="geo-accessible-summary">
			<span>Lire l’itinéraire complet des sept étapes sous forme de texte accessible</span>
		</summary>
		<div class="geo-accessible-content">
			<table class="geo-accessible-table">
				<thead>
					<tr>
						<th scope="col">N°</th>
						<th scope="col">Nom du lieu & vers</th>
						<th scope="col">Catégorie géographique</th>
						<th scope="col">Rôle dans l’apprentissage du héros</th>
						<th scope="col">Explication pour les élèves</th>
					</tr>
				</thead>
				<tbody>
					{percevalSpatialStages.map((stage) => (
						<tr>
							<th scope="row">Étape {stage.order}</th>
							<td>
								<strong>{stage.name}</strong>
								<br />
								<small>{stage.verses}</small>
							</td>
							<td>
								<span class={`status-badge ${stage.categoryBadgeClass}`}>
									{stage.categoryLabel}
								</span>
							</td>
							<td>{stage.spatialRole}</td>
							<td>{stage.didacticExplanation}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</details>
</div>

<style>
	.perceval-geo-app {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin: 2rem 0;
	}

	/* Barre de contrôle */
	.geo-controls-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		background: #fbf9f4;
		border: 1px solid rgba(139, 87, 42, 0.18);
		border-radius: 8px;
		padding: 0.85rem 1.15rem;
	}
	.geo-filters-group {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
	}
	.geo-filters-label {
		font-size: 0.85rem;
		font-weight: bold;
		color: #5a3517;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.geo-filter-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.geo-filter-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		background: #ffffff;
		border: 1px solid rgba(139, 87, 42, 0.25);
		border-radius: 20px;
		padding: 0.28rem 0.65rem;
		font-size: 0.8rem;
		color: #2b1f14;
		cursor: pointer;
		transition: all 0.15s ease-in-out;
	}
	.geo-filter-btn:hover {
		background: #f4ede2;
		border-color: #8b572a;
	}
	.geo-filter-btn.is-active {
		background: #2b1f14;
		color: #ffffff;
		border-color: #2b1f14;
	}
	.geo-filter-dot {
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: var(--cat-color, #8b572a);
	}
	.geo-filter-dot.dot-all {
		background-color: #2b1f14;
	}
	.geo-filter-btn.is-active .geo-filter-dot.dot-all {
		background-color: #f7d28b;
	}

	.geo-actions-group {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}
	.geo-action-btn {
		background: #ffffff;
		border: 1px solid rgba(139, 87, 42, 0.25);
		border-radius: 6px;
		padding: 0.35rem 0.75rem;
		font-size: 0.82rem;
		font-weight: 500;
		color: #5a3517;
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.geo-action-btn:hover {
		background: #f4ede2;
		border-color: #5a3517;
	}

	/* Grille principale */
	.geo-main-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
	}

	/* Canevas SVG */
	.geo-canvas-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		background: #ffffff;
		border: 1px solid rgba(139, 87, 42, 0.18);
		border-radius: 10px;
		padding: 1.15rem;
		box-shadow: 0 4px 12px rgba(43, 31, 20, 0.04);
	}
	.geo-canvas-wrapper {
		position: relative;
		width: 100%;
		background: #fbf9f4;
		border: 1px solid rgba(139, 87, 42, 0.15);
		border-radius: 8px;
		overflow: hidden;
	}
	.geo-narrative-svg {
		display: block;
		width: 100%;
		height: auto;
		max-height: 480px;
	}

	/* Marqueurs SVG interactifs */
	.geo-stage-marker {
		cursor: pointer;
		outline: none;
		transition: transform 0.2s ease;
	}
	.geo-stage-marker:hover .geo-marker-circle,
	.geo-stage-marker:focus-visible .geo-marker-circle {
		fill: #fdf5e8;
		stroke-width: 4;
	}
	.geo-stage-marker:focus-visible .geo-marker-aura {
		opacity: 0.45;
		r: 28;
	}
	.geo-stage-marker.is-active .geo-marker-circle {
		fill: var(--stage-color);
		stroke: #ffffff;
		stroke-width: 3.5;
	}
	.geo-stage-marker.is-active .geo-marker-number {
		fill: #ffffff;
	}
	.geo-stage-marker.is-active .geo-marker-aura {
		opacity: 0.35;
		r: 26;
	}
	.geo-stage-marker.is-dimmed {
		opacity: 0.25;
	}

	/* Légende sous le schéma */
	.geo-legend-box {
		padding: 0.85rem 1rem;
		background: #fbf9f4;
		border-radius: 6px;
		border-left: 3px solid #8b572a;
		font-size: 0.83rem;
		line-height: 1.5;
	}
	.geo-legend-heading {
		display: block;
		font-weight: bold;
		color: #5a3517;
		margin-bottom: 0.45rem;
		text-transform: uppercase;
		font-size: 0.78rem;
		letter-spacing: 0.03em;
	}
	.geo-legend-items {
		list-style: none;
		padding: 0;
		margin: 0 0 0.65rem 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.geo-legend-item {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
	}
	.geo-legend-bullet {
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: var(--cat-color);
		flex-shrink: 0;
		margin-top: 4px;
	}
	.geo-legend-warning {
		margin: 0;
		padding-top: 0.5rem;
		border-top: 1px dashed rgba(139, 87, 42, 0.2);
		color: #655444;
		font-size: 0.82rem;
	}

	/* Panneau de détail latéral */
	.geo-detail-panel {
		position: sticky;
		top: 1.5rem;
	}
	.geo-stage-card {
		background: #ffffff;
		border: 1px solid rgba(139, 87, 42, 0.2);
		border-radius: 10px;
		padding: 1.35rem 1.45rem;
		box-shadow: 0 4px 14px rgba(43, 31, 20, 0.06);
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
	}
	.stage-badge-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.45rem;
	}
	.stage-order-badge {
		font-size: 0.75rem;
		font-weight: bold;
		color: #655444;
		background: #f4ede2;
		padding: 0.2rem 0.55rem;
		border-radius: 4px;
	}
	.stage-card-title {
		font-size: 1.25rem;
		color: #2b1f14;
		margin: 0 0 0.25rem 0;
		font-family: Georgia, serif;
		line-height: 1.3;
	}
	.stage-card-verses {
		font-size: 0.8rem;
		font-style: italic;
		color: #8b572a;
		margin: 0;
	}
	.stage-card-body {
		display: flex;
		flex-direction: column;
		gap: 0.95rem;
	}
	.stage-info-group {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.stage-group-title {
		font-size: 0.78rem;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: #5a3517;
		margin: 0;
	}
	.stage-group-text {
		font-size: 0.88rem;
		color: #2b1f14;
		line-height: 1.55;
		margin: 0;
	}
	.stage-evaluation-box {
		background: #fbf9f4;
		border: 1px solid rgba(139, 87, 42, 0.2);
		border-radius: 6px;
		padding: 0.85rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}
	.stage-eval-title {
		font-size: 0.8rem;
		font-weight: bold;
		color: #235284;
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}
	.stage-eval-status,
	.stage-eval-explanation {
		font-size: 0.84rem;
		color: #3b2d20;
		line-height: 1.5;
		margin: 0;
	}

	/* Alternative accessible */
	.geo-accessible-details {
		background: #ffffff;
		border: 1px solid rgba(139, 87, 42, 0.2);
		border-radius: 8px;
		padding: 0.75rem 1.15rem;
	}
	.geo-accessible-summary {
		font-size: 0.9rem;
		font-weight: 600;
		color: #5a3517;
		cursor: pointer;
	}
	.geo-accessible-content {
		margin-top: 1rem;
		overflow-x: auto;
	}
	.geo-accessible-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.84rem;
		text-align: left;
	}
	.geo-accessible-table th,
	.geo-accessible-table td {
		padding: 0.65rem 0.85rem;
		border-bottom: 1px solid rgba(139, 87, 42, 0.15);
		vertical-align: top;
	}
	.geo-accessible-table th {
		background: #fbf9f4;
		color: #5a3517;
		font-weight: 600;
	}

	/* Responsive */
	@media (max-width: 900px) {
		.geo-main-grid {
			grid-template-columns: 1fr;
		}
		.geo-detail-panel {
			position: static;
		}
	}
	@media (max-width: 640px) {
		.geo-controls-bar {
			padding: 0.75rem;
		}
		.geo-canvas-card {
			padding: 0.85rem;
		}
		.geo-stage-card {
			padding: 1.1rem;
		}
	}
</style>

<script>
	// Script interactif côté client pour le schéma narratif de Perceval
	document.addEventListener('DOMContentLoaded', () => {
		const appEl = document.getElementById('perceval-geo-app');
		if (!appEl) return;

		const dataScript = document.getElementById('perceval-geo-data');
		if (!dataScript) return;

		let geoData: {
			stages: Array<{
				id: string;
				order: number;
				name: string;
				category: string;
				categoryLabel: string;
				categoryBadgeClass: string;
				verses: string;
				summary: string;
				characters: string[];
				spatialRole: string;
				geographicStatus: string;
				didacticExplanation: string;
			}>;
			categories: Record<string, any>;
		};

		try {
			geoData = JSON.parse(dataScript.textContent || '{}');
		} catch {
			return;
		}

		const markers = Array.from(appEl.querySelectorAll<SVGGElement>('.geo-stage-marker'));
		const filterBtns = Array.from(appEl.querySelectorAll<HTMLButtonElement>('.geo-filter-btn'));
		const prevBtn = document.getElementById('btn-prev-stage') as HTMLButtonElement | null;
		const nextBtn = document.getElementById('btn-next-stage') as HTMLButtonElement | null;
		const resetBtn = document.getElementById('btn-reset-geo') as HTMLButtonElement | null;

		// Éléments du panneau de détail
		const badgeEl = document.getElementById('detail-stage-badge');
		const orderEl = document.getElementById('detail-stage-order');
		const titleEl = document.getElementById('detail-stage-title');
		const versesEl = document.getElementById('detail-stage-verses');
		const roleEl = document.getElementById('detail-stage-role');
		const summaryEl = document.getElementById('detail-stage-summary');
		const charsEl = document.getElementById('detail-stage-characters');
		const statusEl = document.getElementById('detail-stage-status');
		const explEl = document.getElementById('detail-stage-explanation');

		let currentStageIndex = 0;
		let currentFilter = 'all';

		function selectStage(index: number) {
			if (index < 0 || index >= geoData.stages.length) return;
			currentStageIndex = index;
			const stage = geoData.stages[index];

			// Mettre à jour l'état visuel et accessible des marqueurs
			markers.forEach((m, idx) => {
				const isCurrent = idx === index;
				m.classList.toggle('is-active', isCurrent);
				m.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
			});

			// Mettre à jour le panneau de détail
			if (badgeEl) {
				badgeEl.textContent = stage.categoryLabel;
				badgeEl.className = `status-badge ${stage.categoryBadgeClass}`;
			}
			if (orderEl) orderEl.textContent = `Étape ${stage.order} sur ${geoData.stages.length}`;
			if (titleEl) titleEl.textContent = stage.name;
			if (versesEl) versesEl.textContent = stage.verses;
			if (roleEl) roleEl.textContent = stage.spatialRole;
			if (summaryEl) summaryEl.textContent = stage.summary;
			if (charsEl) charsEl.textContent = stage.characters.join(' · ');
			if (statusEl) statusEl.textContent = stage.geographicStatus;
			if (explEl) explEl.textContent = stage.didacticExplanation;
		}

		function applyFilter(category: string) {
			currentFilter = category;
			filterBtns.forEach((btn) => {
				const isActive = btn.dataset.geoFilter === category;
				btn.classList.toggle('is-active', isActive);
				btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
			});

			markers.forEach((m) => {
				const stageCat = m.dataset.stageCategory;
				const isDimmed = category !== 'all' && stageCat !== category;
				m.classList.toggle('is-dimmed', isDimmed);
			});
		}

		// Événements sur les jalons SVG
		markers.forEach((m, idx) => {
			m.addEventListener('click', () => selectStage(idx));
			m.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					selectStage(idx);
				}
			});
		});

		// Filtres
		filterBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const cat = btn.dataset.geoFilter || 'all';
				applyFilter(cat);
			});
		});

		// Navigation étape par étape
		prevBtn?.addEventListener('click', () => {
			const newIdx = (currentStageIndex - 1 + geoData.stages.length) % geoData.stages.length;
			selectStage(newIdx);
		});

		nextBtn?.addEventListener('click', () => {
			const newIdx = (currentStageIndex + 1) % geoData.stages.length;
			selectStage(newIdx);
		});

		resetBtn?.addEventListener('click', () => {
			applyFilter('all');
			selectStage(0);
		});
	});
</script>
