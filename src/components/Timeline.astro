---
import '../styles/timeline.css';
import {
	timelineItems,
	timelinePeriods,
	type TimelineItem,
	type TimelinePeriod,
} from '../data/timeline';
import { timelineFilters } from '../data/timeline-filters';

interface Props {
	initialSelectedId?: string;
}

const { initialSelectedId = 'pere-goriot' } = Astro.props;

// Tri rigoureux et programmatique des éléments par ordre chronologique
// Les œuvres littéraires de la même année sont ordonnées avec pertinence (ex. Sedan avant ou après 1870)
const sortedTimelineItems = [...timelineItems].sort((a, b) => {
	if (a.year !== b.year) return a.year - b.year;
	// Ordre chronologique fin en 1870
	const order1870: Record<string, number> = {
		'guerre-franco-prussienne': 1,
		'bataille-sedan': 2,
		'proclamation-troisieme-republique': 3,
		'cahiers-douai': 4,
	};
	const orderA = order1870[a.id] || 0;
	const orderB = order1870[b.id] || 0;
	return orderA - orderB;
});

// Périodes politiques associées par id
const periodsMap = new Map<string, TimelinePeriod>(timelinePeriods.map((p) => [p.id, p]));

// Identifier les tournants historiques majeurs pour accentuation visuelle
const majorTurningPointIds = new Set([
	'revolution-francaise',
	'revolution-juillet-1830',
	'revolution-1848',
	'bataille-sedan',
	'proclamation-troisieme-republique',
	'commune-paris',
]);

// Identifier les jalons industriels majeurs
const majorIndustryPointIds = new Set([
	'machine-vapeur-watt',
	'chemin-de-fer-stockton',
	'liverpool-manchester',
	'exposition-universelle-londres',
	'procede-bessemer',
	'dynamo-gramme',
	'moteur-explosion-otto',
]);

// Identifier les jalons scientifiques majeurs
const majorSciencePointIds = new Set([
	'alessandro-volta',
	'sadi-carnot',
	'michael-faraday',
	'leon-foucault',
	'charles-darwin',
	'gregor-mendel',
	'dmitri-mendeleiev',
	'james-clerk-maxwell',
]);

// Identifier les jalons majeurs de peinture (visuellement proéminents)
const majorPaintingPointIds = new Set([
	'painting-delacroix-liberte',
	'painting-gericault-radeau-meduse',
	'painting-courbet-enterrement-ornans',
	'painting-manet-dejeuner',
	'painting-monet-impression',
]);

// Identifier les jalons majeurs de musique (visuellement proéminents)
const majorMusicPointIds = new Set([
	'music-beethoven-symphonie-9',
	'music-berlioz-symphonie-fantastique',
	'music-wagner-tristan',
]);

// Détermination de l'alternance gauche / droite pour le bureau
// Les œuvres et les tournants majeurs s'alternent harmonieusement
let sideToggle = 0;
const enrichedItems = sortedTimelineItems.map((item) => {
	const isLiterature = item.type === 'literature';
	const isIndustry = item.type === 'industry';
	const isScience = item.type === 'science';
	const isPainting = item.type === 'painting';
	const isMusic = item.type === 'music';
	const isArtisticEvent = item.id === 'painting-exposition-impressionniste-1874';
	const isGalois = item.id === 'e-galois';
	const isMajorTurningPoint = majorTurningPointIds.has(item.id);
	const isMajorIndustryPoint = majorIndustryPointIds.has(item.id);
	const isMajorSciencePoint = majorSciencePointIds.has(item.id);
	const isMajorPaintingPoint = majorPaintingPointIds.has(item.id);
	const isMajorMusicPoint = majorMusicPointIds.has(item.id);
	const period = periodsMap.get(item.periodId);

	// Alternance gauche/droite
	const alignment = sideToggle % 2 === 0 ? 'align-left' : 'align-right';
	sideToggle++;

	return {
		...item,
		alignment,
		isLiterature,
		isIndustry,
		isScience,
		isPainting,
		isMusic,
		isArtisticEvent,
		isGalois,
		isMajorTurningPoint,
		isMajorIndustryPoint,
		isMajorSciencePoint,
		isMajorPaintingPoint,
		isMajorMusicPoint,
		periodTitle: period ? period.title : '',
		periodDates: period ? period.displayDates : '',
	};
});

// Données sérialisées pour le script client
const clientData = {
	items: sortedTimelineItems,
	periods: timelinePeriods,
	initialSelectedId,
};
---

<div class="timeline-wrapper" id="timeline-app" data-timeline={JSON.stringify(clientData)}>
	<!-- En-tête éditorial -->
	<header class="timeline-editorial-header">
		<div class="eyebrow">Visualisation éditoriale interactive</div>
		<h1>Frise chronologique — littérature et histoire au XIXe siècle</h1>
		<p class="timeline-subtitle">
			Des bouleversements politiques de 1789 aux œuvres de Balzac, Musset, Rimbaud et Zola
		</p>
		<div class="pedagogical-statement">
			<p>
				<strong>Les œuvres ne sont pas hors du temps.</strong><br />
				Balzac, Musset, Rimbaud et Zola écrivent dans des France différentes : monarchies, républiques, empires, révolutions et guerres transforment le monde auquel leur littérature répond.
			</p>
		</div>
	</header>

	<!-- Commandes de filtrage -->
	<div class="timeline-controls" role="toolbar" aria-label="Filtres de la frise chronologique">
		<div class="timeline-filters-group">
			<span class="timeline-filters-label">Filtrer par :</span>
			{timelineFilters.map((filter) => (
				<button
					type="button"
					class={`timeline-filter-btn ${filter.id === 'all' ? 'active' : ''}`}
					data-filter={filter.id}
					aria-pressed={filter.id === 'all' ? 'true' : 'false'}
					title={filter.description}
				>
					{filter.label}
				</button>
			))}
		</div>
		<div class="timeline-instructions">
			<span>💡 Cliquez sur une œuvre ou un événement pour explorer son contexte historique</span>
		</div>
	</div>

	<!-- Disposition principale : Frise verticale + Panneau d'informations -->
	<div class="timeline-main-layout">
		
		<!-- Colonne verticale centrale -->
		<div class="vertical-timeline-container" id="vertical-timeline" aria-label="Frise chronologique verticale de 1789 à 1882">
			<!-- Ligne continue d'axe vertical -->
			<div class="vertical-spine-line" aria-hidden="true"></div>
			<div class="timeline-flow-arrow" aria-hidden="true">▼</div>

			<!-- Liste ordonnée sémantique <ol> -->
			<ol class="timeline-ordered-list">
				{enrichedItems.map((item, index) => {
					// Bannière de régime politique contextuelle si nouvelle période
					const prevItem = index > 0 ? enrichedItems[index - 1] : null;
					const isNewPeriod = !prevItem || prevItem.periodId !== item.periodId;
					const currentPeriod = periodsMap.get(item.periodId);

					return (
						<>
							{isNewPeriod && currentPeriod && (
								<li
									class="regime-context-banner"
									id={`period-banner-${currentPeriod.id}`}
									data-period-id={currentPeriod.id}
									aria-hidden="true"
								>
									<span class="regime-banner-title">Contexte politique · {currentPeriod.title}</span>
									<span class="regime-banner-dates">{currentPeriod.displayDates}</span>
								</li>
							)}

							<li
								class={`timeline-step ${item.alignment} ${item.isLiterature ? 'is-literature' : ''} ${item.isIndustry ? 'is-industry' : ''} ${item.isScience ? 'is-science' : ''} ${item.isPainting ? 'is-painting' : ''} ${item.isMusic ? 'is-music' : ''} ${item.isArtisticEvent ? 'is-artistic-event' : ''} ${item.isGalois ? 'is-galois featured' : ''} ${item.isMajorTurningPoint ? 'major-turning-point' : ''} ${item.isMajorIndustryPoint ? 'major-industry-point' : ''} ${item.isMajorSciencePoint ? 'major-science-point' : ''} ${item.isMajorPaintingPoint ? 'major-painting-point' : ''} ${item.isMajorMusicPoint ? 'major-music-point' : ''}`}
								id={`step-${item.id}`}
								data-item-id={item.id}
								data-item-type={item.type}
								data-period-id={item.periodId}
								data-year={item.year}
							>
								<!-- Nœud d'axe sur la colonne vertébrale -->
								<div class="step-spine-node" aria-hidden="true">
									<div class="spine-marker-dot"></div>
								</div>

								<!-- Connecteur latéral vers la carte -->
								<div class="step-branch-connector" aria-hidden="true"></div>

								<!-- Carte / bouton interactif accessible -->
								<button
									type="button"
									class={`timeline-entry-button ${item.id === initialSelectedId ? 'selected' : ''}`}
									id={`item-${item.id}`}
									data-item-id={item.id}
									data-item-type={item.type}
									data-period-id={item.periodId}
									data-year={item.year}
									aria-pressed={item.id === initialSelectedId ? 'true' : 'false'}
									aria-label={`${item.title}, ${item.datePrecise ?? item.year}${item.author ? `, par ${item.author}` : ''}`}
								>
									<div class="entry-card-header">
										<time class="entry-year-time" datetime={String(item.year)}>
											{item.datePrecise ?? item.year}
										</time>
										<span class="entry-type-badge">
											{item.isLiterature ? (item.tagLabel?.split('·')[0].trim() || 'Littérature') : item.type === 'science' ? 'Sciences' : item.type === 'industry' ? 'Industrie' : item.type === 'painting' ? 'Peinture' : item.type === 'music' ? 'Musique' : item.type === 'revolution' ? 'Révolution' : item.type === 'war' ? 'Guerre' : 'Histoire'}
										</span>
									</div>

									{item.image && (
										<span
											class={`entry-thumb fit-${item.image.fit ?? 'cover'} ${item.image.width && item.image.height && item.image.height > item.image.width * 1.2 ? 'entry-thumb--portrait' : ''}`}
											aria-hidden="true"
										>
											<img
												src={item.image.src}
												srcset={item.image.srcset}
												sizes="(max-width: 720px) calc(100vw - 6rem), 350px"
												width={item.image.width}
												height={item.image.height}
												alt=""
												style={item.image.position ? `object-position: ${item.image.position}` : undefined}
												loading="lazy"
												decoding="async"
											/>
										</span>
									)}

									<h3 class="entry-title">{item.title}</h3>

									{item.subtitle && (
										<div class="entry-author">{item.subtitle}</div>
									)}
									{item.author && !item.subtitle && (
										<div class="entry-author">{item.author}</div>
									)}

									<p class="entry-short-desc">{item.description}</p>

									{item.periodTitle && (
										<div class="entry-regime-context-tag">
											Période : {item.periodTitle}
										</div>
									)}
								</button>
							</li>
						</>
					);
				})}
			</ol>
		</div>

		<!-- Panneau d'informations contextuelles (Sticky sur grand écran, dessous sur mobile) -->
		<aside class="timeline-sticky-panel-wrapper">
			<section
				class="timeline-details-panel"
				id="timeline-panel"
				aria-live="polite"
				aria-atomic="true"
			>
				<!-- Rempli dynamiquement par le script -->
			</section>
		</aside>

	</div>

	<!-- Légende éditoriale -->
	<footer class="timeline-legend" aria-label="Légende de la frise">
		<div class="legend-item">
			<span class="legend-indicator dot" style="background: var(--tl-lit-bg); border-color: var(--tl-lit-color); border-width: 2px;"></span>
			<span>Œuvre littéraire majeure (Musset, Balzac, Rimbaud, Zola)</span>
		</div>
		<div class="legend-item">
			<span class="legend-indicator dot" style="background: var(--tl-surface); border-color: var(--tl-rev-color); border-width: 3px;"></span>
			<span>Tournant historique majeur (1789, 1830, 1848, Sedan, Commune)</span>
		</div>
		<div class="legend-item">
			<span class="legend-indicator dot" style="background: var(--tl-surface); border-color: var(--tl-ind-color); border-width: 2.5px;"></span>
			<span>Jalon industriel (vapeur, rail, acier, électricité, moteur)</span>
		</div>
		<div class="legend-item">
			<span class="legend-indicator dot" style="background: var(--tl-surface); border-color: var(--tl-sci-color); border-width: 2.5px;"></span>
			<span>Jalon scientifique (physique, biologie, chimie, mathématiques)</span>
		</div>
		<div class="legend-item">
			<span class="legend-indicator dot" style="background: var(--tl-surface); border-color: var(--tl-paint-color); border-width: 2.5px;"></span>
			<span>Jalon de peinture (David, Géricault, Delacroix, Courbet, Manet, Monet)</span>
		</div>
		<div class="legend-item">
			<span class="legend-indicator dot" style="background: var(--tl-surface); border-color: var(--tl-music-color); border-width: 2.5px;"></span>
			<span>Jalon de musique (Beethoven, Berlioz, Chopin, Offenbach, Wagner, Bizet)</span>
		</div>
		<div class="legend-item">
			<span class="legend-indicator dot" style="background: var(--tl-galois-bg); border-color: var(--tl-galois-accent); border-width: 3px;"></span>
			<span>Évariste Galois (mathématiques & époque révolutionnaire)</span>
		</div>
		<div class="legend-item">
			<span class="legend-indicator dot" style="background: var(--tl-surface); border-color: var(--tl-muted);"></span>
			<span>Événement politique & institutionnel</span>
		</div>
		<div class="legend-item">
			<span class="legend-indicator" style="background: var(--band-bg-subtle); border-color: var(--band-border-subtle);"></span>
			<span>Régime politique de fond</span>
		</div>
	</footer>
</div>

<script>
	import type { TimelineCharacterModel } from '../data/timeline';

	interface TimelineImageCredit {
		source: string;
		sourceUrl: string;
		author?: string;
		license: string;
		attributionRequired: boolean;
		attribution?: string;
	}

	interface TimelineItemImage {
		src: string;
		alt: string;
		caption?: string;
		srcset?: string;
		width?: number;
		height?: number;
		fit?: 'contain' | 'cover';
		position?: string;
		credit?: TimelineImageCredit;
	}

	interface TimelineItemAudio {
		title: string;
		url: string;
		mimeType: string;
		source: string;
		sourceUrl: string;
		license: string;
		licenseUrl?: string;
		performer?: string;
		recordingDate?: string;
		duration?: string;
		attributionRequired: boolean;
		attribution?: string;
	}

	interface TimelineItemListenLink {
		url: string;
		source: string;
		note?: string;
	}

	interface TimelineItem {
		id: string;
		year: number;
		endYear?: number;
		datePrecise?: string;
		type: string;
		category: string;
		title: string;
		subtitle?: string;
		author?: string;
		authorDates?: string;
		tagLabel?: string;
		description: string;
		historicalContext: string;
		contextSectionTitle?: string;
		periodId: string;
		relatedTo: string[];
		relatedLinks?: Array<{ id: string; label?: string; prefix?: string }>;
		quote?: string;
		importance?: string;
		contextualTags?: string[];
		image?: TimelineItemImage;
		secondaryImage?: TimelineItemImage;
		audio?: TimelineItemAudio;
		listenLink?: TimelineItemListenLink;
		characterModel?: TimelineCharacterModel;
	}

	interface TimelinePeriod {
		id: string;
		title: string;
		startYear: number;
		endYear: number;
		displayDates: string;
		description: string;
	}

	const app = document.getElementById('timeline-app');
	if (app) {
		const rawData = app.getAttribute('data-timeline');
		if (rawData) {
			const { items, periods, initialSelectedId } = JSON.parse(rawData) as {
				items: TimelineItem[];
				periods: TimelinePeriod[];
				initialSelectedId: string;
			};

			const itemsMap = new Map<string, TimelineItem>(items.map((it) => [it.id, it]));
			const periodsMap = new Map<string, TimelinePeriod>(periods.map((p) => [p.id, p]));
			const panel = document.getElementById('timeline-panel');
			let currentSelectedId: string = initialSelectedId;

			// Image locale introuvable : on retire le cadre (pas de rectangle vide) sans toucher au texte,
			// et on signale l'asset manquant en développement. Aucune image de substitution.
			function handleBrokenImage(img: HTMLImageElement) {
				const frame = img.closest('.entry-thumb, .details-thumbnail-figure');
				if (!frame) return;
				frame.classList.add('is-broken');
				if (import.meta.env.DEV) console.warn(`[timeline] image introuvable : ${img.currentSrc || img.src}`);
			}
			document.addEventListener(
				'error',
				(event) => {
					if (event.target instanceof HTMLImageElement) handleBrokenImage(event.target);
				},
				true,
			);
			document.querySelectorAll<HTMLImageElement>('.entry-thumb img').forEach((img) => {
				if (img.complete && img.naturalWidth === 0) handleBrokenImage(img);
			});

			const PANEL_SIZES = '(max-width: 960px) calc(100vw - 5rem), 310px';
			const SECONDARY_SIZES = '96px';

			function escapeAttr(value: string): string {
				return value.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
			}

			// Crédit compact : « Source : Wikimedia Commons · Domaine public » (auteur ajouté si attribution requise)
			function renderCredit(credit?: TimelineImageCredit): string {
				if (!credit) return '';
				const parts = [
					`Source : <a href="${escapeAttr(credit.sourceUrl)}" target="_blank" rel="noopener noreferrer">${credit.source}</a>`,
				];
				if (credit.attributionRequired) parts.push(credit.attribution || credit.author || '');
				parts.push(credit.license);
				return `<small class="details-image-credit">${parts.filter(Boolean).join(' · ')}</small>`;
			}

			function renderFigure(image: TimelineItemImage, className: string, sizes: string): string {
				const fitClass = image.fit ? ` fit-${image.fit}` : '';
				const srcset = image.srcset ? ` srcset="${escapeAttr(image.srcset)}" sizes="${sizes}"` : '';
				const dims = image.width && image.height ? ` width="${image.width}" height="${image.height}"` : '';
				const position = image.position ? ` style="object-position: ${escapeAttr(image.position)}"` : '';
				return `
					<figure class="${className}${fitClass}">
						<img src="${escapeAttr(image.src)}"${srcset}${dims}${position} alt="${escapeAttr(image.alt)}" decoding="async" />
						${image.caption || image.credit ? `<figcaption>${image.caption ?? ''}${renderCredit(image.credit)}</figcaption>` : ''}
					</figure>
				`;
			}

			function formatDuration(duration: string): string {
				const [min, sec] = duration.split(':');
				return `${Number(min)} min ${sec}`;
			}

			// Écoute : lecteur natif chargé à la demande (preload="none"), ou lien externe
			function renderListening(item: TimelineItem): string {
				const audio = item.audio;
				if (audio) {
					const label = `Écouter : ${audio.title}`;
					const credit = [
						audio.performer ? `${audio.performer}${audio.recordingDate ? ` (${audio.recordingDate})` : ''}` : '',
						`Source : <a href="${escapeAttr(audio.sourceUrl)}" target="_blank" rel="noopener noreferrer">${audio.source}</a>`,
						audio.licenseUrl
							? `<a href="${escapeAttr(audio.licenseUrl)}" target="_blank" rel="noopener noreferrer">${audio.license}</a>`
							: audio.license,
					];
					return `
						<div class="details-listen is-embedded">
							<p class="details-listen-label">
								<span aria-hidden="true">▶</span> ${label}${audio.duration ? ` <span class="details-listen-duration">(${formatDuration(audio.duration)})</span>` : ''}
							</p>
							<audio controls preload="none" aria-label="${escapeAttr(`${item.title}${item.author ? `, ${item.author}` : ''} — ${audio.title}`)}">
								<source src="${escapeAttr(audio.url)}" type="${escapeAttr(audio.mimeType)}" />
								<a href="${escapeAttr(audio.sourceUrl)}" target="_blank" rel="noopener noreferrer">Écouter l’extrait sur ${audio.source}</a>
							</audio>
							<small class="details-listen-credit">${credit.filter(Boolean).join(' · ')}</small>
							<small class="details-listen-note">Extrait de l’œuvre citée dans la frise.</small>
						</div>
					`;
				}
				const link = item.listenLink;
				if (link) {
					return `
						<div class="details-listen is-external">
							<a class="details-listen-link" href="${escapeAttr(link.url)}" target="_blank" rel="noopener noreferrer">
								Écouter l’œuvre <span aria-hidden="true">↗</span><span class="sr-only"> (${link.source}, nouvel onglet)</span>
							</a>
							<small class="details-listen-credit">Écoute externe · ${link.source}${link.note ? ` — ${link.note}` : ''}</small>
						</div>
					`;
				}
				return '';
			}

			// Schéma secondaire : comment l'œuvre explique le comportement des personnages
			function renderCharacterModel(model?: TimelineCharacterModel): string {
				if (!model) return '';
				const steps = model.steps ?? [];
				const diagramLabel = `Schéma ${model.author} : ${model.factors.join(' et ')}${steps.map((s) => `, puis ${s}`).join('')}, produisent le ${model.outcome}.`;
				const comparison = model.comparison;
				const otherAuthor = comparison?.lines.find((l) => l.author !== model.author)?.author;
				return `
					<div class="details-section details-model">
						<h4>Expliquer les personnages · ${model.heading}</h4>
						<p class="details-model-synthesis">${model.synthesis}</p>
						<figure class="details-model-diagram" role="img" aria-label="${escapeAttr(diagramLabel)}">
							<span class="model-node model-author">${model.author}</span>
							<span class="model-fork"></span>
							<span class="model-factors">
								${model.factors.map((f) => `<span class="model-node">${f}</span>`).join('<span class="model-plus">+</span>')}
							</span>
							<span class="model-arrow">↓</span>
							${steps.map((s) => `<span class="model-node">${s}</span><span class="model-arrow">↓</span>`).join('')}
							<span class="model-node model-outcome">${model.outcome}</span>
						</figure>
						<p class="details-model-question"><strong>${model.author} demande :</strong> ${model.question}</p>
						<details class="details-model-more">
							<summary>Approfondir le modèle</summary>
							<p>${model.explanation}</p>
							<blockquote class="details-quote details-model-source">${model.source.quote}<cite>${model.source.label}</cite></blockquote>
							${model.example ? `
								<div class="details-model-example">
									<h5>${model.example.title}</h5>
									<p>${model.example.text}</p>
								</div>
							` : ''}
							<h5>Repères intellectuels</h5>
							<ul class="details-model-context">
								${model.context.map((c) => `<li>${c}</li>`).join('')}
							</ul>
							<p class="details-model-caveat">Des transformations entremêlées, sans cause unique.</p>
							<p class="details-model-nuance">${model.nuance}</p>
						</details>
						${comparison ? `
							<div class="details-model-comparison">
								<h5>${comparison.heading}</h5>
								<dl>
									${comparison.lines.map((l) => `<div><dt>${l.author}</dt><dd>${l.formula}</dd></div>`).join('')}
								</dl>
								<button type="button" class="details-related-btn" data-target-id="${comparison.targetId}">${comparison.relationLabel}${otherAuthor ? ` · voir ${otherAuthor}` : ''}</button>
								<p class="details-model-caveat">${comparison.note}</p>
							</div>
						` : ''}
					</div>
				`;
			}

			// Rendu du panneau d'information contextuel
			function renderPanel(itemId: string) {
				const item = itemsMap.get(itemId);
				if (!item || !panel) return;

				// Un extrait en cours s'arrête quand on change d'événement
				panel.querySelectorAll('audio').forEach((el) => el.pause());

				const period = periodsMap.get(item.periodId);
				const periodTitle = period ? period.title : '';
				const tagClass = item.id === 'e-galois' ? 'galois' : item.type === 'literature' ? 'lit' : item.type === 'science' ? 'sci' : item.type === 'industry' ? 'ind' : item.type === 'painting' ? 'paint' : item.type === 'music' ? 'music' : item.type === 'revolution' ? 'rev' : item.type === 'war' ? 'war' : 'hist';
				const typeHumanLabel = item.id === 'e-galois' ? 'Sciences · Mathématiques d’exception' : item.type === 'literature' ? (item.tagLabel || 'Littérature') : item.type === 'science' ? (item.tagLabel || 'Sciences') : item.type === 'industry' ? (item.tagLabel || 'Industrie') : item.type === 'painting' ? (item.tagLabel || 'Peinture') : item.type === 'music' ? (item.tagLabel || 'Musique') : item.type === 'revolution' ? 'Révolution' : item.type === 'war' ? 'Guerre' : 'Régime politique';

				// Repères et liens associés avec libellés contextuels
				const relatedButtons = item.relatedTo
					.map((relId) => {
						const relItem = itemsMap.get(relId);
						const relPeriod = periodsMap.get(relId);
						const customLink = item.relatedLinks?.find((l) => l.id === relId);

						let labelText = '';
						if (customLink?.label) {
							labelText = customLink.label;
						} else {
							// Labels contextuels spécifiques si non définis
							if ((item.id === 'pot-bouille' && relId === 'au-bonheur-des-dames') || (item.id === 'au-bonheur-des-dames' && relId === 'pot-bouille')) {
								labelText = 'Du magasin de nouveautés au grand magasin : ' + (relItem ? `${relItem.title} (${relItem.datePrecise || relItem.year})` : relId);
							} else if ((item.id === 'exposition-universelle-londres' && relId === 'au-bonheur-des-dames') || (item.id === 'au-bonheur-des-dames' && relId === 'exposition-universelle-londres')) {
								labelText = 'Commerce moderne et industrialisation : ' + (relItem ? `${relItem.title} (${relItem.datePrecise || relItem.year})` : relId);
							} else if ((item.id === 'second-empire-event' && relId === 'au-bonheur-des-dames') || (item.id === 'au-bonheur-des-dames' && relId === 'second-empire-event')) {
								labelText = 'Modernité urbaine parisienne : ' + (relItem ? `${relItem.title} (${relItem.datePrecise || relItem.year})` : relPeriod ? `${relPeriod.title} (${relPeriod.displayDates})` : relId);
							} else if ((item.id === 'e-galois' && relId === 'revolution-juillet-1830') || (item.id === 'revolution-juillet-1830' && relId === 'e-galois')) {
								labelText = 'Contexte politique : ' + (relItem ? `${relItem.title} (${relItem.datePrecise || relItem.year})` : relId);
							} else {
								const defaultTitle = relItem ? `${relItem.title} (${relItem.datePrecise || relItem.year})` : relPeriod ? `${relPeriod.title} (${relPeriod.displayDates})` : relId;
								labelText = `↳ ${defaultTitle}`;
							}
						}
						return `<button type="button" class="details-related-btn" data-target-id="${relId}">${labelText}</button>`;
					})
					.join('');

				// Affichage optionnel d'une vignette historique si disponible
				const imageBlock = item.image
					? renderFigure(item.image, 'details-thumbnail-figure', PANEL_SIZES) +
						(item.secondaryImage
							? renderFigure(item.secondaryImage, 'details-thumbnail-figure details-secondary-figure', SECONDARY_SIZES)
							: '')
					: '';

				const contextHeading = item.contextSectionTitle || 'Contexte historique';

				const contextualTagsHtml = item.contextualTags && item.contextualTags.length > 0
					? `
						<div class="details-context-tags" style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.75rem;">
							${item.contextualTags.map((tag) => `<span style="display: inline-block; font-size: 0.72rem; padding: 0.15rem 0.45rem; border-radius: 3px; background: rgba(139, 87, 42, 0.08); color: #8b572a; border: 1px solid rgba(139, 87, 42, 0.2); font-weight: 500;">${tag}</span>`).join('')}
						</div>
					`
					: '';

				panel.innerHTML = `
					<div class="details-panel-header">
						<span class="details-category-tag ${tagClass}">${typeHumanLabel}</span>
						<h3 class="details-title">${item.title}</h3>
						<div class="details-meta">
							${item.authorDates ? `<strong>${item.authorDates}</strong> · ` : item.author ? `<strong>${item.author}</strong> · ` : ''}
							<time datetime="${item.year}">${item.datePrecise || item.year}</time>
							${periodTitle ? `<br /><span>Période : <em>${periodTitle}</em></span>` : ''}
						</div>
					</div>

					${imageBlock}

					<div class="details-section">
						<h4>Présentation</h4>
						<p>${item.description}</p>
						${item.quote ? `<blockquote class="details-quote">${item.quote}</blockquote>` : ''}
						${renderListening(item)}
					</div>

					${renderCharacterModel(item.characterModel)}

					<div class="details-section details-context-box">
						<h4>${contextHeading}</h4>
						${contextualTagsHtml}
						<p>${item.historicalContext}</p>
						${item.relatedTo.length > 0 ? `
							<div style="margin-top: 0.85rem;">
								<h4 style="font-size: 0.8rem; color: var(--tl-muted); text-transform: uppercase;">Repères & œuvres contemporains :</h4>
								<div class="details-related-list">
									${relatedButtons}
								</div>
							</div>
						` : ''}
					</div>
				`;

				// Écouteurs sur les boutons de renvoi vers d'autres événements
				panel.querySelectorAll('.details-related-btn').forEach((btn) => {
					btn.addEventListener('click', () => {
						const targetId = btn.getAttribute('data-target-id');
						if (targetId) {
							selectItem(targetId);
							scrollToItem(targetId);
						}
					});
				});
			}

			// Scroll fluide vers l'élément sélectionné
			function scrollToItem(itemId: string) {
				const stepEl = document.getElementById(`step-${itemId}`);
				if (!stepEl) return;
				stepEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
			}

			// Sélection d'un élément
			function selectItem(itemId: string) {
				currentSelectedId = itemId;
				const selectedItem = itemsMap.get(itemId);

				// Retrait des classes précédentes
				document.querySelectorAll('.timeline-step').forEach((el) => {
					el.classList.remove('selected', 'context-highlight');
				});
				document.querySelectorAll('.timeline-entry-button').forEach((el) => {
					el.classList.remove('selected', 'context-highlight');
					el.setAttribute('aria-pressed', 'false');
				});
				document.querySelectorAll('.regime-context-banner').forEach((el) => {
					el.classList.remove('context-highlight');
				});

				// Mise en valeur de l'élément sélectionné
				const activeStep = document.getElementById(`step-${itemId}`);
				const activeBtn = document.getElementById(`item-${itemId}`);
				if (activeStep) activeStep.classList.add('selected');
				if (activeBtn) {
					activeBtn.classList.add('selected');
					activeBtn.setAttribute('aria-pressed', 'true');
				}

				if (selectedItem) {
					// Mise en valeur de la période politique d'appartenance
					if (selectedItem.periodId) {
						const bannerEl = document.getElementById(`period-banner-${selectedItem.periodId}`);
						bannerEl?.classList.add('context-highlight');
					}

					// Mise en valeur des éléments associés (contexte historique direct)
					selectedItem.relatedTo.forEach((relId) => {
						const relatedStep = document.getElementById(`step-${relId}`);
						const relatedBtn = document.getElementById(`item-${relId}`);
						relatedStep?.classList.add('context-highlight');
						relatedBtn?.classList.add('context-highlight');
					});
				}

				renderPanel(itemId);
			}

			// Filtrage des éléments
			function applyFilter(filterId: string) {
				// Mise à jour de l'état des boutons de filtres
				document.querySelectorAll('.timeline-filter-btn').forEach((btn) => {
					const isActive = btn.getAttribute('data-filter') === filterId;
					btn.classList.toggle('active', isActive);
					btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
				});

				// Filtrage des étapes
				items.forEach((item) => {
					const stepEl = document.getElementById(`step-${item.id}`);
					if (!stepEl) return;

					let visible = true;
					if (filterId === 'literature') {
						visible = item.type === 'literature';
					} else if (filterId === 'history') {
						visible = item.type !== 'literature' && item.type !== 'industry' && item.type !== 'science' && item.type !== 'painting' && item.type !== 'music';
					} else if (filterId === 'industry') {
						visible = item.type === 'industry';
					} else if (filterId === 'science') {
						visible = item.type === 'science';
					} else if (filterId === 'painting') {
						visible = item.type === 'painting';
					} else if (filterId === 'music') {
						visible = item.type === 'music';
					}

					stepEl.classList.toggle('timeline-step-dimmed', !visible);
				});

				// Bannières de régime
				periods.forEach((p) => {
					const banner = document.getElementById(`period-banner-${p.id}`);
					if (!banner) return;
					let visible = true;
					if (filterId === 'literature' || filterId === 'industry' || filterId === 'science' || filterId === 'painting' || filterId === 'music') {
						visible = false;
					}
					banner.classList.toggle('timeline-step-dimmed', !visible);
				});
			}

			// Un seul extrait à la fois
			document.addEventListener(
				'play',
				(event) => {
					document.querySelectorAll('audio').forEach((el) => {
						if (el !== event.target) el.pause();
					});
				},
				true,
			);

			// Écouteurs de clics sur les boutons de la frise
			document.querySelectorAll('.timeline-entry-button').forEach((btn) => {
				btn.addEventListener('click', () => {
					const id = btn.getAttribute('data-item-id');
					if (id) selectItem(id);
				});
			});

			// Écouteurs de survol pour aperçu contextuel rapide
			document.querySelectorAll('.timeline-entry-button').forEach((btn) => {
				btn.addEventListener('mouseenter', () => {
					const id = btn.getAttribute('data-item-id');
					const item = id ? itemsMap.get(id) : null;
					if (item && item.periodId) {
						document.getElementById(`period-banner-${item.periodId}`)?.classList.add('context-highlight');
					}
				});
				btn.addEventListener('mouseleave', () => {
					const id = btn.getAttribute('data-item-id');
					const item = id ? itemsMap.get(id) : null;
					if (item && item.periodId && itemsMap.get(currentSelectedId)?.periodId !== item.periodId) {
						document.getElementById(`period-banner-${item.periodId}`)?.classList.remove('context-highlight');
					}
				});
			});

			// Écouteurs sur les boutons de filtres
			document.querySelectorAll('.timeline-filter-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const filterId = btn.getAttribute('data-filter');
					if (filterId) applyFilter(filterId);
				});
			});

			// Initialisation au démarrage
			selectItem(initialSelectedId);
		}
	}
</script>
