<!-- Script interactif Leaflet côté client -->
<script>
	import L from 'leaflet';
	import 'leaflet/dist/leaflet.css';

	interface PlaceData {
		id: string;
		name: string;
		historicName1870?: string;
		category: string;
		precision: string;
		coordinates: [number, number] | null;
		shortDescription: string;
		literaryAnalysis: string;
		historicalDistinction: string;
		quotation: string;
		quotationReference: string;
		documentarySources: string;
		poems: string[];
		scale: 'local' | 'regional' | 'elargi';
	}

	interface PoemData {
		id: string;
		title: string;
		cahier: number;
		order: number;
		dateWritten: string;
		theme: string;
	}

	interface CategoryMeta {
		id: string;
		label: string;
		color: string;
		symbol: string;
		description: string;
	}

	interface ReadingPathData {
		id: string;
		title: string;
		subtitle: string;
		description: string;
		focus: string;
		placeIds: string[];
	}

	interface AppData {
		places: PlaceData[];
		poems: PoemData[];
		categories: Record<string, CategoryMeta>;
		precisionLabels: Record<string, { label: string; description: string }>;
		readingPaths: ReadingPathData[];
		mapConfig: {
			tileUrl: string;
			attribution: string;
			defaultCenter: [number, number];
			defaultZoom: number;
			minZoom: number;
			maxZoom: number;
		};
	}

	function initRimbaudMap() {
		const dataScript = document.getElementById('rimbaud-places-data');
		if (!dataScript) return;

		let appData: AppData;
		try {
			appData = JSON.parse(dataScript.textContent || '{}');
		} catch (e) {
			console.error('Erreur de parsing des données Rimbaud', e);
			return;
		}

		const { places, poems, categories, precisionLabels, readingPaths, mapConfig } = appData;
		const mapContainer = document.getElementById('rimbaud-leaflet-map');
		if (!mapContainer) return;

		// État de l'application
		let activePathId: string = 'all';
		let activeCategoryFilter: string = 'all';
		let activePoemFilter: string = 'all';
		let selectedPlaceId: string = places[0].id;

		let map: L.Map | null = null;
		const markersById: Record<string, { marker: L.Marker; el: HTMLElement; place: PlaceData }> = {};

		// Initialisation de la carte Leaflet
		try {
			map = L.map(mapContainer, {
				center: mapConfig.defaultCenter,
				zoom: mapConfig.defaultZoom,
				minZoom: mapConfig.minZoom,
				maxZoom: mapConfig.maxZoom,
			});

			L.tileLayer(mapConfig.tileUrl, {
				attribution: mapConfig.attribution,
				maxZoom: mapConfig.maxZoom,
			}).addTo(map);
		} catch (err) {
			console.error('Erreur initialisation Leaflet', err);
			return;
		}

		// Création des marqueurs pour les lieux géolocalisés
		places.forEach((place) => {
			if (!place.coordinates) return; // Ignore les espaces imaginaires sur la carte

			const catMeta = categories[place.category];
			const markerIcon = L.divIcon({
				className: 'custom-rimbaud-marker',
				html: `
					<div class="rimbaud-pin-wrapper ${place.id === selectedPlaceId ? 'is-selected' : ''}" 
						 style="--marker-bg: ${catMeta?.color || '#b91c1c'};" 
						 data-marker-place-id="${place.id}" 
						 title="${place.name}">
						<span aria-hidden="true">${catMeta?.symbol || '📍'}</span>
					</div>
				`,
				iconSize: [30, 30],
				iconAnchor: [15, 15],
			});

			const marker = L.marker(place.coordinates, {
				icon: markerIcon,
				title: place.name,
			}).addTo(map!);

			// Clic sur marqueur
			marker.on('click', () => {
				selectPlace(place.id, true);
			});

			const markerElement = marker.getElement();
			if (markerElement) {
				markersById[place.id] = { marker, el: markerElement, place };
			}
		});

		// Mise à jour de la fiche détaillée d'un lieu
		function updatePlaceCard(place: PlaceData) {
			const catMeta = categories[place.category];
			const precisionMeta = precisionLabels[place.precision];

			const badgeCat = document.getElementById('card-badge-category');
			const badgeSymbol = document.getElementById('card-badge-symbol');
			const badgeLabel = document.getElementById('card-badge-label');
			const badgePrecision = document.getElementById('card-badge-precision');
			const badgeStatus = document.getElementById('card-badge-status');
			const titleEl = document.getElementById('card-place-name');
			const historicNameContainer = document.getElementById('card-historic-name');
			const historicNameVal = document.getElementById('card-historic-name-val');
			const shortDescEl = document.getElementById('card-short-desc');
			const poemsListEl = document.getElementById('card-poems-list');
			const quoteTextEl = document.getElementById('card-quote-text');
			const quoteRefEl = document.getElementById('card-quote-ref');
			const analysisTextEl = document.getElementById('card-analysis-text');
			const distinctionTextEl = document.getElementById('card-distinction-text');
			const sourcesTextEl = document.getElementById('card-sources-text');

			if (badgeCat && catMeta) {
				badgeCat.style.backgroundColor = catMeta.color;
			}
			if (badgeSymbol && catMeta) badgeSymbol.textContent = catMeta.symbol;
			if (badgeLabel && catMeta) badgeLabel.textContent = catMeta.label;
			if (badgePrecision && precisionMeta) badgePrecision.textContent = precisionMeta.label;
			if (badgeStatus) {
				if (place.epistemologicalStatus === 'atteste_texte') badgeStatus.textContent = '✓ Attesté par le texte';
				else if (place.epistemologicalStatus === 'source_historique') badgeStatus.textContent = '🏛️ Établi historiquement';
				else if (place.epistemologicalStatus === 'hypothese_argumentee') badgeStatus.textContent = '💡 Hypothèse critique';
				else badgeStatus.textContent = '✨ Espace symbolique';
			}
			if (titleEl) titleEl.textContent = place.name;

			if (historicNameContainer && historicNameVal) {
				if (place.historicName1870) {
					historicNameVal.textContent = place.historicName1870;
					historicNameContainer.style.display = 'block';
				} else {
					historicNameContainer.style.display = 'none';
				}
			}

			if (shortDescEl) shortDescEl.textContent = place.shortDescription;

			if (poemsListEl) {
				poemsListEl.innerHTML = place.poems
					.map((pid) => {
						const poemObj = poems.find((p) => p.id === pid);
						return `<span class="poem-tag">📜 <em>${poemObj?.title || pid}</em> (${poemObj?.dateWritten || '1870'})</span>`;
					})
					.join('');
			}

			if (quoteTextEl) quoteTextEl.textContent = `« ${place.quotation} »`;
			if (quoteRefEl) quoteRefEl.textContent = `— ${place.quotationReference}`;
			if (analysisTextEl) analysisTextEl.textContent = place.literaryAnalysis;
			if (distinctionTextEl) distinctionTextEl.textContent = place.historicalDistinction;
			if (sourcesTextEl) sourcesTextEl.textContent = `📚 ${place.documentarySources}`;
		}

		// Sélection d'un lieu
		function selectPlace(placeId: string, panMap: boolean = true) {
			selectedPlaceId = placeId;
			const place = places.find((p) => p.id === placeId);
			if (!place) return;

			// Mettre à jour l'apparence des marqueurs
			Object.entries(markersById).forEach(([id, { marker }]) => {
				const el = marker.getElement()?.querySelector('.rimbaud-pin-wrapper');
				if (el) {
					if (id === placeId) {
						el.classList.add('is-selected');
					} else {
						el.classList.remove('is-selected');
					}
				}
			});

			updatePlaceCard(place);

			// Recentrage de la carte si le lieu est géographique
			if (panMap && place.coordinates && map) {
				map.setView(place.coordinates, Math.max(map.getZoom(), 10), { animate: true });
			}
		}

		// Filtrage global (parcours, catégorie, poème)
		function applyFilters() {
			let visibleCount = 0;
			const bounds = L.latLngBounds([]);

			places.forEach((place) => {
				let matches = true;

				// 1. Filtre par parcours
				if (activePathId !== 'all') {
					const pathObj = readingPaths.find((rp) => rp.id === activePathId);
					if (pathObj && !pathObj.placeIds.includes(place.id)) {
						matches = false;
					}
				}

				// 2. Filtre par catégorie
				if (matches && activeCategoryFilter !== 'all') {
					if (place.category !== activeCategoryFilter) {
						matches = false;
					}
				}

				// 3. Filtre par poème
				if (matches && activePoemFilter !== 'all') {
					if (!place.poems.includes(activePoemFilter)) {
						matches = false;
					}
				}

				// Appliquer visibilité marqueur
				const markerEntry = markersById[place.id];
				if (markerEntry) {
					if (matches) {
						if (!map!.hasLayer(markerEntry.marker)) {
							markerEntry.marker.addTo(map!);
						}
						bounds.extend(place.coordinates!);
						visibleCount++;
					} else {
						if (map!.hasLayer(markerEntry.marker)) {
							map!.removeLayer(markerEntry.marker);
						}
					}
				} else if (place.category === 'imaginaire' && matches) {
					visibleCount++;
				}

				// Visibilité carte imaginaire
				const imaginaryCard = document.getElementById(`imaginary-item-${place.id}`);
				if (imaginaryCard) {
					imaginaryCard.style.display = matches ? 'block' : 'none';
				}
			});

			// Mise à jour du compteur live
			const liveCounter = document.getElementById('map-live-counter');
			if (liveCounter) {
				liveCounter.textContent = `Affichage de ${visibleCount} lieu${visibleCount > 1 ? 'x' : ''} sur ${places.length}`;
			}

			// Ajuster vue si marqueurs visibles
			if (bounds.isValid() && map) {
				map.fitBounds(bounds, { padding: [40, 40], maxZoom: 12 });
			}
		}

		// Événements boutons Parcours
		const pathPills = document.querySelectorAll<HTMLButtonElement>('.path-pill');
		pathPills.forEach((pill) => {
			pill.addEventListener('click', () => {
				const pathId = pill.dataset.pathId || 'all';
				activePathId = pathId;

				pathPills.forEach((p) => {
					p.classList.toggle('is-active', p === pill);
					p.setAttribute('aria-selected', p === pill ? 'true' : 'false');
				});

				// Mettre à jour le bandeau du parcours
				const bannerTitle = document.getElementById('active-path-title');
				const bannerDesc = document.getElementById('active-path-desc');
				const bannerBadge = document.getElementById('active-path-badge');

				if (pathId === 'all') {
					if (bannerTitle) bannerTitle.textContent = 'Vue panoramique complète';
					if (bannerDesc) {
						bannerDesc.innerHTML =
							'Explorez l’ensemble des 14 repères littéraires et biographiques des <em>Cahiers de Douai</em> : des bastions ardennais aux routes de Belgique, de la captivité de Mazas aux plaines révolutionnaires de Valmy.';
					}
					if (bannerBadge) bannerBadge.textContent = '14 repères · 22 poèmes';
				} else {
					const pathObj = readingPaths.find((rp) => rp.id === pathId);
					if (pathObj) {
						if (bannerTitle) bannerTitle.textContent = pathObj.title;
						if (bannerDesc) bannerDesc.textContent = pathObj.description;
						if (bannerBadge) bannerBadge.textContent = `${pathObj.placeIds.length} repères · ${pathObj.focus}`;
					}
				}

				applyFilters();
			});
		});

		// Événements boutons Catégorie
		const chipButtons = document.querySelectorAll<HTMLButtonElement>('.chip-button');
		chipButtons.forEach((chip) => {
			chip.addEventListener('click', () => {
				const cat = chip.dataset.categoryFilter || 'all';
				activeCategoryFilter = cat;

				chipButtons.forEach((c) => {
					c.classList.toggle('is-active', c === chip);
					c.setAttribute('aria-pressed', c === chip ? 'true' : 'false');
				});

				applyFilters();
			});
		});

		// Événement menu déroulant Poèmes
		const poemSelect = document.getElementById('poem-dropdown') as HTMLSelectElement | null;
		if (poemSelect) {
			poemSelect.addEventListener('change', () => {
				activePoemFilter = poemSelect.value;
				applyFilters();
			});
		}

		// Boutons utilitaires carte
		const btnRecenter = document.getElementById('btn-recenter-markers');
		if (btnRecenter) {
			btnRecenter.addEventListener('click', () => {
				applyFilters();
			});
		}

		const btnArdennes = document.getElementById('btn-reset-ardennes');
		if (btnArdennes && map) {
			btnArdennes.addEventListener('click', () => {
				map.setView([49.77, 4.72], 10, { animate: true });
			});
		}

		// Clic sur les cartes d'espaces imaginaires
		const imaginaryCards = document.querySelectorAll<HTMLElement>('.imaginary-card');
		imaginaryCards.forEach((card) => {
			card.addEventListener('click', () => {
				const placeId = card.dataset.placeId;
				if (placeId) selectPlace(placeId, false);
			});
			card.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					const placeId = card.dataset.placeId;
					if (placeId) selectPlace(placeId, false);
				}
			});
		});

		// Clic depuis le tableau textuel accessible
		const tableButtons = document.querySelectorAll<HTMLButtonElement>('.btn-select-from-table');
		tableButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const placeId = btn.dataset.selectPlace;
				if (placeId) {
					selectPlace(placeId, true);
					mapContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}
			});
		});

		// Initialisation initiale de la fiche
		updatePlaceCard(places[0]);
	}

	// Lancement après chargement du DOM
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initRimbaudMap);
	} else {
		initRimbaudMap();
	}
</script>
