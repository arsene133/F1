---
// Coupe architecturale narrative du 28, rue de Choiseul (Pot-Bouille)
// Représentation spatiale de l'immeuble bourgeois d'Émile Zola (1882) :
// étages, distribution rue/cour, escalier d'honneur, escalier de service,
// habitants et contrastes sociaux (façade honorable vs secrets privés).
import {
	potBouilleBuildingFloors,
	potBouilleExteriorSpace,
	type BuildingFloor,
	type BuildingRoom,
} from '../data/pot-bouille-building';
import { potBouilleCharacters } from '../data/pot-bouille';

interface Props {
	id?: string;
}

const { id = 'coupe-immeuble' } = Astro.props;

const charactersById = new Map(potBouilleCharacters.map((c) => [c.id, c]));

// Liste aplatie de toutes les pièces pour le sélecteur et l'index textuel
const allRooms: { floor: BuildingFloor; room: BuildingRoom }[] = [];
potBouilleBuildingFloors.forEach((f) => {
	f.rooms.forEach((r) => {
		allRooms.push({ floor: f, room: r });
	});
});
allRooms.push({
	floor: {
		id: 'exterieur',
		level: -2,
		name: 'Extérieur',
		subtitle: 'Le monde des grands magasins',
		carpet: 'Pavé parisien',
		rooms: [potBouilleExteriorSpace],
		circulationNote: 'Rue Neuve-Saint-Augustin / Rue de la Michodière',
	},
	room: potBouilleExteriorSpace,
});

// Données client pour interactions
const clientBuildingData = {
	floors: potBouilleBuildingFloors,
	exterior: potBouilleExteriorSpace,
	characters: Object.fromEntries(
		potBouilleCharacters.map((c) => [
			c.id,
			{
				id: c.id,
				label: c.label,
				caption: c.caption,
				eyebrow: c.eyebrow,
				color: c.color,
				tier: c.tier,
			},
		]),
	),
};
---

<section
	id={id}
	class="building-cutaway"
	aria-labelledby={`${id}-heading`}
	data-building-cutaway
>
	<script type="application/json" data-building-json set:html={JSON.stringify(clientBuildingData)} />

	<header class="cutaway-header">
		<p class="cutaway-eyebrow">Architecture spatiale & mœurs bourgeoises</p>
		<h2 id={`${id}-heading`}>Coupe de l’immeuble du 28, rue de Choiseul</h2>
		<p class="cutaway-sub">
			Explorez l’organisation verticale de la maison : du luxe trompeur des vestibules chauffés et des
			premiers étages nobles jusqu’au froid des combles où croupissent les domestiques.
		</p>
		<p class="cutaway-instructions">
			Sélectionnez une pièce ou un résident pour révéler les intrigues, secrets et contrastes de cet espace.
		</p>
	</header>

	<!-- Barre de filtres / modes de vue -->
	<nav class="cutaway-controls" aria-label="Filtres de la coupe architecturale">
		<span class="controls-label">Explorer par contraste :</span>
		<div class="controls-buttons" role="group">
			<button
				type="button"
				class="ctrl-btn is-active"
				data-filter="all"
				aria-pressed="true"
			>
				Tous les étages
			</button>
			<button
				type="button"
				class="ctrl-btn"
				data-filter="rue"
				aria-pressed="false"
			>
				Façade & rue (Apparences)
			</button>
			<button
				type="button"
				class="ctrl-btn"
				data-filter="cour"
				aria-pressed="false"
			>
				Cour & alcôves (Secrets)
			</button>
			<button
				type="button"
				class="ctrl-btn"
				data-filter="communs"
				aria-pressed="false"
			>
				Escaliers & Coulisses
			</button>
			<button
				type="button"
				class="ctrl-btn"
				data-filter="mouret"
				aria-pressed="false"
			>
				Lieux d’Octave Mouret
			</button>
		</div>
	</nav>

	<div class="cutaway-main-layout">
		<!-- Vue graphique de la coupe (Coupe architecturale haussmannienne réaliste) -->
		<div class="cutaway-elevation-wrapper">
			<!-- Bandeau supérieur d'orientation spatiale immédiate -->
			<div class="building-spatial-compass" aria-hidden="true">
				<div class="compass-side compass-street">
					<span class="compass-arrow">←</span>
					<span class="compass-title">FAÇADE RUE DE CHOISEUL</span>
					<span class="compass-sub">Apparences · Salons & Honneur</span>
				</div>
				<div class="compass-center">
					<span class="compass-divider">COUPE ARCHITECTURALE · 28, RUE DE CHOISEUL</span>
				</div>
				<div class="compass-side compass-court">
					<span class="compass-title">COUR INTÉRIEURE</span>
					<span class="compass-sub">Puits de jour · Secrets & Boyaux</span>
					<span class="compass-arrow">→</span>
				</div>
			</div>

			<!-- Toiture haussmannienne en coupe avec brisis d'ardoise, terrasson zinc, lucarnes et cheminées -->
			<div class="building-facade-roof" aria-hidden="true">
				<div class="roof-silhouette">
					<!-- Crête de toit décorative en zinc -->
					<div class="roof-cresting"></div>

					<!-- Souches de cheminée en brique et mitres en terre cuite sur les murs mitoyens -->
					<div class="chimneys">
						<div class="chimney chimney-left" title="Souche de cheminée en brique · mur mitoyen rue">
							<span class="chimney-cap"></span>
							<div class="chimney-pots">
								<span class="chimney-pot"></span>
								<span class="chimney-pot"></span>
							</div>
						</div>
						<div class="chimney chimney-right" title="Souche de cheminée en brique · mur mitoyen cour">
							<span class="chimney-cap"></span>
							<div class="chimney-pots">
								<span class="chimney-pot"></span>
								<span class="chimney-pot"></span>
							</div>
						</div>
					</div>

					<!-- Brisis en ardoise et terrasson en zinc avec lucarnes haussmanniennes -->
					<div class="roof-zinc">
						<div class="zinc-ridge"></div>
						<div class="roof-dormers">
							<div class="dormer" title="Lucarne mansardée en zinc">
								<span class="dormer-pediment"></span>
								<span class="dormer-window"></span>
							</div>
							<div class="dormer" title="Lucarne mansardée en zinc">
								<span class="dormer-pediment"></span>
								<span class="dormer-window"></span>
							</div>
							<div class="dormer" title="Lucarne mansardée en zinc">
								<span class="dormer-pediment"></span>
								<span class="dormer-window"></span>
							</div>
							<div class="dormer" title="Lucarne mansardée en zinc">
								<span class="dormer-pediment"></span>
								<span class="dormer-window"></span>
							</div>
						</div>
					</div>

					<!-- Corniche sous brisis avec modillons -->
					<div class="roof-cornice"></div>
				</div>
			</div>

			<!-- Corps du bâtiment : Coupe verticale des étages -->
			<div class="building-structure" role="region" aria-label="Coupe verticale des étages de l'immeuble">
				{potBouilleBuildingFloors.map((floor) => (
					<section
						class={`building-floor floor-${floor.id}`}
						data-floor-id={floor.id}
						data-floor-level={floor.level}
						aria-labelledby={`floor-label-${floor.id}`}
					>
						<!-- Plancher porteur et entablement de l'étage -->
						<div class="floor-slab" aria-hidden="true">
							<div class={`floor-slab-finish finish-${floor.id}`}></div>
							<div class="floor-slab-core"></div>
						</div>

						<!-- En-tête d'étage avec cartouche, tapis et mention architecturale -->
						<div class="floor-strip">
							<div class="floor-badge">
								<span class="floor-number" id={`floor-label-${floor.id}`}>{floor.name}</span>
								<span class="floor-carpet" title={floor.carpet}>
									{floor.level >= 1 && floor.level <= 3 ? '🔴 Tapis rouge d’honneur' : floor.level === 4 ? '⚪ Toile grise' : floor.level === 5 ? '🟡 Combles zinc' : floor.level === 0 ? '🟤 Entresol bas' : '🏛️ Vestibule faux marbre'}
								</span>
							</div>
							<div class="floor-specs" aria-hidden="true">
								<span class="floor-facade-note">{floor.facadeFeature || floor.subtitle}</span>
							</div>
						</div>

						<!-- Ligne de coupe : Façade rue à gauche, appartements au centre, cour à droite -->
						<div class="floor-sectional-container">
							<!-- Flanc gauche de façade sur rue avec balcon d'étage -->
							<aside class={`floor-flank flank-street flank-street-${floor.id}`} aria-hidden="true">
								<div class="flank-stone-wall">
									<span class="flank-stone-joint"></span>
									<span class="flank-stone-joint"></span>
								</div>
								{floor.level === 1 && (
									<div class="balcony-pier balcony-noble" title="Grand balcon en fonte ouvragée soutenu par des cariatides">
										<div class="balcony-rail">
											<svg viewBox="0 0 32 16" class="balcony-iron-svg" aria-hidden="true">
												<path d="M0,2 L32,2 M0,14 L32,14 M4,2 C4,8 12,8 12,14 M12,2 C12,8 4,8 4,14 M20,2 C20,8 28,8 28,14 M28,2 C28,8 20,8 20,14" fill="none" stroke="currentColor" stroke-width="1.2" />
											</svg>
										</div>
										<div class="balcony-console" title="Console sculptée"></div>
									</div>
								)}
								{floor.level === 3 && (
									<div class="balcony-pier balcony-standard" title="Balcon intermédiaire en pierre avec grille de fonte">
										<div class="balcony-rail">
											<svg viewBox="0 0 32 12" class="balcony-iron-svg" aria-hidden="true">
												<path d="M0,2 L32,2 M0,10 L32,10 M8,2 L8,10 M16,2 L16,10 M24,2 L24,10" fill="none" stroke="currentColor" stroke-width="1.2" />
											</svg>
										</div>
										<div class="balcony-console balcony-console-small"></div>
									</div>
								)}
								{floor.level === -1 && (
									<div class="cochere-arch" title="Arcade de la porte cochère en chêne à ferrures">
										<span class="arch-keystone"></span>
									</div>
								)}
							</aside>

							<!-- Distribution intérieure des pièces sur l'étage -->
							<div class="floor-rooms-row">
								{floor.rooms.map((room) => {
									const characters = room.characterIds
										.map((cid) => charactersById.get(cid))
										.filter(Boolean);

									return (
										<article
											class={`room-cell room-orient-${room.orientation} room-${room.id}`}
											data-room-id={room.id}
											data-orientation={room.orientation}
											data-character-ids={room.characterIds.join(' ')}
											tabindex="0"
											role="button"
											aria-expanded="false"
											aria-controls="cutaway-detail-panel"
										>
											<!-- Cordon de moulure de plafond -->
											<div class="room-cornice-top" aria-hidden="true"></div>

											<div class="room-cell-header">
												<span class={`room-tag tag-${room.orientation}`}>
													{room.orientation === 'rue' ? 'Façade Rue' : room.orientation === 'cour' ? 'Sur Cour' : room.orientation === 'communs' ? 'Circulation / Service' : 'Commerce'}
												</span>
												<h3 class="room-title">{room.title}</h3>
											</div>

											{room.subtitle && <p class="room-subtitle">{room.subtitle}</p>}

											{characters.length > 0 && (
												<div class="room-occupants" aria-label="Habitants de cette pièce">
													{characters.map((ch) => ch && (
														<span
															class="occupant-pill"
															style={`--occupant-color: ${ch.color};`}
															data-char-id={ch.id}
															title={`${ch.label} (${ch.caption})`}
														>
															<span class="occupant-dot"></span>
															<strong class="occupant-name">{ch.label}</strong>
														</span>
													))}
												</div>
											)}

											<p class="room-micro-desc">{room.description}</p>

											<!-- Parquet ou revêtement de sol d'appartement -->
											<div class="room-floor-base" aria-hidden="true"></div>
										</article>
									);
								})}
							</div>

							<!-- Flanc droit sur cour intérieure avec descente pluviale et baies de service -->
							<aside class={`floor-flank flank-court flank-court-${floor.id}`} aria-hidden="true">
								<div class="court-wall">
									<span class="court-downpipe"></span>
								</div>
							</aside>
						</div>
					</section>
				))}

				<!-- Espace extérieur rattaché : Au Bonheur des Dames -->
				<aside
					class="building-exterior-cell room-cell room-orient-commerce"
					data-room-id={potBouilleExteriorSpace.id}
					data-orientation="commerce"
					data-character-ids="caroline-hedouin"
					tabindex="0"
					role="button"
					aria-expanded="false"
					aria-controls="cutaway-detail-panel"
				>
					<div class="exterior-storefront-badge" aria-hidden="true">
						<span class="storefront-icon">🏛️</span>
						<span>Architecture commerciale moderne · Fer & Verre</span>
					</div>
					<div class="room-cell-header">
						<span class="room-tag tag-commerce">Extérieur · Nouveautés</span>
						<h3 class="room-title">{potBouilleExteriorSpace.title}</h3>
					</div>
					<p class="room-subtitle">{potBouilleExteriorSpace.subtitle}</p>
					<div class="room-occupants">
						{potBouilleExteriorSpace.characterIds
							.map((cid) => charactersById.get(cid))
							.filter(Boolean)
							.map((ch) => ch && (
								<span
									class="occupant-pill"
									style={`--occupant-color: ${ch.color};`}
									data-char-id={ch.id}
								>
									<span class="occupant-dot"></span>
									<strong class="occupant-name">{ch.label}</strong>
								</span>
							))}
					</div>
					<p class="room-micro-desc">{potBouilleExteriorSpace.description}</p>
				</aside>
			</div>

			<!-- Pied architectural du bâtiment : fondations et trottoir -->
			<div class="building-trottoir" aria-hidden="true">
				<div class="trottoir-pave">
					<div class="trottoir-street-side">
						<span class="street-plaque">28, RUE DE CHOISEUL · PARIS IIᵉ</span>
						<span class="pave-symbol">◆ Trottoir en granit & pavés de grès</span>
					</div>
					<div class="trottoir-court-side">
						<span class="court-pave-symbol">Pavés humides de la cour intérieure ◆</span>
					</div>
				</div>
				<div class="building-foundations">
					<span class="foundations-vaults">Caves particulières des locataires · Voûtes de meulière · Égout collecteur</span>
				</div>
			</div>
		</div>

		<!-- Panneau latéral d'analyse narrative détaillée -->
		<aside
			id="cutaway-detail-panel"
			class="cutaway-detail-panel"
			aria-live="polite"
			data-detail-panel
		>
			<div class="detail-placeholder" data-detail-placeholder>
				<div class="placeholder-icon" aria-hidden="true">🏛️</div>
				<h3>Sélectionnez une pièce ou un habitant</h3>
				<p>
					Cliquez sur un appartement, sur la loge ou sur l’un des résidents pour explorer les détails
					architecturaux, les citations de Zola et les intrigues qui s’y trament.
				</p>
				<div class="placeholder-tips">
					<p><strong>Repères de lecture zolienne :</strong></p>
					<ul>
						<li><strong>Façade sur rue :</strong> respectabilité, salons blanc et or, pianotages virtuoses.</li>
						<li><strong>Sur cour :</strong> chambres étouffantes, jalousies, adultères et calculs d’argent.</li>
						<li><strong>L’escalier :</strong> faux marbre et chaleur tiède en bas, mansardes glacées en haut.</li>
					</ul>
				</div>
			</div>

			<div class="detail-content is-hidden" data-detail-content>
				<header class="detail-header">
					<span class="detail-badge" data-detail-badge>Étage</span>
					<h3 class="detail-title" data-detail-title>Titre de la pièce</h3>
					<p class="detail-sub" data-detail-subtitle>Sous-titre</p>
				</header>

				<div class="detail-occupants-list" data-detail-occupants></div>

				<div class="detail-body">
					<p class="detail-description" data-detail-desc></p>

					<blockquote class="detail-quote" data-detail-quote-block>
						<p class="quote-text" data-detail-quote-text></p>
						<cite class="quote-source" data-detail-quote-source></cite>
					</blockquote>

					<div class="detail-secrets-block" data-detail-secrets-block>
						<h4>Sous le vernis bourgeois :</h4>
						<ul class="detail-secrets-list" data-detail-secrets-list></ul>
					</div>
				</div>

				<footer class="detail-footer">
					<button type="button" class="detail-reset-btn" data-detail-reset>
						Fermer les détails
					</button>
				</footer>
			</div>
		</aside>
	</div>

	<!-- Tableau récapitulatif textuel et accessible de la coupe pour lecteurs d'écran -->
	<details class="cutaway-accessible-index">
		<summary>Inventaire complet des étages et appartements de l’immeuble (version texte)</summary>
		<div class="accessible-table-wrapper">
			<table class="accessible-table">
				<thead>
					<tr>
						<th scope="col">Niveau</th>
						<th scope="col">Pièce ou appartement</th>
						<th scope="col">Orientation</th>
						<th scope="col">Résidents principaux</th>
						<th scope="col">Fonction narrative & satire</th>
					</tr>
				</thead>
				<tbody>
					{allRooms.map(({ floor, room }) => (
						<tr>
							<th scope="row">
								<strong>{floor.name}</strong>
								<br />
								<small>{floor.subtitle}</small>
							</th>
							<td>
								<strong>{room.title}</strong>
								{room.subtitle && <><br /><span>{room.subtitle}</span></>}
							</td>
							<td>{room.orientation === 'rue' ? 'Façade Rue' : room.orientation === 'cour' ? 'Sur Cour' : room.orientation === 'communs' ? 'Circulation / Service' : 'Commerce'}</td>
							<td>
								{room.characterIds.length > 0
									? room.characterIds
											.map((cid) => charactersById.get(cid)?.label)
											.filter(Boolean)
											.join(', ')
									: 'Aucun ou anonymes'}
							</td>
							<td>{room.description}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</details>
</section>

<script>
	function initBuildingCutaway() {
		const root = document.querySelector('[data-building-cutaway]');
		if (!root) return;

		const scriptTag = root.querySelector('[data-building-json]');
		if (!scriptTag) return;

		let buildingData: any = {};
		try {
			buildingData = JSON.parse(scriptTag.textContent || '{}');
		} catch (e) {
			console.error('Erreur chargement données de coupe', e);
			return;
		}

		const roomCells = root.querySelectorAll<HTMLElement>('.room-cell');
		const filterButtons = root.querySelectorAll<HTMLButtonElement>('.ctrl-btn');
		const detailPlaceholder = root.querySelector<HTMLElement>('[data-detail-placeholder]');
		const detailContent = root.querySelector<HTMLElement>('[data-detail-content]');
		const detailBadge = root.querySelector<HTMLElement>('[data-detail-badge]');
		const detailTitle = root.querySelector<HTMLElement>('[data-detail-title]');
		const detailSub = root.querySelector<HTMLElement>('[data-detail-subtitle]');
		const detailOccupants = root.querySelector<HTMLElement>('[data-detail-occupants]');
		const detailDesc = root.querySelector<HTMLElement>('[data-detail-desc]');
		const detailQuoteBlock = root.querySelector<HTMLElement>('[data-detail-quote-block]');
		const detailQuoteText = root.querySelector<HTMLElement>('[data-detail-quote-text]');
		const detailQuoteSource = root.querySelector<HTMLElement>('[data-detail-quote-source]');
		const detailSecretsBlock = root.querySelector<HTMLElement>('[data-detail-secrets-block]');
		const detailSecretsList = root.querySelector<HTMLElement>('[data-detail-secrets-list]');
		const detailResetBtn = root.querySelector<HTMLButtonElement>('[data-detail-reset]');

		// Index des pièces par ID
		const roomsById = new Map<string, { floor: any; room: any }>();
		buildingData.floors.forEach((f: any) => {
			f.rooms.forEach((r: any) => {
				roomsById.set(r.id, { floor: f, room: r });
			});
		});
		if (buildingData.exterior) {
			roomsById.set(buildingData.exterior.id, {
				floor: {
					name: 'Extérieur',
					subtitle: 'Rue Neuve-Saint-Augustin',
					carpet: 'Pavé parisien',
				},
				room: buildingData.exterior,
			});
		}

		let activeRoomId: string | null = null;

		function selectRoom(roomId: string | null) {
			activeRoomId = roomId;

			roomCells.forEach((cell) => {
				const isSelected = cell.dataset.roomId === roomId;
				cell.classList.toggle('is-selected', isSelected);
				cell.setAttribute('aria-expanded', isSelected ? 'true' : 'false');
			});

			if (!roomId || !roomsById.has(roomId)) {
				if (detailPlaceholder) detailPlaceholder.classList.remove('is-hidden');
				if (detailContent) detailContent.classList.add('is-hidden');
				return;
			}

			const data = roomsById.get(roomId)!;
			const { floor, room } = data;

			if (detailPlaceholder) detailPlaceholder.classList.add('is-hidden');
			if (detailContent) detailContent.classList.remove('is-hidden');

			if (detailBadge) {
				detailBadge.textContent = `${floor.name} · ${room.orientation === 'rue' ? 'Façade Rue' : room.orientation === 'cour' ? 'Sur Cour' : room.orientation === 'communs' ? 'Circulation' : 'Commerce'}`;
			}
			if (detailTitle) detailTitle.textContent = room.title;
			if (detailSub) detailSub.textContent = room.subtitle || floor.subtitle || '';
			if (detailDesc) detailDesc.textContent = room.description;

			// Occupants
			if (detailOccupants) {
				detailOccupants.innerHTML = '';
				const charIds: string[] = room.characterIds || [];
				if (charIds.length > 0) {
					charIds.forEach((cid) => {
						const ch = buildingData.characters[cid];
						if (ch) {
							const el = document.createElement('div');
							el.className = 'detail-occupant-card';
							el.style.borderColor = ch.color || '#888';
							el.innerHTML = `
								<span class="docc-dot" style="background:${ch.color}"></span>
								<div class="docc-text">
									<strong>${ch.label}</strong>
									<small>${ch.caption}</small>
								</div>
							`;
							detailOccupants.appendChild(el);
						}
					});
				}
			}

			// Citation
			if (detailQuoteBlock && detailQuoteText && detailQuoteSource) {
				if (room.quote && room.quote.text) {
					detailQuoteBlock.style.display = 'block';
					detailQuoteText.textContent = `« ${room.quote.text} »`;
					detailQuoteSource.textContent = `Émile Zola, Pot-Bouille (${room.quote.source})`;
				} else {
					detailQuoteBlock.style.display = 'none';
				}
			}

			// Secrets / satire
			if (detailSecretsBlock && detailSecretsList) {
				if (room.secrets && room.secrets.length > 0) {
					detailSecretsBlock.style.display = 'block';
					detailSecretsList.innerHTML = '';
					room.secrets.forEach((s: string) => {
						const li = document.createElement('li');
						li.textContent = s;
						detailSecretsList.appendChild(li);
					});
				} else {
					detailSecretsBlock.style.display = 'none';
				}
			}
		}

		// Gestion des clics sur les cellules
		roomCells.forEach((cell) => {
			const roomId = cell.dataset.roomId;
			if (!roomId) return;

			cell.addEventListener('click', () => {
				if (activeRoomId === roomId) {
					selectRoom(null);
				} else {
					selectRoom(roomId);
				}
			});

			cell.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					if (activeRoomId === roomId) {
						selectRoom(null);
					} else {
						selectRoom(roomId);
					}
				} else if (e.key === 'Escape') {
					selectRoom(null);
				}
			});
		});

		// Bouton réinitialiser
		if (detailResetBtn) {
			detailResetBtn.addEventListener('click', () => {
				selectRoom(null);
			});
		}

		// Filtres
		filterButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const filter = btn.dataset.filter || 'all';

				filterButtons.forEach((b) => {
					const isActive = b === btn;
					b.classList.toggle('is-active', isActive);
					b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
				});

				roomCells.forEach((cell) => {
					const orient = cell.dataset.orientation;
					const charIds = (cell.dataset.characterIds || '').split(' ');

					let visible = true;
					if (filter === 'all') {
						visible = true;
					} else if (filter === 'rue' || filter === 'cour' || filter === 'communs') {
						visible = orient === filter;
					} else if (filter === 'mouret') {
						visible = charIds.includes('mouret') || cell.dataset.roomId === 'chambre-octave';
					}

					cell.classList.toggle('is-dimmed', !visible);
				});
			});
		});
	}

	// Initialisation au chargement de la page et lors des navigations Astro
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initBuildingCutaway);
	} else {
		initBuildingCutaway();
	}
	document.addEventListener('astro:page-load', initBuildingCutaway);
</script>

