	.btn-select-from-text {
		margin-top: 0.5rem;
		padding: 0.35rem 0.75rem;
		font-family: inherit;
		font-size: 0.82rem;
		color: #172b3a;
		background: #f5f2eb;
		border: 1px solid var(--map-border, #dcd6cb);
		border-radius: 4px;
		cursor: pointer;
	}

	.btn-select-from-text:hover {
		background: #172b3a;
		color: #ffffff;
	}

	/* Marqueurs Leaflet personnalisés stylés en CSS pur ---------------------- */
	:global(.custom-balzac-marker) {
		background: transparent;
		border: none;
	}

	:global(.balzac-pin-wrapper) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--marker-color, #172b3a);
		border: 2px solid #ffffff;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
		color: #ffffff;
		font-weight: 700;
		font-size: 12px;
		line-height: 1;
		cursor: pointer;
		user-select: none;
		transition: transform 0.18s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.18s ease;
	}

	:global(.balzac-pin-wrapper:hover) {
		transform: scale(1.15);
		box-shadow: 0 3px 10px rgba(0, 0, 0, 0.45);
		z-index: 900 !important;
	}

	:global(.balzac-pin-wrapper.is-selected) {
		transform: scale(1.25);
		border-color: #ffd700;
		box-shadow: 0 0 0 3px rgba(255, 215, 0, 0.5), 0 4px 12px rgba(0, 0, 0, 0.5);
		z-index: 1000 !important;
	}
</style>

<!-- Script d'interactivité côté client -->
<script>
	import L from 'leaflet';
	import 'leaflet/dist/leaflet.css';

	interface PlaceData {
		id: string;
		name: string;
		subtitle: string;
		category: string;
		coordinates: [number, number];
		locationPrecision: 'exact' | 'approximate' | 'district';
		historicalAddress: string;
		modernLocation: string;
		characters: string[];
		narrativeRole: string;
		literaryAnalysis: string;
		observationPoint?: string;
		eventOrder: number;
		narrativeStepTitle: string;
		narrativeStepExplanation: string;
		quotation: string;
		quotationReference: string;
	}

	interface AppData {
		places: PlaceData[];
		categories: Record<string, { id: string; label: string; color: string }>;
		precisionLabels: Record<string, { label: string; description: string }>;
	}

	function initGoriotMap() {
		const dataScript = document.getElementById('goriot-places-data');
		if (!dataScript) return;

		let appData: AppData;
		try {
			appData = JSON.parse(dataScript.textContent || '{}');
		} catch (e) {
			console.error('Erreur de parsing des données du Père Goriot', e);
			return;
		}

		const { places, categories, precisionLabels } = appData;
		const mapContainer = document.getElementById('balzac-paris-map');
		if (!mapContainer) return;

		// Initialisation de Leaflet
		// Centre initial : Paris (entre le Quartier Latin et l'Opéra)
		const map = L.map(mapContainer, {
			center: [48.858, 2.348],
			zoom: 13,
			zoomControl: true,
			scrollWheelZoom: false, // Empêche le défilement intempestif sur mobile
		});

		// Fond de carte CartoDB Positron sobre et élégant avec clé API officielle
		L.tileLayer(
			'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?key=cb1_4hbo_1_0764a6788a577c5a3bff641e',
			{
				attribution:
					'&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions" target="_blank" rel="noopener">CARTO</a>',
				subdomains: 'abcd',
				maxZoom: 19,
			}
		).addTo(map);

		// État de l'application
		let currentMode: 'explore' | 'narrative' = 'explore';
		let activeFilter: string = 'all';
		let selectedPlaceId: string = places[0].id;
		let currentStepIndex: number = 0; // 0 à places.length - 1

		// Dictionnaire des marqueurs Leaflet
		const markersById: Record<string, { marker: L.Marker; el: HTMLElement; place: PlaceData }> = {};

		// Création des marqueurs personnalisés
		places.forEach((place) => {
			const cat = categories[place.category];
			const pinEl = document.createElement('div');
			pinEl.className = 'balzac-pin-wrapper';
			pinEl.style.setProperty('--marker-color', cat?.color || '#172b3a');
			pinEl.setAttribute('role', 'button');
			pinEl.setAttribute('aria-label', `${place.name} (${cat?.label})`);
			pinEl.tabIndex = 0;
			pinEl.innerHTML = `<span aria-hidden="true">${place.eventOrder}</span>`;

			const customIcon = L.divIcon({
				html: pinEl,
				className: 'custom-balzac-marker',
				iconSize: [28, 28],
				iconAnchor: [14, 14],
				popupAnchor: [0, -16],
			});

			const marker = L.marker(place.coordinates, {
				icon: customIcon,
				zIndexOffset: place.eventOrder * 10,
			});

			// Popup accessible Leaflet avec informations synthétiques
			marker.bindPopup(`
				<div style="font-family: inherit; font-size: 0.9rem; line-height: 1.4;">
					<strong style="color: ${cat?.color || '#172b3a'}; display: block; font-size: 0.75rem; text-transform: uppercase;">
						${cat?.label || ''}
					</strong>
					<h4 style="margin: 0.2rem 0 0.3rem; font-size: 1.05rem;">${place.name}</h4>
					<p style="margin: 0 0 0.4rem; color: #555; font-size: 0.85rem;">${place.subtitle}</p>
					<p style="margin: 0; font-size: 0.8rem;"><strong>Lieu :</strong> ${place.historicalAddress}</p>
				</div>
			`);

			marker.on('click', () => {
				selectPlace(place.id, { centerMap: false });
			});

			// Clavier sur le marqueur
			pinEl.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					selectPlace(place.id, { centerMap: true });
				}
			});

			marker.addTo(map);
			markersById[place.id] = { marker, el: pinEl, place };
		});

		// Fonction d'actualisation de la fiche lieu
		function updatePlaceCard(place: PlaceData) {
			const cat = categories[place.category];
			const prec = precisionLabels[place.locationPrecision];

			const catBadge = document.getElementById('card-badge-category');
			if (catBadge) {
				catBadge.textContent = cat?.label || place.category;
				catBadge.style.backgroundColor = cat?.color || '#172b3a';
			}

			const precBadge = document.getElementById('card-badge-precision');
			if (precBadge) {
				precBadge.textContent = prec?.label || place.locationPrecision;
				precBadge.title = prec?.description || '';
				precBadge.className = `badge-precision precision-${place.locationPrecision}`;
			}

			const titleEl = document.getElementById('card-place-title');
			if (titleEl) titleEl.textContent = place.name;

			const subEl = document.getElementById('card-place-subtitle');
			if (subEl) subEl.textContent = place.subtitle;

			const histEl = document.getElementById('card-historical-address');
			if (histEl) histEl.textContent = place.historicalAddress;

			const modEl = document.getElementById('card-modern-location');
			if (modEl) modEl.textContent = place.modernLocation;

			const charEl = document.getElementById('card-characters');
			if (charEl) charEl.textContent = place.characters.join(' · ');

			const narrEl = document.getElementById('card-narrative-role');
			if (narrEl) narrEl.textContent = place.narrativeRole;

			const litEl = document.getElementById('card-literary-analysis');
			if (litEl) litEl.textContent = place.literaryAnalysis;

			const obsBox = document.getElementById('card-observation-box');
			const obsText = document.getElementById('card-observation-text');
			if (obsBox && obsText) {
				if (place.observationPoint) {
					obsBox.hidden = false;
					obsText.textContent = place.observationPoint;
				} else {
					obsBox.hidden = true;
				}
			}

			const quoteText = document.getElementById('card-quote-text');
			if (quoteText) quoteText.textContent = `« ${place.quotation} »`;

			const quoteRef = document.getElementById('card-quote-ref');
			if (quoteRef) quoteRef.textContent = `— ${place.quotationReference}`;
		}

		// Sélectionner un lieu
		function selectPlace(placeId: string, options: { centerMap?: boolean; zoom?: number } = {}) {
			const item = markersById[placeId];
			if (!item) return;

			selectedPlaceId = placeId;
			const { place, marker, el } = item;

			// Mettre à jour les classes visuelles des pins
			Object.values(markersById).forEach(({ el: otherEl }) => {
				otherEl.classList.remove('is-selected');
			});
			el.classList.add('is-selected');

			// Mise à jour de la fiche latérale
			updatePlaceCard(place);

			// Ouvrir le popup du marqueur
			marker.openPopup();

			// Recentrage si demandé
			if (options.centerMap) {
				map.setView(place.coordinates, options.zoom || 14, { animate: true });
			}

			// Si en mode narratif, ajuster l'index du stepper
			const stepIdx = places.findIndex((p) => p.id === placeId);
			if (stepIdx !== -1) {
				currentStepIndex = stepIdx;
				updateNarrativeStepperUI();
			}
		}

		// Filtrage Mode A
		function applyFilter(filterId: string) {
			activeFilter = filterId;
			let visibleCount = 0;
			const visibleLatLngs: L.LatLngExpression[] = [];

			places.forEach((place) => {
				const item = markersById[place.id];
				if (!item) return;

				const isVisible = filterId === 'all' || place.category === filterId;
				if (isVisible) {
					if (!map.hasLayer(item.marker)) {
						map.addLayer(item.marker);
					}
					visibleLatLngs.push(place.coordinates);
					visibleCount++;
				} else {
					if (map.hasLayer(item.marker)) {
						map.removeLayer(item.marker);
					}
				}
			});

			const statusEl = document.getElementById('map-live-status');
			if (statusEl) {
				statusEl.textContent = `Affichage de ${visibleCount} lieu${visibleCount > 1 ? 'x' : ''} sur Paris`;
			}

			// Mettre à jour l'état visuel des boutons de filtres
			document.querySelectorAll('.chip-button').forEach((btn) => {
				const f = btn.getAttribute('data-filter');
				const isSelected = f === filterId;
				btn.classList.toggle('is-active', isSelected);
				btn.setAttribute('aria-pressed', String(isSelected));
			});

			// Si le lieu sélectionné n'est plus visible, sélectionner le premier lieu visible
			const currentItem = markersById[selectedPlaceId];
			if (currentItem && !map.hasLayer(currentItem.marker)) {
				const firstVisible = places.find(
					(p) => filterId === 'all' || p.category === filterId
				);
				if (firstVisible) {
					selectPlace(firstVisible.id, { centerMap: false });
				}
			}

			if (visibleLatLngs.length > 0) {
				map.fitBounds(L.latLngBounds(visibleLatLngs), { padding: [40, 40], maxZoom: 14 });
			}
		}

		// Mise à jour de l'UI du mode narratif
		function updateNarrativeStepperUI() {
			const curPlace = places[currentStepIndex];
			if (!curPlace) return;

			const stepIdxEl = document.getElementById('current-step-index');
			if (stepIdxEl) stepIdxEl.textContent = String(currentStepIndex + 1);

			const stepTitleEl = document.getElementById('current-step-title');
			if (stepTitleEl) stepTitleEl.textContent = curPlace.name;

			const stepExpEl = document.getElementById('current-step-explanation');
			if (stepExpEl) stepExpEl.textContent = curPlace.narrativeStepExplanation;

			const prevBtn = document.getElementById('narrative-prev-btn') as HTMLButtonElement;
			const nextBtn = document.getElementById('narrative-next-btn') as HTMLButtonElement;

			if (prevBtn) prevBtn.disabled = currentStepIndex === 0;
			if (nextBtn) nextBtn.disabled = currentStepIndex === places.length - 1;
		}

		// Bascule de mode
		function setMode(mode: 'explore' | 'narrative') {
			currentMode = mode;

			const tabExplore = document.getElementById('tab-mode-explore');
			const tabNarrative = document.getElementById('tab-mode-narrative');
			const panelExplore = document.getElementById('panel-explore');
			const panelNarrative = document.getElementById('panel-narrative');

			if (mode === 'explore') {
				tabExplore?.classList.add('is-active');
				tabExplore?.setAttribute('aria-selected', 'true');
				tabNarrative?.classList.remove('is-active');
				tabNarrative?.setAttribute('aria-selected', 'false');

				if (panelExplore) panelExplore.hidden = false;
				if (panelNarrative) panelNarrative.hidden = true;

				// Réappliquer le filtre courant
				applyFilter(activeFilter);
			} else {
				tabNarrative?.classList.add('is-active');
				tabNarrative?.setAttribute('aria-selected', 'true');
				tabExplore?.classList.remove('is-active');
				tabExplore?.setAttribute('aria-selected', 'false');

				if (panelNarrative) panelNarrative.hidden = false;
				if (panelExplore) panelExplore.hidden = true;

				// En mode narratif, s'assurer que tous les marqueurs sont sur la carte
				places.forEach((p) => {
					const item = markersById[p.id];
					if (item && !map.hasLayer(item.marker)) {
						map.addLayer(item.marker);
					}
				});

				updateNarrativeStepperUI();
				const target = places[currentStepIndex];
				if (target) {
					selectPlace(target.id, { centerMap: true, zoom: 14 });
				}
			}
		}

		// Événements boutons de mode
		document.getElementById('tab-mode-explore')?.addEventListener('click', () => setMode('explore'));
		document.getElementById('tab-mode-narrative')?.addEventListener('click', () => setMode('narrative'));

		// Événements filtres chips
		document.querySelectorAll('.chip-button').forEach((btn) => {
			btn.addEventListener('click', () => {
				const filter = btn.getAttribute('data-filter');
				if (filter) applyFilter(filter);
			});
		});

		// Événements navigation narrative
		document.getElementById('narrative-prev-btn')?.addEventListener('click', () => {
			if (currentStepIndex > 0) {
				currentStepIndex--;
				const p = places[currentStepIndex];
				selectPlace(p.id, { centerMap: true, zoom: 14 });
			}
		});

		document.getElementById('narrative-next-btn')?.addEventListener('click', () => {
			if (currentStepIndex < places.length - 1) {
				currentStepIndex++;
				const p = places[currentStepIndex];
				selectPlace(p.id, { centerMap: true, zoom: 14 });
			}
		});

		// Événements boutons utilitaires carte
		document.getElementById('btn-recenter-places')?.addEventListener('click', () => {
			const visibleMarkers = Object.values(markersById)
				.filter(({ marker }) => map.hasLayer(marker))
				.map(({ place }) => place.coordinates);
			if (visibleMarkers.length > 0) {
				map.fitBounds(L.latLngBounds(visibleMarkers), { padding: [40, 40], maxZoom: 14 });
			}
		});

		document.getElementById('btn-reset-paris')?.addEventListener('click', () => {
			map.setView([48.858, 2.348], 12, { animate: true });
		});

		// Événements boutons de sélection depuis l'alternative textuelle
		document.querySelectorAll('.btn-select-from-text').forEach((btn) => {
			btn.addEventListener('click', () => {
				const placeId = btn.getAttribute('data-select-place-id');
				if (placeId) {
					selectPlace(placeId, { centerMap: true, zoom: 15 });
					mapContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}
			});
		});

		// Sélection initiale
		selectPlace(initialPlace.id, { centerMap: false });
	}

	// Lancement après chargement du DOM
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initGoriotMap);
	} else {
		initGoriotMap();
	}
</script>
