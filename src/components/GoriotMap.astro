<!-- Script d'interactivité côté client -->
<script>
	import L from 'leaflet';
	import 'leaflet/dist/leaflet.css';

	interface HistoricalPoint {
		pixelOrig: [number, number];
		pixel3200: [number, number];
		percent: [number, number];
		leafletCoords: [number, number];
	}

	interface PlaceData {
		id: string;
		name: string;
		subtitle: string;
		category: string;
		coordinates: [number, number];
		historicalCoordinates: HistoricalPoint;
		locationPrecision: 'exact' | 'approximate' | 'district';
		historicalAddress: string;
		modernLocation: string;
		characters: string[];
		narrativeRole: string;
		literaryAnalysis: string;
		observationPoint?: string;
		eventOrder: number;
		narrativeStepTitle: string;
		narrativeStepExplanation: string;
		quotation: string;
		quotationReference: string;
	}

	interface MapConfig {
		title: string;
		author: string;
		publicationYear: number;
		sourceWork: string;
		collection: string;
		attribution: string;
		altText: string;
		imageSrc: string;
		width: number;
		height: number;
		originalWidth: number;
		originalHeight: number;
		geoBounds?: {
			southWest: [number, number];
			northEast: [number, number];
			center: [number, number];
		};
		zoomOffsetToEPSG3857?: number;
	}

	interface ModernMapConfig {
		title: string;
		tileUrl: string;
		subdomains: string;
		maxZoom: number;
		minZoom: number;
		defaultCenter: [number, number];
		defaultZoom: number;
		attribution: string;
		altText: string;
	}

	interface AppData {
		places: PlaceData[];
		categories: Record<string, { id: string; label: string; color: string }>;
		precisionLabels: Record<string, { label: string; description: string }>;
		mapConfig: MapConfig;
		modernMapConfig: ModernMapConfig;
	}

	function initGoriotMap() {
		const dataScript = document.getElementById('goriot-places-data');
		if (!dataScript) return;

		let appData: AppData;
		try {
			appData = JSON.parse(dataScript.textContent || '{}');
		} catch (e) {
			console.error('Erreur de parsing des données du Père Goriot', e);
			return;
		}

		const { places, categories, precisionLabels, mapConfig, modernMapConfig } = appData;
		const mapContainer = document.getElementById('balzac-paris-map');
		if (!mapContainer) return;

		// Dimensions de l'image historique (3200 × 2452 px)
		const imgW = mapConfig?.width || 3200;
		const imgH = mapConfig?.height || 2452;
		const historicalBounds: L.LatLngBoundsExpression = [
			[0, 0],
			[imgH, imgW],
		];

		// État de l'application
		let activeLayer: 'historical' | 'modern' = 'historical';
		let currentMode: 'explore' | 'narrative' = 'explore';
		let activeFilter: string = 'all';
		let selectedPlaceId: string = places[0].id;
		let currentStepIndex: number = 0; // 0 à places.length - 1

		let map: L.Map | null = null;
		let historicalOverlay: L.ImageOverlay | null = null;
		let modernTileLayer: L.TileLayer | null = null;

		// Dictionnaire des marqueurs Leaflet
		const markersById: Record<string, { marker: L.Marker; el: HTMLElement; place: PlaceData }> = {};

		// Fonctions de synchronisation et transformation géographique
		// Calibrées sur les 11 repères historiques et urbains de Paris sous la Restauration
		function geoToHistoricalSimple(lat: number, lng: number): [number, number] {
			const x = 24426.06 * lng - 619.08 * lat - 25401.01;
			const y = -515.95 * lng + 40473.25 * lat - 1974992.42;
			return [
				Math.max(0, Math.min(imgH, y)),
				Math.max(0, Math.min(imgW, x)),
			];
		}

		function historicalSimpleToGeo(y: number, x: number): [number, number] {
			const lng = 0.00004051 * x + 0.00000055 * y + 2.27823;
			const lat = 0.00000049 * x + 0.00002455 * y + 48.82678;
			return [lat, lng];
		}

		// Décalage théorique d'échelle entre CRS.Simple et Web Mercator EPSG:3857 (≈ 15.08)
		const ZOOM_OFFSET = mapConfig?.zoomOffsetToEPSG3857 || 15.08;

		function zoomHistoricalToModern(zHist: number): number {
			return Math.max(11, Math.min(19, zHist + ZOOM_OFFSET));
		}

		function zoomModernToHistorical(zMod: number): number {
			return Math.max(-2, Math.min(2, zMod - ZOOM_OFFSET));
		}

		// Initialisation ou recréation de l'instance Leaflet selon le système de projection (CRS)
		function setupMapInstance(
			layer: 'historical' | 'modern',
			preserveView = false,
			previousView?: { centerGeo: [number, number]; zoomScale: number }
		) {
			if (map) {
				map.closePopup();
				map.stop();
				Object.values(markersById).forEach(({ marker }) => {
					marker.remove();
				});
				map.remove();
				map = null;
				historicalOverlay = null;
				modernTileLayer = null;
			}

			if (layer === 'historical') {
				// Projection plane CRS.Simple pour le plan historique de 1821
				map = L.map(mapContainer, {
					crs: L.CRS.Simple,
					minZoom: -2,
					maxZoom: 2,
					zoomSnap: 0.1,
					zoomDelta: 0.5,
					zoomControl: true,
					scrollWheelZoom: false,
					attributionControl: true,
					maxBounds: [
						[-imgH * 0.2, -imgW * 0.2],
						[imgH * 1.2, imgW * 1.2],
					],
					maxBoundsViscosity: 0.8,
				});

				historicalOverlay = L.imageOverlay(mapConfig?.imageSrc || '/images/plan-maire-paris-1821.webp', historicalBounds, {
					attribution: mapConfig?.attribution || 'Plan lavé topographiquement de Paris, N. M. Maire, 1821 — David Rumsey Historical Map Collection',
					alt: mapConfig?.altText || 'Plan historique de Paris par N. M. Maire (1821)',
					interactive: false,
				}).addTo(map);

				mapContainer.setAttribute('aria-label', 'Carte interactive historique de Paris (1821)');
			} else {
				// Projection géographique moderne EPSG:3857 (Spherical Mercator) pour CARTO Positron
				map = L.map(mapContainer, {
					crs: L.CRS.EPSG3857,
					minZoom: modernMapConfig?.minZoom || 11,
					maxZoom: modernMapConfig?.maxZoom || 19,
					zoomSnap: 0.1,
					zoomDelta: 0.5,
					zoomControl: true,
					scrollWheelZoom: false,
					attributionControl: true,
				});

				modernTileLayer = L.tileLayer(
					modernMapConfig?.tileUrl || 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
					{
						attribution:
							modernMapConfig?.attribution ||
							'&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors',
						subdomains: modernMapConfig?.subdomains || 'abc',
						maxZoom: modernMapConfig?.maxZoom || 19,
					}
				).addTo(map);

				mapContainer.setAttribute('aria-label', 'Carte interactive contemporaine de Paris');
			}

			// Création ou repositionnement des marqueurs Leaflet avec les coordonnées adaptées
			places.forEach((place) => {
				const cat = categories[place.category];
				const pinEl = document.createElement('div');
				pinEl.className = 'balzac-pin-wrapper';
				if (place.id === selectedPlaceId) {
					pinEl.classList.add('is-selected');
				}
				pinEl.style.setProperty('--marker-color', cat?.color || '#172b3a');
				pinEl.setAttribute('role', 'button');
				pinEl.setAttribute('aria-label', `${place.name} (${cat?.label})`);
				pinEl.tabIndex = 0;
				pinEl.innerHTML = `<span aria-hidden="true">${place.eventOrder}</span>`;

				const customIcon = L.divIcon({
					html: pinEl,
					className: 'custom-balzac-marker',
					iconSize: [28, 28],
					iconAnchor: [14, 14],
					popupAnchor: [0, -16],
				});

				// Coordonnées : CRS.Simple pour 1821, géographiques [lat, lng] pour moderne
				const markerCoords: L.LatLngExpression =
					layer === 'historical'
						? place.historicalCoordinates?.leafletCoords || [imgH / 2, imgW / 2]
						: place.coordinates;

				const marker = L.marker(markerCoords, {
					icon: customIcon,
					zIndexOffset: place.eventOrder * 10,
				});

				marker.bindPopup(`
					<div style="font-family: inherit; font-size: 0.9rem; line-height: 1.4;">
						<strong style="color: ${cat?.color || '#172b3a'}; display: block; font-size: 0.75rem; text-transform: uppercase;">
							${cat?.label || ''}
						</strong>
						<h4 style="margin: 0.2rem 0 0.3rem; font-size: 1.05rem;">${place.name}</h4>
						<p style="margin: 0 0 0.4rem; color: #555; font-size: 0.85rem;">${place.subtitle}</p>
						<p style="margin: 0; font-size: 0.8rem;"><strong>${layer === 'historical' ? 'Lieu (1821) :' : 'Adresse actuelle :'}</strong> ${layer === 'historical' ? place.historicalAddress : place.modernLocation}</p>
					</div>
				`);

				marker.on('click', () => {
					selectPlace(place.id, { centerMap: false });
				});

				pinEl.addEventListener('click', (e) => {
					e.stopPropagation();
					selectPlace(place.id, { centerMap: false });
				});

				pinEl.addEventListener('keydown', (e) => {
					if (e.key === 'Enter' || e.key === ' ') {
						e.preventDefault();
						selectPlace(place.id, { centerMap: true });
					}
				});

				markersById[place.id] = { marker, el: pinEl, place };

				// Vérifier si le marqueur doit être affiché selon le filtre actif
				const isVisible = currentMode === 'narrative' || activeFilter === 'all' || place.category === activeFilter;
				if (isVisible) {
					marker.addTo(map!);
				}
			});

			// Ajustement de la vue (synchronisation géographique si preserveView = true)
			if (preserveView && previousView) {
				if (layer === 'historical') {
					const [lat, lng] = previousView.centerGeo;
					const [y, x] = geoToHistoricalSimple(lat, lng);
					const targetZoom = zoomModernToHistorical(previousView.zoomScale);
					map.setView([y, x], targetZoom, { animate: false });
				} else {
					const targetZoom = zoomHistoricalToModern(previousView.zoomScale);
					map.setView(previousView.centerGeo, targetZoom, { animate: false });
				}
			} else {
				if (layer === 'historical') {
					map.fitBounds(historicalBounds, { padding: [10, 10] });
				} else {
					const allGeoCoords = places.map((p) => p.coordinates);
					map.fitBounds(L.latLngBounds(allGeoCoords), { padding: [35, 35] });
				}
			}

			// Garantir le bon calcul des dimensions du conteneur après le basculement
			setTimeout(() => {
				map?.invalidateSize();
			}, 50);
		}

		// Fonction d'actualisation de la fiche lieu
		function updatePlaceCard(place: PlaceData) {
			const cat = categories[place.category];
			const prec = precisionLabels[place.locationPrecision];

			const catBadge = document.getElementById('card-badge-category');
			if (catBadge) {
				catBadge.textContent = cat?.label || place.category;
				catBadge.style.backgroundColor = cat?.color || '#172b3a';
			}

			const precBadge = document.getElementById('card-badge-precision');
			if (precBadge) {
				precBadge.textContent = prec?.label || place.locationPrecision;
				precBadge.title = prec?.description || '';
				precBadge.className = `badge-precision precision-${place.locationPrecision}`;
			}

			const titleEl = document.getElementById('card-place-title');
			if (titleEl) titleEl.textContent = place.name;

			const subEl = document.getElementById('card-place-subtitle');
			if (subEl) subEl.textContent = place.subtitle;

			const histEl = document.getElementById('card-historical-address');
			if (histEl) histEl.textContent = place.historicalAddress;

			const modEl = document.getElementById('card-modern-location');
			if (modEl) modEl.textContent = place.modernLocation;

			const charEl = document.getElementById('card-characters');
			if (charEl) charEl.textContent = place.characters.join(' · ');

			const narrEl = document.getElementById('card-narrative-role');
			if (narrEl) narrEl.textContent = place.narrativeRole;

			const litEl = document.getElementById('card-literary-analysis');
			if (litEl) litEl.textContent = place.literaryAnalysis;

			const obsBox = document.getElementById('card-observation-box');
			const obsText = document.getElementById('card-observation-text');
			if (obsBox && obsText) {
				if (place.observationPoint) {
					obsBox.hidden = false;
					obsText.textContent = place.observationPoint;
				} else {
					obsBox.hidden = true;
				}
			}

			const quoteText = document.getElementById('card-quote-text');
			if (quoteText) quoteText.textContent = `« ${place.quotation} »`;

			const quoteRef = document.getElementById('card-quote-ref');
			if (quoteRef) quoteRef.textContent = `— ${place.quotationReference}`;
		}

		// Sélectionner un lieu
		function selectPlace(
			placeId: string,
			options: { centerMap?: boolean; zoom?: number; openPopup?: boolean; animate?: boolean } = {}
		) {
			const item = markersById[placeId];
			if (!item || !map) return;

			selectedPlaceId = placeId;
			const { place, marker, el } = item;

			// Mettre à jour les classes visuelles des pins
			Object.values(markersById).forEach(({ el: otherEl }) => {
				otherEl.classList.remove('is-selected');
			});
			el.classList.add('is-selected');

			// Mise à jour de la fiche latérale
			updatePlaceCard(place);

			// Ouvrir le popup du marqueur si explicitement demandé (par défaut true lors d'un clic/interaction)
			if (options.openPopup !== false) {
				marker.openPopup();
			}

			// Recentrage si demandé
			if (options.centerMap) {
				const defaultZoom = activeLayer === 'historical' ? 0.5 : zoomHistoricalToModern(0.5);
				const targetZoom = options.zoom !== undefined ? options.zoom : Math.max(map.getZoom(), defaultZoom);
				const shouldAnimate = options.animate !== false;
				map.setView(marker.getLatLng(), targetZoom, { animate: shouldAnimate });
			}

			// Si en mode narratif, ajuster l'index du stepper
			const stepIdx = places.findIndex((p) => p.id === placeId);
			if (stepIdx !== -1) {
				currentStepIndex = stepIdx;
				updateNarrativeStepperUI();
			}
		}

		// Filtrage Mode A
		function applyFilter(filterId: string) {
			if (!map) return;
			activeFilter = filterId;
			let visibleCount = 0;
			const visibleLatLngs: L.LatLng[] = [];

			places.forEach((place) => {
				const item = markersById[place.id];
				if (!item) return;

				const isVisible = filterId === 'all' || place.category === filterId;
				if (isVisible) {
					if (!map!.hasLayer(item.marker)) {
						map!.addLayer(item.marker);
					}
					visibleLatLngs.push(item.marker.getLatLng());
					visibleCount++;
				} else {
					if (map!.hasLayer(item.marker)) {
						map!.removeLayer(item.marker);
					}
				}
			});

			const statusEl = document.getElementById('map-live-status');
			if (statusEl) {
				statusEl.textContent = `Affichage de ${visibleCount} lieu${visibleCount > 1 ? 'x' : ''} sur Paris`;
			}

			// Mettre à jour l'état visuel des boutons de filtres
			document.querySelectorAll('.chip-button').forEach((btn) => {
				const f = btn.getAttribute('data-filter');
				const isSelected = f === filterId;
				btn.classList.toggle('is-active', isSelected);
				btn.setAttribute('aria-pressed', String(isSelected));
			});

			// Si le lieu sélectionné n'est plus visible, sélectionner le premier lieu visible
			const currentItem = markersById[selectedPlaceId];
			if (currentItem && !map.hasLayer(currentItem.marker)) {
				const firstVisible = places.find(
					(p) => filterId === 'all' || p.category === filterId
				);
				if (firstVisible) {
					selectPlace(firstVisible.id, { centerMap: false });
				}
			}

			if (visibleLatLngs.length > 0) {
				const maxZ = activeLayer === 'historical' ? 0.5 : zoomHistoricalToModern(0.5);
				map.fitBounds(L.latLngBounds(visibleLatLngs), { padding: [40, 40], maxZoom: maxZ });
			}
		}

		// Mise à jour de l'UI du mode narratif
		function updateNarrativeStepperUI() {
			const curPlace = places[currentStepIndex];
			if (!curPlace) return;

			const stepIdxEl = document.getElementById('current-step-index');
			if (stepIdxEl) stepIdxEl.textContent = String(currentStepIndex + 1);

			const stepTitleEl = document.getElementById('current-step-title');
			if (stepTitleEl) stepTitleEl.textContent = curPlace.name;

			const stepExpEl = document.getElementById('current-step-explanation');
			if (stepExpEl) stepExpEl.textContent = curPlace.narrativeStepExplanation;

			const prevBtn = document.getElementById('narrative-prev-btn') as HTMLButtonElement;
			const nextBtn = document.getElementById('narrative-next-btn') as HTMLButtonElement;

			if (prevBtn) prevBtn.disabled = currentStepIndex === 0;
			if (nextBtn) nextBtn.disabled = currentStepIndex === places.length - 1;
		}

		// Bascule de mode
		function setMode(mode: 'explore' | 'narrative') {
			if (!map) return;
			currentMode = mode;

			const tabExplore = document.getElementById('tab-mode-explore');
			const tabNarrative = document.getElementById('tab-mode-narrative');
			const panelExplore = document.getElementById('panel-explore');
			const panelNarrative = document.getElementById('panel-narrative');

			if (mode === 'explore') {
				tabExplore?.classList.add('is-active');
				tabExplore?.setAttribute('aria-selected', 'true');
				tabNarrative?.classList.remove('is-active');
				tabNarrative?.setAttribute('aria-selected', 'false');

				if (panelExplore) panelExplore.hidden = false;
				if (panelNarrative) panelNarrative.hidden = true;

				// Réappliquer le filtre courant
				applyFilter(activeFilter);
			} else {
				tabNarrative?.classList.add('is-active');
				tabNarrative?.setAttribute('aria-selected', 'true');
				tabExplore?.classList.remove('is-active');
				tabExplore?.setAttribute('aria-selected', 'false');

				if (panelNarrative) panelNarrative.hidden = false;
				if (panelExplore) panelExplore.hidden = true;

				// En mode narratif, s'assurer que tous les marqueurs sont sur la carte
				places.forEach((p) => {
					const item = markersById[p.id];
					if (item && !map!.hasLayer(item.marker)) {
						map!.addLayer(item.marker);
					}
				});

				updateNarrativeStepperUI();
				const target = places[currentStepIndex];
				if (target) {
					const defaultZoom = activeLayer === 'historical' ? 0.5 : zoomHistoricalToModern(0.5);
					selectPlace(target.id, { centerMap: true, zoom: defaultZoom });
				}
			}
		}

		// Bascule de fond de carte (1821 vs Moderne)
		function setLayer(layer: 'historical' | 'modern') {
			if (activeLayer === layer) return;
			const previousLayer = activeLayer;
			activeLayer = layer;

			// Capture de la vue géographique courante avant destruction de l'ancienne carte
			let previousView: { centerGeo: [number, number]; zoomScale: number } | undefined;
			if (map) {
				const center = map.getCenter();
				const zoom = map.getZoom();
				if (previousLayer === 'historical') {
					// L'ancienne carte était 'historical' (center = [y, x] en CRS.Simple)
					const [lat, lng] = historicalSimpleToGeo(center.lat, center.lng);
					previousView = {
						centerGeo: [lat, lng],
						zoomScale: zoom,
					};
				} else {
					// L'ancienne carte était 'modern' (center = [lat, lng] en EPSG:3857)
					previousView = {
						centerGeo: [center.lat, center.lng],
						zoomScale: zoom,
					};
				}
			}

			const btnHist = document.getElementById('btn-layer-historical');
			const btnMod = document.getElementById('btn-layer-modern');
			const creditHist = document.getElementById('credit-historical-map');
			const creditMod = document.getElementById('credit-modern-map');

			if (layer === 'historical') {
				btnHist?.classList.add('is-active');
				btnHist?.setAttribute('aria-checked', 'true');
				btnHist?.setAttribute('tabindex', '0');
				btnMod?.classList.remove('is-active');
				btnMod?.setAttribute('aria-checked', 'false');
				btnMod?.setAttribute('tabindex', '-1');

				if (creditHist) creditHist.hidden = false;
				if (creditMod) creditMod.hidden = true;
			} else {
				btnMod?.classList.add('is-active');
				btnMod?.setAttribute('aria-checked', 'true');
				btnMod?.setAttribute('tabindex', '0');
				btnHist?.classList.remove('is-active');
				btnHist?.setAttribute('aria-checked', 'false');
				btnHist?.setAttribute('tabindex', '-1');

				if (creditMod) creditMod.hidden = false;
				if (creditHist) creditHist.hidden = true;
			}

			// Recréer l'instance Leaflet avec le CRS approprié en préservant l'échelle géographique et le centre
			setupMapInstance(layer, Boolean(previousView), previousView);

			// Mettre à jour l'état visuel du marqueur sélectionné sans forcer un autre niveau de zoom
			if (selectedPlaceId) {
				const currentItem = markersById[selectedPlaceId];
				if (currentItem && map?.hasLayer(currentItem.marker)) {
					selectPlace(selectedPlaceId, { centerMap: false, openPopup: false });
				}
			}
		}

		// Initialisation du fond de carte par défaut (1821)
		setupMapInstance('historical');

		// Événements boutons de fond de carte
		const btnLayerHist = document.getElementById('btn-layer-historical');
		const btnLayerMod = document.getElementById('btn-layer-modern');

		btnLayerHist?.addEventListener('click', () => setLayer('historical'));
		btnLayerMod?.addEventListener('click', () => setLayer('modern'));

		// Gestion de l'accessibilité clavier (Touches fléchées dans le radiogroup)
		const layerRadiogroup = document.querySelector('.map-layer-switch');
		layerRadiogroup?.addEventListener('keydown', (e) => {
			const evt = e as KeyboardEvent;
			if (evt.key === 'ArrowRight' || evt.key === 'ArrowDown') {
				evt.preventDefault();
				setLayer('modern');
				btnLayerMod?.focus();
			} else if (evt.key === 'ArrowLeft' || evt.key === 'ArrowUp') {
				evt.preventDefault();
				setLayer('historical');
				btnLayerHist?.focus();
			}
		});

		// Événements boutons de mode
		document.getElementById('tab-mode-explore')?.addEventListener('click', () => setMode('explore'));
		document.getElementById('tab-mode-narrative')?.addEventListener('click', () => setMode('narrative'));

		// Événements filtres chips
		document.querySelectorAll('.chip-button').forEach((btn) => {
			btn.addEventListener('click', () => {
				const filter = btn.getAttribute('data-filter');
				if (filter) applyFilter(filter);
			});
		});

		// Événements navigation narrative
		document.getElementById('narrative-prev-btn')?.addEventListener('click', () => {
			if (currentStepIndex > 0) {
				currentStepIndex--;
				const p = places[currentStepIndex];
				const defaultZoom = activeLayer === 'historical' ? 0.5 : zoomHistoricalToModern(0.5);
				selectPlace(p.id, { centerMap: true, zoom: defaultZoom });
			}
		});

		document.getElementById('narrative-next-btn')?.addEventListener('click', () => {
			if (currentStepIndex < places.length - 1) {
				currentStepIndex++;
				const p = places[currentStepIndex];
				const defaultZoom = activeLayer === 'historical' ? 0.5 : zoomHistoricalToModern(0.5);
				selectPlace(p.id, { centerMap: true, zoom: defaultZoom });
			}
		});

		// Événements boutons utilitaires carte
		document.getElementById('btn-recenter-places')?.addEventListener('click', () => {
			if (!map) return;
			const visibleMarkers = Object.values(markersById)
				.filter(({ marker }) => map!.hasLayer(marker))
				.map(({ marker }) => marker.getLatLng());
			if (visibleMarkers.length > 0) {
				const maxZ = activeLayer === 'historical' ? 0.5 : zoomHistoricalToModern(0.5);
				map.fitBounds(L.latLngBounds(visibleMarkers), { padding: [40, 40], maxZoom: maxZ });
			}
		});

		document.getElementById('btn-reset-paris')?.addEventListener('click', () => {
			if (!map) return;
			if (activeLayer === 'historical') {
				map.fitBounds(historicalBounds, { padding: [10, 10] });
			} else {
				// Cadrage moderne sur l'emprise historique équivalente de Paris 1821
				const gb = mapConfig?.geoBounds;
				if (gb) {
					map.fitBounds([gb.southWest, gb.northEast], { padding: [10, 10] });
				} else {
					map.setView(modernMapConfig?.defaultCenter || [48.8577, 2.3437], 12.8);
				}
			}
		});

		// Événements boutons de sélection depuis l'alternative textuelle
		document.querySelectorAll('.btn-select-from-text').forEach((btn) => {
			btn.addEventListener('click', () => {
				const placeId = btn.getAttribute('data-select-place-id');
				if (placeId) {
					const defaultZoom = activeLayer === 'historical' ? 0.5 : zoomHistoricalToModern(0.5);
					selectPlace(placeId, { centerMap: true, zoom: defaultZoom });
					mapContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}
			});
		});

		// Sélection initiale
		if (places.length > 0) {
			selectPlace(places[0].id, { centerMap: false, openPopup: false });
		}
	}

	// Lancement après chargement du DOM
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initGoriotMap);
	} else {
		initGoriotMap();
	}
</script>
