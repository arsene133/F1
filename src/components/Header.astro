---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

interface LiteraryWork {
	href: string;
	title: string;
	author: string;
	date: string;
	tag: string;
}

const literaryWorks: LiteraryWork[] = [
	{
		href: '/don-juan',
		title: 'Dom Juan',
		author: 'Molière',
		date: '1665',
		tag: 'Personnages & thèmes',
	},
	{
		href: '/graffigny',
		title: 'Lettres d’une Péruvienne',
		author: 'Françoise de Graffigny',
		date: '1747–1752',
		tag: 'Cartographie & récit',
	},
	{
		href: '/goriot',
		title: 'Le Père Goriot',
		author: 'Honoré de Balzac',
		date: '1835',
		tag: 'Lieux & thèmes',
	},
	{
		href: '/on-ne-badine-pas-avec-l-amour',
		title: 'On ne badine pas avec l’amour',
		author: 'Alfred de Musset',
		date: '1834',
		tag: 'Personnages',
	},
	{
		href: '/rimbaud',
		title: 'Cahiers de Douai',
		author: 'Arthur Rimbaud',
		date: '1870',
		tag: 'Cartographie littéraire',
	},
	{
		href: '/balzac-rimbaud',
		title: 'Balzac & Rimbaud',
		author: 'Balzac · Marx · Rimbaud',
		date: '1835–1871',
		tag: 'Parcours croisé',
	},
	{
		href: '/pot-bouille',
		title: 'Pot-Bouille',
		author: 'Émile Zola',
		date: '1882',
		tag: 'Personnages & immeuble',
	},
];

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const currentSection = '/' + (subpath?.[0] || '');
const isWorkActive = literaryWorks.some(
	(w) => w.href === currentSection || pathname === w.href || pathname.startsWith(w.href + '/')
);
---

<header>
	<nav aria-label="Navigation principale">
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Accueil</HeaderLink>
			<HeaderLink href="/chronologie">Chronologie</HeaderLink>

			<details class="dropdown" id="works-dropdown">
				<summary
					class:list={['dropdown-toggle', { active: isWorkActive }]}
					aria-haspopup="true"
				>
					<span>Œuvres &amp; auteurs</span>
					<svg
						class="dropdown-chevron"
						viewBox="0 0 16 16"
						width="12"
						height="12"
						aria-hidden="true"
						focusable="false"
					>
						<path
							fill="currentColor"
							d="M3.2 5.5a.8.8 0 0 1 1.13 0L8 9.17l3.67-3.67a.8.8 0 1 1 1.13 1.13l-4.24 4.24a.8.8 0 0 1-1.13 0L3.2 6.63a.8.8 0 0 1 0-1.13z"
						></path>
					</svg>
				</summary>
				<ul class="dropdown-menu" role="menu">
					{literaryWorks.map((work) => {
						const isItemActive =
							work.href === currentSection ||
							pathname === work.href ||
							pathname.startsWith(work.href + '/');
						return (
							<li role="none">
								<a
									href={work.href}
									role="menuitem"
									class:list={['dropdown-item', { active: isItemActive }]}
								>
									<span class="work-title">{work.title}</span>
									<span class="work-meta">
										<span class="work-author">{work.author}</span>
										<span class="work-sep">·</span>
										<span class="work-date">{work.date}</span>
									</span>
								</a>
							</li>
						);
					})}
				</ul>
			</details>

			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>

		<div class="social-links">
			<a href="https://m.webtoo.ls/@astro" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Suivre Astro sur Mastodon</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path
						fill="currentColor"
						d="M11.19 12.195c2.016-.24 3.77-1.475 3.99-2.603.348-1.778.32-4.339.32-4.339 0-3.47-2.286-4.488-2.286-4.488C12.062.238 10.083.017 8.027 0h-.05C5.92.017 3.942.238 2.79.765c0 0-2.285 1.017-2.285 4.488l-.002.662c-.004.64-.007 1.35.011 2.091.083 3.394.626 6.74 3.78 7.57 1.454.383 2.703.463 3.709.408 1.823-.1 2.847-.647 2.847-.647l-.06-1.317s-1.303.41-2.767.36c-1.45-.05-2.98-.156-3.215-1.928a3.614 3.614 0 0 1-.033-.496s1.424.346 3.228.428c1.103.05 2.137-.064 3.188-.189zm1.613-2.47H11.13v-4.08c0-.859-.364-1.295-1.091-1.295-.804 0-1.207.517-1.207 1.541v2.233H7.168V5.89c0-1.024-.403-1.541-1.207-1.541-.727 0-1.091.436-1.091 1.296v4.079H3.197V5.522c0-.859.22-1.541.66-2.046.456-.505 1.052-.764 1.793-.764.856 0 1.504.328 1.933.983L8 4.39l.417-.695c.429-.655 1.077-.983 1.934-.983.74 0 1.336.259 1.791.764.442.505.661 1.187.661 2.046v4.203z"
					></path>
				</svg>
			</a>
			<a href="https://twitter.com/astrodotbuild" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Suivre Astro sur Twitter</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path
						fill="currentColor"
						d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
					></path>
				</svg>
			</a>
			<a href="https://github.com/withastro/astro" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Accéder au dépôt GitHub d’Astro</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<script>
	// Gestion accessible du menu déroulant
	function setupDropdown() {
		const dropdown = document.getElementById('works-dropdown') as HTMLDetailsElement | null;
		if (!dropdown) return;

		// Fermer au clic en dehors
		document.addEventListener('click', (e) => {
			if (!dropdown.open) return;
			const target = e.target as Node;
			if (!dropdown.contains(target)) {
				dropdown.open = false;
			}
		});

		// Fermer avec Échap
		dropdown.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && dropdown.open) {
				dropdown.open = false;
				const summary = dropdown.querySelector('summary');
				summary?.focus();
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupDropdown);
	} else {
		setupDropdown();
	}
</script>

<style>
	header {
		position: relative;
		z-index: 1000;
		margin: 0;
		padding: 0 1.2em;
		background: var(--bg);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1.05em;
		letter-spacing: -0.01em;
	}

	h2 a,
	h2 a.active {
		color: var(--heading);
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 56px;
	}
	nav a {
		padding: 1em 0.75em;
		color: var(--heading);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	nav a:hover,
	nav a:focus-visible {
		color: var(--accent);
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		color: var(--accent-dark);
		font-weight: 600;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
		white-space: nowrap;
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
	}
	.social-links a {
		padding: 0.5em;
		border-bottom: none;
	}

	/* Menu déroulant Œuvres & auteurs */
	.dropdown {
		position: relative;
		display: inline-block;
	}
	.dropdown-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 1em 0.75em;
		color: var(--heading);
		font-family: inherit;
		font-size: 1em;
		cursor: pointer;
		border-bottom: 4px solid transparent;
		list-style: none;
		user-select: none;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	/* Masquer le triangle natif de details/summary */
	.dropdown-toggle::-webkit-details-marker {
		display: none;
	}
	.dropdown-toggle::marker {
		display: none;
		content: '';
	}
	.dropdown-toggle:hover,
	.dropdown-toggle:focus-visible {
		color: var(--accent);
	}
	.dropdown-toggle.active {
		border-bottom-color: var(--accent);
		color: var(--accent-dark);
		font-weight: 600;
	}
	.dropdown-chevron {
		transition: transform 0.2s ease;
		opacity: 0.7;
	}
	.dropdown[open] .dropdown-chevron {
		transform: rotate(180deg);
	}

	/* Conteneur de la liste déroulante */
	.dropdown-menu {
		position: absolute;
		top: calc(100% + 4px);
		left: 50%;
		transform: translateX(-50%);
		min-width: 290px;
		margin: 0;
		padding: 0.5em 0;
		list-style: none;
		background: var(--bg);
		border: 1px solid var(--hr);
		border-radius: 8px;
		box-shadow: 0 8px 24px rgba(var(--black), 12%), 0 2px 6px rgba(var(--black), 6%);
		z-index: 1010;
	}
	.dropdown-menu li {
		margin: 0;
		padding: 0;
	}
	.dropdown-item {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15em;
		padding: 0.6em 1em;
		border-bottom: none;
		color: var(--heading);
		font-size: 0.92em;
		line-height: 1.3;
		white-space: normal;
		text-align: left;
		transition: background-color 0.15s ease, color 0.15s ease;
	}
	.dropdown-item:hover,
	.dropdown-item:focus-visible {
		background-color: var(--code-bg);
		color: var(--accent);
	}
	.dropdown-item.active {
		border-bottom: none;
		background-color: rgba(35, 55, 255, 0.08);
		color: var(--accent-dark);
		font-weight: 600;
	}
	@media (prefers-color-scheme: dark) {
		.dropdown-item.active {
			background-color: rgba(129, 140, 248, 0.15);
		}
	}
	.work-title {
		font-weight: 600;
		color: inherit;
	}
	.work-meta {
		font-size: 0.82em;
		color: var(--gray);
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
	}
	.work-sep {
		opacity: 0.6;
	}

	/* Responsive : tablette & mobile */
	@media (max-width: 768px) {
		.social-links {
			display: none;
		}
		nav {
			flex-wrap: wrap;
			padding: 0.4em 0;
		}
		h2 {
			flex: 1 0 100%;
			padding: 0.4em 0 0.2em 0;
		}
		h2 a {
			display: inline-flex;
			align-items: center;
			min-height: 44px;
		}
		.internal-links {
			flex: 1 0 100%;
			justify-content: flex-start;
			gap: 0.1em;
			flex-wrap: wrap;
		}
		nav .internal-links :global(a),
		.dropdown-toggle {
			display: inline-flex;
			align-items: center;
			min-height: 44px;
			padding: 0.5em 0.6em;
			font-size: 0.95em;
			box-sizing: border-box;
		}
		.dropdown-menu {
			position: static;
			transform: none;
			width: 100%;
			min-width: 100%;
			margin-top: 0.3em;
			margin-bottom: 0.5em;
			box-shadow: none;
			border: 1px solid var(--hr);
		}
		.dropdown-item {
			padding: 0.7em 0.9em;
			min-height: 44px;
			box-sizing: border-box;
		}
	}
</style>
