---
// Composant interactif de la Carte des Relations entre les personnages du Père Goriot
// Respecte les conventions d'accessibilité (WCAG AAA/AA, focus visible, navigation clavier, prefers-reduced-motion)
// Supporte les filtres par catégorie, les parcours guidés, la chronologie par étape et la recherche de personnages.

import '../styles/editorial-map.css';
import { targetsOf } from './relationship-map/geometry';
import {
	estimateLabelSize,
	estimateNodeBox,
	layoutGoriotMap,
	type MapLayoutResult,
} from './relationship-map/goriot-layout';
import { edgePath } from './relationship-map/label-placement';
import type { EdgeType, MapNode, MapRelationship } from './relationship-map/types';
import {
	goriotCharacters,
	goriotGuidedTracks,
	goriotMapLayout,
	goriotNarrativeStages,
	goriotRelCategories,
	goriotRelationships,
	goriotStructuralClusters,
	type GoriotCharacterData,
	type GoriotRelationshipCategory,
	type GoriotRelationshipData,
	type GoriotStructuralCluster,
	type NarrativeStage,
} from '../data/goriot-relationships';

interface Props {
	id?: string;
}

const { id = 'goriot-rel-network' } = Astro.props;

// Conversion des données Goriot vers le format MapNode et MapRelationship
const layout = goriotMapLayout.desktop;
const mobileLayout = goriotMapLayout.mobile;
const anchor = goriotMapLayout.anchor;

const mapNodes: MapNode[] = goriotCharacters.map((c) => ({
	id: c.id,
	label: c.label,
	caption: c.caption,
	eyebrow: c.eyebrow,
	meta: c.meta,
	description: c.description,
	points: c.keyFacts,
	color: c.color,
	tier: c.tier,
	x: c.x,
	y: c.y,
	mx: c.mx,
	my: c.my,
}));

const mapRelationships: MapRelationship[] = goriotRelationships.map((r) => ({
	id: r.id,
	source: r.source,
	target: r.target,
	type: r.category,
	label: r.label,
	description: r.description,
}));

// Conversion des catégories en EdgeType pour le style SVG
const edgeTypes: Record<string, EdgeType> = Object.fromEntries(
	Object.entries(goriotRelCategories).map(([catKey, cat]) => [
		catKey,
		{
			legend: cat.label,
			stroke: cat.color,
			activeStroke: cat.color,
			width: 2,
			activeWidth: 3.2,
			dash: cat.dash,
			arrow: cat.arrow,
		},
	]),
);

const nodesById = new Map(mapNodes.map((n) => [n.id, n]));
const rels = mapRelationships.map((r, i) => ({
	...r,
	id: r.id ?? `${r.source}-${i}`,
	targets: targetsOf(r),
}));

const markerId = (type: string, active: boolean) => `${id}-arrow-${type}${active ? '-on' : ''}`;
const typeStyle = (type: string) => {
	const t = edgeTypes[type] ?? {};
	const styles = [
		`--stroke: ${t.stroke ?? 'var(--map-border)'}`,
		`--stroke-on: ${t.activeStroke ?? 'var(--map-accent)'}`,
		`--w: ${t.width ?? 1.75}`,
		`--w-on: ${t.activeWidth ?? (t.width ?? 1.75) + 1}`,
		`--dash: ${t.dash ?? 'none'}`,
	];
	if (t.arrow) {
		styles.push(`--m-end: url(#${markerId(type, false)})`, `--m-end-on: url(#${markerId(type, true)})`);
		if (t.arrow === 'both') {
			styles.push(`--m-start: url(#${markerId(type, false)})`, `--m-start-on: url(#${markerId(type, true)})`);
		}
	}
	return styles.join('; ');
};

const nameOf = (nid: string) => nodesById.get(nid)?.label ?? nid;
const relTitle = (r: (typeof rels)[number]) =>
	`${nameOf(r.source)} ${edgeTypes[r.type]?.arrow === 'end' ? '→' : '↔'} ${r.targets.map(nameOf).join(' et ')}`;

const layouts = [
	{ key: 'desktop', mobile: false, size: layout },
	{ key: 'mobile', mobile: true, size: mobileLayout },
];

// Tracé initial calculé au rendu serveur à partir de tailles estimées ;
// le client le recalcule ensuite avec les tailles réellement mesurées.
const labelSizes = new Map(goriotRelationships.map((r) => [r.id, estimateLabelSize(r.label)]));
const computed: Record<string, MapLayoutResult> = Object.fromEntries(
	layouts.map(({ key, mobile, size }) => [
		key,
		layoutGoriotMap({
			rels: goriotRelationships,
			clusters: goriotStructuralClusters,
			mobile,
			size,
			boxes: new Map(goriotCharacters.map((c) => [c.id, estimateNodeBox(c, mobile)])),
			labelSizes,
			obstacles: mobile ? [] : [{ l: anchor.x - 150, t: anchor.y - 34, r: anchor.x + 150, b: anchor.y + 34 }],
		}),
	]),
);

const categoriesList = Object.values(goriotRelCategories);

// Données client complètes pour scripts d'interaction
const clientPayload = {
	characters: goriotCharacters,
	relationships: goriotRelationships,
	categories: goriotRelCategories,
	stages: goriotNarrativeStages,
	tracks: goriotGuidedTracks,
	clusters: goriotStructuralClusters,
	layout: { desktop: layout, mobile: mobileLayout },
};

const canvasStyle = [
	`--dcw: ${layout.width}`,
	`--dch: ${layout.height}`,
	`--mcw: ${mobileLayout.width}`,
	`--mch: ${mobileLayout.height}`,
].join('; ');
---

<div class="goriot-rel-app" id={id} data-goriot-rel-app>
	<!-- Données JSON sérialisées -->
	<script type="application/json" data-network-data set:html={JSON.stringify(clientPayload)} />

	<!-- Barre des contrôles : Filtres, Chronologie, Parcours guidés & Recherche -->
	<div class="network-controls" aria-label="Contrôles du graphe relationnel">
		<!-- Ligne 1 : Recherche + Compteur interactif + Réinitialisation -->
		<div class="controls-toolbar">
			<div class="search-box">
				<label for={`${id}-search-input`} class="sr-only">Rechercher un personnage du Père Goriot</label>
				<input
					type="search"
					id={`${id}-search-input`}
					class="search-input"
					placeholder="Rechercher un personnage (ex : Rastignac, Goriot, Vautrin...)"
					autocomplete="off"
					data-search-input
				/>
			</div>

			<div class="toolbar-stats" aria-live="polite" data-stats-indicator>
				<span class="stats-badge" data-stats-count>
					<strong>16</strong> personnages visibles · <strong>23</strong> relations
				</span>
			</div>

			<div class="toolbar-actions">
				<button type="button" class="ctrl-btn btn-show-all" data-btn-show-all title="Afficher toutes les catégories et relations">
					Tout afficher
				</button>
				<button type="button" class="ctrl-btn btn-reset" data-btn-reset title="Réinitialiser filtres et sélection">
					Réinitialiser
				</button>
			</div>
		</div>

		<!-- Ligne 2 : Filtres de catégories de relations (cases interactives) -->
		<div class="categories-filter-bar" role="group" aria-label="Filtrer par type de relation">
			<span class="filter-bar-label">Catégories de liens :</span>
			<div class="cat-chips">
				{categoriesList.map((cat) => {
					const count = goriotRelationships.filter((r) => r.category === cat.id).length;
					return (
						<button
							type="button"
							class="cat-chip is-checked"
							data-cat-filter={cat.id}
							aria-pressed="true"
							style={`--cat-accent: ${cat.color};`}
						>
							<span class="cat-chip-bullet" aria-hidden="true" />
							<span class="cat-chip-name">{cat.label}</span>
							<span class="cat-chip-count">({count})</span>
						</button>
					);
				})}
			</div>
		</div>

		<!-- Ligne 3 : Parcours guidés éditoriaux & Évolution chronologique -->
		<div class="guided-and-stages-bar">
			<!-- Parcours guidés -->
			<div class="guided-tracks-selector">
				<span class="bar-sublabel">Parcours guidés :</span>
				<div class="track-buttons" role="group" aria-label="Sélectionner un parcours guidé">
					{goriotGuidedTracks.map((track) => (
						<button
							type="button"
							class="track-btn"
							data-track-id={track.id}
							aria-pressed="false"
							title={track.subtitle}
						>
							{track.title}
						</button>
					))}
				</div>
			</div>

			<!-- Évolution dans le récit (chronologie des 4 étapes) -->
			<div class="stages-timeline-selector">
				<label for={`${id}-stage-select`} class="bar-sublabel">Évolution du roman :</label>
				<select id={`${id}-stage-select`} class="stage-select" data-stage-select>
					<option value="all" selected>Roman entier (Toutes les étapes · 1819–1820)</option>
					{goriotNarrativeStages.map((stage) => (
						<option value={stage.id}>
							{stage.title} ({stage.partName})
						</option>
					))}
				</select>
			</div>
		</div>

		<!-- Bannière informative lorsqu'un parcours ou une étape est actif -->
		<div class="track-banner" data-track-banner hidden>
			<div class="track-banner-text">
				<strong data-track-banner-title></strong>
				<p data-track-banner-desc></p>
			</div>
			<button type="button" class="btn-close-track" data-close-track aria-label="Quitter le parcours guidé">×</button>
		</div>
	</div>

	<!-- Guide pédagogique de structure du réseau relationnel -->
	<section class="network-structure-guide" aria-label="Organisation du réseau relationnel">
		<div class="structure-guide-header">
			<span class="structure-guide-title">
				<svg class="structure-guide-icon" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
					<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
				</svg>
				Structure du réseau relationnel
			</span>
			<p class="structure-guide-summary">
				Ce graphe rassemble 16 personnages et 23 relations documentées. Il s’articule autour d’un <strong>noyau relationnel central</strong> (7 personnages majeurs et confidents), entouré de <strong>4 satellites distincts</strong> rattachés par des points pivots précis, et d’un <strong>personnage périphérique</strong>. Ces regroupements mettent en lumière la structure des intrigues sans enfermer les personnages : certains, comme Madame Vauquer, jouent un rôle transversal entre la sociabilité du noyau et le service de ses domestiques.
			</p>
		</div>

		<div class="structure-clusters-nav" role="group" aria-label="Explorer les groupes du réseau">
			<span class="clusters-nav-label">Explorer par groupe :</span>
			<div class="cluster-chips">
				{goriotStructuralClusters.map((cluster) => (
					<button
						type="button"
						class={`cluster-chip cluster-chip--${cluster.type}`}
						data-cluster-filter={cluster.id}
						aria-pressed="false"
						title={cluster.subtitle}
					>
						<span class="cluster-chip-badge">{cluster.tag}</span>
						<span class="cluster-chip-name">{cluster.label.replace(/^(Satellite|Périphérie) /, '')}</span>
					</button>
				))}
			</div>
		</div>
	</section>

	<!-- Graphe SVG & Éléments positionnés -->
	<div class="rm-frame">
		<p class="rm-scroll-hint" aria-hidden="true">
			← Faites défiler horizontalement pour voir tout le graphe →
		</p>
		<div class="rm-viewport" data-map-viewport>
			<div class="rm-canvas" style={canvasStyle} data-map-canvas>
				<!-- Repère d'angle discret pour le roman -->
				<div class="rm-anchor rm-pos" style={`--x: ${anchor.x}; --y: ${anchor.y};`} aria-hidden="true" data-map-anchor>
					<span class="rm-anchor-title">L’Échiquier social balzacien</span>
					<span class="rm-anchor-sub">Rastignac au centre des ambitions et des tentations</span>
				</div>

				<!-- Zones structurales en arrière-plan (noyau et satellites) -->
				{layouts.map(({ key, mobile, size }) => (
					<svg
						class={`rm-zones rm-zones--${key}`}
						viewBox={`0 0 ${size.width} ${size.height}`}
						preserveAspectRatio="none"
						aria-hidden="true"
						focusable="false"
					>
						{goriotStructuralClusters.map((cluster) => {
							const rect = mobile ? cluster.mRect : cluster.dRect;
							const labelY = rect.y + 14;
							const labelX = rect.x + 10;
							return (
								<g
									class={`rm-cluster-zone rm-cluster-zone--${cluster.type}`}
									data-cluster-id={cluster.id}
									data-cluster-type={cluster.type}
								>
									<rect
										x={rect.x}
										y={rect.y}
										width={rect.w}
										height={rect.h}
										rx={rect.rx ?? 10}
										ry={rect.rx ?? 10}
										class="rm-cluster-rect"
									/>
									<text x={labelX} y={labelY} class="rm-cluster-tag">
										{cluster.tag.toUpperCase()}
									</text>
									<text x={labelX + cluster.tag.length * 6.5 + 8} y={labelY} class="rm-cluster-name">
										· {cluster.label}
									</text>
								</g>
							);
						})}
					</svg>
				))}

				<!-- Définitions SVG des flèches -->
				<svg class="rm-defs" aria-hidden="true" focusable="false" width="0" height="0">
					<defs>
						{Object.entries(edgeTypes).filter(([, t]) => t.arrow).flatMap(([type, t]) =>
							[false, true].map((active) => (
								<marker
									id={markerId(type, active)}
									viewBox="0 0 10 10"
									markerWidth="9"
									markerHeight="9"
									markerUnits="userSpaceOnUse"
									refX="9"
									refY="5"
									orient="auto-start-reverse"
								>
									<path
										d="M0 0 L10 5 L0 10 z"
										style={`fill: ${active ? t.activeStroke ?? 'var(--map-accent)' : t.stroke ?? 'var(--map-border)'}`}
									/>
								</marker>
							)),
						)}
					</defs>
				</svg>

				<!-- Tracé SVG des arêtes (desktop et mobile) -->
				{layouts.map(({ key, mobile, size }) => (
					<svg
						class={`rm-lines rm-lines--${key}`}
						viewBox={`0 0 ${size.width} ${size.height}`}
						preserveAspectRatio="none"
						aria-hidden="true"
						focusable="false"
					>
						{rels.map((r) => {
							const edge = computed[key].edges[r.id];
							const relFull = goriotRelationships.find((item) => item.id === r.id);
							return (
								<g
									class={`rm-edge rm-edge--${r.type}`}
									style={typeStyle(r.type)}
									data-edge-id={r.id}
									data-category={r.type}
									data-stage={relFull?.firstEstablishedStage}
									data-ends={[r.source, ...r.targets].join(' ')}
								>
									<path d={edgePath(edge)} class="rm-edge-line" />
								</g>
							);
						})}
					</svg>
				))}

				<!-- Étiquettes cliquables des relations -->
				<ul class="rm-labels" aria-label="Relations entre personnages">
					{rels.map((r) => {
						const d = computed.desktop.labels[r.id];
						const m = computed.mobile.labels[r.id];
						const relFull = goriotRelationships.find((item) => item.id === r.id);
						return (
							<li>
								<button
									type="button"
									class={`rm-label rm-pos rm-label--${r.type}`}
									data-edge-id={r.id}
									data-category={r.type}
									data-stage={relFull?.firstEstablishedStage}
									data-ends={[r.source, ...r.targets].join(' ')}
									aria-pressed="false"
									aria-label={`Relation ${relTitle(r)} : ${r.label}`}
									style={`--x: ${d.x}; --y: ${d.y}; --mx: ${m.x}; --my: ${m.y};`}
								>
									{r.label}
								</button>
							</li>
						);
					})}
				</ul>

				<!-- Nœuds des personnages -->
				<ul class="rm-nodes" aria-label="Personnages du Père Goriot">
					{mapNodes.map((node) => (
						<li>
							<button
								type="button"
								class={`rm-node rm-pos rm-node--${node.tier ?? 'standard'}`}
								aria-pressed="false"
								aria-controls={`${id}-panel`}
								data-node-id={node.id}
								style={[
									`--x: ${node.x}`,
									`--y: ${node.y}`,
									node.mx !== undefined && `--mx: ${node.mx}`,
									node.my !== undefined && `--my: ${node.my}`,
									node.color && `--node-color: ${node.color}`,
								].filter(Boolean).join('; ')}
							>
								<span class="rm-node-bullet" aria-hidden="true" />
								<span class="rm-node-content">
									<strong class="rm-node-title">{node.label}</strong>
									<span class="rm-node-caption">{node.caption}</span>
								</span>
							</button>
						</li>
					))}
				</ul>
			</div>
		</div>

		<!-- Légende accessible intégrée -->
		<ul class="rm-legend" aria-label="Légende des types de liens">
			{categoriesList.map((cat) => (
				<li style={typeStyle(cat.id)}>
					<svg viewBox="0 0 40 10" width="40" height="10" aria-hidden="true" focusable="false">
						<line x1="2" y1="5" x2={edgeTypes[cat.id]?.arrow ? 36 : 38} y2="5" class="rm-edge-line" />
					</svg>
					{cat.label}
				</li>
			))}
		</ul>
	</div>

	<!-- Panneau d'information contextuel -->
	<aside class="rm-panel" id={`${id}-panel`} aria-live="polite" data-panel>
		<div class="rm-panel-hint" data-panel-hint>
			<p>
				<em>
					Cliquez ou appuyez sur un personnage pour explorer sa fiche et ses relations directes, ou sur un lien pour en comprendre l’enjeu narratif et financier. Les flèches du clavier parcourent les personnages, Échap réinitialise la vue.
				</em>
			</p>
		</div>

		<div class="rm-panel-detail" data-panel-detail hidden>
			<header class="rm-detail-header">
				<div>
					<span class="rm-detail-eyebrow" data-detail-eyebrow></span>
					<h2 class="rm-detail-title" data-detail-title tabindex="-1"></h2>
					<p class="rm-detail-meta" data-detail-meta></p>
				</div>
				<button type="button" class="rm-reset" data-panel-reset>Tout réinitialiser</button>
			</header>

			<!-- Rôle social ou nature de la relation -->
			<div class="rm-detail-role-wrap" data-detail-role-wrap hidden>
				<span class="detail-badge-role" data-detail-role></span>
				<span class="detail-badge-cluster" data-detail-cluster hidden></span>
			</div>

			<p class="rm-detail-description" data-detail-description></p>

			<!-- Citation textuelle vérifiée -->
			<blockquote class="detail-quote" data-detail-quote-wrap hidden>
				<p class="quote-text" data-detail-quote-text></p>
				<cite class="quote-cite" data-detail-quote-cite></cite>
			</blockquote>

			<!-- Faits narratifs avérés -->
			<div class="rm-detail-block" data-detail-points-wrap>
				<strong>Repères narratifs vérifiés dans le roman :</strong>
				<ul class="rm-detail-points" data-detail-points></ul>
			</div>

			<!-- Relations directes connectées -->
			<div class="rm-detail-block" data-detail-relations-wrap>
				<strong>Relations avec les autres personnages :</strong>
				<ul class="rm-detail-relations" data-detail-relations></ul>
			</div>
		</div>
	</aside>

	<!-- Table/liste accessible synchronisée (alternative au graphe visuel) -->
	<details class="network-accessible-table" data-accessible-table>
		<summary>
			<strong>Inventaire textuel et accessible des personnages et de leurs relations</strong>
			<span class="toggle-icon" aria-hidden="true">Déplier ▾</span>
		</summary>
		<div class="accessible-table-content">
			<p class="accessible-intro">
				Ce tableau présente de manière exhaustive l'ensemble des 16 personnages et de leurs 23 relations documentées, synchronisé avec les filtres en cours.
			</p>
			<div class="table-responsive-wrapper">
				<table class="data-table">
					<thead>
						<tr>
							<th scope="col">Personnage</th>
							<th scope="col">Rôle & condition</th>
							<th scope="col">Relations directes</th>
							<th scope="col">Action</th>
						</tr>
					</thead>
					<tbody>
						{goriotCharacters.map((c) => {
							const relsOf = goriotRelationships.filter(
								(r) => r.source === c.id || r.target === c.id,
							);
							return (
								<tr data-acc-row-id={c.id}>
									<th scope="row">
										<strong>{c.label}</strong>
										<br />
										<small>{c.caption}</small>
									</th>
									<td>
										<div>{c.socialRole}</div>
										<div class="acc-cluster-info">
											<span class={`acc-cluster-tag acc-cluster-tag--${c.clusterId.startsWith('satellite') ? 'satellite' : c.clusterId === 'core' ? 'core' : 'peripheral'}`}>
												{c.clusterId === 'core' ? 'Noyau relationnel' : c.clusterId === 'peripheral-nucingen' ? 'Périphérie' : 'Satellite'}
											</span>
											<small class="acc-cluster-desc">{c.structuralRole}</small>
										</div>
									</td>
									<td>
										<ul class="acc-rels-list">
											{relsOf.map((r) => {
												const otherId = r.source === c.id ? r.target : r.source;
												const otherName = nameOf(otherId);
												const catMeta = goriotRelCategories[r.category];
												return (
													<li>
														<span class="acc-cat-tag" style={`border-color: ${catMeta.color}; color: ${catMeta.color};`}>
															{catMeta.label}
														</span>
														<strong> {otherName}</strong> : {r.label} ({r.shortSummary})
													</li>
												);
											})}
										</ul>
									</td>
									<td>
										<button
											type="button"
											class="btn-acc-select"
											data-acc-select-id={c.id}
										>
											Sélectionner
										</button>
									</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>
		</div>
	</details>
</div>

<script>
	import type { Box } from './relationship-map/geometry';
	import { layoutGoriotMap, type LayoutCluster, type Size } from './relationship-map/goriot-layout';
	import { edgePath, type Rect } from './relationship-map/label-placement';

	interface ClusterPayload extends LayoutCluster {
		id: string;
		type: 'core' | 'satellite' | 'peripheral';
		label: string;
		subtitle: string;
		tag: string;
		description: string;
		nodeIds: string[];
		attachmentPointNodeIds: string[];
		attachmentEdgeIds: string[];
	}

	interface CharacterPayload {
		id: string;
		label: string;
		usageName: string;
		caption: string;
		eyebrow: string;
		meta: string[];
		socialRole: string;
		description: string;
		keyFacts: string[];
		quote?: {
			text: string;
			context: string;
			reference: string;
		};
		color: string;
		tier: string;
		clusterId: string;
		structuralRole: string;
	}

	interface RelPayload {
		id: string;
		source: string;
		target: string;
		category: string;
		label: string;
		shortSummary: string;
		description: string;
		asymmetric: boolean;
		directionLabel?: string;
		firstEstablishedStage: string;
		certainty: string;
		textualQuote?: {
			text: string;
			speaker?: string;
			reference: string;
		};
		narrativeContext: string;
		bend?: number;
		mBend?: number;
		labelT?: number;
	}

	interface CategoryPayload {
		id: string;
		label: string;
		description: string;
		color: string;
	}

	interface TrackPayload {
		id: string;
		title: string;
		subtitle: string;
		description: string;
		focusNodeIds: string[];
		highlightRelIds: string[];
	}

	interface NetworkData {
		characters: CharacterPayload[];
		relationships: RelPayload[];
		categories: Record<string, CategoryPayload>;
		stages: Array<{ id: string; num: number; title: string; partName: string; synopsis: string }>;
		tracks: TrackPayload[];
		clusters: ClusterPayload[];
		layout: Record<'desktop' | 'mobile', { width: number; height: number }>;
	}

	function initGoriotRelNetwork(appEl: HTMLElement) {
		const rawData = appEl.querySelector('[data-network-data]')?.textContent;
		if (!rawData) return;
		const data = JSON.parse(rawData) as NetworkData;

		const q = <T extends Element = HTMLElement>(sel: string) => appEl.querySelector<T>(sel)!;
		const qa = <T extends Element = HTMLElement>(sel: string) => [...appEl.querySelectorAll<T>(sel)];

		const canvas = q('[data-map-canvas]');
		const viewport = q('[data-map-viewport]');
		const nodeButtons = qa<HTMLButtonElement>('.rm-node');
		const labelButtons = qa<HTMLButtonElement>('.rm-label');
		const edgeGroups = qa<SVGGElement>('.rm-edge');
		const catChips = qa<HTMLButtonElement>('[data-cat-filter]');
		const clusterChips = qa<HTMLButtonElement>('[data-cluster-filter]');
		const clusterZones = qa<SVGGElement>('.rm-cluster-zone');
		const trackButtons = qa<HTMLButtonElement>('[data-track-id]');
		const stageSelect = q<HTMLSelectElement>('[data-stage-select]');
		const searchInput = q<HTMLInputElement>('[data-search-input]');
		const statsCount = q('[data-stats-count]');
		const btnShowAll = q('[data-btn-show-all]');
		const btnReset = q('[data-btn-reset]');

		const trackBanner = q('[data-track-banner]');
		const trackBannerTitle = q('[data-track-banner-title]');
		const trackBannerDesc = q('[data-track-banner-desc]');
		const closeTrackBtn = q('[data-close-track]');

		const panelHint = q('[data-panel-hint]');
		const panelDetail = q('[data-panel-detail]');
		const detailEyebrow = q('[data-detail-eyebrow]');
		const detailTitle = q('[data-detail-title]');
		const detailMeta = q('[data-detail-meta]');
		const detailRoleWrap = q('[data-detail-role-wrap]');
		const detailRole = q('[data-detail-role]');
		const detailCluster = q('[data-detail-cluster]');
		const detailDesc = q('[data-detail-description]');
		const detailQuoteWrap = q('[data-detail-quote-wrap]');
		const detailQuoteText = q('[data-detail-quote-text]');
		const detailQuoteCite = q('[data-detail-quote-cite]');
		const pointsWrap = q('[data-detail-points-wrap]');
		const pointsList = q('[data-detail-points]');
		const relsWrap = q('[data-detail-relations-wrap]');
		const relsList = q('[data-detail-relations]');
		const panelReset = q('[data-panel-reset]');

		const charMap = new Map(data.characters.map((c) => [c.id, c]));
		const relMap = new Map(data.relationships.map((r) => [r.id, r]));
		const clusterMap = new Map((data.clusters ?? []).map((cl) => [cl.id, cl]));
		const nodeBtnById = new Map(nodeButtons.map((b) => [b.dataset.nodeId!, b]));

		// État interactif
		let activeCategories = new Set(Object.keys(data.categories));
		let currentStage: string = 'all'; // 'all' ou 'stage-1'..'stage-4'
		let currentTrack: TrackPayload | null = null;
		let searchQuery = '';
		type Selection =
			| { kind: 'node'; id: string }
			| { kind: 'edge'; id: string }
			| { kind: 'cluster'; id: string }
			| null;
		let selected: Selection = null;

		const endsOf = (r: RelPayload) => [r.source, r.target];
		const relsOfNode = (nodeId: string) => data.relationships.filter((r) => r.source === nodeId || r.target === nodeId);

		// Filtrage combiné : catégorie + étape narrative chronologique + recherche
		function isRelVisible(r: RelPayload): boolean {
			// 1. Catégorie active
			if (!activeCategories.has(r.category)) return false;

			// 2. Étape chronologique
			if (currentStage !== 'all') {
				const currentStageNum = data.stages.find((s) => s.id === currentStage)?.num ?? 99;
				const relStageNum = data.stages.find((s) => s.id === r.firstEstablishedStage)?.num ?? 1;
				if (relStageNum > currentStageNum) return false;
			}

			// 3. Parcours guidé actif : ne masque pas les autres mais les filtres généraux s'appliquent
			return true;
		}

		function isNodeVisible(c: CharacterPayload): boolean {
			// Recherche texte par nom ou métadonnées
			if (searchQuery) {
				const qLower = searchQuery.toLowerCase();
				const matchName = c.label.toLowerCase().includes(qLower) || c.usageName.toLowerCase().includes(qLower);
				const matchMeta = c.caption.toLowerCase().includes(qLower) || c.socialRole.toLowerCase().includes(qLower);
				if (!matchName && !matchMeta) return false;
			}
			return true;
		}

		function updateVisibility() {
			let visibleRelsCount = 0;
			let visibleNodesCount = 0;

			// Mise à jour des arêtes et étiquettes
			for (const r of data.relationships) {
				const visible = isRelVisible(r);
				if (visible) visibleRelsCount++;

				for (const edge of edgeGroups) {
					if (edge.dataset.edgeId === r.id) {
						edge.style.display = visible ? '' : 'none';
					}
				}
				for (const lbl of labelButtons) {
					if (lbl.dataset.edgeId === r.id) {
						lbl.style.display = visible ? '' : 'none';
					}
				}
			}

			// Mise à jour des nœuds
			for (const c of data.characters) {
				const visible = isNodeVisible(c);
				if (visible) visibleNodesCount++;
				const btn = nodeBtnById.get(c.id);
				if (btn) {
					btn.style.display = visible ? '' : 'none';
				}
			}

			// Mise à jour de l'indicateur de stats
			statsCount.innerHTML = `<strong>${visibleNodesCount}</strong> personnage${visibleNodesCount > 1 ? 's' : ''} visible${visibleNodesCount > 1 ? 's' : ''} · <strong>${visibleRelsCount}</strong> relation${visibleRelsCount > 1 ? 's' : ''}`;

			// Synchronisation avec la table accessible
			for (const row of qa('[data-acc-row-id]')) {
				const rowId = row.dataset.accRowId!;
				const charData = charMap.get(rowId)!;
				row.style.display = isNodeVisible(charData) ? '' : 'none';
			}

			highlight(selected);
		}

		function highlight(sel: Selection) {
			appEl.toggleAttribute('data-active', !!sel || !!currentTrack);
			const activeNodes = new Set<string>();
			const relatedNodes = new Set<string>();
			const pivotNodes = new Set<string>();
			const activeEdges = new Set<string>();
			const highlightedClusters = new Set<string>();

			if (sel?.kind === 'node') {
				activeNodes.add(sel.id);
				const charData = charMap.get(sel.id);
				if (charData?.clusterId) {
					highlightedClusters.add(charData.clusterId);
					const cl = clusterMap.get(charData.clusterId);
					if (cl && cl.type !== 'core') {
						cl.attachmentPointNodeIds.forEach((pid) => {
							relatedNodes.add(pid);
							pivotNodes.add(pid);
						});
						cl.attachmentEdgeIds.forEach((eid) => activeEdges.add(eid));
					}
				}

				for (const r of relsOfNode(sel.id)) {
					if (isRelVisible(r)) {
						activeEdges.add(r.id);
						endsOf(r).forEach((n) => n !== sel.id && relatedNodes.add(n));
					}
				}
			} else if (sel?.kind === 'edge') {
				const r = relMap.get(sel.id);
				if (r && isRelVisible(r)) {
					activeEdges.add(r.id);
					relatedNodes.add(r.source);
					relatedNodes.add(r.target);
					const sChar = charMap.get(r.source);
					const tChar = charMap.get(r.target);
					if (sChar?.clusterId) highlightedClusters.add(sChar.clusterId);
					if (tChar?.clusterId) highlightedClusters.add(tChar.clusterId);
				}
			} else if (sel?.kind === 'cluster') {
				highlightedClusters.add(sel.id);
				const cl = clusterMap.get(sel.id);
				if (cl) {
					cl.nodeIds.forEach((nid) => activeNodes.add(nid));
					if (cl.type !== 'core') {
						cl.attachmentPointNodeIds.forEach((pid) => {
							relatedNodes.add(pid);
							pivotNodes.add(pid);
						});
					}
					for (const r of data.relationships) {
						if (cl.nodeIds.includes(r.source) && cl.nodeIds.includes(r.target) && isRelVisible(r)) {
							activeEdges.add(r.id);
						}
					}
					cl.attachmentEdgeIds.forEach((eid) => {
						const r = relMap.get(eid);
						if (r && isRelVisible(r)) activeEdges.add(eid);
					});
				}
			} else if (currentTrack) {
				currentTrack.focusNodeIds.forEach((nid) => activeNodes.add(nid));
				currentTrack.highlightRelIds.forEach((rid) => activeEdges.add(rid));
			}

			for (const btn of nodeButtons) {
				const nid = btn.dataset.nodeId!;
				btn.classList.toggle('is-active', activeNodes.has(nid));
				btn.classList.toggle('is-related', relatedNodes.has(nid));
				btn.classList.toggle('is-pivot', pivotNodes.has(nid));
			}

			for (const el of [...edgeGroups, ...labelButtons]) {
				const eid = el.dataset.edgeId!;
				el.classList.toggle('is-related', activeEdges.has(eid));
			}

			for (const zone of clusterZones) {
				const cid = zone.dataset.clusterId!;
				zone.classList.toggle('is-highlighted', highlightedClusters.has(cid));
			}

			for (const chip of clusterChips) {
				const cid = chip.dataset.clusterFilter!;
				chip.setAttribute('aria-pressed', String(sel?.kind === 'cluster' && sel.id === cid));
				chip.classList.toggle('is-active', sel?.kind === 'cluster' && sel.id === cid);
			}
		}

		function populate(sel: Selection) {
			panelHint.hidden = !!sel;
			panelDetail.hidden = !sel;
			if (!sel) return;

			pointsList.replaceChildren();
			relsList.replaceChildren();

			if (sel.kind === 'node') {
				const c = charMap.get(sel.id)!;
				detailEyebrow.textContent = c.eyebrow ?? 'Personnage';
				detailTitle.textContent = c.label;
				detailMeta.textContent = `${c.caption} · ${c.meta.join(' · ')}`;

				detailRoleWrap.hidden = false;
				detailRole.textContent = `Rôle : ${c.socialRole}`;

				const cluster = clusterMap.get(c.clusterId);
				if (cluster) {
					detailCluster.hidden = false;
					if (cluster.type === 'core') {
						detailCluster.textContent = `Position : Noyau relationnel central (${c.structuralRole})`;
					} else if (cluster.type === 'satellite') {
						const attachmentNames = cluster.attachmentPointNodeIds
							.map((id) => charMap.get(id)?.label ?? id)
							.join(', ');
						detailCluster.textContent = `Position : ${cluster.label} · Rattaché au noyau via ${attachmentNames} (${c.structuralRole})`;
					} else {
						const attachmentNames = cluster.attachmentPointNodeIds
							.map((id) => charMap.get(id)?.label ?? id)
							.join(', ');
						detailCluster.textContent = `Position : Périphérie · Rattaché via ${attachmentNames} (${c.structuralRole})`;
					}
				} else {
					detailCluster.hidden = true;
				}

				detailDesc.textContent = c.description;

				// Citation du personnage
				if (c.quote) {
					detailQuoteWrap.hidden = false;
					detailQuoteText.textContent = `« ${c.quote.text} »`;
					detailQuoteCite.textContent = `${c.quote.reference} — ${c.quote.context}`;
				} else {
					detailQuoteWrap.hidden = true;
				}

				// Points clés
				for (const pt of c.keyFacts) {
					const li = document.createElement('li');
					li.textContent = pt;
					pointsList.append(li);
				}
				pointsWrap.hidden = c.keyFacts.length === 0;

				// Relations du personnage
				const related = relsOfNode(c.id).filter(isRelVisible);
				for (const r of related) {
					const li = document.createElement('li');
					const badge = document.createElement('span');
					badge.className = 'rm-rel-badge';
					badge.textContent = `${r.label} · ${data.categories[r.category]?.label.toLowerCase()}`;
					li.append(badge);

					const otherId = r.source === c.id ? r.target : r.source;
					const other = charMap.get(otherId)!;

					const link = document.createElement('button');
					link.type = 'button';
					link.className = 'rm-rel-link';
					link.textContent = other.label;
					link.addEventListener('click', () => {
						select({ kind: 'node', id: otherId });
						nodeBtnById.get(otherId)?.focus({ preventScroll: true });
					});
					li.append(link);

					li.append(` : ${r.shortSummary}`);
					relsList.append(li);
				}
				relsWrap.hidden = related.length === 0;
			} else if (sel.kind === 'edge') {
				const r = relMap.get(sel.id)!;
				const catMeta = data.categories[r.category];
				const src = charMap.get(r.source)!;
				const tgt = charMap.get(r.target)!;

				detailEyebrow.textContent = `Relation · ${catMeta?.label ?? r.category}`;
				detailTitle.textContent = `${src.label} ${r.asymmetric ? '→' : '↔'} ${tgt.label}`;
				detailMeta.textContent = `Type : ${r.label} (Étape : ${r.firstEstablishedStage}) · Degré : ${r.certainty.replace(/_/g, ' ')}`;

				detailRoleWrap.hidden = true;
				detailCluster.hidden = true;
				detailDesc.textContent = r.description;

				// Citation textuelle sur la relation
				if (r.textualQuote) {
					detailQuoteWrap.hidden = false;
					detailQuoteText.textContent = `« ${r.textualQuote.text} »`;
					detailQuoteCite.textContent = `${r.textualQuote.reference}${r.textualQuote.speaker ? ` (${r.textualQuote.speaker})` : ''}`;
				} else {
					detailQuoteWrap.hidden = true;
				}

				pointsWrap.hidden = false;
				const li = document.createElement('li');
				li.textContent = `Contexte narratif : ${r.narrativeContext}`;
				pointsList.append(li);

				relsWrap.hidden = true;
			} else if (sel.kind === 'cluster') {
				const cl = clusterMap.get(sel.id)!;
				detailEyebrow.textContent = `${cl.tag.toUpperCase()} · STRUCTURE DU RÉSEAU`;
				detailTitle.textContent = cl.label;
				detailMeta.textContent = cl.subtitle;

				detailRoleWrap.hidden = false;
				detailRole.textContent =
					cl.type === 'core'
						? 'Rôle : Noyau relationnel central (forte interconnexion des protagonistes)'
						: cl.type === 'satellite'
							? 'Rôle : Groupe satellite (communauté autonome reliée au noyau)'
							: 'Rôle : Sommet périphérique (faiblement connecté)';

				detailCluster.hidden = false;
				if (cl.attachmentPointNodeIds.length > 0) {
					const attachmentNames = cl.attachmentPointNodeIds
						.map((id) => charMap.get(id)?.label ?? id)
						.join(', ');
					detailCluster.textContent = `Point(s) de pivot vers le noyau : ${attachmentNames}`;
				} else {
					detailCluster.textContent = 'Centre gravitationnel du roman';
				}

				detailDesc.textContent = cl.description;
				detailQuoteWrap.hidden = true;

				pointsWrap.hidden = false;
				const memberNames = cl.nodeIds.map((id) => charMap.get(id)?.label ?? id).join(', ');
				const liMembers = document.createElement('li');
				liMembers.innerHTML = `<strong>Personnages de ce groupe :</strong> ${memberNames}`;
				pointsList.append(liMembers);

				if (cl.attachmentPointNodeIds.length > 0) {
					const liAttach = document.createElement('li');
					const pNames = cl.attachmentPointNodeIds.map((id) => charMap.get(id)?.label ?? id).join(' et ');
					liAttach.innerHTML = `<strong>Point(s) de pivot vers le noyau :</strong> relié à <em>${pNames}</em>`;
					pointsList.append(liAttach);
				}

				// Relations du groupe
				relsWrap.hidden = false;
				const relsToShow = data.relationships.filter(
					(r) =>
						(cl.nodeIds.includes(r.source) && cl.nodeIds.includes(r.target)) ||
						cl.attachmentEdgeIds.includes(r.id),
				);
				for (const r of relsToShow) {
					const li = document.createElement('li');
					const isAttach = cl.attachmentEdgeIds.includes(r.id);
					const badge = document.createElement('span');
					badge.className = 'rm-rel-badge';
					badge.textContent = isAttach
						? `Lien de rattachement au noyau · ${r.label}`
						: `Lien interne au groupe · ${r.label}`;
					li.append(badge);

					const src = charMap.get(r.source)!;
					const tgt = charMap.get(r.target)!;
					li.append(` ${src.label} ↔ ${tgt.label} : ${r.shortSummary}`);
					relsList.append(li);
				}
			}
		}

		function select(sel: Selection) {
			selected = sel;
			for (const btn of nodeButtons) {
				btn.setAttribute('aria-pressed', String(sel?.kind === 'node' && btn.dataset.nodeId === sel.id));
			}
			for (const btn of labelButtons) {
				btn.setAttribute('aria-pressed', String(sel?.kind === 'edge' && btn.dataset.edgeId === sel.id));
			}
			for (const chip of clusterChips) {
				chip.setAttribute('aria-pressed', String(sel?.kind === 'cluster' && chip.dataset.clusterFilter === sel.id));
				chip.classList.toggle('is-active', sel?.kind === 'cluster' && chip.dataset.clusterFilter === sel.id);
			}
			highlight(sel);
			populate(sel);
		}

		function clear() {
			const prev = selected;
			select(null);
			if (prev?.kind === 'node') nodeBtnById.get(prev.id)?.focus({ preventScroll: true });
		}

		const isSame = (a: Selection, b: Selection) => !!a && !!b && a.kind === b.kind && a.id === b.id;

		function bindNode(btn: HTMLButtonElement, sel: Selection) {
			btn.addEventListener('click', () => (isSame(selected, sel) ? clear() : select(sel)));
			btn.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && highlight(sel));
			btn.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && highlight(selected));
			btn.addEventListener('focus', () => highlight(sel));
			btn.addEventListener('blur', () => highlight(selected));
		}

		nodeButtons.forEach((btn) => bindNode(btn, { kind: 'node', id: btn.dataset.nodeId! }));
		labelButtons.forEach((btn) => bindNode(btn, { kind: 'edge', id: btn.dataset.edgeId! }));

		clusterChips.forEach((chip) => {
			const cid = chip.dataset.clusterFilter!;
			const sel: Selection = { kind: 'cluster', id: cid };
			chip.addEventListener('click', () => (isSame(selected, sel) ? clear() : select(sel)));
			chip.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && highlight(sel));
			chip.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && highlight(selected));
			chip.addEventListener('focus', () => highlight(sel));
			chip.addEventListener('blur', () => highlight(selected));
		});

		// Navigation clavier fléchée entre nœuds
		nodeButtons.forEach((btn, i) => {
			btn.addEventListener('keydown', (e) => {
				const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
				if (e.key === 'Home' || e.key === 'End') {
					e.preventDefault();
					nodeButtons[e.key === 'Home' ? 0 : nodeButtons.length - 1].focus();
				} else if (step) {
					e.preventDefault();
					nodeButtons[(i + step + nodeButtons.length) % nodeButtons.length].focus();
				}
			});
		});

		panelReset.addEventListener('click', clear);

		appEl.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				if (selected) {
					e.preventDefault();
					clear();
				} else if (currentTrack) {
					e.preventDefault();
					deactivateTrack();
				}
			}
		});

		canvas.addEventListener('click', (e) => {
			if (selected && !(e.target as Element).closest('button')) select(null);
		});

		// Filtres de catégories
		catChips.forEach((chip) => {
			chip.addEventListener('click', () => {
				const catId = chip.dataset.catFilter!;
				if (activeCategories.has(catId)) {
					// Ne pas vider toutes les catégories
					if (activeCategories.size > 1) {
						activeCategories.delete(catId);
						chip.classList.remove('is-checked');
						chip.setAttribute('aria-pressed', 'false');
					}
				} else {
					activeCategories.add(catId);
					chip.classList.add('is-checked');
					chip.setAttribute('aria-pressed', 'true');
				}
				updateVisibility();
			});
		});

		// Évolution chronologique par étape
		stageSelect.addEventListener('change', () => {
			currentStage = stageSelect.value;
			updateVisibility();
		});

		// Parcours guidés
		function activateTrack(track: TrackPayload) {
			currentTrack = track;
			trackButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.trackId === track.id)));
			trackBanner.hidden = false;
			trackBannerTitle.textContent = `${track.title} : ${track.subtitle}`;
			trackBannerDesc.textContent = track.description;
			highlight(selected);
		}

		function deactivateTrack() {
			currentTrack = null;
			trackButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
			trackBanner.hidden = true;
			highlight(selected);
		}

		trackButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const trackId = btn.dataset.trackId!;
				if (currentTrack?.id === trackId) {
					deactivateTrack();
				} else {
					const track = data.tracks.find((t) => t.id === trackId);
					if (track) activateTrack(track);
				}
			});
		});

		closeTrackBtn.addEventListener('click', deactivateTrack);

		// Recherche
		searchInput.addEventListener('input', () => {
			searchQuery = searchInput.value.trim();
			updateVisibility();
		});

		// Bouton Tout afficher
		btnShowAll.addEventListener('click', () => {
			activeCategories = new Set(Object.keys(data.categories));
			catChips.forEach((c) => {
				c.classList.add('is-checked');
				c.setAttribute('aria-pressed', 'true');
			});
			currentStage = 'all';
			stageSelect.value = 'all';
			searchQuery = '';
			searchInput.value = '';
			updateVisibility();
		});

		// Bouton Réinitialiser
		btnReset.addEventListener('click', () => {
			activeCategories = new Set(Object.keys(data.categories));
			catChips.forEach((c) => {
				c.classList.add('is-checked');
				c.setAttribute('aria-pressed', 'true');
			});
			currentStage = 'all';
			stageSelect.value = 'all';
			searchQuery = '';
			searchInput.value = '';
			deactivateTrack();
			clear();
			updateVisibility();
		});

		// Sélection depuis la table accessible
		qa<HTMLButtonElement>('[data-acc-select-id]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const charId = btn.dataset.accSelectId!;
				select({ kind: 'node', id: charId });
				const nodeBtn = nodeBtnById.get(charId);
				if (nodeBtn) {
					nodeBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
					nodeBtn.focus({ preventScroll: true });
				}
			});
		});

		// Tracé des arêtes et placement des étiquettes à partir des tailles
		// réellement rendues (polices, zoom, largeur du canevas).
		const labelSizePx = new Map<string, Size>();
		const nodeSizePx = new Map<string, Size>();
		const remember = (cache: Map<string, Size>, key: string, el: HTMLElement) => {
			if (el.offsetWidth) cache.set(key, { w: el.offsetWidth, h: el.offsetHeight });
			return cache.get(key);
		};
		const anchorEl = appEl.querySelector<HTMLElement>('[data-map-anchor]');

		function fitEdges() {
			for (const svg of appEl.querySelectorAll<SVGSVGElement>('.rm-lines')) {
				const frame = svg.getBoundingClientRect();
				if (!frame.width) continue;
				const mobile = svg.classList.contains('rm-lines--mobile');
				const k = svg.viewBox.baseVal.width / frame.width;
				const boxes = new Map<string, Box>();
				for (const [nodeId, btn] of nodeBtnById) {
					const size = remember(nodeSizePx, nodeId, btn);
					if (!size) return;
					const style = getComputedStyle(btn);
					boxes.set(nodeId, {
						x: parseFloat(style.left) * k,
						y: parseFloat(style.top) * k,
						hw: (size.w / 2) * k,
						hh: (size.h / 2) * k,
					});
				}
				const labelSizes = new Map<string, Size>();
				for (const lbl of labelButtons) {
					const size = remember(labelSizePx, lbl.dataset.edgeId!, lbl);
					if (!size) return;
					labelSizes.set(lbl.dataset.edgeId!, { w: size.w * k, h: size.h * k });
				}
				const obstacles: Rect[] = [];
				if (!mobile && anchorEl?.offsetWidth) {
					const a = anchorEl.getBoundingClientRect();
					obstacles.push({
						l: (a.left - frame.left) * k,
						t: (a.top - frame.top) * k,
						r: (a.right - frame.left) * k,
						b: (a.bottom - frame.top) * k,
					});
				}
				const { edges, labels } = layoutGoriotMap({
					rels: data.relationships,
					clusters: data.clusters,
					mobile,
					size: data.layout[mobile ? 'mobile' : 'desktop'],
					boxes,
					labelSizes,
					obstacles,
				});
				for (const g of svg.querySelectorAll<SVGGElement>('.rm-edge')) {
					g.querySelector('path')!.setAttribute('d', edgePath(edges[g.dataset.edgeId!]));
				}
				for (const lbl of labelButtons) {
					const p = labels[lbl.dataset.edgeId!];
					lbl.style.setProperty(mobile ? '--mx' : '--x', String(p.x));
					lbl.style.setProperty(mobile ? '--my' : '--y', String(p.y));
				}
			}
		}

		new ResizeObserver(fitEdges).observe(canvas);
		document.fonts?.ready.then(fitEdges);

		// Défilement initial sur mobile : Rastignac, centre de la carte, au milieu de l'écran
		const pivot = nodeBtnById.get('rastignac');
		if (pivot && viewport.scrollWidth > viewport.clientWidth) {
			viewport.scrollLeft = pivot.offsetLeft - viewport.clientWidth / 2;
		}

		updateVisibility();
	}

	document.querySelectorAll<HTMLElement>('[data-goriot-rel-app]').forEach(initGoriotRelNetwork);
</script>

